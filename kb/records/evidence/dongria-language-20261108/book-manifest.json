  "glossary_and_map_data": {
    "review_date": "2026-11-06",
    "glossary_intro": "These short definitions explain how the terms are used in this book. Spellings follow the cited accounts.",
    "glossary": [
      {
        "term": "Aal",
        "definition": "The roots used as a dye material in NIFT’s account of Kotpad yarn colouring.",
        "source_url": "https://nift.ac.in/chhaap2026/KapiloMahanta.html",
        "chapter_slug": "kotpad-and-kapadaganda",
        "editorial_limit": "Do not add a botanical species identification; source wording is roots."
      },
      {
        "term": "Bejuni",
        "definition": "A priestess; the seed accounts describe particular bejuni helping recover varieties and conducting rituals before sowing.",
        "source_url": "https://www.ipsnews.net/2015/07/tribal-priestesses-become-guardians-of-seeds-in-eastern-india/",
        "chapter_slug": "seed-keeping",
        "editorial_limit": "Do not generalise one account into every village’s practice."
      },
      {
        "term": "Bijun Parab",
        "definition": "A seed festival described in the 2018 reporting, with seeds prepared and brought to a priestess before planting.",
        "source_url": "https://india.mongabay.com/2018/12/photos-the-dongrias-of-niyamgiri-revive-climate-resilient-heirloom-seeds/",
        "chapter_slug": "seed-keeping",
        "editorial_limit": ""
      },
      {
        "term": "DKDA",
        "definition": "Dongria Kondh Development Agency; the development agency referred to in the training and livelihood accounts.",
        "source_url": "https://stsc.odisha.gov.in/sites/default/files/2022-02/ADIVASI_Journal_Dec-2020.pdf",
        "chapter_slug": "kapadaganda",
        "editorial_limit": "Expansion also in Sahapedia’s work account; source printed p.24."
      },
      {
        "term": "GI",
        "definition": "Geographical indication: an indication linking goods to a place whose origin gives them a particular quality, reputation or other characteristic.",
        "source_url": "https://ipindia.gov.in/gi-introduction",
        "chapter_slug": "kapadaganda",
        "editorial_limit": "A definition, not proof that an individual depicted cloth is GI-certified."
      },
      {
        "term": "Gram Sabha",
        "definition": "A village assembly. In the Niyamgiri case, the assemblies examined community, cultural and religious claims connected with the proposed mining.",
        "source_url": "https://cdnbbsr.s3waas.gov.in/s3ec0490f1f4972d133619a60c30f3559e/documents/supremecourtreport/2013_v6_piv.pdf",
        "chapter_slug": "niyamgiri",
        "editorial_limit": "Reuse the chapter’s verified 18 April 2013 judgment, paragraphs 55–62; not a current permissions guide."
      },
      {
        "term": "Jatapu",
        "definition": "Used here in the title Jatapu (Kuvi) Primer and for Prasanna Sree’s devised script. The primer uses Telugu-based writing, not that devised script.",
        "source_url": "https://ciil.org/primers/Jatapu_Primer.pdf",
        "chapter_slug": "kuvi-and-jatapu-script",
        "editorial_limit": "Pair with chapter sources for devised script; not a name for every Kuvi-speaking community."
      },
      {
        "term": "Kapadaganda",
        "definition": "Cloth embroidered by Dongria makers, worn and given as well as made for sale; sources also spell it Kapdagonda or Kapdaganda.",
        "source_url": "https://www.sahapedia.org/kapdagondas-motifs-and-technique",
        "chapter_slug": "kapadaganda",
        "editorial_limit": ""
      },
      {
        "term": "Katri",
        "definition": "A blade-shaped hair ornament also used to cut thread and trim loose ends in the embroidery account.",
        "source_url": "https://www.sahapedia.org/kapdagondas-motifs-and-technique",
        "chapter_slug": "ornaments-in-use",
        "editorial_limit": "Not a universal name assigned to every visible hairpin."
      },
      {
        "term": "Kotpad",
        "definition": "A town in Koraput district and the name associated here with its cotton dyeing and handloom-weaving tradition, distinct from Kapadaganda embroidery.",
        "source_url": "https://nift.ac.in/chhaap2026/KapiloMahanta.html",
        "chapter_slug": "kotpad-and-kapadaganda",
        "editorial_limit": ""
      },
      {
        "term": "Kui",
        "definition": "A Dravidian language closely related to Kuvi, with a separate entry in the Central Institute of Indian Languages collections.",
        "source_url": "https://sanchika.ciil.org/communities/ad651338-c2a2-49ec-ae49-0731c4d175b6",
        "chapter_slug": "kuvi-and-jatapu-script",
        "editorial_limit": ""
      },
      {
        "term": "Kuvi",
        "definition": "A Dravidian language spoken in Odisha and Andhra Pradesh. Its name is not interchangeable with Kui; Kuwi is a spelling used in one primer’s title.",
        "source_url": "https://sanchika.ciil.org/collections/edf4dd66-e969-4277-863c-7032451b2358",
        "chapter_slug": "kuvi-and-jatapu-script",
        "editorial_limit": ""
      },
      {
        "term": "NIFT",
        "definition": "National Institute of Fashion Technology, publisher of the Kapilo Mahanta craft profile used in the Kotpad chapter.",
        "source_url": "https://nift.ac.in/chhaap2026/KapiloMahanta.html",
        "chapter_slug": "kotpad-and-kapadaganda",
        "editorial_limit": ""
      },
      {
        "term": "Niyam Raja",
        "definition": "The deity associated with the Niyamgiri hills in the worship, seed and song accounts.",
        "source_url": "https://grain.org/en/article/743-endangered-tribals-up-against-the-terror-of-vedanta",
        "chapter_slug": "songs-and-singers",
        "editorial_limit": "No newly invented translated epithet or universal creed."
      },
      {
        "term": "ORMAS",
        "definition": "Odisha Rural Development and Marketing Society, the state organisation referred to in the account of product marketing plans.",
        "source_url": "https://ormas.odisha.gov.in/en/sun/page/about-ormas",
        "chapter_slug": "harvest-to-market",
        "editorial_limit": ""
      },
      {
        "term": "Pucca",
        "definition": "A building whose walls and roof use durable materials, such as burnt brick, stone, cement or concrete.",
        "source_url": "https://www.mospi.gov.in/sites/default/files/NSS7733/77th_V_I_Final.pdf",
        "source_locator": "NSS77 instructions, section3.4.8.1, printedC-23",
        "chapter_slug": "homes-and-repair",
        "editorial_limit": "A materials-based category, not a claim that a house is better suited to every household."
      }
    ],
