      "id": "matira-original-creation",
      "locator": "Printed276–277 / PDF284–285",
      "evidence_type": "Author retrospective first-person memoir",
      "paraphrase": "Kalindi recalls Balakrushna Kar’s Saraswat Press novel-series plan and an invitation to write within two months. He wrote Matira Manisha in that period, drawing characters from village experience. He describes reading the completed novel aloud, printing and Bhagaban Pati’s proof correction.",
      "adoption_limit": "Supports novel creation and publication, not a film transaction or exact independently established publication date."
    },
    {
      "id": "matira-publication-rights-caution",
      "locator": "Printed277 / PDF285, middle paragraph",
      "evidence_type": "Memoir reports what some friends told him amid ironic responses to authorship criticism",
      "paraphrase": "He reports being told that publication rights were not his.",
      "adoption_limit": "Not a signed assignment, independently established ownership finding, royalty statement or film-rights agreement. Do not turn reported criticism into contractual fact."
    },
    {
      "id": "odia-periodical-contributor-pay",
      "locator": "Printed300 / PDF308, fourth paragraph; surrounding section PDF308–310upper",
      "evidence_type": "Author recollection as editor",
      "paraphrase": "He proposed paying Odia writers and artists in Bhanja Pradip, as English contributors were paid. He says the proposal was accepted and grateful letters arrived; a Dewan objected to the expense.",
      "adoption_limit": "Periodical contributor remuneration, not his own fee, a rate, novel royalties or film compensation."
    },
