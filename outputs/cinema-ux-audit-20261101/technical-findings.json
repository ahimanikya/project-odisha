  "findings": [
    {
      "id": "UX-01",
      "priority": "P2",
      "kind": "navigation gap, not broken links",
      "title": "The central route loses continuity inside six articles",
      "evidence": [
        "projects/site/src/lib/cinema-article.mjs:192–194 always selects the next cinema.articles entry",
        "projects/site/src/components/CinemaReading.astro:9–18 uses the same full sequence",
        "Six exact transitions are listed in central_path_sequence_differences"
      ],
      "impact": "A reader choosing ten readings is sent into the fifty-reading sequence by Continue reading and Next, without a labelled distinction. The links are valid and mutually consistent, but do not continue the selected route.",
      "recommendation": "Offer an explicitly labelled central-route next link on its ten articles, while retaining Previous/Next labelled as the full collection. Avoid silently replacing navigation or requiring stored browser state."
    },
    {
      "id": "UX-02",
      "priority": "P3",
      "kind": "discoverability improvement",
      "title": "The primary ten-reading route is not distinguished on the web",
      "evidence": [
        "projects/site/src/pages/cinema/reading-guide.astro:17 renders all reading_paths identically and uses full article titles, ignoring primary and labels",
        "projects/site/src/pages/cinema/index.astro:14 offers generic Reading paths and connections",
        "projects/site/src/lib/cinema-article.mjs:153 introduction links to generic #reading-paths"
      ],
      "impact": "The existing ten-reading route is present first, but has no individual anchor, concise configured labels or visible indication that it is the central route rather than one of five equivalent thematic lists.",
      "recommendation": "Give primary path a stable heading anchor and short configured labels; link to that anchor explicitly from hub/introduction. Retain four thematic paths and the complete collection."
    },
    {
      "id": "UX-03",
      "priority": "P3",
      "kind": "new requested enhancement; not existing rendering failure",
      "title": "Book tail drawings are absent from article endings",
      "evidence": [
        "cinemaNarrative.line_art has three before_heading placements: literature, preservation, futures",
        "cinemaNarrative.book_tail_vignettes has Maya Miriga, Bhukha and Pratikshya",
        "projects/site/src/lib/cinema-article.mjs:97–120 only reads line_art; no book_tail_vignettes support",
        "Rendered 50-route inventory finds three line-art blocks, none on those three film articles"
      ],
      "impact": "The same three ending drawings seen in the latest book are not encountered on their web articles.",
      "recommendation": "If desired, reuse the approved three drawings as explicit optional narrative-end placements before Continue and notes, with intrinsic dimensions and restrained sizing. Do not repeat them across all fifty articles or use new screenshots as artwork."
    },
    {
      "id": "UX-04",
      "priority": "P3",
      "kind": "edition expectation gap; metadata is correct for released downloads",
      "title": "Book download page intentionally serves the prior published edition",
      "evidence": [
        "projects/site/src/pages/cinema/book.astro:16–18 labels the available edition 31 October2026",
        "review_books points to remote31October release assets,254digital/282print",
        "Latest local close-readings record and receipts describe1November drafts254digital/280print with the central route and new close readings"
      ],
      "impact": "A reader of the local revised HTML who downloads the available PDF receives the older published text. The page accurately dates the edition but does not explicitly say it lacks the newer local revisions.",
      "recommendation": "Keep actual published URLs and hashes; clarify edition distinction in preview/review context. Only update public metadata after an authorized release of verified new assets. Do not point public users at local draft paths."
    },
    {
      "id": "UX-05",
      "priority": "P3",
      "kind": "confirmed low-value control",
      "title": "Introduction contents menu contains only Footnotes & Sources",
      "evidence": [
        "projects/site/src/components/ReviewedCultureArticle.astro:15 always renders ResearchContents and appends the source link",
        "Local dist introduction details.research-contents has exactly one href: #footnote-label",
        "Root browser expansion confirms this menu has no narrative section destinations"
      ],
      "affected_slugs": [
        "the-question-that-brought-me-here"
      ],
      "recommendation": "Suppress the contents disclosure when there are no narrative headings; keep the normal visible sources heading and citation links. Do not add unnecessary sections to the personal essay."
    }
  ],
