u0b37\u0b4d\u0b23\u0b38\u0b3f\u0b02\u0b39. \u0b2e\u0b39\u0b3e\u0b2d\u0b3e\u0b30\u0b24 \u0b2c\u0b28) \n \n:\u0b68\u0b68. \u0b2c\u0b3f\u0b2a\u0b26\u0b4d\u0b17\u0b4d\u0b30\u0b38\u0b4d\u0b24 \u0b39\u0b47\u0b2c\u0b3e; \u0b2c\u0b3f\u0b2a\u0b28\u0b4d\u0b28 \u0b39\u0b47\u0b2c\u0b3e \u2014\u0b68\u0b68. To be afflicted with calamity; to be beset with danger.\n \n(\u0b09\u2014 \u0b06\u0b2a\u0b47 \u0b2c\u0b41\u0b21\u0b3c\u0b3f\u0b32\u0b47 \u0b2f\u0b41\u0b17\u0b2c\u0b41\u0b21\u0b3c \u0b22\u0b17) \n \n:\u0b68\u0b69. \u0b1c\u0b3e\u0b24\u0b3f\u0b1a\u0b4d\u0b5f\u0b41\u0b24 \u0b2c\u0b3e \u0b38\u0b2e\u0b3e\u0b1c\u0b1a\u0b4d\u0b5f\u0b41\u0b24 \u0b39\u0b47\u0b2c\u0b3e \u2014\u0b68\u0b69. To be outcasted or excommunicated.\n \n:\u0b68\u0b6a. \u0b1c\u0b33\u0b3e\u0b26\u0b3f\u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b2a\u0b4d\u0b33\u0b3e\u0b39\u0b3f\u0b24 \u0b39\u0b47\u0b2c\u0b3e \u2014\u0b68\u0b6a. To be flooded or in undated.,\n \n[\u0b09\u2014\u0b18\u0b30 \u0b2c\u0b41\u0b21\u0b3c\u0b3f \u0b2a\u0b3e\u0b23\u0b3f \u0b06\u0b23\u0b4d\u0b20\u0b41\u0b0f \u0b39\u0b47\u0b32\u0b3e\u0b23\u0b3f; \u0b15\u0b23\u0b3e \u0b2c\u0b4b\u0b32\u0b47 \u0b2e\u0b47\u0b18 \u0b26\u0b41\u0b32\u0b41\u0b15\u0b41\u0b1b\u0b3f \u0b22\u0b17] \n \n:\u0b68\u0b6b. \u0b05\u0b24\u0b4d\u0b5f\u0b28\u0b4d\u0b24 \u0b06\u0b30\u0b4d\u0b26\u0b4d\u0b30 \u0b39\u0b47\u0b2c\u0b3e; \u0b24\u0b3f\u0b28\u0b4d\u0b24\u0b3f \u0b2f\u0b3f\u0b2c\u0b3e; \u0b1c\u0b41\u0b21\u0b3c\u0b41\u0b2c\u0b41\u0b21\u0b3c\u0b41 \u0b39\u0b47\u0b2c\u0b3e \u2014 \u0b68\u0b6b. To be besmeared; to be bedaubed; to be soaked\n \n(\u0b09\u2014\u0b26\u0b41\u0b07 \u0b38\u0b47\u0b28\u0b3e \u0b2f\u0b3e\u0b15\u0b30 \u0b2c\u0b38\u0b28 \u0b30\u0b15\u0b24\u0b47, \u0b2c\u0b41\u0b21\u0b3c\u0b28\u0b4d\u0b24\u0b47 \u0b2a\u0b3e\u0b1f\u0b2a\u0b30\u0b3f \u0b26\u0b3f\u0b36\u0b3f\u0b32\u0b47 \u0b38\u0b47 \u0b28\u0b47\u0b24\u0b4d\u0b30\u0b47 \u0b15\u0b43\u0b37\u0b4d\u0b23\u0b38\u0b3f\u0b02\u0b39. \u0b2e\u0b39\u0b3e\u0b2d\u0b3e\u0b30\u0b24 \u0b26\u0b4d\u0b30\u0b4b\u0b23) \n \n:\u0b68\u0b6c. \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b2c\u0b38\u0b4d\u0b24\u0b41\u0b15\u0b41 \u0b2c\u0b3f\u0b36\u0b47\u0b37 \u0b2a\u0b30\u0b3f\u0b2e\u0b3e\u0b23\u0b30\u0b47 \u0b2a\u0b3e\u0b07\u0b2c\u0b3e \u0b2c\u0b3e \u0b2d\u0b4b\u0b17 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u2014\u0b68\u0b6c. To get or enjoy in profusion.\n \n(\u0b2f\u0b25\u0b3e\u2014 \u0b2e\u0b4b \u0b38\u0b3e\u0b06\u0b28\u0b4d\u0b24\u0b19\u0b4d\u0b15 \u0b2a\u0b3e\u0b16\u0b30\u0b47 \u0b2e\u0b41\u0b01 \u0b05\u0b5f\u0b38\u0b30\u0b47 \u0b13 \u0b06\u0b26\u0b30\u0b30\u0b47 \u0b2c\u0b41\u0b21\u0b3c\u0b3f\u0b1b\u0b3f) \n \n\u0b68\u0b6d : \u0b2c\u0b3e\u0b39\u0b41 \u0b15\u0b3e\u0b33 \u0b1c\u0b33\u0b30\u0b47 \u0b28\u0b3f\u0b2e\u0b1c\u0b4d\u0b1c\u0b3f\u0b24 \u0b39\u0b4b\u0b07 \u0b38\u0b4d\u0b28\u0b3e\u0b28 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u2014\u0b68\u0b6d. To bathe in water for a long time\n \n(\u0b2f\u0b25\u0b3e\u2014 \u0b26\u0b43\u0b37\u0b4d\u0b1f \u0b2a\u0b3f\u0b32\u0b3e\u0b17\u0b41\u0b21\u0b3c\u0b3e\u0b15 \u0b2a\u0b4b\u0b16\u0b30\u0b40 \u0b2a\u0b3e\u0b23\u0b3f\u0b30\u0b47 \u0b2c\u0b41\u0b21\u0b3c\u0b3f \u0b2c\u0b41\u0b21\u0b3c\u0b3f \u0b2a\u0b3e\u0b23\u0b3f\u0b15\u0b3f \u0b38\u0b3e\u0b24 \u0b2a\u0b30\u0b38\u0b4d\u0b24 \u0b17\u0b4b\u0b33\u0b47\u0b07 \u0b38\u0b3e\u0b30\u0b3f\u0b32\u0b47\u0b23\u0b3f) \n \n:\u0b68\u0b6e. \u0b2e\u0b1c\u0b4d\u0b1c\u0b3f\u0b2c\u0b3e; \u0b2e\u0b3e\u0b24\u0b3f\u0b2f\u0b3f\u0b2c\u0b3e; \u0b2c\u0b4d\u0b5f\u0b38\u0b28\u0b3e\u0b15\u0b4d\u0b24 \u0b39\u0b47\u0b2c\u0b3e \u2014\u0b68\u0b6f. To be addicted to\n \n(\u0b09\u2014 \u0b24\u0b41\u0b2e\u0b4d\u0b2d\u0b30\u0b24 \u0b05\u0b27\u0b30\u0b4d\u0b2e\u0b47 \u0b2c\u0b41\u0b21\u0b3c\u0b3f\u0b32\u0b3e\u0b23\u0b3f \u0b2c\u0b41\u0b26\u0b4d\u0b27\u0b3f \u0b15\u0b43\u0b37\u0b4d\u0b23\u0b38\u0b3f\u0b02\u0b39. \u0b2e\u0b39\u0b3e\u0b2d\u0b3e\u0b30\u0b24 \u0b09\u0b26\u0b4d\u0b17\u0b4b\u0b17) \n \n:\u0b68\u0b6f. (\u0b2c\u0b47\u0b33) \u0b38\u0b42\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b3e\u0b38\u0b4d\u0b24\u0b30 \u0b38\u0b40\u0b2e\u0b3e\u0b15\u0b41 \u0b1f\u0b2a\u0b3f\u0b2c\u0b3e; \u0b36\u0b47\u0b37 \u0b39\u0b47\u0b2c\u0b3e; \u0b05\u0b28\u0b4d\u0b24 \u0b39\u0b47\u0b2c\u0b3e \u2014 \u0b68\u0b6f. To pass the time of sunset.\n \n[\u0b09\u2014 \u0b2c\u0b41\u0b21\u0b3c\u0b3f \u0b28\u0b3e\u0b39\u0b3f\u0b01 \u0b2c\u0b47\u0b33\u0b47 \u0b17\u0b4b\u0b27\u0b42\u0b33\u0b3f \u0b06\u0b15\u0b3e\u0b36\u0b47 \u0b2d\u0b3f\u0b15\u0b3e\u0b30\u0b40. \u0b17\u0b40\u0b24\u0b32\u0b39\u0b30\u0b40] \n \n['''\u0b26\u0b4d\u0b30\u0b37\u0b4d\u0b1f\u0b2c\u0b4d\u0b5f''' \u2014 \u0b0f\u0b39\u0b3f \u0b05\u0b30\u0b4d\u0b25\u0b30\u0b47 \u0b0f\u0b39\u0b3e \u0b38\u0b28\u0b4d\u0b27\u0b4d\u0b5f\u0b3e \u0b2c\u0b41\u0b21\u0b3c\u0b3f\u0b2c\u0b3e, \u0b2c\u0b47\u0b33\u0b2c\u0b41\u0b21\u0b3c\u0b3f\u0b2c\u0b3e \u0b0f\u0b39\u0b3f \u0b26\u0b41\u0b07 \u0b36\u0b2c\u0b4d\u0b26\u0b30\u0b47 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b43\u0b24 \u0b39\u0b41\u0b0f] \n \n:\u0b69. (\u0b2f\u0b25\u0b3e\u0b15\u0b3e\u0b33\u0b30\u0b47 \u0b0b\u0b23\u0b30 \u0b2a\u0b30\u0b3f\u0b36\u0b4b\u0b27 \u0b28 \u0b39\u0b47\u0b2c\u0b3e\u0b30\u0b41 \u0b2c\u0b28\u0b4d\u0b27\u0b15 \u0b25\u0b3f\u0b2c\u0b3e \u0b2c\u0b38\u0b4d\u0b24\u0b41 \u0b2c\u0b3e \u0b38\u0b2e\u0b4d\u0b2a\u0b24\u0b4d\u0b24\u0b3f) \u0b2e\u0b41\u0b15\u0b41\u0b33\u0b3e\u0b07 \u0b28 \u0b39\u0b47\u0b2c\u0b3e \u2014\u0b69\u0b66. To be foreclosed; to become unredeemable (said of a pledged article or mortgaged property, when the loan is not repaid in time).\n \n(\u0b2f\u0b25\u0b3e\u2014 \u0b1f\u0b19\u0b4d\u0b15\u0b3e \u0b38\u0b1c\u0b3f\u0b32\u0b4d \u0b28 \u0b39\u0b47\u0b2c\u0b3e\u0b30\u0b41 \u0b2e\u0b4b \u0b2c\u0b28\u0b4d\u0b27\u0b15\u0b3f \u0b05\u0b33\u0b19\u0b4d\u0b15\u0b3e\u0b30\u0b2f\u0b3e\u0b15 \u0b2e\u0b39\u0b3e\u0b1c\u0b28 \u0b18\u0b30\u0b47 \u0b2c\u0b41\u0b21\u0b3c\u0b3f\u0b32\u0b3e) \n \n:\u0b69\u0b67. \u0b24\u0b40\u0b30\u0b4d\u0b25\u0b30\u0b47 \u0b38\u0b4d\u0b28\u0b3e\u0b28 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u2014\u0b69\u0b67. To take a bath in any sacred water.\n \n:\u0b69\u0b68. \u0b1c\u0b33\u0b30 \u0b17\u0b2d\u0b40\u0b30\u0b24\u0b3e \u0b2e\u0b27\u0b4d\u0b5f\u0b30\u0b47 (\u0b2e\u0b28\u0b41\u0b37\u0b4d\u0b5f\u0b30, \u0b2f\u0b37\u0b4d\u0b1f\u0b3f\u0b30 \u0b2c\u0b3e \u0b05\u0b28\u0b4d\u0b5f\u0b1c\u0b40\u0b2c\u0b30) \u0b38\u0b2e\u0b41\u0b26\u0b3e\u0b5f \u0b09\u0b1a\u0b4d\u0b1a\u0b24\u0b3e \u0b28\u0b3f\u0b2e\u0b1c\u0b4d\u0b1c\u0b3f\u0b24 \u0b39\u0b47\u0b2c\u0b3e; \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b38\u0b4d\u0b25\u0b3e\u0b28\u0b30 \u0b1c\u0b33\u0b30 \u0b17\u0b2d\u0b40\u0b30\u0b24\u0b3e \u0b05\u0b2a\u0b47\u0b15\u0b4d\u0b37\u0b3e \u0b09\u0b1a\u0b4d\u0b1a\u0b24\u0b3e\u0b30\u0b47 \u0b15\u0b2e\u0b4d \u0b39\u0b47\u0b2c\u0b3e \u2014\u0b69\u0b68. To sink.\n \n(\u0b2f\u0b25\u0b3e\u2014 \u0b0f \u0b15\u0b42\u0b05\u0b30\u0b47 \u0b67 \u0b39\u0b3e\u0b24\u0b30 \u0b32\u0b3e\u0b17\u0b3f \u0b2c\u0b41\u0b21\u0b3c\u0b3f\u0b17\u0b32\u0b3e \u0b2e\u0b39\u0b3e\u2014 \u0b28\u0b26\u0b40\u0b30 \u0b2a\u0b3e\u0b23\u0b3f\u0b30\u0b47 \u0b39\u0b3e\u0b24\u0b40 \u0b2c\u0b41\u0b21\u0b3c\u0b3f\u0b2f\u0b3f\u0b2c) \n \n['''\u0b26\u0b4d\u0b30\u0b37\u0b4d\u0b1f\u0b2c\u0b4d\u0b5f''' \u2014\u0b0f\u0b39\u0b3f \u0b15\u0b4d\u0b30\u0b3f\u0b5f\u0b3e\u0b30 \u0b05\u0b38\u0b2e\u0b3e\u0b2a\u0b3f\u0b15\u0b3e\u0b30\u0b42\u0b2a\u0b47 \u0b38\u0b19\u0b4d\u0b17\u0b47 \u0b2f\u0b3f\u0b2c\u0b3e \u0b15\u0b4d\u0b30\u0b3f\u0b5f\u0b3e\u0b30 \u0b38\u0b2e\u0b3e\u0b2a\u0b3f\u0b15\u0b3e\u0b30\u0b42\u0b2a \u0b2f\u0b41\u0b15\u0b4d\u0b24 \u0b39\u0b41\u0b0f; \u0b2c\u0b41\u0b21\u0b3c\u0b3f\u0b2f\u0b3f\u0b2c] \n \n \n------------------\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2c\u0b1f \u0b24\u0b3f\u0b06\u0b30\u0b3f \u0b69]]"}}}]},"83968":{"pageid":83968,"ns":0,"title":"\u0b2e\u0b3e\u0b09\u0b38\u0b40","revisions":[{"revid":216849,"parentid":157543,"slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","*":"'''\u0b2e\u0b3e\u0b09\u0b38\u0b40'''\n== [[\u0b13\u0b21\u0b3c\u0b3f\u0b06]] ==\n \n=== \u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23 ===\n{{\u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23|M\u0101us\u012b| m\u02c8au\u0283\u02cci}}\n* {{\u0b05\u0b21\u0b3c\u0b3f\u0b13|LL-Q33810 (ori)-Psubhashish-\u0b