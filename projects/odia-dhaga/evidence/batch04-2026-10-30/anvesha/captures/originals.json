32\u0b26\u0b3f\u0b2c\u0b3e''\u0b05\u0b28\u0b4d\u0b5f\u0b30\u0b42\u0b2a'' \n \n\u0b15\u0b30\u0b3f\u0b2c\u0b3e \u2014 To undertake the maintenance of a lazy person.\n \n:\u0b68. \u0b05\u0b28\u0b4d\u0b5f \u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f\u0b20\u0b3e\u0b30\u0b47 \u0b05\u0b15\u0b30\u0b4d\u0b2e\u0b23\u0b4d\u0b5f \u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f\u0b30 \u0b2d\u0b30\u0b23 \u0b2a\u0b4b\u0b37\u0b23\u0b30 \u0b2d\u0b3e\u0b30 \u0b05\u0b30\u0b4d\u0b2a\u0b23 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u2014\u0b68. To lay upon another the burden of maintaining a useless person.\n \n:\u0b69. \u0b28\u0b3f\u0b1c\u0b30 \u0b2c\u0b3e\u0b33\u0b41\u0b24 \u0b2c\u0b3f\u0b27\u0b2c\u0b3e \u0b13 \u0b17\u0b30\u0b40\u0b2c \u0b15\u0b28\u0b4d\u0b5f\u0b3e\u0b30 \u0b2c\u0b3e \u0b05\u0b2c\u0b40\u0b30\u0b3e \u0b2d\u0b30\u0b23 \u0b2a\u0b4b\u0b37\u0b23 \u0b2d\u0b3e\u0b30 \u0b2c\u0b3e\u0b27\u0b4d\u0b5f \u0b39\u0b4b\u0b07 \u0b17\u0b4d\u0b30\u0b39\u0b23 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u2014\u0b69. To be burdenedd with the duty of maintaining one's child-widow-daughter or issueless daughter-in-law.\n \n \n------------------\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2c\u0b1f \u0b24\u0b3f\u0b06\u0b30\u0b3f \u0b69]]"}}}]},"88825":{"pageid":88825,"ns":0,"title":"\u0b2e\u0b42\u0b32\u0b3e\u0b07\u0b2c\u0b3e","revisions":[{"revid":214967,"parentid":128651,"slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","*":"'''\u0b2e\u0b42\u0b32\u0b3e\u0b07\u0b2c\u0b3e'''\n== [[\u0b13\u0b21\u0b3c\u0b3f\u0b06]] ==\n \n=== \u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23 ===\n{{\u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23|M\u016b\u0101ib\u0101| m\u02c8u\u02d0la\u02cciba}}\n* {{\u0b05\u0b21\u0b3c\u0b3f\u0b13|LL-Q33810 (ori)-Psubhashish-\u0b2e\u0b42\u0b32\u0b3e\u0b07\u0b2c\u0b3e.wav|\u0b27\u0b4d\u0b71\u0b28\u0b3f (\u0b2e\u0b3e\u0b28\u0b15 \u0b13\u0b21\u0b3c\u0b3f\u0b06)|lang=or}} \n=== \u0b05\u0b28\u0b41\u0b2c\u0b3e\u0b26 ===\n{{trans-top|\u0b2e\u0b42\u0b32\u0b3e\u0b07\u0b2c\u0b3e}}\n* \u0b2c\u0b19\u0b4d\u0b17\u0b3e\u0b33\u0b40: [[\u09a6\u09b0\u09cd \u09a6\u09be\u09ae \u0995\u09b0\u09be]]\n* \u0b39\u0b3f\u0b28\u0b4d\u0b26\u0b40: [[\u092e\u094b\u0932 \u0926\u094b\u0932 \u0915\u0930\u0928\u093e \u092e\u094b\u0932\u0928\u093e]]\n* \u0b2c\u0b19\u0b4d\u0b17\u0b3e\u0b33\u0b40: [[\u0995\u09c7\u09a8\u09be]]\n* \u0b39\u0b3f\u0b28\u0b4d\u0b26\u0b40: [[\u092e\u094b\u0932\u0928\u093e]]\n\n{{trans-bottom}}\n \n=== \u0b26\u0b47\u0b36\u0b1c - \u0b15\u0b4d\u0b30\u0b3f. (\u0b38\u0b02\u0b38\u0b4d\u0b15\u0b43\u0b24 - \u0b2e\u0b42\u0b32\u0b4d\u0b5f \u0b36\u0b26\u0b4d\u0b26\u0b30\u0b41 \u0b13\u0b21\u0b3c\u0b3f\u0b06 \u0b15\u0b4d\u0b30\u0b3f\u0b5f\u0b3e) ===\n \n:\u0b67. \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b26\u0b4d\u0b30\u0b2c\u0b4d\u0b5f \u0b15\u0b3f\u0b23\u0b3f\u0b2c\u0b3e \u0b09\u0b26\u0b4d\u0b26\u0b47\u0b36\u0b4d\u0b5f\u0b30\u0b47 \u0b26\u0b30\u2014 \u0b26\u0b3e\u0b2e \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u2014\u0b67. To bargain for; to make valuation of a thing to purchase it; to appraise.\n \n[\u0b09\u2014 \u0b2a\u0b07\u0b38\u0b3e \u0b28 \u0b25\u0b3e\u0b07 \u0b2e\u0b41\u0b32\u0b3e\u0b09 \u0b25\u0b3e\u0b0f \u0b26\u0b47\u0b16\u0b41\u0b25\u0b3f\u0b32\u0b47 \u0b2a\u0b47\u0b1f \u0b2b\u0b41\u0b32\u0b3e\u0b09 \u0b25\u0b3e\u0b0f\u2014\u0b22\u0b3c\u0b17 ] \n \n:\u0b68. \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b06\u0b2a\u0b26\u0b15\u0b41 \u0b2c\u0b3e \u0b26\u0b23\u0b4d\u0b21\u0b15\u0b41 \u0b06\u0b2a\u0b23\u0b3e \u0b09\u0b2a\u0b30\u0b15\u0b41 \u0b21\u0b3c\u0b3e\u0b15\u0b3f \u0b06\u0b23\u0b3f\u0b2c\u0b3e; \u0b26\u0b23\u0b4d\u0b21\u0b3e\u0b30\u0b4d\u0b39 \u0b15\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u2014 \u0b68. To deserve or court a punishment.\n \n(\u0b09\u2014\u0b38\u0b47 \u0b17\u0b41\u0b21\u0b3c\u0b3f\u0b0f \u0b2e\u0b3e\u0b21\u0b3c \u0b2e\u0b42\u0b32\u0b3e\u0b07\u0b32\u0b3e\u0b23\u0b3f\u2014\u0b22\u0b3c\u0b17 ) \n \n \n------------------\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2c\u0b1f \u0b24\u0b3f\u0b06\u0b30\u0b3f \u0b69]]"}}}]}}}}