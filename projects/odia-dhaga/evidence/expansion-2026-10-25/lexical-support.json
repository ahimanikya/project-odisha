e'''\n== [[\u0b13\u0b21\u0b3c\u0b3f\u0b06]] ==\n \n=== \u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23 ===\n{{\u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23|\u1e60ik\u0101| \u0283\u02c8ika}}\n* {{\u0b05\u0b21\u0b3c\u0b3f\u0b13|LL-Q33810 (ori)-Psubhashish-\u0b36\u0b3f\u0b15\u0b3e.wav|\u0b27\u0b4d\u0b71\u0b28\u0b3f (\u0b2e\u0b3e\u0b28\u0b15 \u0b13\u0b21\u0b3c\u0b3f\u0b06)|lang=or}} \n=== \u0b05\u0b28\u0b41\u0b2c\u0b3e\u0b26 ===\n{{trans-top|\u0b36\u0b3f\u0b15\u0b3e}}\n* \u0b2c\u0b19\u0b4d\u0b17\u0b3e\u0b33\u0b40: [[\u09b6\u09bf\u0995\u09be]]\n* \u0b39\u0b3f\u0b28\u0b4d\u0b26\u0b40: [[\u0938\u093f\u0915\u093e]], [[ \u091b\u0940\u0915\u093e]], [[ \u0938\u093f\u0915\u0939\u0930]]\n\n{{trans-bottom}}\n \n=== \u0b26\u0b47\u0b36\u0b1c - \u0b2c\u0b3f(\u0b38\u0b02\u0b38\u0b4d\u0b15\u0b43\u0b24 - \u0b36\u0b3f\u0b15\u0b4d\u0b5f\u0b3e) ===\n \n:\u0b67. \u0b39\u0b3e\u0b23\u0b4d\u0b21\u0b3f, \u0b18\u0b21\u0b3c\u0b3f \u0b06\u0b26\u0b3f \u0b1d\u0b41\u0b32\u0b3e\u0b07 \u0b30\u0b16\u0b3f\u0b2c\u0b3e \u0b28\u0b3f\u0b2e\u0b28\u0b4d\u0b24\u0b47 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b43\u0b24 \u0b30\u0b1c\u0b4d\u0b1c\u0b2e\u0b5f \u0b06\u0b27\u0b3e\u0b30 \u2014\u0b67. A net-work hanging basket of ropes used for suspending articles and pots; a hanging shelf made of ropes woven like a cage.\n \n['''\u0b26\u0b4d\u0b30\u0b37\u0b4d\u0b1f\u0b2c\u0b4d\u0b5f''' \u2014\u0b0f\u0b39\u0b3e\u0b15\u0b41 \u0b18\u0b30\u0b30 \u0b1a\u0b3e\u0b33\u0b30\u0b41 \u0b13 \u0b2c\u0b3e\u0b09\u0b01\u0b36\u0b30\u0b41 \u0b1d\u0b41\u0b32\u0b3e\u0b07 \u0b24\u0b39\u0b3f\u0b01\u0b30\u0b47 \u0b16\u0b3e\u0b26\u0b4d\u0b5f \u0b2a\u0b3e\u0b24\u0b4d\u0b30\u0b3e\u0b26\u0b3f \u0b30\u0b16\u0b3e\u0b2f\u0b3e\u0b0f] \n \n[\u0b09\u2014 \u0b2c\u0b3f\u0b30\u0b3e\u0b21\u0b3c\u0b3f \u0b15\u0b2a\u0b3e\u0b33\u0b15\u0b41 \u0b36\u0b3f\u0b15\u0b3e \u0b1b\u0b3f\u0b21\u0b3c\u0b3f\u0b2c\u0b3e \u0b28\u0b4d\u0b5f\u0b3e\u0b5f \u2014 \u0b36\u0b3f\u0b15\u0b3e\u0b30\u0b47 \u0b30\u0b16\u0b3e\u0b2f\u0b3e\u0b07 \u0b2e\u0b25\u0b3e\u0b28\u0b30\u0b41 \u0b1d\u0b41\u0b32\u0b3e \u0b39\u0b4b\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b16\u0b3e\u0b26\u0b4d\u0b5f \u0b2a\u0b26\u0b3e\u0b30\u0b4d\u0b25 (\u0b26\u0b41\u0b27, \u0b2e\u0b3e\u0b1b\u0b06\u0b26\u0b3f)\u0b15\u0b41 \u0b2c\u0b3f\u0b30\u0b3e\u0b21\u0b3c\u0b3f \u0b16\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b47 \u0b28\u0b3e\u0b39\u0b3f\u0b01 \u0b0f\u0b25\u0b3f\u0b2a\u0b3e\u0b07\u0b01 \u0b2d\u0b42\u0b07\u0b01\u0b30\u0b47 \u0b2c\u0b38\u0b3f \u0b38\u0b24\u0b43\u0b37\u0b4d\u0b23 \u0b28\u0b5f\u0b28\u0b30\u0b47 \u0b38\u0b47\u0b39\u0b3f \u0b36\u0b3f\u0b15\u0b3e\u0b30\u0b47 \u0b25\u0b3f\u0b2c\u0b3e \u0b26\u0b4d\u0b30\u0b2c\u0b4d\u0b5f \u0b06\u0b21\u0b3c\u0b15\u0b41 \u0b05\u0b28\u0b3e\u0b07 \u0b30\u0b39\u0b3f\u0b25\u0b3e\u0b0f \u0b26\u0b48\u0b2c\u0b17\u0b24\u0b4d\u0b5f\u0b3e \u0b36\u0b3f\u0b15\u0b3e\u0b30 \u0b26\u0b09\u0b21\u0b3c\u0b3f \u0b1b\u0b3f\u0b23\u0b4d\u0b21\u0b3f\u0b17\u0b32\u0b47 \u0b36\u0b3f\u0b15\u0b3e\u0b30\u0b47 \u0b25\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b24\u0b4d\u0b30 \u0b13 \u0b16\u0b3e\u0b26\u0b4d\u0b5f \u0b2d\u0b42\u0b2e\u0b3f\u0b30\u0b47 \u0b2a\u0b3c\u0b21\u0b3c\u0b3f\u0b2f\u0b3e\u0b0f \u0b13 \u0b2c\u0b3f\u0b30\u0b3e\u0b21\u0b3c\u0b3f \u0b24\u0b3e\u0b39\u0b3e \u0b16\u0b3e\u0b07\u0b2c\u0b3e\u0b15\u0b41 \u0b38\u0b2e\u0b30\u0b4d\u0b25 \u0b39\u0b41\u0b0f \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b05\u0b38\u0b3e\u0b27\u0b4d\u0b5f \u0b2c\u0b3e \u0b05\u0b2a\u0b4d\u0b30\u0b3e\u0b2a\u0b4d\u0b5f \u0b2c\u0b38\u0b4d\u0b24\u0b41 \u0b24\u0b24\u0b4d\u0b2a\u0b4d\u0b30\u0b24\u0b4d\u0b5f\u0b3e\u0b36\u0b40 \u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f\u0b15\u0b41 \u0b26\u0b48\u0b2c\u0b17\u0b24\u0b4d\u0b5f\u0b3e \u0b2e\u0b3f\u0b33\u0b3f\u0b17\u0b32\u0b47 \u0b0f \u0b28\u0b4d\u0b5f\u0b5f\u0b30 \u0b09\u0b26\u0b3e\u0b39\u0b30\u0b23 \u0b26\u0b3f\u0b06\u0b2f\u0b3e\u0b0f] \n \n:\u0b68. \u0b2c\u0b3e\u0b39\u0b41\u0b19\u0b4d\u0b17\u0b3f\u0b30\u0b47 \u0b26\u0b41\u0b07 \u0b2a\u0b3e\u0b16\u0b30\u0b47 \u0b2c\u0b4b\u0b1d (\u0b05\u0b19\u0b4d\u0b17\u0b3e) \u0b1d\u0b41\u0b32\u0b3e\u0b07 \u0b26\u0b4d\u0b30\u0b2c\u0b4d\u0b5f \u0b2c\u0b39\u0b3f\u0b2c\u0b3e \u0b28\u0b3f\u0b2e\u0b28\u0b4d\u0b24\u0b47 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b43\u0b24 \u0b30\u0b1c\u0b4d\u0b1c\u0b41\u0b2e\u0b5f \u0b05\u0b27\u0b3e\u0b30 \u2014 \u0b68. A sling or cage of ropes attached to either end of a pole which is carried across the shouldders and is used for carrying things in it.\n\n=== \u0b2c\u0b48\u0b26\u0b47\u0b36\u0b3f\u0b15 - \u0b2c\u0b3f\u0b36\u0b47\u0b37\u0b4d\u0b5f - (\u0b06) ===\n \n[[\u0b38\u0b3f\u0b15\u0b4d\u0b15\u0b3e ]] (\u0b26\u0b47\u0b16) - \u2014Sikk\u0101 (See)\n \n \n------------------\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2c\u0b1f \u0b24\u0b3f\u0b06\u0b30\u0b3f \u0b69]]\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2c\u0b48\u0b26\u0b47\u0b36\u0b3f\u0b15 \u0b36\u0b2c\u0b4d\u0b26 - \u0b06\u0b30\u0b2c\u0b40]]"}}}]}}}}