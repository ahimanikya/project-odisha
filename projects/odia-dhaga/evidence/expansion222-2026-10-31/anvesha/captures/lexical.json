b3f\u0b1f\u0b3e \u0b2e\u0b3e\u0b1f\u0b3f\u0b30\u0b47 \u0b2a\u0b3e\u0b23\u0b3f \u0b1c\u0b2e\u0b3f \u0b30\u0b39\u0b3f\u0b25\u0b3f\u0b2c\u0b3e \u0b1a\u0b24\u0b30\u0b3e\n\u0b2c\u0b3e \u0b16\u0b3e\u0b32 \u2014\u0b69. A small pool at the foot of a\nhill where water is left in summer.</p>\n<p>[\u0b26\u0b4d\u0b30\u2014\u0b2c\u0b28\u0b4d\u0b5f \u0b2a\u0b36\u0b41\u0b2e\u0b3e\u0b28\u0b47 \u0b0f\u0b20\u0b3e\u0b15\u0b41 \u0b2a\u0b3e\u0b23\u0b3f \u0b2a\u0b3f\u0b07\u0b2c\u0b3e\u0b15\u0b41 \u0b06\u0b38\u0b28\u0b4d\u0b24\u0b3f] </p>  <br/>\n\n\n\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2c\u0b1f \u0b24\u0b3f\u0b06\u0b30\u0b3f]]\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b38\u0b2e\u0b4d\u0b2c\u0b32\u0b2a\u0b41\u0b30\u0b40 \u0b36\u0b2c\u0b4d\u0b26]]"}}}]},"15334":{"pageid":15334,"ns":0,"title":"\u0b16\u0b3e\u0b21\u0b3c\u0b3f\u0b06","revisions":[{"revid":168538,"parentid":52697,"slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","*":"[[\u0b36\u0b2c\u0b4d\u0b26\u0b3e\u0b30\u0b4d\u0b25]]:\n\n'''\u0b16\u0b3e\u0b21\u0b3c\u0b3f\u0b06''' \u2014\n<br> \u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23:  Kh\u0101\u1e5f\u1e0d\u0320i\u0101</br>\n<p>\u0b26\u0b47. \u0b2c\u0b3f \u2014</p>\n<p>\u0b67:  \u0b15\u0b3e\u0b28\u0b4d\u0b27\u0b30 \u0b26\u0b41\u0b07 \u0b2a\u0b3e\u0b16\u0b30\u0b47 \u0b1c\u0b3e\u0b09\u0b01\u0b33\u0b3f \u0b15\u0b30\u0b3f \u0b2a\u0b15\u0b3e\u0b07\u0b2c\u0b3e\n\u0b2a\u0b3e\u0b07\u0b01 \u0b2a\u0b25\u0b3f\u0b15\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b43\u0b24 \u0b32\u0b2e\u0b4d\u0b2c \u0b15\u0b28\u0b3e\u0b30 \u0b2e\u0b41\u0b23\u0b3f \u2014\n\u0b67. A long cloth-bag with two pouches at\nboth ends and carried on the shoulder,\nthe ends hanging in front\nand sides.</p>\n<p>\u0b68:  \u0b16\u0b3e\u0b21\u0b3c\u0b3f \u0b1c\u0b3e\u0b32 (\u0b26\u0b47\u0b16) \n\u0b68. Kh\u0101\u1e5f\u1e0d\u0320ij\u0101la (See)</p>\n<p>\u0b69:  \u0b05\u0b21\u0b3c\u0b41\u0b06; \u0b17\u0b4b\u0b33\u0b2e\u0b3e\u0b33 \u2014\n\u0b69. Confusion; disorder.</p>\n<p>\u0b6a:  \u0b15\u0b33\u0b3f; \u0b2c\u0b3f\u0b2c\u0b3e\u0b26 \u2014\u0b6a. Quarrel; dissension.</p>  \n<p>\u0b26\u0b47. \u0b2c\u0b3f\u0b23 \u2014</p>\n<p>\u0b25\u0b4b\u0b30\u0b3f\u0b06 (\u0b1c\u0b3e\u0b24\u0b3f) \u2014\n(people) Carrying on trade by\nmeans of pack-bullocks.</p>  \n<p>\u0b2a\u0b4d\u0b30\u0b3e\u0b26\u0b47 (\u0b2e\u0b47\u0b26\u0b3f\u0b28\u0b40\u0b2a\u0b41\u0b30) \u0b2c\u0b3f (\u0b24\u0b41\u0b33. \u0b2c\u0b02. \u0b15\u0b3e\u0b22\u0b40) \u2014</p>\n<p>\u0b30\u0b42\u0b2a\u0b3e \u0b2c\u0b3e \u0b38\u0b41\u0b28\u0b3e\u0b30 \u0b38\u0b30\u0b41 \u0b15\u0b3e\u0b20\u0b3f \u2014\nLong and thick bar or ingot of gold\nand silver.</p>  <br/>\n\n\n\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2c\u0b1f \u0b24\u0b3f\u0b06\u0b30\u0b3f]]\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2e\u0b47\u0b26\u0b3f\u0b28\u0b40\u0b2a\u0b41\u0b30\u0b3f\u0b06 \u0b36\u0b2c\u0b4d\u0b26]]"}}}]},"15899":{"pageid":15899,"ns":0,"title":"\u0b16\u0b41\u0b26\u0b15\u0b41\u0b23\u0b4d\u0b21\u0b3e","revisions":[{"revid":53245,"parentid":51097,"slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","*":"[[\u0b36\u0b2c\u0b4d\u0b26\u0b3e\u0b30\u0b4d\u0b25]]:\n\n'''\u0b16\u0b41\u0b26\u0b15\u0b41\u0b23\u0b4d\u0b21\u0b3e''' \u2014\n<br> \u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23:  Khudaku\u1e47\u1e0d\u0101</br>\n<p>(\u0b16\u0b41\u0b26\u0b41\u0b15\u0b41\u0b23\u0b4d\u0b21\u0b3e\u2014\u0b05\u0b28\u0b4d\u0b5f\u0b30\u0b42\u0b2a) </p>\n\u0996\u09c1\u09a6\u0995\u09c1\u0981\u09a1\u09bc\u09be <br>\n<p>\u0b26\u0b47. \u0b2c\u0b3f \u2014</p>\n<p>\u0b67:  \u0b05\u0b24\u0b3f\u0b36\u0b5f \u0b1a\u0b42\u0b28\u0b3e \u0b15\u0b41\u0b23\u0b4d\u0b21\u0b3e \u2014\n\u0b67. Fine husks of paddy.</p>\n <p>\u0b28 \u0b2a\u0b3e\u0b07\u0b32\u0b3e \u0b26\u0b41\u0b03\u0b16\u0b40 \u0b2a\u0b4d\u0b30\u0b1c\u0b3e \u0b16\u0b41\u0b26\u0b15\u0b41\u0b23\u0b4d\u0b21\u0b3e\u2014\n\u0b30\u0b3e\u0b27\u0b3e\u0b28\u0b3e\u0b25. \u0b26\u0b30\u0b2c\u0b3e\u0b30 </p> \n<p>\u0b68:  \u0b15\u0b4d\u0b37\u0b41\u0b26\u0b4d\u0b30 \u0b1a\u0b3e\u0b09\u0b33\u0b