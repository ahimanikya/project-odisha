f\u0b2c\u0b4d\u0b5f''' \u2014\u0b0f\u0b39\u0b3f \u0b36\u0b2c\u0b4d\u0b26 \u0b39\u0b3f\u0b38\u0b3e\u0b2c\u0b2a\u0b24\u0b4d\u0b30\u0b30\u0b47 '\u0b2e\u0b27\u0b4d\u0b5f\u0b30\u0b41' \u0b05\u0b30\u0b4d\u0b25\u0b30\u0b47 /?/ \u0b0f\u0b39\u0b3f\u0b2a\u0b30\u0b3f \u0b38\u0b3e\u0b19\u0b4d\u0b15\u0b47\u0b24\u0b3f\u0b15\u0b30\u0b42\u0b2a\u0b47 \u0b32\u0b47\u0b16\u0b3e \u0b2f\u0b3e\u0b0f \n \n\u0b2f\u0b25\u0b3e\u2014\u0b1c\u0b2e\u0b3e \u0b1f \u0b69 /?/ \u0b16\u0b30\u0b1a \u0b1f \u0b68 \u0b2f\u0b3e\u0b07 \u0b2c\u0b3e\u0b15\u0b3f \u0b30\u0b39\u0b3f\u0b32\u0b3e \u0b1f : \n \n\u0b05\u0b30\u0b4d\u0b25\u0b3e\u0b24\u0b4d \u0b24\u0b3f\u0b28\u0b3f\u0b1f\u0b19\u0b4d\u0b15\u0b3e \u0b1c\u0b2e\u0b3e \u0b2e\u0b07\u0b27\u0b47 \u0b2c\u0b3e \u0b2e\u0b27\u0b4d\u0b5f\u0b30\u0b41 \u0b26\u0b41\u0b07\u0b1f\u0b19\u0b4d\u0b15\u0b3e \u0b26\u0b41\u0b07\u0b05\u0b23\u0b3e \u0b16\u0b30\u0b1a \u0b2c\u0b3e\u0b26\u0b4d \u0b2f\u0b3e\u0b07 \u0b2c\u0b3e\u0b15\u0b3f \u0b2c\u0b33\u0b3f\u0b32\u0b3e \u0b1a\u0b09\u0b26\u0b05\u0b23\u0b3e] \n \n \n------------------\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2c\u0b1f \u0b24\u0b3f\u0b06\u0b30\u0b3f \u0b69]]\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b15\u0b1a\u0b3f\u0b30\u0b3f\u0b06 \u0b36\u0b2c\u0b4d\u0b26]]"}}}]}},"rightsinfo":{"url":"https://creativecommons.org/licenses/by-sa/4.0/deed.or","text":"Creative Commons Attribution-Share Alike 4.0"}}}