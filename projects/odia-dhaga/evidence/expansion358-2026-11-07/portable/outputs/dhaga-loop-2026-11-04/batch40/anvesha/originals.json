b4d\u0b26\u0b40: [[\u0924\u094d\u0930\u094d\u092a\u094d\u0930\u0917\u0941\u0920\u0940\u092c\u093e\u0932\u093e (\u0932\u0940)]]\n\n{{trans-bottom}}\n \n=== \u0b26\u0b47\u0b36\u0b1c - \u0b2c\u0b3f\u0b36\u0b47\u0b37\u0b4d\u0b5f - (\u0b38\u0b02\u0b38\u0b4d\u0b15\u0b43\u0b24 - \u0b2e\u0b41\u0b26\u0b4d\u0b30\u0b3f\u0b15\u0b3e; \u0b2a\u0b4d\u0b30\u0b3e \u0b2e\u0b41\u0b26\u0b4d\u0b26\u0b3f\u0b06) ===\n \n\u0b2e\u0b41\u0b39\u0b2a\u0b30\u0b3f \u0b17\u0b4b\u0b32\u0b3e\u0b15\u0b3e\u0b30 \u0b27\u0b3e\u0b24\u0b41 \u0b2c\u0b33\u0b5f \u2014A ring of metal.\n \n[\u0b09\u2014\u0b2e\u0b4b\u0b21\u0b3c\u0b3e \u0b28 \u0b2a\u0b21\u0b3c\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b17\u0b41\u0b23 \u0b2e\u0b41\u0b26\u0b3f\u0b06\u0b15\u0b41; \u0b16\u0b1e\u0b4d\u0b1c\u0b3f\u0b32\u0b47 \u0b28\u0b15\u0b41\u0b33 \u0b0f \u0b21\u0b3e\u0b33 \u0b38\u0b47 \u0b21\u0b3e\u0b33\u0b15\u0b41 \u0b15\u0b43\u0b37\u0b4d\u0b23\u0b38\u0b3f\u0b02\u0b39 \u0b2e\u0b39\u0b3e\u0b2d\u0b3e\u0b30\u0b24. \u0b2c\u0b3f\u0b30\u0b3e\u0b1f] \n \n=== \u0b26\u0b47\u0b36\u0b1c - \u0b2c\u0b3f\u0b36\u0b47\u0b37\u0b23 - \u0b2a\u0b41\u0b02. \u0b13 \u0b38\u0b4d\u0b24\u0b4d\u0b30\u0b40 ===\n \n\u0b2f\u0b47 \u0b2e\u0b41\u0b26\u0b3f \u0b2a\u0b3f\u0b28\u0b4d\u0b27\u0b3f\u0b25\u0b3e\u0b0f \u2014Wearing a ring.\n \n(\u0b26\u0b4d\u0b30\u2014\u0b0f\u0b39\u0b3e \u0b05\u0b28\u0b4d\u0b5f \u0b36\u0b2c\u0b4d\u0b26 \u0b38\u0b19\u0b4d\u0b17\u0b47 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b43\u0b24 \u0b39\u0b41\u0b0f \u0b2f\u0b25\u0b3e\u2014 \u0b38\u0b41\u0b28\u0b3e\u0b2e\u0b41\u0b26\u0b3f\u0b06) \n \n(\u0b09\u2014\u0b38\u0b41\u0b28\u0b3e\u0b2e\u0b41\u0b26\u0b3f\u0b06 \u0b39\u0b3e\u0b24\u0b30\u0b47 \u0b1a\u0b3e\u0b2a\u0b41\u0b21\u0b3c\u0b3e \u0b16\u0b3e\u0b07\u0b32\u0b47 \u0b17\u0b19\u0b4d\u0b17\u0b3e\u0b38\u0b4d\u0b28\u0b3e\u0b28 \u0b2b\u0b33 \u0b2e\u0b3f\u0b33\u0b47 \u0b22\u0b17) \n \n \n------------------\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2c\u0b1f \u0b24\u0b3f\u0b06\u0b30\u0b3f \u0b69]]'''\u0b2e\u0b41\u0b26\u0b3f\u0b06'''\n== [[\u0b13\u0b21\u0b3c\u0b3f\u0b06]] ==\n \n=== \u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23 ===\n{{\u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23|Mudiy\u0101| m\u02c8udi\u02cca}} \n=== \u0b05\u0b28\u0b41\u0b2c\u0b3e\u0b26 ===\n{{trans-top|\u0b2e\u0b41\u0b26\u0b3f\u0b06}}\n* \u0b2c\u0b19\u0b4d\u0b17\u0b3e\u0b33\u0b40: [[\u0986\u0981\u0997\u09a0\u09be]]\n* \u0b39\u0b3f\u0b28\u0b4d\u0b26\u0b40: [[\u0924\u094d\u0930\u094d\u092a\u094d\u0930\u0902\u0917\u0941\u0920\u0940]], [[ \u092e\u0941\u0902\u0926\u094d\u0930\u0940]]\n* \u0b2c\u0b19\u0b4d\u0b17\u0b3e\u0b33\u0b40: [[\u0986\u0981\u0997\u09be\u09a0\u09bf\u09a4\u09cd\u09a4\u09af\u09bc\u09be\u09b2\u09be]]\n* \u0b39\u0b3f\u0b28\u0b4d\u0b26\u0b40: [[\u0924\u094d\u0930\u094d\u092a\u094d\u0930\u0917\u0941\u0920\u0940\u092c\u093e\u0932\u093e (\u0932\u0940)]]\n\n{{trans-bottom}}\n \n=== \u0b26\u0b47\u0b36\u0b1c - \u0b2c\u0b3f\u0b36\u0b47\u0b37\u0b4d\u0b5f - (\u0b38\u0b02\u0b38\u0b4d\u0b15\u0b43\u0b24 - \u0b2e\u0b41\u0b26\u0b4d\u0b30\u0b3f\u0b15\u0b3e; \u0b2a\u0b4d\u0b30\u0b3e \u0b2e\u0b41\u0b26\u0b4d\u0b26\u0b3f\u0b06) ===\n \n\u0b2e\u0b41\u0b39\u0b2a\u0b30\u0b3f \u0b17\u0b4b\u0b32\u0b3e\u0b15\u0b3e\u0b30 \u0b27\u0b3e\u0b24\u0b41 \u0b2c\u0b33\u0b5f \u2014A ring of metal.\n \n[\u0b09\u2014\u0b2e\u0b4b\u0b21\u0b3c\u0b3e \u0b28 \u0b2a\u0b21\u0b3c\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b17\u0b41\u0b23 \u0b2e\u0b41\u0b26\u0b3f\u0b06\u0b15\u0b41; \u0b16\u0b1e\u0b4d\u0b1c\u0b3f\u0b32\u0b47 \u0b28\u0b15\u0b41\u0b33 \u0b0f \u0b21\u0b3e\u0b33 \u0b38\u0b47 \u0b21\u0b3e\u0b33\u0b15\u0b41 \u0b15\u0b43\u0b37\u0b4d\u0b23\u0b38\u0b3f\u0b02\u0b39 \u0b2e\u0b39\u0b3e\u0b2d\u0b3e\u0b30\u0b24. \u0b2c\u0b3f\u0b30\u0b3e\u0b1f] \n \n=== \u0b26\u0b47\u0b36\u0b1c - \u0b2c\u0b3f\u0b36\u0b47\u0b37\u0b23 - \u0b2a\u0b41\u0b02. \u0b13 \u0b38\u0b4d\u0b24\u0b4d\u0b30\u0b40 ===\n \n\u0b2f\u0b47 \u0b2e\u0b41\u0b26\u0b3f \u0b2a\u0b3f\u0b28\u0b4d\u0b27\u0b3f\u0b25\u0b3e\u0b0f \u2014Wearing a ring.\n \n(\u0b26\u0b4d\u0b30\u2014\u0b0f\u0b39\u0b3e \u0b05\u0b28\u0b4d\u0b5f \u0b36\u0b2c\u0b4d\u0b26 \u0b38\u0b19\u0b4d\u0b17\u0b47 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b43\u0b24 \u0b39\u0b41\u0b0f \u0b2f\u0b25\u0b3e\u2014 \u0b38\u0b41\u0b28\u0b3e\u0b2e\u0b41\u0b26\u0b3f\u0b06) \n \n(\u0b09\u2014\u0b38\u0b41\u0b28\u0b3e\u0b2e\u0b41\u0b26\u0b3f\u0b06 \u0b39\u0b3e\u0b24\u0b30\u0b47 \u0b1a\u0b3e\u0b2a\u0b41\u0b21\u0b3c\u0b3e \u0b2b\u0b3e\u0b07\u0b32\u0b47 \u0b17\u0b19\u0b4d\u0b17\u0b3e\u0b38\u0b4d\u0b28\u0b3e \u0b2b\u0b33 \u0b2e\u0b3f\u0b33\u0b47 \u0b22\u0b17) \n \n \n------------------\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2c\u0b1f \u0b24\u0b3f\u0b06\u0b30\u0b3f \u0b69]]\n\n[[category:need check3]]"}}}]},"91356":{"pageid":91356,"ns":0,"title":"\u0b2f\u0b3e\u0b24\u0b4d\u0b30\u0b3e \u0b15\u0b3e\u0b33\u0b3f \u0b2d\u0b17\u0b3e\u0b30\u0b3f","revisions":[{"revid":131275,"parentid":0,"timestamp":"2015-05-19T20:58:10Z","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","*":"'''\u0b2f\u0b3e\u0b24\u0b4d\u0b30\u0b3e \u0b15\u0b3e\u0b33\u0b3f \u0b2d\u0b17\u0b3e\u0b30\u0b3f'''\n== [[\u0b13\u0b21\u0b3c\u0b3f\u0b06]] ==\n \n=== \u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23 ===\n{{\u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23|J\u0304\u0101tr\u0101 k\u0101\u1e3bi bhag\u0101ri| d\u0292\u02c8at\u027ea k\u02c8al\u0329\u02cci b\u02b0\u02c8\u028c\u0261a\u027e\u02cci}} \n(\u0b2f\u0b3e\u0b24\u0b4d\u0b30\u0b3e \u0b15\u0b3e\u0b33\u0b3f\u0b06 \u0b2d\u0b17\u0b3e\u0b30\u0b3f\u2014\u0b05\u0b28\u0b4d\u0b5f\u0b30\u0b42\u0b2a) \n \n=== \u0b05\u0b28\u0b41\u0b2c\u0b3e\u0b26 ===\n{{trans-top|\u0b2f\u0b3e\u0b24\u0b4d\u0b30\u0b3e \u0b15\u0b3e\u0b33\u0b3f \u0b2d\u0b17\u0b3e\u0b30\u0b3f}}\n* \u0b2c\u0b19\u0b4d\u0b17\u0b3e\u0b33\u0b40: [[\u09b9\u09a0\u09be\u09a4\u09cd \u0989\u09aa\u09b7\u09cd\u099a\u09bf\u09a4 \u09ad\u09be\u0997\u09bf\u09a6\u09be\u09b0]]\n* \u0b39\u0b3f\u0b28\u0b4d\u0b26\u0b40: [[\u0924\u094d\u0930\u094d\u092a\u094d\u0930\u091c\u0917\u092c\u0940 \u0926\u0941\u0937\u092e\u0928]]\n\n{{trans-bottom}}\n \n=== \u0b26\u0b47\u0b36\u0b1c - \u0b2c\u0b3f ===\n \n\u0b05\u0b15\u0b38\u0b4d\u0b2e\u0b3e\u0b24\u0b4d \u0b09\u0b2a\u0b38\u0b4d\u0b25\u0b3f\u0b24 \u0b2a\u0b4d\u0b30\u0b24\u0b3f\u0b26\u0b4d\u0b71\u0b28\u0b4d\u0b26\u0b4d\u0b71\u0b40 \u0b2c\u0b3e \u0b36\u0b24\u0b4d\u0b30\u0b41 \u0b2c\u0b3e \u0b38\u0b2e\u0b4d\u0b2a\u0b24\u0b4d\u0b24\u0b3f\u0b30\u0b47 \u0b2d\u0b3e\u0b17 \u0b2c\u0b38\u0b3e\u0b07\u0b2c\u0b3e \u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f \u2014 An enemy or rival or claimant who appears unexpectedly.\n \n(\u0b09\u2014\u0b2d\u0b17\u0b3e\u0b30\u0b3f \u0b28 \u0b25\u0b3f\u0b32\u0b47 \u0b2f\u0b3e\u0b24\u0b4d\u0b30\u0b3e\u0b15\u0b3e\u0b33\u0b3f \u0b2d\u0b17\u0b3e\u0b30\u0b3f \u0b2c\u0b3e\u0b39\u0b3e\u0b30\u0b3f\u0b28\u0b4d\u0b24\u2014\u0b22\u0b17) \n \n \n------------------\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2c\u0b1f \u0b24\u0b3f\u0b06\u0b30\u0b3f \u0b69]]"}}}]}},"rightsinfo":{"url":"https://creativecommons.org/licenses/by-sa/4.0/deed.or","text":"Creative Commons Attribution-Share Alike 4.0"}}}