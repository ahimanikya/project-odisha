. \u0b30\u0b1e\u0b4d\u0b1c\u0b3f\u0b24 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u2014\u0b67. To paint.\n \n:\u0b68. \u0b30\u0b15\u0b4d\u0b24\u2014 \u0b2c\u0b30\u0b4d\u0b23\u0b4d\u0b23 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u2014\u0b68. To redden.\n \n:\u0b69. \u0b30\u0b15\u0b4d\u0b24\u2014 \u0b2c\u0b30\u0b4d\u0b23\u0b4d\u0b23 \u0b27\u0b3e\u0b30\u0b23 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u2014\u0b69. To become red.\n \n[\u0b09\u2014 \u0b1a\u0b05\u0b01\u0b30 \u0b30\u0b19\u0b4d\u0b17\u0b47\u0b07\u0b32\u0b3e, \u0b26\u0b3f\u0b28\u0b26\u0b3f\u0b28\u0b15\u0b30 \u0b2d\u0b3e\u0b2c\u0b2a\u0b40\u0b30\u0b24\u0b3f, \u0b26\u0b07\u0b2c \u0b2d\u0b19\u0b4d\u0b17\u0b47\u0b07\u0b32\u0b3e\u2014\u0b22\u0b17] \n \n:\u0b6a. (\u0b2a\u0b4d\u0b30\u0b5f\u0b4b\u0b1c\u0b15)\u2014\u0b05\u0b28\u0b4d\u0b5f\u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b30\u0b1e\u0b4d\u0b1c\u0b28 \u0b15\u0b30\u0b4d\u0b2e \u0b15\u0b30\u0b3e\u0b07\u0b2c\u0b3e \u2014\u0b6a. To cause to paint.\n \n \n------------------\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2c\u0b1f \u0b24\u0b3f\u0b06\u0b30\u0b3f \u0b69]]"}}}]},"98640":{"pageid":98640,"ns":0,"title":"\u0b32\u0b23\u0b4d\u0b21\u0b3e \u0b2e\u0b41\u0b23\u0b4d\u0b21\u0b3e","revisions":[{"revid":138728,"parentid":0,"timestamp":"2015-05-22T16:16:06Z","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","*":"'''\u0b32\u0b23\u0b4d\u0b21\u0b3e \u0b2e\u0b41\u0b23\u0b4d\u0b21\u0b3e'''\n== [[\u0b13\u0b21\u0b3c\u0b3f\u0b06]] ==\n \n=== \u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23 ===\n{{\u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23|La\u1e47\u1e0d\u0101 mu\u1e47\u1e0d\u0101| l\u02c8\u028cn\u0256a m\u02c8un\u0256a}} \n(\u0b32\u0b23\u0b4d\u0b21\u0b3e \u0b2e\u0b41\u0b23\u0b4d\u0b21\u0b3f\u0b06\u2014 \u0b05\u0b28\u0b4d\u0b5f\u0b30\u0b42\u0b2a) \n \n\u0b32\u0b3e\u0b23\u0b4d\u0b22\u0b3f\u0b2e\u0b41\u0b23\u0b4d\u0b21\u0b63, \u0b32\u0b23\u0b4d\u0b21\u0b3f\u0b2e\u0b41\u0b23\u0b4d\u0b21\u0b40''\u0b38\u0b4d\u0b24\u0b4d\u0b30\u0b40'' \n \n=== \u0b26\u0b47\u0b36\u0b1c - \u0b2c\u0b3f\u0b36\u0b47\u0b37\u0b23 - \u0b2a\u0b41\u0b02.\u2014 (\u0b38\u0b02\u0b38\u0b4d\u0b15\u0b43\u0b24 - \u0b2e\u0b41\u0b23\u0b4d\u0b21\u0b3f\u0b24\u0b2e\u0b41\u0b23\u0b4d\u0b21) ===\n \n:\u0b67. \u0b2e\u0b41\u0b23\u0b4d\u0b21\u0b3f\u0b24\u2014 \u0b15\u0b47\u0b36 \u2014\u0b67. With the head clean shaven;\n \n:\u0b68. \u0b32\u0b41\u0b28\u0b36\u0b3f\u0b16 \u2014\u0b68. With tonsured head.\n \n:\u0b69. \u0b1f\u0b3e\u0b19\u0b4d\u0b17\u0b30\u0b3e \u2014\u0b69. Bald headed.\n \n(\u0b09\u2014 \u0b32\u0b23\u0b4d\u0b21\u0b3e\u0b2e\u0b41\u0b23\u0b4d\u0b21\u0b3e \u0b2a\u0b4b\u0b07\u0b01 \u0b15\u0b47\u0b30\u0b47\u0b23\u0b4d\u0b21\u0b3e, \u0b38\u0b3f\u0b02\u0b18\u0b3f \u0b26\u0b41\u0b06\u0b30\u0b47 \u0b25\u0b3e\u0b0f, \u0b05\u0b07\u0b01\u0b20\u0b3e \u0b2d\u0b3e\u0b24\u0b30\u0b41 \u0b17\u0b23\u0b4d\u0b21\u0b3f\u0b0f \u0b2a\u0b3e\u0b07\u0b32\u0b47 \u0b2a\u0b3e\u0b23\u0b3f \u0b1b\u0b21\u0b3c\u0b47\u0b07 \u0b16\u0b3e\u0b0f\u2014\u0b22\u0b17) \n \n \n------------------\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2c\u0b1f \u0b24\u0b3f\u0b06\u0b30\u0b3f \u0b69]]"}}}]}},"rightsinfo":{"url":"https://creativecommons.org/licenses/by-sa/4.0/deed.or","text":"Creative Commons Attribution-Share Alike 4.0"}}}