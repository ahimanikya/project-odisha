\u0b4d\u0b1a\u0b41\u0b19\u0b4d\u0b17\u0b3f\u0b06 \u0b2e\u0b3e\u0b17\u0b41\u0b30\u0b28\u0b3f\u0b36\u0b3f\u0b06 \u0b39\u0b3f\u0b06\u0b30\u0b47 \u0b28 \u0b25\u0b3e\u0b0f \u0b2c\u0b3e\u0b33 \u0b0f \u0b24\u0b3f\u0b28\u0b3f\u0b19\u0b4d\u0b15\u0b3f \u0b2a\u0b30\u0b24\u0b47 \u0b28 \u0b2f\u0b3f\u0b2c \u0b2c\u0b40\u0b07\u0b01\u0b25\u0b3f\u0b2c \u0b2f\u0b47\u0b24\u0b47\u0b15\u0b3e\u0b33 \u0b22\u0b3c\u0b17 \n \n:\u0b68. \u0b05\u0b27\u0b40\u0b30 \u2014\u0b68. Impatient.\n \n:\u0b69. \u0b2f\u0b41\u0b2c\u0b3e \u0b13 \u0b38\u0b41\u0b28\u0b4d\u0b26\u0b30 \u2014\u0b69. Youthful and handsome.\n \n:\u0b69. \u0b2c\u0b3f\u0b33\u0b3e\u0b38\u0b32\u0b4b\u0b33 \u2014\u0b69. Frolicsome; buxom.\n \n:\u0b6a. \u0b38\u0b41\u0b38\u0b4d\u0b25 \u0b38\u0b2c\u0b33 \u2014\u0b6a. Healthy and spirited.\n \n:\u0b6b. \u0b28\u0b2c\u0b2f\u0b4c\u0b2c\u0b28\u0b2f\u0b41\u0b15\u0b4d\u0b24 (\u0b2c\u0b5f\u0b38) \u2014 \u0b6b. Youthful (age).\n \n:\u0b6c. \u0b28\u0b2c\u0b2f\u0b4c\u0b2c\u0b28 (\u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f) \u2014\u0b6d. A person who is in the full bloom of youth.\n \n \n------------------\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2c\u0b1f \u0b24\u0b3f\u0b06\u0b30\u0b3f \u0b69]]"}}}]},"29442":{"pageid":29442,"ns":0,"title":"\u0b1c\u0b3e\u0b24\u0b3f \u0b28\u0b47\u0b2c\u0b3e","revisions":[{"revid":67878,"parentid":0,"timestamp":"2014-12-31T00:53:46Z","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","*":"'''\u0b1c\u0b3e\u0b24\u0b3f \u0b28\u0b47\u0b2c\u0b3e'''\n== [[\u0b13\u0b21\u0b3c\u0b3f\u0b06]] ==\n \n=== \u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23 ===\n{{\u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23|J\u0101ti neb\u0101| \u025f\u02c8ati n\u02c8ewba}} \n=== \u0b05\u0b28\u0b41\u0b2c\u0b3e\u0b26 ===\n{{trans-top|\u0b1c\u0b3e\u0b24\u0b3f \u0b28\u0b47\u0b2c\u0b3e}}\n* \u0b2c\u0b19\u0b4d\u0b17\u0b3e\u0b33\u0b40: [[\u099c\u09be\u09a4\u09b2\u0993\u09af\u09bc\u09be]]\n* \u0b39\u0b3f\u0b28\u0b4d\u0b26\u0b40: [[\u091c\u093e\u0924 \u0932\u0947\u0928\u093e]]\n\n{{trans-bottom}}\n \n=== \u0b26\u0b47\u0b36\u0b1c - \u0b15\u0b4d\u0b30\u0b3f\u0b5f\u0b3e\u0b2a\u0b26 - ===\n \n:\u0b67. \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b32\u0b4b\u0b15\u0b30 \u0b38\u0b3e\u0b2e\u0b3e\u0b1c\u0b3f\u0b15 \u0b2c\u0b3f\u0b36\u0b3f\u0b37\u0b4d\u0b1f\u0b24\u0b3e \u0b28\u0b37\u0b4d\u0b1f \u0b15\u0b30\u0b3e\u0b07\u0b2c\u0b3e; \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f\u0b15\u0b41 \u0b05\u0b2a\u0b2c\u0b3f\u0b24\u0b4d\u0b30 \u0b15\u0b30\u0b3e\u0b07 \u0b2c\u0b3e \u0b05\u0b16\u0b3e\u0b26\u0b4d\u0b5f \u0b16\u0b41\u0b06\u0b07 \u0b24\u0b3e\u0b39\u0b3e\u0b15\u0b41 \u0b1c\u0b3e\u0b24\u0b3f\u0b2d\u0b4d\u0b30\u0b37\u0b4d\u0b1f \u0b15\u0b30\u0b3e\u0b07\u0b2c\u0b3e \u2014 \u0b67. To make a person unclean by making him do or eat prohibited things.\n \n:\u0b68. \u0b15\u0b41\u0b33\u0b38\u0b4d\u0b24\u0b4d\u0b30\u0b40\u0b30 \u0b38\u0b24\u0b40\u0b24\u0b4d\u0b71 \u0b28\u0b3e\u0b36 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u2014 \u0b68. To commit adultery with a woman of family.\n \n\u0b2a\u0b3f\u0b28\u0b4d\u0b27\u0b3f\u0b25\u0b3f\u0b32\u0b3f \u0b2a\u0b3e\u0b1f \u0b38\u0b3e\u0b22\u0b3c\u0b40, \u0b1c\u0b3e\u0b24\u0b3f \u0b28\u0b2c \u0b2c\u0b4b\u0b32\u0b3f \u0b2a\u0b20\u0b3e\u0b23\u0b1f\u0b4b\u0b15\u0b3e \u0b26\u0b41\u0b06\u0b07 \u0b2c\u0b38\u0b3f\u0b32\u0b3e \u0b2e\u0b3e\u0b21\u0b3c\u0b3f\u2014\u0b22\u0b3c\u0b17 \n \n \n------------------\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2c\u0b1f \u0b24\u0b3f\u0b06\u0b30\u0b3f \u0b69]]"}}}]},"32434":{"pageid":32434,"ns":0,"title":"\u0b1f\u0b3f\u0b23\u0b3e","revisions":[{"revid":228156,"parentid":197780,"timestamp":"2023-09-06T06:15:10Z","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","*":"'''\u0b1f\u0b3f\u0b23\u0b3e'''\n== [[\u0b13\u0b21\u0b3c\u0b3f\u0b06]] ==\n \n=== \u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23 ===\n{{\u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23|\u1e6ci&\u1e47\u0101| \u0288\u02c8ina}}\n* {{\u0b05\u0b21\u0b3c\u0b3f\u0b13|Ori-nor-\u0b1f\u0b3f\u0b23\u0b3e.wav|\u0b27\u0b4d\u0b71\u0b28\u0b3f (\u0