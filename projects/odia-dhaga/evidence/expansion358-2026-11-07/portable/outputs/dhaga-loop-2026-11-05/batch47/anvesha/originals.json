b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2c\u0b1f \u0b24\u0b3f\u0b06\u0b30\u0b3f \u0b69]]"}}}]},"95479":{"pageid":95479,"ns":0,"title":"\u0b30\u0b3e\u0b28\u0b4d\u0b27\u0b23\u0b3e \u0b2a\u0b3e\u0b33\u0b3f","revisions":[{"revid":135485,"parentid":0,"timestamp":"2015-05-21T08:59:55Z","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","*":"'''\u0b30\u0b3e\u0b28\u0b4d\u0b27\u0b23\u0b3e \u0b2a\u0b3e\u0b33\u0b3f'''\n== [[\u0b13\u0b21\u0b3c\u0b3f\u0b06]] ==\n \n=== \u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23 ===\n{{\u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23|R\u0101ndha\u1e47\u0101 p\u0101\u1e3bi| \u027e\u02c8and\u02b0\u028cn\u02cca p\u02c8al\u0329\u02cci}} \n=== \u0b05\u0b28\u0b41\u0b2c\u0b3e\u0b26 ===\n{{trans-top|\u0b30\u0b3e\u0b28\u0b4d\u0b27\u0b23\u0b3e \u0b2a\u0b3e\u0b33\u0b3f}}\n* \u0b2c\u0b19\u0b4d\u0b17\u0b3e\u0b33\u0b40: [[\u09b0\u09be\u09a8\u09cd\u09a8\u09be\u09b0\u09aa\u09be\u09b2\u09be]]\n* \u0b39\u0b3f\u0b28\u0b4d\u0b26\u0b40: [[\u0930\u093e\u0902\u0927\u0928\u093e\u092a\u093e\u0930\u0940]]\n\n{{trans-bottom}}\n \n=== \u0b26\u0b47\u0b36\u0b1c - \u0b2c\u0b3f\u0b36\u0b47\u0b37\u0b4d\u0b5f - ===\n \n\u0b2a\u0b30\u0b3f\u0b2c\u0b3e\u0b30\u0b38\u0b4d\u0b25 \u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15 \u0b2e\u0b27\u0b4d\u0b5f\u0b30\u0b41 \u0b2a\u0b3e\u0b33\u0b3f \u0b15\u0b30\u0b3f \u0b30\u0b3e\u0b28\u0b4d\u0b27\u0b41\u0b25\u0b3f\u0b2c\u0b3e \u0b05\u0b2c\u0b38\u0b4d\u0b25\u0b3e\u0b30\u0b47 \u0b2f\u0b3e\u0b39\u0b3e\u0b30 \u0b2f\u0b47\u0b09\u0b01 \u0b26\u0b3f\u0b28 \u0b30\u0b3e\u0b28\u0b4d\u0b27\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b2a\u0b3e\u0b33\u0b3f \u0b2c\u0b3e \u0b15\u0b4d\u0b30\u0b2e \u0b2a\u0b21\u0b3c\u0b47 \u2014 Turn of cooking which comes to a particular (female) member of a joint family on a certain day.\n \n[\u0b09\u2014\u0b21\u0b3c\u0b3e\u0b33\u0b3f\u0b2a\u0b4b\u0b39\u0b33\u0b3e \u0b2e\u0b3e\u0b33\u0b40, \u0b06\u0b1c\u0b3f \u0b2c\u0b21\u0b3c \u0b2c\u0b4b\u0b39\u0b42\u0b19\u0b4d\u0b15\u0b30 \u0b30\u0b3e\u0b28\u