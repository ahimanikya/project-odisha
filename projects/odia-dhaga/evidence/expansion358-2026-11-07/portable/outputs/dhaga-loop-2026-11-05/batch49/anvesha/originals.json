0b32\u0b2a\u0b41\u0b30] \u0b2c\u0b3f\u0b36\u0b47\u0b37\u0b4d\u0b5f - ===\n \n\u0b2e\u0b3e\u0b18 \u2014The month of M\u0101gha.\n \n=== \u0b2a\u0b4d\u0b30\u0b3e\u0b26\u0b47\u0b36\u0b3f\u0b15 - \u0b2c\u0b3f\u0b36\u0b47\u0b37\u0b23 - ===\n \n\u0b2e\u0b3e\u0b18 \u0b2e\u0b3e\u0b38 \u0b38\u0b2e\u0b4d\u0b71\u0b28\u0b4d\u0b27\u0b40\u0b5f \u2014Relating to the month of M\u0101gha.\n \n[\u0b09\u2014\u0b2e\u0b18\u0b3e \u0b2c\u0b30\u0b37\u0b3e, \u0b2e\u0b3e\u0b06\u0b2a\u0b30\u0b38\u0b3e, \u0b0f \u0b26\u0b41\u0b39\u0b3f\u0b19\u0b4d\u0b15\u0b30 \u0b0f\u0b15\u0b3e \u0b26\u0b36\u0b3e \u0b22\u0b17] \n \n \n------------------\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2c\u0b1f \u0b24\u0b3f\u0b06\u0b30\u0b3f \u0b69]]\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b38\u0b2e\u0b4d\u0b2c\u0b32\u0b2a\u0b41\u0b30\u0b40 \u0b36\u0b2c\u0b4d\u0b26]]"}}}]},"105376":{"pageid":105376,"ns":0,"title":"\u0b36\u0b3f\u0b33 \u0b36\u0b3f\u0b33\u0b3f\u0b2a\u0b41\u0b06","revisions":[{"revid":145613,"parentid":0,"timestamp":"2015-05-25T14:21:12Z","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","*":"'''\u0b36\u0b3f\u0b33 \u0b36\u0b3f\u0b33\u0b3f\u0b2a\u0b41\u0b06'''\n== [[\u0b13\u0b21\u0b3c\u0b3f\u0b06]] ==\n \n=== \u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23 ===\n{{\u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23|\u1e60i\u1e3b\u0101 \u1e61i\u1e3bipu\u0101| \u0283\u02c8il\u0329\u02cc\u028c \u0283\u02c8il\u0329\u02ccipu\u02cca}} \n=== \u0b05\u0b28\u0b41\u0b2c\u0b3e\u0b26 ===\n{{trans-top|\u0b36\u0b3f\u0b33 \u0b36\u0b3f\u0b33\u0b3f\u0b2a\u0b41\u0b06}}\n* \u0b2c\u0b19\u0b4d\u0b17\u0b3e\u0b33\u0b40: [[\u09b6\u09bf\u09b2 \u09a8\u09cb\u09a1\u09bc\u09be]]\n* \u0b39\u0b3f\u0b28\u0b4d\u0b26\u0b40: [[\u0936\u093f\u0932\u0932\u093e\u0909]]\n\n{{trans-bottom}}\n \n=== \u0b26\u0b47\u0b36\u0b1c - \u0b2c\u0b3f\u0b36\u0b47\u0b37\u0b4d\u0b5f -(\u0b38\u0b02\u0b38\u0b4d\u0b15\u0b43\u0b24 - \u0b36\u0b3f\u0b33\u0b3e+\u0b36\u0b3f\u0b33\u0b3e \u0b2a\u0b41\u0b24\u0b4d\u0b30) ===\n \n:\u0b67. \u0b2c\u0b1f\u0b3e \u0b39\u0b47\u0b2c\u0b3e \u0b28\u0b3f\u0b2e\u0b28\u0b4d\u0b24\u0b47 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b43\u0b24 \u0b2d\u0b42\u0b2e\u0b3f\u0b30\u0b47 \u0b2a\u0b3e\u0b24\u0b3f\u0b24 \u0b36\u0b3f\u0b33\u0b2a\u0b1f\u0b4d\u0b1f \u0b13 \u0b2c\u0b3e\u0b1f\u0b3f\u0b2c\u0b3e \u0b28\u0b3f\u0b2e\u0b28\u0b4d\u0b24\u0b47 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b43\u0b24 \u0b32\u0b2e\u0b4d\u0b71 \u0b1b\u0b4b\u0b1f \u0b36\u0b33\u0b3e \u0b16\u0b23\u0b4d\u0b21 \u2014\u0b67, The pesting slab and the pesting stone.\n \n:\u0b68. (\u0b32\u0b15\u0b4d\u0b37\u0b23\u0b3e\u0b30\u0b4d\u0b25)\u2014 \u0b2d\u0b3e\u0b30\u0b3f \u0b2c\u0b38\u0b4d\u0b24\u0b41 \u0b38\u0b2e\u0b42\u0b39 \u2014\u0b68. (figurative) Heavy things.\n \n[\u0b09\u2014\u0b36\u0b3f\u0b33 \u0b36\u0b3f\u0b33\u0b2a\u0b41\u0b06 \u0b17\u0b17\u0b28\u0b47 \u0b09\u0b21\u0b41\u0b1b\u0b28\u0b4d\u0b24\u0b3f' \u0b36\u0b3f\u0b2e\u0b3f\u0b33\u0b3f \u0b24\u0b41\u0b33\u0b3e \u0b15\u0b39\u0b41\u0b1b\u0b3f \u0b2e\u0b4b\u0b24\u0b47 \u0b30\u0b16\u0b4d\u2014\u0b22\u0b17] \n \n \n------------------\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2c\u0b1f \u0b24\u0b3f\u0b06\u0b30\u0b3f \u0b69]]"}}}]}},"rightsinfo":{"url":"https://creativecommons.org/licenses/by-sa/4.0/deed.or","text":"Creative Commons Attribution-Share Alike 4.0"}}}