0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2c\u0b1f \u0b24\u0b3f\u0b06\u0b30\u0b3f \u0b69]]"}}}]}},"rightsinfo":{"url":"https://creativecommons.org/licenses/by-sa/4.0/deed.or","text":"Creative Commons Attribution-Share Alike 4.0"}}}