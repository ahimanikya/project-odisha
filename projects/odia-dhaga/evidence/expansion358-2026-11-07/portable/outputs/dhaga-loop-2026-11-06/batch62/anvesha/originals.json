0:\u0b38\u0b2e\u0b4d\u0b2c\u0b32\u0b2a\u0b41\u0b30\u0b40 \u0b36\u0b2c\u0b4d\u0b26]]"}}}]},"96290":{"pageid":96290,"ns":0,"title":"\u0b30\u0b41\u0b1f\u0b41\u0b30\u0b41\u0b1f\u0b41","revisions":[{"revid":199678,"parentid":178917,"timestamp":"2023-03-24T04:14:38Z","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","*":"'''\u0b30\u0b41\u0b1f\u0b41\u0b30\u0b41\u0b1f\u0b41'''\n== [[\u0b13\u0b21\u0b3c\u0b3f\u0b06]] ==\n \n=== \u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23 ===\n{{\u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23|Ru\u1e6duru\u1e6du| \u027e\u02c8u\u0288u\u027e\u02ccu\u0288u}}\n* {{\u0b05\u0b21\u0b3c\u0b3f\u0b13|LL-Q33810 (ori)-Psubhashish-\u0b30\u0b41\u0b1f\u0b41\u0b30\u0b41\u0b1f\u0b41.wav|\u0b27\u0b4d\u0b71\u0b28\u0b3f (\u0b2e\u0b3e\u0b28\u0b15 \u0b13\u0b21\u0b3c\u0b3f\u0b06)|lang=or}} \n=== \u0b05\u0b28\u0b41\u0b2c\u0b3e\u0b26 ===\n{{trans-top|\u0b30\u0b41\u0b1f\u0b41\u0b30\u0b41\u0b1f\u0b41}}\n* \u0b2c\u0b19\u0b4d\u0b17\u0b3e\u0b33\u0b40: [[\u0995\u09c1\u099f\u0995\u09c1\u099f]]\n* \u0b39\u0b3f\u0b28\u0b4d\u0b26\u0b40: [[\u091a\u0941\u091f\u094d\u091a\u093e\u091f\u094d]]\n\n{{trans-bottom}}\n \n=== \u0b26\u0b47\u0b36\u0b1c - \u0b05[\u0b2c\u0b39\u0b41 \u0b15\u0b4d\u0b30\u0b3f\u0b5f\u0b3e\u0b38\u0b42\u0b1a\u0b15] ===\n \n:\u0b67. \u0b27\u0b42\u0b33\u0b3f\u0b06 \u0b1c\u0b28\u0b4d\u0b26\u0b3e \u0b13 \u0b2a\u0b3f\u0b2e\u0b4d\u0b2a\u0b41\u0b21\u0b3c\u0b3f \u0b1f\u0b3e\u0b23 \u0b15\u0b30\u0b3f \u0b0f\u0b15\u0b3e\u0b27\u0b3f\u0b15 \u0b25\u0b30 \u0b15\u0b3e\u0b2e\u0b41\u0b21\u0b3c\u0b3f\u0b2c\u0b3e \u0b2a\u0b4d\u0b30\u0b15\u0b3e\u0b30\u0b47 \u2014\u0b67. Repeated biting of ants.\n \n:\u0b68. \u0b1b\u0b4b\u0b1f\u0b2c\u0b3e\u0b33\u0b15 \u0b09\u0b2a\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b41\u0b2a\u0b30\u0b3f\u0b15\u0b39\u0b41\u0b23\u0b40 \u0b2e\u0b3e\u0b30\u0b3f\u0b2c\u0b3e \n<!-- -- \u0b6d\u0b67\u0b6a\u0b6e -- -->\n \u0b2a\u0b4d\u0b30\u0b15\u0b3e\u0b30\u0b47 \u2014\u0b68. Dealing small blows repeatedly with the elbow.\n \n[\u0b2f\u0b25\u0b3e\u2014\u0b2e\u0b4b \u0b2a\u0b3f\u0b32\u0b3e\u0b1f\u0b3f \u0b2c\u0b21\u0b3c \u0b26\u0b41\u0b37\u0b4d\u0b1f\u0b41, \u0b15\u0b39\u0b41\u0b23\u0b40 \u0b2e\u0b3e\u0b30\u0b3f\u0b2c \u0b30\u0b41\u0b1f\u0b42\u0b30\u0b41\u0b1f\u0b42, \u0b26\u0b42\u0b30\u0b4d \u0b2a\u0b33\u0b3e,\u0b26\u0b42\u0b30\u0b4d \u0b2a\u0b33\u0b3e \u0b15\u0b3e\u0b39\u0b3e\u0b23\u0b40 \u0b17\u0b40\u0b24 ] \n \n:\u0b69. \u0b1b\u0b4b\u0b1f \u0b2e\u0b42\u0b37\u0b3e \u0b26\u0b3e\u0b28\u0b4d\u0b24\u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b15\u0b3e\u0b1f\u0b3f\u0b2c\u0b3e \u0b2a\u0b4d\u0b30\u0b15\u0b3e\u0b30\u0b47 \u2014 \u0b69. Nibbling by small rats.\n \n[\u0b09\u2014\u0b1a\u0b41\u0b1f\u0b3f\u0b06 \u0b2e\u0b42\u0b37\u0b3e ? \u0b30\u0b41\u0b1f\u0b41\u0b30\u0b41\u0b1f\u0b41 \u0b15\u0b30\u0b3f \u0b15\u0b3e\u0b1f\u0b07 \u0b16\u0b4b\u0b38\u0b3e \u0b22\u0b17 ] \n \n[ \u0b26\u0b4d\u0b30\u2014 \u0b30\u0b1f\u0b4d\u0b30\u0b1f\u0b4d\u0b20\u0b3e\u0b30\u0b41 \u0b30\u0b41\u0b1f\u0b4d\u0b30\u0b41\u0b1f\u0b4d \u0b05\u0b33\u0b4d\u0b2a\u0b24\u0b3e \u0b2c\u0b4d\u0b5f\u0b1e\u0b4d\u0b1c\u0b15 ] \n \n \n------------------\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2c\u0b1f \u0b24\u0b3f\u0b06\u0b30\u0b3f \u0b69]]\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b26\u0b47\u0b36\u0b1c \u0b05\u0b2c\u0b4d\u0b5f\u0b5f]]"}}}]}},"rightsinfo":{"url":"https://creativecommons.org/licenses/by-sa/4.0/deed.or","text":"Creative Commons Attribution-Share Alike 4.0"}}}