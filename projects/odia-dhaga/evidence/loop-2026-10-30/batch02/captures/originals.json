3e\u0b39\u0b3e \u0b05\u0b38\u0b41\u0b28\u0b4d\u0b26\u0b30 \u0b26\u0b47\u0b16\u0b3e\u0b2f\u0b3e\u0b0f \u0b06\u0b5f\u0b30\u0b41 \u0b2c\u0b4d\u0b5f\u0b5f \u0b2c\u0b47\u0b36\u0b40 \u0b39\u0b47\u0b2c\u0b3e \u0b38\u0b4d\u0b25\u0b33\u0b30\u0b47 \u0b0f \u0b22\u0b17 \u0b2c\u0b4b\u0b32\u0b3e\u0b2f\u0b3e\u0b0f] \n \n \n------------------\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2c\u0b1f \u0b24\u0b3f\u0b06\u0b30\u0b3f \u0b69]]"}}}]},"106006":{"pageid":106006,"ns":0,"title":"\u0b36\u0b41\u0b16\u0b3f\u0b2c\u0b3e","revisions":[{"revid":193077,"parentid":146266,"slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","*":"'''\u0b36\u0b41\u0b16\u0b3f\u0b2c\u0b3e'''\n== [[\u0b13\u0b21\u0b3c\u0b3f\u0b06]] ==\n \n=== \u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23 ===\n{{\u0b09\u0b1a\u0b4d\u0b1a\u0b3e\u0b30\u0b23| \u1e60ukhib\u0101| \u0283\u02c8uk\u02b0ib\u02cca}} \n=== \u0b05\u0b28\u0b41\u0b2c\u0b3e\u0b26 ===\n{{trans-top|\u0b36\u0b41\u0b16\u0b3f\u0b2c\u0b3e}}\n* \u0b2c\u0b19\u0b4d\u0b17\u0b3e\u0b33\u0b40: [[\u09b6\u09c1\u0995\u09c1\u09af\u09bc\u09c7\u09b7\u09be\u0993\u09af\u09bc\u09be]]\n* \u0b39\u0b3f\u0b28\u0b4d\u0b26\u0b40: [[\u0938\u0941\u0916\u0928\u093e]]\n\n{{trans-bottom}}\n \n(\u0b36\u0b41\u0b16\u0b3f\u0b2f\u0b3f\u0b2c\u0b3e\u2014\u0b05\u0b28\u0b4d\u0b5f\u0b30\u0b42\u0b2a) \n \n=== \u0b26\u0b47\u0b36\u0b1c - \u0b15\u0b4d\u0b30\u0b3f\u0b5f\u0b3e\u0b2a\u0b26 - (\u0b05\u0b15\u0b30\u0b4d\u0b2e\u0b15; \u0b38\u0b02\u0b38\u0b4d\u0b15\u0b43\u0b24 - \u0b36\u0b41\u0b37\u0b4d \u0b27\u0b3e\u0b24\u0b41\u0b1c \u0b36\u0b41\u0b37\u0b4d\u0b15\u0b30\u0b41) ===\n \n:\u0b67. \u0b05\u0b30\u0b4d\u0b26\u0b4d\u0b30 \u0b2c\u0b3e \u0b1c\u0b33\u0b40\u0b5f\u0b2c\u0b38\u0b4d\u0b24\u0b41) \u0b36\u0b41\u0b37\u0b4d\u0b15 \u0b39\u0b47\u0b2c\u0b3e; \u0b28\u0b3f\u0b30\u0b4d\u0b1c\u0b4d\u0b1c\u0b33 \u0b39\u0b47\u0b2c\u0b3e \u2014 \u0b67. (a wet thing) o become dry or water-less.\n \n:\u0b68. (\u0b1c\u0b33\u0b2a\u0b42\u0b30\u0b4d\u0b23\u0b4d\u0b23 \u0b2a\u0b41\u0b37\u0b4d\u0b15\u0b30\u0b3f\u0b23\u0b40 \u0b06\u0b26\u0b3f)\u0b30\u0b4c\u0b26\u0b4d\u0b30 \u0b2f\u0b4b\u0b17\u0b41\u0b01 \u0b2c\u0b3e \u0b1c\u0b33 \u0b28\u0b3f\u0b03\u0b36\u0b47\u0b37\u0b3f\u0b24 \u0b39\u0b47\u0b2c\u0b3e \u0b2f\u0b4b\u0b17\u0b41\u0b01 \u0b36\u0b41\u0b37\u0b4d\u0b15 \u0b39\u0b47\u0b2c\u0b3e \u2014\u0b68. To dry up (said of a river or tank from which water has been drained up or has evaporated.\n \n(\u0b09\u2014\u0b28\u0b08 \u0b36\u0b41\u0b16\u0b3f\u0b32\u0b47 \u0b15\u0b3f \u0b15\u0b30\u0b07 \u0b28\u0b3e\u0b06\u2014 \u0b22\u0b3c\u0b17) \n \n:\u0b69. (\u0b13\u0b26\u0b3e \u0b32\u0b41\u0b17\u0b3e \u0b13 \u0b27\u0b3e\u0b28 \u0b06\u0b26\u0b3f\u0b30\u0b41 \u0b2a\u0b3e\u0b23\u0b3f \u0b36\u0b41\u0b16\u0b3f\u0b2f\u0b3f\u0b2c \u0b2a\u0b3e\u0b07\u0b01 \u0b24\u0b3e\u0b39\u0b3e) \u0b16\u0b30\u0b3e\u0b30\u0b47 \u0b2c\u0b3e \u0b2a\u0b2c\u0b28\u0b30\u0b47 \u0b2e\u0b47\u0b32\u0b3e \u0b39\u0b4b\u0b07 \u0b38\u0b4d\u0b25\u0b3e\u0b2a\u0b3f\u0b24 \n<!-- -- \u0b6d\u0b6d\u0b69\u0b69 -- -->\n \u0b39\u0b47\u0b2c\u0b3e \u2014\u0b69. To be spread in air or sun to be dried (said of wet cloth etc).\n \n(\u0b09\u2014 \u0b06\u0b18\u0b1f\u0b23 \u0b15\u0b25\u0b3e \u0b36\u0b41\u0b23\u0b3f \u0b2e\u0b3e\u0b07\u0b2a\u0b47, \u0b27\u0b3e\u0b28 \u0b36\u0b41\u0b16\u0b41\u0b25\u0b3f\u0b32\u0b3e \u0b2c\u0b3f\u0b1e\u0b4d\u0b1b\u0b23\u0b3e \u0b1f\u0b3e\u0b15\u0b47 \u0b22\u0b3c\u0b17) \n \n:\u0b6a. (\u0b32\u0b15\u0b4d\u0b37\u0b23\u0b3e\u0b30\u0b4d\u0b25) (\u0b2e\u0b41\u0b16) \u0b2c\u0b3f\u0b37\u0b23\u0b4d\u0b23 \u0b2c\u0b3e \u0b2c\u0b3f\u0b2e\u0b30\u0b4d\u0b37 \u0b39\u0b47\u0b2c\u0b3e; \u0b2e\u0b4d\u0b33\u0b3e\u0b28 \u0b39\u0b47\u0b2c\u0b3e \u2014\u0b6a. (figurative) To look sad or dejected.\n \n(\u0b09\u2014\u0b30\u0b3e\u0b1c\u0b28 \u0b15\u0b3f\u0b38 \u0b15\u0b30 \u0b27\u0b4d\u0b5f\u0b3e\u0b28 \u0b36\u0b41\u0b16\u0b41\u0b1b\u0b3f \u0b24\u0b41\u0b2e\u0b4d\u0b2d\u0b30 \u0b2c\u0b26\u0b28 \u0b1c\u0b17\u0b28\u0b4d\u0b28\u0b3e\u0b25. \u0b2d\u0b3e\u0b17\u0b2c\u0b24) \n \n:\u0b6b. (\u0b18\u0b3e\u0b06 \u0b06\u0b26\u0b3f\u0b30\u0b41) \u0b2a\u0b41\u0b1c \u0b2a\u0b3e\u0b23\u0b3f\u0b30 \u0b38\u0b4d\u0b30\u0b3e\u0b2c \u0b2c\u0b28\u0b4d\u0b26 \u0b39\u0b47\u0b2c\u0b3e \u2014\u0b6b. To dry up (said of healding sores which had been running)\n \n:\u0b6c. (\u0b2e\u0b3e\u0b24\u0b43 \u0b38\u0b4d\u0b24\u0b28\u0b30\u0b41) \u0b38\u0b4d\u0b24\u0b28\u0b4d\u0b5f \u0b36\u0b47\u0b37 \u0b2a\u0b3e\u0b07\u0b2c\u0b3e \u2014\u0b6c. To dry up (said of the mother's breast when a child is weaned.)\n \n[\u0b09\u2014 \u0b26\u0b41\u0b27 \u0b36\u0b41\u0b16\u0b3f\u0b32\u0b47 \u0b15\u0b3f \u0b15\u0b30\u0b3f\u0b2c \u0b2e\u0b3e\u0b06 \u0b22\u0b3c\u0b17] \n \n['''\u0b26\u0b4d\u0b30\u0b37\u0b4d\u0b1f\u0b2c\u0b4d\u0b5f''' \u2014 \u0b2f\u0b47\u0b09\u0b01\u0b20\u0b3e\u0b30\u0b47 \u0b2f\u0b47\u0b09\u0b01 \u0b2a\u0b4d\u0b30\u0b15\u0b3e\u0b30 \u0b1c\u0b33\u0b40\u0b5f \u0b2c\u0b38\u0b4d\u0b24\u0b41 \u0b25\u0b3e\u0b0f; \u0b2f\u0b25\u0b3e\u2014 \u0b2a\u0b3e\u0b1f\u0b3f\u0b30\u0b47 \u0b1b\u0b47\u0b2a, \u0b26\u0b47\u0b39\u0b30\u0b47 \u0b30\u0b15\u0b4d\u0b24, \u0b24\u0b39\u0b3f\u0b01\u0b30 \u0b1c\u0b33\u0b40\u0b5f\u0b3e\u0b02\u0b36 \u0b36\u0b41\u0b37\u0b4d\u0b15 \u0b39\u0b47\u0b32\u0b47 \u0b2c\u0b3e \u0b15\u0b2e\u0b3f\u0b17\u0b32\u0b47 '\u0b36\u0b41\u0b16\u0b3f\u0b2c\u0b3e' \u0b36\u0b2c\u0b4d\u0b26 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b0f \u0b2f\u0b25\u0b3e\u2014\u0b2e\u0b4b\u0b24\u0b23\u0b4d\u0b1f\u0b3f \u0b36\u0b41\u0b16\u0b3f \u0b2f\u0b3e\u0b09\u0b1b\u0b3f, \u0b24\u0b3e \u0b26\u0b47\u0b39\u0b30\u0b41 \u0b30\u0b15\u0b4d\u0b24 \u0b36\u0b41\u0b16\u0b3f \u0b2f\u0b3e\u0b09\u0b1b\u0b3f] \n \n:\u0b6d. (\u0b32\u0b15\u0b4d\u0b37\u0b23\u0b3e\u0b30\u0b4d\u0b25) (\u0b26\u0b47\u0b39) \u0b36\u0b40\u0b30\u0b4d\u0b23\u0b4d\u0b23 \u0b39\u0b47\u0b2c\u0b3e \u2014\u0b6d. (figurative) To become lean or emaciated (said of the body)\n \n:\u0b6e. \u0b17\u0b1b \u0b06\u0b26\u0b3f \u0b1c\u0b33\u0b3e\u0b2d\u0b3e\u0b2c\u0b30\u0b41 \u0b2c\u0b3e \u0b16\u0b30\u0b3e \u0b24\u0b47\u0b1c\u0b30\u0b47 \u0b36\u0b41\u0b16\u0b3f\u0b2f\u0b3f\u0b2c\u0b3e \u0b2c\u0b3e \u0b1d\u0b3e\u0b09\u0b01\u0b33\u0b3f \u0b2a\u0b21\u0b3c\u0b3f\u0b2c\u0b3e \u2014\u0b6e. To wither (said of plants),\n \n \n------------------\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b2c\u0b1f \u0b24\u0b3f\u0b06\u0b30\u0b3f \u0b69]]\n[[\u0b36\u0b4d\u0b30\u0b47\u0b23\u0b40:\u0b05\u0b15\u0b30\u0b4d\u0b2e\u0b15 \u0b15\u0b4d\u0b30\u0b3f\u0b5f\u0b3e]]"}}}]}}}}