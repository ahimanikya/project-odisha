rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    function validKind(kind) { return kind in ['traveller', 'investor']; }
    // Retained closure marker blocks writes from other devices and stale tokens.
    match /users/{uid} {
      allow get: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly(['closureRequested','requestedAt'])
        && request.resource.data.closureRequested == true
        && request.resource.data.requestedAt == request.time;
      allow update, delete, list: if false;
    }
    match /users/{uid}/{kind}/{copyId} {
      allow get: if owns(uid) && validKind(kind);
      allow list: if owns(uid) && validKind(kind) && request.query.limit <= 20;
      allow create: if owns(uid) && validKind(kind)
        && !exists(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.keys().hasOnly(['owner','kind','version','title','payload','createdAt'])
        && request.resource.data.owner == uid
        && request.resource.data.kind == kind
        && request.resource.data.version == 1
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.payload is string && request.resource.data.payload.size() <= 500000
        && request.resource.data.createdAt == request.time;
      // Immutable snapshots avoid overwriting another device's changes.
      allow update: if false;
      allow delete: if owns(uid) && validKind(kind);
    }
    // Jhula survey: isolated from existing traveller and investor records.
    function jhulaEntry(e) {
      return e is map && e.keys().hasAll(['rating','comment'])
        && e.keys().hasOnly(['rating','comment'])
        && e.rating is int && e.rating >= 0 && e.rating <= 5
        && e.comment is string && e.comment.size() <= 300;
    }
    function jhulaValid(d) {
      return d.keys().hasAll(['entries','favourite','name','comment','kit','updatedAt'])
        && d.keys().hasOnly(['entries','favourite','name','comment','kit','updatedAt'])
        && d.name is string && d.name.size() <= 80
        && d.comment is string && d.comment.size() <= 1000
        && d.kit in ['bag','kit','unsure']
        && d.favourite in ['','01','02','03','04','05','06','07','08','09','10','11','12']
        && d.updatedAt == request.time
        && d.entries is map
        && d.entries.keys().hasAll(['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'])
        && d.entries.keys().hasOnly(['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'])
        && jhulaEntry(d.entries['01'])
        && jhulaEntry(d.entries['02'])
        && jhulaEntry(d.entries['03'])
        && jhulaEntry(d.entries['04'])
        && jhulaEntry(d.entries['05'])
        && jhulaEntry(d.entries['06'])
        && jhulaEntry(d.entries['07'])
        && jhulaEntry(d.entries['08'])
        && jhulaEntry(d.entries['09'])
        && jhulaEntry(d.entries['10'])
        && jhulaEntry(d.entries['11'])
        && jhulaEntry(d.entries['12'])
        && (d.entries['01'].rating > 0 || d.entries['02'].rating > 0 || d.entries['03'].rating > 0 || d.entries['04'].rating > 0 || d.entries['05'].rating > 0 || d.entries['06'].rating > 0 || d.entries['07'].rating > 0 || d.entries['08'].rating > 0 || d.entries['09'].rating > 0 || d.entries['10'].rating > 0 || d.entries['11'].rating > 0 || d.entries['12'].rating > 0);
    }
    match /jhulaRatings/{uid} {
      allow get, delete: if owns(uid);
      allow list: if false;
      allow create, update: if owns(uid) && jhulaValid(request.resource.data);
    }
  }
}
