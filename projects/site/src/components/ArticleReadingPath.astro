---
import ResponsiveImage from './ResponsiveImage.astro';
interface Link { href: string; title: string; description?: string; image?: string }
interface Props { links: Link[]; heading?: string; intro?: string; id?: string; class?: string; headingLevel?: 2 | 3; compact?: boolean }
const { links, heading = 'Continue reading', intro, id, class: className, headingLevel = 2, compact = false } = Astro.props;
const Heading = headingLevel === 3 ? 'h3' : 'h2';
---
<section id={id} class:list={['article-reading-path', className, {'is-compact': compact}]} aria-label={heading}>
  <Heading>{heading}</Heading>
  {intro && <p class="reading-path-intro">{intro}</p>}
  <nav aria-label={heading}>
    <ul>{links.map(link => <li>
      <a href={link.href} class:list={['reading-path-link', {'has-image': link.image}]}>
        {link.image && <ResponsiveImage src={link.image} sizes={compact ? "(max-width: 350px) 120px, (max-width: 600px) 88px, 120px" : "(max-width: 358px) calc(100vw - 2.4rem), (max-width: 600px) 320px, 180px"} alt="" width="180" height="120" loading="lazy"/>}
        <span class="reading-path-copy"><span class="reading-path-title">{link.title} <span aria-hidden="true">→</span></span>
        {link.description && <span class="reading-path-description">{link.description}</span>}</span>
      </a>
    </li>)}</ul>
  </nav>
</section>
<style>
.article-reading-path{margin-top:3rem;padding-top:1.5rem;border-top:1px solid var(--line)}
.article-reading-path h2,.article-reading-path h3{font-size:clamp(1.5rem,3vw,1.8rem);line-height:1.3;margin:0 0 1.25rem}
.article-reading-path .reading-path-intro{font-size:1rem;line-height:1.75;margin:0 0 1.25rem}
.article-reading-path ul{list-style:none;padding:0;margin:0}
.article-reading-path li{margin:0;padding:1rem 0;border-bottom:1px solid var(--line)}
.article-reading-path li:last-child{border-bottom:0;padding-bottom:0}
.article-reading-path a{display:inline-block;font-size:1.05rem;line-height:1.65;text-underline-offset:.2em;overflow-wrap:anywhere}
.article-reading-path .reading-path-link{text-decoration:none;display:flex;align-items:flex-start;gap:1rem}
.article-reading-path .reading-path-title{text-decoration:underline;text-underline-offset:.2em}
.article-reading-path .reading-path-copy{min-width:0}
.article-reading-path .reading-path-description{display:block;font-size:.95rem;line-height:1.7;margin-top:.35rem;color:var(--muted)}
.article-reading-path :global(img){display:block;width:180px;height:auto;flex:none;margin:0;aspect-ratio:3/2;object-fit:contain;background:var(--paper)}
@media(max-width:600px){.article-reading-path .has-image{flex-direction:column}.article-reading-path :global(img){width:100%;max-width:320px}}
.article-reading-path a:focus-visible{outline:3px solid var(--earth);outline-offset:4px}
.article-reading-path.is-compact{margin-top:1.5rem;padding-top:1rem}
.article-reading-path.is-compact h3{font-size:1.15rem;margin-bottom:.75rem}
.article-reading-path.is-compact :global(img){width:120px;max-width:120px;aspect-ratio:3/2;object-fit:contain}
.article-reading-path.is-compact .reading-path-link{gap:.9rem}
.article-reading-path.is-compact .reading-path-description{font-size:.9rem;line-height:1.55;margin-top:.2rem}
@media(max-width:600px){.article-reading-path.is-compact .has-image{flex-direction:row}.article-reading-path.is-compact :global(img){width:88px;max-width:88px}.article-reading-path.is-compact .reading-path-link{font-size:1rem}}
@media(max-width:350px){.article-reading-path.is-compact .has-image{flex-direction:column}}
</style>
