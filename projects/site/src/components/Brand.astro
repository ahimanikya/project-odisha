---
const {language='en', tone='colour'} = Astro.props;
const variant=language==='or'?'or':'en';
---
<span class:list={['brand','brand-'+variant]} lang={variant==='or'?'or':'en'}>
 <img class="brand-signature" src={'/assets/brand-v4/project-odisha-'+variant+'-'+(tone==='reverse'?'reverse':'colour')+'.svg'} alt={variant==='or'?'ପ୍ରୋଜେକ୍ଟ ଓଡ଼ିଶା':'Project Odisha'} width="850" height="140"/>
</span>
