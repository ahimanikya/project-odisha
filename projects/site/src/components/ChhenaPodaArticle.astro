---
import MagazineCover from './MagazineCover.astro';
import MagazineContents from './MagazineContents.astro';
import ArticleByline from './ArticleByline.astro';
import ArticleFootnote from './ArticleFootnote.astro';
import ArticleFootnotes from './ArticleFootnotes.astro';
const {entry,photo,links,editorial}=Astro.props;
const passages=entry.sections.flatMap(s=>s.paragraphs.map((p,i)=>({id:`${s.id}-${i}`,source_ids:p.source_ids}))).filter(p=>p.source_ids.length);
---
<div class="utk-magazine utk-magazine--food chhena-editorial">
 <MagazineCover title={entry.title} odia={entry.odia} eyebrow={'A taste of Odisha · '+entry.area} deck={[entry.lead]} photo={{...photo,fit:'contain'}} saveId={entry.save_id} startHref={'#'+entry.sections[0].id} startLabel="Meet the dish" footline="A taste to remember. A question to take with you."><Fragment slot="byline"><ArticleByline author={editorial.author}/></Fragment></MagazineCover>
 <MagazineContents links={[...entry.sections.map(s=>({href:'#'+s.id,label:s.title})),{href:'#food-further-reading',label:'Further reading'},{href:'#story-sources',label:'Footnotes & Sources'}]}/>
 <article class="mag-content">
  <div class="chhena-chapters">{entry.sections.map((section,index)=><section id={section.id} class="chhena-section"><p class="eyebrow">{String(index+1).padStart(2,'0')} · A taste of Odisha</p><h2>{section.title}</h2>{section.paragraphs.map((p,i)=><p data-source-ids={p.source_ids.join(' ')}>{p.text}<ArticleFootnote ids={p.source_ids} sources={editorial.sources} passage={`${section.id}-${i}`}/></p>)}</section>)}</div>
  <section id="food-further-reading" class="chhena-further-reading"><details class="utk-disclosure"><summary>Further reading</summary><nav aria-label="Related food and places"><ul>{links.map(link=><li><a href={link.href}>{link.title} →</a>{link.reason&&<p>{link.reason}</p>}</li>)}</ul></nav></details></section>
  <ArticleFootnotes sources={editorial.sources} passages={passages}><div id="food-image-credits"><h3>Photograph and reuse</h3><p><a href={photo.source}>Chhena poda ({photo.date?.slice(0,4)})</a> by {photo.creator} · <a href={photo.license_url}>{photo.license}</a>. {photo.changes}</p></div></ArticleFootnotes>
  <p class="chhena-update"><a href="/contribute/?page=%2Ffood%2Fchhena-poda%2F">Suggest an update</a>. GitHub submissions are public; omit private contact details and consent documents.</p>
 </article>
</div>
<script>
import {bindStorySourceLinks} from '../lib/story-source-links.mjs';
document.querySelectorAll('.chhena-editorial sup, .chhena-editorial .article-footnotes').forEach(group=>bindStorySourceLinks(group,document));
</script>
<style>
.chhena-chapters,.chhena-further-reading,.chhena-update{max-width:740px;margin-inline:auto}
.chhena-section{margin:56px 0;scroll-margin-top:28px}
.chhena-section h2{font-size:clamp(28px,3vw,38px);line-height:1.3;margin:0 0 24px}
.chhena-section p:not(.eyebrow){font-size:18px;line-height:1.85;margin:0 0 1.25em}
.chhena-further-reading p{font-size:15px;line-height:1.7;color:var(--muted)}
.chhena-update{font-size:15px;line-height:1.8;margin-block:40px}
.chhena-editorial :global(.article-footnotes){max-width:740px;margin:64px auto 48px;border-top:1px solid var(--line);padding-top:28px;font-size:16px;line-height:1.8}
.chhena-editorial :global(.article-footnotes p){margin:0 0 1.25em}
.chhena-editorial :global(.article-footnotes h2){font-size:30px;margin:0 0 24px}
.chhena-editorial :global(.article-footnotes h3){font-size:22px;margin:24px 0 16px}
.chhena-editorial :global(.article-footnotes li){margin-bottom:24px;scroll-margin-top:24px;overflow-wrap:anywhere}
.chhena-editorial :global(.article-footnotes li:target){outline:2px solid var(--line);outline-offset:6px}
.chhena-editorial :global(sup){font-size:.7em;line-height:0;margin-left:.15em}
.chhena-editorial :global(a[data-footnote-ref]){font-weight:600;text-decoration:none;padding:.2em .15em}
.chhena-editorial :global(a[data-footnote-backref]){display:inline-block;padding:.2rem .3rem}
.chhena-editorial :global(a:focus-visible){outline:2px solid var(--earth);outline-offset:3px}
@media(max-width:700px){.chhena-section{margin-block:40px}.chhena-section p:not(.eyebrow){font-size:17px;line-height:1.8}}
</style>
