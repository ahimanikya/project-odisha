---
import ArticleReadingPath from './ArticleReadingPath.astro';
import {cinemaNarrative} from '../lib/cinema-article.mjs';
interface Props { heading?: string; writers?: boolean }
const {heading='Explore a question', writers=false}=Astro.props;
---
<ArticleReadingPath compact heading={heading} links={cinemaNarrative.section_guide || []}/>
{writers && <ArticleReadingPath compact heading="More people behind the stories" intro="Explore these online companions to the main reading sequence." links={cinemaNarrative.writers_beyond_series || []}/>}
