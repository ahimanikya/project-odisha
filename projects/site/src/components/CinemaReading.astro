---
import Shell from '../layouts/Shell.astro';
import ReviewedCultureArticle from './ReviewedCultureArticle.astro';
import ArticleReadingPath from './ArticleReadingPath.astro';
import {cinema,cinemaArticle,cinemaNavigationLabel} from '../lib/cinema-article.mjs';
const {entry}=Astro.props;
const {article,readingSections,afterReading,hero}=cinemaArticle(entry);
article.html=`<p class="cinema-reading-intro">${entry.series_intro.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;')}</p>`+article.html;
const index=cinema.articles.findIndex(a=>a.slug===entry.slug);
const part=cinema.parts.find(p=>p.chapters.includes(entry.slug));
const sequence=[index>0?{entry:cinema.articles[index-1],direction:'Previous'}:null,index<cinema.articles.length-1?{entry:cinema.articles[index+1],direction:'Next'}:null].filter(Boolean);
---
<Shell title={article.title} description={entry.series_intro} active="explore" related={false} shareImage={{src:hero.file,alt:entry.hero.alt,width:hero.width,height:hero.height}}>
 <div class="cinema-reader"><ReviewedCultureArticle article={article}>
  <p slot="intro" class="cinema-context"><a href="/cinema/">Odia cinema</a><span aria-hidden="true"> · </span><span>{part?.title}</span></p>
  <section id="further-reading" class="cinema-further-reading"><h2>Further reading</h2>{readingSections.map(section=><Fragment><div set:html={section.before}/>{section.compactReferences ? <section id={section.id} class="cinema-references"><h3>{section.heading}</h3><ul>{section.links.map(link=><li><a href={link.href}>{link.title}</a></li>)}</ul></section> : <ArticleReadingPath uniformImages id={section.id} heading={section.heading} headingLevel={3} compact links={section.links}/>}</Fragment>)}</section>
  <div class="cinema-update" set:html={afterReading}/>
  <nav class="cinema-sequence" aria-label="Reading sequence">{sequence.map(n=><a href={n.entry.route} rel={n.direction==='Next'?'next':'prev'}><span>{n.direction}</span>{n.direction==='Previous'&&<span aria-hidden="true">← </span>}{cinemaNavigationLabel(n.entry)}{n.direction==='Next'&&<span aria-hidden="true"> →</span>}</a>)}</nav>
  <nav class="cinema-utilities" aria-label="Cinema collection"><a href="/cinema/">All {cinema.articles.length} readings</a><a href="/cinema/book/">Read or print the book</a><a href="/cinema/watch/">Find something to watch</a><a href="/cinema/reading-guide/">People and turning points</a></nav>
 </ReviewedCultureArticle></div>
</Shell>
<style>
:global(html:has(.cinema-reader)){scroll-behavior:auto}
.cinema-context{font-size:.85rem;line-height:1.5;margin-bottom:.85rem}
:global(.cinema-reader .cinema-narrative-continue){border-top:1px solid var(--line);margin-block:2rem;padding-block:1rem}
:global(.cinema-reader .cinema-narrative-continue a){display:inline-block;padding-block:.6rem;min-height:44px}
:global(.cinema-reader [data-footnote-ref]),:global(.cinema-reader [data-footnote-backref]){display:inline-flex;align-items:center;justify-content:center;min-width:24px;min-height:24px;line-height:1}
:global(.cinema-reader .cinema-citation-tail){white-space:nowrap}
:global(.cinema-reader [id^="user-content-fn-"]:focus){outline:2px solid var(--earth);outline-offset:4px}
.eyebrow{color:var(--earth);font-size:.8rem;letter-spacing:.08em}.cinema-further-reading{margin-top:2.5rem}.cinema-references{margin-top:1.5rem}.cinema-references h3{font-size:1.15rem}.cinema-references ul{padding-left:1.2rem}.cinema-references li{font-size:.95rem;line-height:1.65;margin:.45rem 0}.cinema-sequence{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;border-top:1px solid var(--line);margin-top:2rem;padding-top:1rem}.cinema-sequence a{min-width:0;font-size:1rem;line-height:1.6;overflow-wrap:break-word}.cinema-sequence a[rel="prev"]{grid-column:1;grid-row:1;text-align:left}.cinema-sequence a[rel="next"]{grid-column:2;grid-row:1;text-align:right}.cinema-sequence a>span:first-child{display:block;font-size:.8rem;color:var(--muted)}.cinema-utilities{display:flex;flex-wrap:wrap;gap:.5rem 1.25rem;margin-top:1.5rem;padding-bottom:1rem;font-size:.95rem}.cinema-utilities a{padding:.3rem 0}.cinema-sequence a:focus-visible,.cinema-utilities a:focus-visible{outline:3px solid var(--earth);outline-offset:4px}
:global(.reviewed-culture .cinema-image-credit){display:block;margin-top:.35em}
/* Preserve native table relationships and allow keyboard scrolling on narrow screens. */
:global(.reviewed-culture .article-table.cinema-comparison){max-inline-size:100%;max-block-size:75vh;overflow:auto}
:global(.reviewed-culture .article-table.cinema-comparison table){min-inline-size:750px;table-layout:auto;border-collapse:separate;border-spacing:0}
:global(.reviewed-culture .article-table.cinema-comparison caption){text-align:start;font-weight:600;padding-block:.75rem;line-height:1.5}
:global(.reviewed-culture .article-table.cinema-comparison th),:global(.reviewed-culture .article-table.cinema-comparison td){padding:.8rem;vertical-align:top;white-space:normal;overflow-wrap:normal;word-break:normal}
:global(.reviewed-culture .article-table.cinema-comparison thead){position:sticky;inset-block-start:0;z-index:2;background:var(--paper,#fff)}
:global(.reviewed-culture .article-table.cinema-comparison tbody th){position:sticky;inset-inline-start:0;z-index:1;background:var(--paper,#fff);min-inline-size:150px;max-inline-size:180px;text-align:start}
:global(.reviewed-culture .article-table.cinema-comparison:focus-visible){outline:3px solid var(--earth);outline-offset:4px}
:global(.reviewed-culture .article-table.cinema-comparison tr>:nth-child(1)){min-inline-size:150px}
:global(.reviewed-culture .article-table.cinema-comparison tr>:nth-child(2)){min-inline-size:100px}
:global(.reviewed-culture .article-table.cinema-comparison tr>:nth-child(3)){min-inline-size:140px}
:global(.reviewed-culture .article-table.cinema-comparison tr>:nth-child(4)){min-inline-size:140px}
:global(.reviewed-culture .article-table.cinema-comparison tr>:nth-child(5)){min-inline-size:220px}
/* Awards retain their four-column relationships at narrow widths. */
:global(.reviewed-culture .article-table.cinema-recognition){max-inline-size:100%;max-block-size:75vh;overflow:auto}
:global(.reviewed-culture .article-table.cinema-recognition table){min-inline-size:740px;table-layout:auto;border-collapse:separate;border-spacing:0}
:global(.reviewed-culture .article-table.cinema-recognition caption){text-align:start;font-weight:600;padding-block:.75rem;line-height:1.5}
:global(.reviewed-culture .article-table.cinema-recognition th),:global(.reviewed-culture .article-table.cinema-recognition td){padding:.8rem;vertical-align:top;white-space:normal;overflow-wrap:normal;word-break:normal}
:global(.reviewed-culture .article-table.cinema-recognition thead){position:sticky;inset-block-start:0;z-index:2;background:var(--paper,#fff)}
:global(.reviewed-culture .article-table.cinema-recognition tbody th){position:sticky;inset-inline-start:0;z-index:1;background:var(--paper,#fff);min-inline-size:160px;max-inline-size:210px;text-align:start}
:global(.reviewed-culture .article-table.cinema-recognition tr>:nth-child(2)){min-inline-size:180px}
:global(.reviewed-culture .article-table.cinema-recognition tr>:nth-child(3)){min-inline-size:100px}
:global(.reviewed-culture .article-table.cinema-recognition tr>:nth-child(4)){min-inline-size:210px}
:global(.reviewed-culture .article-table.cinema-recognition:focus-visible){outline:3px solid var(--earth);outline-offset:4px}

:global(.reviewed-culture .cinema-callback){border-inline-start:3px solid var(--earth);background:var(--paper,#faf8f3);padding:1rem 1.3rem;margin-block:2rem}
:global(.reviewed-culture .cinema-callback p){margin-block:.4rem}
:global(.reviewed-culture .cinema-callback-label){font-size:.8rem;font-weight:700;letter-spacing:.04em;color:var(--earth)}
:global(.reviewed-culture figcaption sup){white-space:nowrap;font-size:.8em;vertical-align:super;margin-inline-start:.15em}
.cinema-update{margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid var(--line)}.cinema-update :global(p){margin-top:0}
</style>

<style>
/* Natural figure geometry: no fixed-ratio panels, clipping or empty filler. */
:global(.cinema-reader .article-reading.reviewed-culture figure){width:var(--cinema-figure-width,100%);max-width:100%;margin-inline:auto}
:global(.cinema-reader .article-reading.reviewed-culture figure .cinema-full-image),
:global(.cinema-reader .article-reading.reviewed-culture figure picture){display:block;width:100%}
:global(.cinema-reader .article-reading.reviewed-culture figure picture img){display:block;position:static;width:100%;height:auto;max-width:100%;max-height:none;aspect-ratio:var(--cinema-image-ratio);object-fit:var(--cinema-image-fit,contain);object-position:var(--cinema-image-position,50% 50%);margin:0}
:global(.cinema-reader .article-reading.reviewed-culture figure figcaption){text-align:left;margin-inline:0;padding-inline:0;text-indent:0}
</style>

<style>
/* Optional small pauses use intrinsic proportions, without cropping or extra panels. */
:global(.cinema-reader .article-reading.reviewed-culture .cinema-line-art){width:var(--line-art-width);max-width:100%;margin:2rem auto;break-inside:avoid}
:global(.cinema-reader .article-reading.reviewed-culture .cinema-line-art img){display:block;width:100%;height:auto;max-height:none;aspect-ratio:var(--line-art-ratio);object-fit:contain;margin:0}
:global(.cinema-reader .article-reading.reviewed-culture .cinema-line-art-caption){font-size:.8rem;line-height:1.5;text-align:left;margin:.5rem 0 0}
</style>
