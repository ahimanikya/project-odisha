---
import pratibhaEditorial from '../../../../kb/research/voices/pratibha-editorial.json';
import saralaEditorial from '../../../../kb/research/voices/sarala-editorial.json';
import sixAcresEditorial from '../../../../kb/research/voices/six-acres-editorial.json';
import fakirEditorial from '../../../../kb/research/voices/fakir-editorial.json';
import literatureEditorial from '../../../../kb/research/voices/literature-editorial.json';
import odiaEditorial from '../../../../kb/research/voices/odia-editorial.json';
import languagesEditorial from '../../../../kb/research/voices/languages-editorial.json';
import ArticleByline from './ArticleByline.astro';
import ArticleFootnote from './ArticleFootnote.astro';
import ArticleFootnotes from './ArticleFootnotes.astro';
import MagazineCover from './MagazineCover.astro';
import VoicesParagraph from './VoicesParagraph.astro';
import {voiceSources} from '../lib/voices-sources.mjs';
import MagazineContents from './MagazineContents.astro';
import CultureCards from './CultureCards.astro';
import LanguagePopulation from './LanguagePopulation.astro';
import atlas from '../../../../kb/research/voices/population-2011.json';
import LanguageDirectory from './LanguageDirectory.astro';
import LanguageLearning from './LanguageLearning.astro';
import LanguageInvitation from './LanguageInvitation.astro';
import CultureConnections from './CultureConnections.astro';
import {cultureTrailsFor} from '../data/culture-trails';
import VoicesCredits from './VoicesCredits.astro';
import CultureOnward from './CultureOnward.astro';
import collection from '../../../../kb/research/voices/collection.json';
import '../styles/culture-magazine.css';
const {entry}=Astro.props,hero=collection.assets[entry.hero_asset],hub=!entry.path.includes('/');
const editorial=entry.path==='languages'?languagesEditorial:entry.path==='languages/odia'?odiaEditorial:entry.path==='literature'?literatureEditorial:entry.path==='people/fakir-mohan-senapati'?fakirEditorial:entry.path==='literature/six-acres-and-a-third'?sixAcresEditorial:entry.path==='people/sarala-das'?saralaEditorial:entry.path==='people/pratibha-ray'?pratibhaEditorial:null;
const passageSources=id=>editorial?.passages.find(p=>p.id===id)?.source_ids||[];
const proseFirst=entry.path==='literature';
const assetIds=[...new Set([entry.hero_asset,...entry.cards.map(c=>c.asset)].filter(Boolean))];
const editorialAssets=proseFirst?assetIds.filter((id,i)=>assetIds.findIndex(other=>collection.assets[other].source===collection.assets[id].source)===i):assetIds;
const sources=voiceSources(entry,collection.sources);
const hasPopulation=entry.path.startsWith('languages/')&&Object.hasOwn(atlas.profiles,entry.path.split('/')[1]);
const kind=entry.path.startsWith('languages')?'A living language':entry.path.startsWith('people')?'A literary life':'A world of words';
const start=hub&&!proseFirst&&entry.cards.length?'#reading-doors':'#'+entry.sections[0].id;
---
<div class:list={["utk-magazine","utk-magazine--culture",{"culture-script":hero?.kind==='script',"languages-editorial":!!editorial}]}>
 <MagazineCover title={entry.title} eyebrow={entry.kicker} deck={[entry.lead]} photo={hero} caption={entry.hero_caption||hero?.caption} identity={entry.identity_panel} identityLabel={entry.identity_label||kind} identityNote={entry.identity_note||'A reading doorway, not a script specimen.'} saveId={hub?undefined:'reading:'+entry.path} startHref={start} startLabel={proseFirst?'Begin reading':hub?'Find a reading doorway':'Follow the story'} footline="A place becomes richer when you listen to its voices."><Fragment slot="byline">{editorial&&<ArticleByline author={editorial.author}/>}</Fragment></MagazineCover>
 <MagazineContents links={[
 ...(hub&&!proseFirst&&entry.cards.length?[{href:'#reading-doors',label:'A place to begin'}]:[]),
 ...entry.sections.map(s=>({href:'#'+s.id,label:s.title})),
 ...(proseFirst&&entry.cards.length?[{href:'#reading-doors',label:'Choose a reading path'}]:[]),
 ...(hasPopulation?[{href:'#population',label:'Population & districts'}]:[]),
 ...(entry.learning_resource?[{href:'#learning-shelf',label:'Reading shelf'}]:[]),
 ...(entry.roster?[{href:'#more-voices',label:'More voices'}]:[]),
 ...(entry.language_contribution?[{href:'#share-a-voice',label:'Share a voice'}]:[]),
 ...(entry.path==='languages'?[{href:'#language-counts',label:'Where languages were counted'}]:[]),
 ...(editorial?[{href:'#story-sources',label:'Footnotes & Sources'}]:[])
 ]}/>
 <article class="mag-content">
  {hub&&!proseFirst&&(entry.path==='languages'?<LanguageDirectory entry={entry} editorial={editorial}/>:<CultureCards entry={entry}/>)}
  <div class="mag-article-chapters">{entry.sections.map((s,index)=><section id={s.id} class:list={['mag-reading-section',{'mag-reading-section--warm':index===1}]}><div><p class="eyebrow">{String(index+1).padStart(2,'0')} · {kind}</p><h2>{s.title}</h2></div><div>{s.paragraphs.map((p,i)=>editorial?<p data-source-ids={p.source_ids.join(' ')}>{p.text}<ArticleFootnote ids={passageSources(`${s.id}-${i}`)} sources={editorial.sources} passage={`${s.id}-${i}`}/></p>:<VoicesParagraph paragraph={p} sources={sources}/>)}</div></section>)}</div>
  {entry.path==='languages'&&<section id="language-counts" class="mag-reading-section language-counts"><div><p class="eyebrow">The numbers behind the voices</p><h2>Where languages were counted</h2></div><div>{entry.atlas_paragraphs.map((p,i)=><p data-source-ids={p.source_ids.join(' ')}>{p.text}<ArticleFootnote ids={passageSources(`atlas-${i}`)} sources={editorial.sources} passage={`atlas-${i}`}/></p>)}<a class="text-link" href="/languages/atlas/">Open the language population atlas →</a><p><a href="/languages/districts/">Start with a district →</a> · <a href="/languages/multilingual-odisha/">Multilingual Odisha →</a></p></div></section>}
  {hasPopulation&&<LanguagePopulation path={entry.path} editorial={editorial}/>}
  {(!hub||proseFirst)&&<CultureCards entry={entry} editorial={proseFirst?editorial:null}/>}
  {entry.learning_resource&&<LanguageLearning resource={entry.learning_resource}/>}
  {entry.roster&&<section id="more-voices" class="culture-roster"><p class="eyebrow">The collection will grow</p><h2>{entry.roster_heading}</h2><ul>{entry.roster.map(name=><li>{name}</li>)}</ul><p>{entry.roster_note}{editorial&&<ArticleFootnote ids={passageSources('roster')} sources={editorial.sources} passage="roster"/>}</p>{entry.roster_sources?.includes('scstrti')&&<a class="text-link" href={collection.sources.scstrti.url}>Browse SCSTRTI’s learning resources ↗</a>}</section>}
  {entry.external_links?.length>0&&<section class="culture-reading-links"><p class="eyebrow">Continue with the work</p>{entry.external_links.map(link=><a href={link.href}>{link.title} ↗</a>)}</section>}
  {cultureTrailsFor('/'+entry.path+'/').length>0&&<details class="mag-disclosure"><summary>Places, languages and connected stories</summary><CultureConnections path={'/'+entry.path+'/'}/></details>}
  {entry.language_contribution&&<LanguageInvitation language={hub?'':entry.title}/>}
  <CultureOnward entry={entry} collapsed={!!editorial}/>
  {editorial?<><ArticleFootnotes sources={editorial.sources} passages={editorial.passages}><div id="language-image-credits"><h3>Images and reuse</h3><ul>{editorialAssets.map(id=><li><a href={collection.assets[id].source}>{collection.assets[id].caption}</a><p>{collection.assets[id].creator} · <a href={collection.assets[id].license_url}>{collection.assets[id].license}</a>. {collection.assets[id].changes}</p>{collection.assets[id].rights_note&&<p>{collection.assets[id].rights_note}</p>}</li>)}</ul></div></ArticleFootnotes><p class="languages-update"><a href={`/contribute/?page=${encodeURIComponent('/'+entry.path+'/')}`}>Suggest an update</a>. GitHub submissions are public; omit private contact details and consent documents.</p></>:<><VoicesCredits entry={entry}/><p class="mag-status">Editorial preview · awaiting Founder and language or literary review.</p></>}
 </article>
</div>

<script>
import {bindStorySourceLinks} from '../lib/story-source-links.mjs';
document.querySelectorAll('.languages-editorial sup, .languages-editorial .article-footnotes').forEach(group=>bindStorySourceLinks(group,document));
</script>
<style>
.languages-editorial .mag-article-chapters,.languages-editorial .language-counts,.languages-editorial .languages-update{max-width:740px;margin-inline:auto}
.languages-editorial .mag-reading-section{display:block;padding:0;margin:56px 0;background:none}
.languages-editorial .language-counts{margin-inline:auto}
.languages-editorial .mag-reading-section h2{font-size:clamp(28px,3vw,38px);line-height:1.3;margin:0 0 24px;max-width:none}
.languages-editorial .mag-reading-section p:not(.eyebrow){font-size:18px;line-height:1.85;margin:0 0 1.25em;max-width:none}
.languages-editorial :global(.article-footnotes){max-width:740px;margin:64px auto 48px;border-top:1px solid var(--line);padding-top:28px;font-size:16px;line-height:1.8}
.languages-editorial :global(.article-footnotes p){margin:0 0 1.25em}
.languages-editorial :global(.article-footnotes h2){font-size:30px;margin:0 0 24px}
.languages-editorial :global(.article-footnotes li){margin-bottom:24px;scroll-margin-top:24px;overflow-wrap:anywhere}
.languages-editorial :global(.article-footnotes li:target){outline:2px solid var(--line);outline-offset:6px}
.languages-editorial :global(sup){font-size:.7em;line-height:0;margin-left:.15em}
.languages-editorial :global(a[data-footnote-ref]){font-weight:600;text-decoration:none;padding:.2em .15em}
.languages-editorial :global(a[data-footnote-backref]){display:inline-block;padding:.2rem .3rem}
.languages-editorial :global(a:focus-visible){outline:2px solid var(--earth);outline-offset:3px}
.languages-update{font-size:15px;line-height:1.8;margin-block:40px}
@media(max-width:700px){.languages-editorial .mag-reading-section{margin-block:40px}.languages-editorial .mag-reading-section p:not(.eyebrow){font-size:17px;line-height:1.8}}
</style>
