---
import Shell from '../layouts/Shell.astro';
import MagazineCover from './MagazineCover.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import SaveJourney from './SaveJourney.astro';
import {allowsPage} from '../data/edition';
const {story}=Astro.props;
import foods from '../../../../kb/research/food/collection.json';
const chapters=story.chapters.map(c=>({...c,page:foods.pages.find(p=>p.slug===c.slug)})).filter(c=>allowsPage('/food/'+c.slug+'/'));
const onward=story.onward.map(slug=>foods.pages.find(p=>p.slug===slug)).filter(p=>p&&allowsPage('/food/'+p.slug+'/'));
const photo=foods.assets[story.hero];
const credits=[...new Set([story.hero,...chapters.map(c=>c.page.hero),...onward.map(p=>p.hero)])].map(id=>foods.assets[id]);
---
<Shell title={story.title} description={story.lead} active="explore" wide related={false}>
<div class="utk-magazine utk-magazine--food everyday-table">
<MagazineCover title={story.title} eyebrow={story.eyebrow||'Food, memory & the people behind a meal'} deck={[story.lead]} photo={photo} saveId={story.save_id} startHref="#stories" startLabel={story.start_label||'Pull up a chair'} footline={story.footline||'Small dishes. Stories worth taking home.'}/>
<div class="table-body"><p class="table-intro">{story.intro}</p>
<section id="stories" aria-labelledby="table-stories"><p class="eyebrow">{story.chapter_eyebrow||'Three ways into the meal'}</p><h2 id="table-stories">{story.chapter_title?<em>{story.chapter_title}</em>:<>Start with <em>a taste.</em></>}</h2>
<div class="table-stories">{chapters.map((c,i)=><article>
<a class="table-picture" href={'/food/'+c.slug+'/'} aria-label={'Read '+c.page.title}><ResponsiveImage {...Object.fromEntries(['src','alt','width','height'].map(k=>[k,foods.assets[c.page.hero][k]]))} loading="lazy" sizes="(max-width: 700px) 92vw, 30vw"/></a>
<div><p class="eyebrow">0{i+1} · {c.page.title}</p><h3><a href={'/food/'+c.slug+'/'}>{c.title} →</a></h3><p>{c.text}</p><SaveJourney id={c.page.save_id} quiet/></div>
</article>)}</div></section>
<section class="table-conversation"><div><p class="eyebrow">Meet the maker</p><h2>A good question<br/><em>opens a kitchen story.</em></h2></div><ul>{story.questions.map(q=><li>{q}</li>)}</ul></section>
<section class="table-onward"><div><p class="eyebrow">Leave room for another story</p><h2>{story.onward_title||<>From a leaf<br/>to a browned edge.</>}</h2><p>{story.onward_text||'Follow the existing Enduri and Poda pitha stories. Save a dish now; confirm the version and availability when you visit.'}</p><a href="/food/">Explore all food & flavours →</a></div><div class="table-more">{onward.map(p=><a href={'/food/'+p.slug+'/'}><ResponsiveImage {...Object.fromEntries(['src','alt','width','height'].map(k=>[k,foods.assets[p.hero][k]]))} loading="lazy"/><strong>{p.title} →</strong></a>)}</div></section>
<section class="table-contribute"><h2>{story.contribution_title||'What does home taste like to you?'}</h2><p>{story.contribution}</p><div class="actions"><a class="utk-button" href="/contribute/">Share a food memory →</a><a href="/journey/">Open my journey →</a></div></section>
{story.connections&&<nav class="table-connections" aria-label="Continue the food story">{story.connections.filter(c=>allowsPage(c.href)).map(c=><a href={c.href}>{c.title} →</a>)}</nav>}
<details class="mag-article-credits"><summary>Sources, image credits & editorial notes</summary><p>{story.limits} Each dish links to its own named sources. Human editorial and Odia review pending. Founder & Editor-in-Chief: Ahimanikya Satapathy.</p><ul>{credits.map(p=><li><a href={p.source}>{p.caption}</a> · {p.creator} · <a href={p.license_url}>{p.license}</a>. {p.changes}</li>)}</ul></details>
</div></div></Shell>
<style>
.table-connections{display:flex;gap:24px;flex-wrap:wrap;margin:32px 0}.table-body{padding:0 clamp(20px,4vw,64px) 48px}.table-intro{max-width:65ch;font-size:clamp(19px,2vw,24px);line-height:1.8;margin:48px 0 64px}.table-body h2{font-size:clamp(32px,3.5vw,52px);line-height:1.15}.table-body em{color:var(--earth)}.table-stories{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;margin-top:32px}.table-stories article{min-width:0;background:var(--paper);display:flex;flex-direction:column}.table-stories article>div{padding:24px;display:flex;flex-direction:column;flex:1}.table-picture{display:block}.table-picture img{display:block;width:100%;height:auto;aspect-ratio:1.3;object-fit:cover}.table-stories h3{font-size:clamp(25px,2.3vw,34px);line-height:1.2;margin:14px 0}.table-stories h3 a{text-decoration:none}.table-stories h3 a:hover{text-decoration:underline}.table-stories p{line-height:1.75}.table-stories :global(.journey-save){margin-top:auto;padding-top:16px}.table-conversation,.table-onward{display:grid;grid-template-columns:1fr 1fr;gap:48px;margin-top:64px;padding:40px 0;border-top:1px solid var(--line);align-items:center}.table-conversation ul{padding-left:24px}.table-conversation li{padding:12px 0;font-size:20px}.table-onward p{max-width:52ch;line-height:1.8}.table-more{display:grid;grid-template-columns:1fr 1fr;gap:20px}.table-more img{display:block;width:100%;height:auto;aspect-ratio:1;object-fit:cover}.table-more strong{display:block;padding-top:12px}.table-contribute{background:var(--paper);padding:clamp(24px,4vw,48px);margin:32px 0 48px}.table-contribute p{max-width:70ch;line-height:1.8}.table-contribute .actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap}.table-body section{scroll-margin-top:24px}@media(max-width:900px){.table-stories{gap:16px}.table-stories article>div{padding:18px}}@media(max-width:700px){.table-stories,.table-conversation,.table-onward{grid-template-columns:1fr}.table-conversation,.table-onward{gap:20px;margin-top:40px}.table-intro{margin:32px 0 40px}.table-picture img{aspect-ratio:1.5}.table-more{gap:12px}}
</style>
