---
const {id,name}=Astro.props;
---
<fieldset class="design-feedback" data-feedback-fields disabled><legend class="sr-only">Your view of {name}</legend><fieldset class="rating-scale"><legend>Would you buy this?</legend><div class="rating-options">{[1,2,3,4,5].map(n=><label><input type="radio" form="jhula-feedback" name={'rating-'+id} value={n} aria-label={'Likelihood of buying '+name+': '+n+' out of 5'}/><span>{n} ★</span></label>)}</div><p class="rating-hint">1 · Not for me &nbsp; 5 · Love it</p><div class="rating-actions"><button type="button" class="clear-rating" data-clear-rating={id}>Clear choice</button><p class="choice-save" data-save-status={id} role="status" aria-live="polite"></p></div></fieldset><label class="favourite-option"><input type="radio" form="jhula-feedback" name="favourite" value={id}/> My favourite design</label><details class="comment-disclosure"><summary>Comment on this design <span>(optional)</span></summary><label class="design-comment"><span class="comment-label">Your comment on {name}</span><textarea form="jhula-feedback" name={'comment-'+id} maxlength="300" rows="3" placeholder="Colour, cloth, shape, or something you would change…"></textarea></label></details></fieldset>

<style>
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}
.design-feedback{margin:0;padding:20px 0 0;border:0;border-top:1px solid var(--line);min-width:0}
.rating-scale{margin:0;padding:0;border:0;min-width:0}
.rating-scale legend{padding:0;font-size:13px;line-height:1.5}
.rating-options{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:6px;max-width:280px;margin-top:12px}
.rating-options label{position:relative;cursor:pointer;min-width:0}
.rating-options input{position:absolute;opacity:0;width:1px;height:1px}
.rating-options span{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;height:44px;border:1px solid var(--sea);border-radius:3px;color:var(--sea);font-size:14px;white-space:nowrap}
.rating-options input:checked+span{background:var(--sea);color:#fff}
.rating-options input:focus-visible+span{outline:3px solid var(--earth);outline-offset:3px}
.rating-hint{font-size:12px;line-height:1.5;margin:8px 0 0}
.clear-rating{display:block;background:none;border:0;text-decoration:underline;color:var(--sea);cursor:pointer;padding:8px 0;min-height:44px;font-size:13px;text-align:left}
.favourite-option{display:flex;align-items:center;gap:10px;padding:8px 0;min-height:44px;box-sizing:border-box;font-size:14px;line-height:1.5;cursor:pointer}
.favourite-option input{width:18px;height:18px;margin:0;accent-color:var(--sea);flex-shrink:0}
.design-comment{display:block;font-size:14px;padding:0 0 4px}
.design-comment textarea{display:block;width:100%;box-sizing:border-box;background:#fffdf8;border:1px solid var(--line);border-radius:3px;padding:12px;font:inherit;line-height:1.6;margin-top:8px;resize:vertical}
.design-feedback:disabled{opacity:.65}
.rating-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;max-width:280px;min-height:44px}.choice-save{font-size:12px;line-height:1.5;color:var(--sea);margin:0;text-align:right}.choice-save:empty{display:none}
.comment-disclosure{border-top:1px solid var(--line);margin-top:12px}
.comment-disclosure summary{cursor:pointer;font-size:13px;line-height:1.5;min-height:44px;padding:12px 0;box-sizing:border-box}
.comment-disclosure summary span,.comment-label{font-size:12px;color:var(--muted)}
.comment-label{display:block;margin-top:4px}
</style>
