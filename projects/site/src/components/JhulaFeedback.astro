---
const {id,name}=Astro.props;
---
<fieldset class="design-feedback" data-feedback-fields disabled><legend>Your view of {name}</legend><fieldset class="rating-scale"><legend>Rating <span>(optional)</span></legend><div class="rating-options">{[1,2,3,4,5].map(n=><label><input type="radio" form="jhula-feedback" name={'rating-'+id} value={n} aria-label={n+' out of 5 for '+name}/><span>{n} ★</span></label>)}</div><p class="rating-hint">1 · Not for me &nbsp; 5 · Love it</p><button type="button" class="clear-rating" data-clear-rating={id}>Clear rating</button></fieldset><label class="favourite-option"><input type="radio" form="jhula-feedback" name="favourite" value={id}/> My favourite design</label><label class="design-comment">Comment on this design <span>(optional)</span><textarea form="jhula-feedback" name={'comment-'+id} maxlength="300" rows="3" placeholder="Colour, cloth, shape, or something you would change…"></textarea></label></fieldset>

<style>
.design-feedback{margin:22px 0 0;padding:18px 0 0;border:0;border-top:1px solid var(--line);min-width:0}.design-feedback>legend{font-family:Georgia,serif;font-size:21px;padding-top:15px}.rating-scale{border:0;padding:10px 0;margin:0;min-width:0}.rating-scale legend{font-size:15px}.rating-options{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.rating-options label{position:relative;cursor:pointer}.rating-options input{position:absolute;opacity:0;width:1px;height:1px}.rating-options span{display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;padding:5px;border:1px solid var(--sea);border-radius:3px;color:var(--sea);font-size:15px}.rating-options input:checked+span{background:var(--sea);color:#fff}.rating-options input:focus-visible+span{outline:3px solid var(--earth);outline-offset:3px}.rating-hint{font-size:12px!important;margin:7px 0}.clear-rating{background:none;border:0;text-decoration:underline;color:var(--sea);cursor:pointer;padding:10px 0;min-height:44px}.favourite-option{display:flex;align-items:center;gap:9px;padding:12px 0;min-height:44px;font-size:15px}.favourite-option input,.kit-preference input{width:19px;height:19px;accent-color:var(--sea);flex-shrink:0}.design-comment{display:block;font-size:15px}.design-comment span,.form-field span,.rating-scale legend span{font-size:12px;color:var(--muted)}.design-comment textarea,.form-field textarea,.form-field input{display:block;width:100%;box-sizing:border-box;background:#fffdf8;border:1px solid var(--line);border-radius:3px;padding:12px;font:inherit;margin-top:9px;resize:vertical}.design-feedback:disabled{opacity:.65}
</style>
