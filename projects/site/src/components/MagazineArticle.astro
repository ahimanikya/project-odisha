---
import ResponsiveImage from './ResponsiveImage.astro';
import VoicesParagraph from './VoicesParagraph.astro';
import MagazineContents from './MagazineContents.astro';
import MagazineCover from './MagazineCover.astro';
const {kind,title,subtitle,odia,eyebrow,deck,photo,caption,saveId,sections,links=[],footline,startLabel,chapterLabel,sectionPhotos={},voiceSources}=Astro.props;
const warmId=kind==='food'?'origin':'paraja';
const sectionLinks=id=>kind==='person'?links.filter(link=>id==='paraja'?link.href.includes('oup.com'):id==='listen'?!link.href.includes('oup.com'):false):[];
---
<div class:list={['utk-magazine','utk-magazine--'+kind,{'utk-magazine--maker':kind==='culture'}]}>
 <MagazineCover title={title} subtitle={subtitle} odia={odia} eyebrow={eyebrow} deck={deck} photo={photo} caption={caption} saveId={saveId} startHref={'#'+sections[0].id} startLabel={startLabel||(kind==='food'?'Meet the sweet':'Meet the writer')} footline={footline}/>
 <MagazineContents links={sections.map(section=>({href:'#'+section.id,label:section.title}))}/>
 <article class="mag-content">
  <div class="mag-article-chapters">{sections.map((section,index)=><section id={section.id} class:list={['mag-reading-section',{'mag-reading-section--warm':section.id===warmId}]}>
   <div><p class="eyebrow">{String(index+1).padStart(2,'0')} · {chapterLabel||(kind==='food'?'A taste of Odisha':'A literary life')}</p><h2>{section.title}</h2></div>
   <div>{sectionPhotos[section.id]&&<figure class="chapter-photo" style={section.photo_max_width?`max-width: ${section.photo_max_width}px`:undefined}><ResponsiveImage src={sectionPhotos[section.id].src} alt={sectionPhotos[section.id].alt} width={sectionPhotos[section.id].width} height={sectionPhotos[section.id].height} loading="lazy"/><figcaption>{sectionPhotos[section.id].caption}</figcaption></figure>}{section.paragraphs.map(p=>voiceSources?<VoicesParagraph paragraph={p} sources={voiceSources}/>:<p data-source-ids={p.source_ids.join(' ')}>{p.text}</p>)}
    {sectionLinks(section.id).length>0&&<div class="mag-section-links">{sectionLinks(section.id).map(link=><a href={link.href}>{link.title} ↗</a>)}</div>}
    {kind==='food'&&section.id==='try'&&<div class="mag-section-links">{links.map(link=><div><a href={link.href}>{link.title} →</a>{link.reason&&<p class="connection-reason">{link.reason}</p>}</div>)}</div>}
   </div>
  </section>)}</div>
  <slot/>
 </article>
</div>

<style>.chapter-photo{margin:0 0 2rem}.chapter-photo img{display:block;width:100%;height:auto}.chapter-photo figcaption{font-size:14px;line-height:1.6;color:var(--muted);margin-top:12px}.connection-reason{font-size:14px!important;line-height:1.65;margin:0 0 12px;color:var(--muted)}</style>
