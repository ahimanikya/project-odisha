---
import ArticleByline from './ArticleByline.astro';
import ArticleFootnote from './ArticleFootnote.astro';
import ArticleFootnotes from './ArticleFootnotes.astro';
import chilikaEditorial from '../../../../kb/research/destinations/chilika-editorial.json';
import konarkEditorial from '../../../../kb/research/destinations/konark-editorial.json';
import VisitReadiness from './VisitReadiness.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import MagazineContents from './MagazineContents.astro';
import VisitNotebook from './VisitNotebook.astro';
import {allowsPage,isCoastalEdition} from '../data/edition';
import CollectionOnward from './CollectionOnward.astro';
import SaveJourney from './SaveJourney.astro';
import StorySources from './StorySources.astro';
import PhotoJourney from './PhotoJourney.astro';
import CultureConnections from './CultureConnections.astro';
import MagazineCover from './MagazineCover.astro';
import layouts from '../../../../kb/research/stories/magazine-layouts.json';
const {entry,story,destination:d,sources,evidenceUses}=Astro.props;
const layout=layouts[entry.slug];
const editorial=entry.slug==='konark'?konarkEditorial:entry.slug==='chilika'?chilikaEditorial:null;
const foodLead=d.foods.find(item=>item.id===layout.foodLead);
const foodOthers=d.foods.filter(item=>item.id!==layout.foodLead);
const chapterId=story.voice?'poems-songs':'history';
---
<div class:list={["utk-magazine",{"place-editorial":!!editorial}]}>
  <MagazineCover title={layout.title} odia={layout.odia} eyebrow={layout.eyebrow} deck={layout.deck} photo={story.image} caption={story.image.short_caption||story.image.caption} saveId={d.id} startHref={'#'+chapterId} startLabel="Read the story" footline={layout.footline}>{editorial&&<ArticleByline slot="byline" author={editorial.author}/>}</MagazineCover>
  <MagazineContents links={[{href:"#"+chapterId,label:"The story"},{href:"#things-to-do",label:layout.choicesLabel},...(story.history?[{href:"#poems-songs",label:"Culture & stories"}]:[]),{href:"#food",label:"At the table"},{href:"#plan-visit",label:"Plan a visit"},{href:"#visit-notebook",label:"Visit notebook"},...(editorial?[{href:"#story-sources",label:"Footnotes & Sources"}]:[])]}/>
  <article class="mag-content">
    <section class:list={['mag-chapter mag-story',{'mag-story--history':!!story.history,'mag-story--voice':!!story.voice&&!!editorial}]} id={chapterId} aria-labelledby="mag-story-title" data-source-ids={(story.voice?.sources||story.history.sources).join(' ')}>
      <div class="mag-chapter-label" aria-hidden="true"><span>01</span><p class="eyebrow">{layout.storyKicker}</p></div>
      <div class="mag-story-copy">
        <h2 id="mag-story-title">{layout.storyTitle[0]}<br/><em>{layout.storyTitle[1]}</em></h2>
        <p class="mag-reading">{story.opening}</p>
        {story.voice&&<><blockquote><p lang={story.voice.language}>{story.voice.original}</p><p class="mag-translation">{story.voice.translation}</p><footer>{story.voice.author} · <cite>{story.voice.work}</cite></footer></blockquote><p class="mag-context">{story.voice.context}{editorial&&<ArticleFootnote ids={story.voice.sources} sources={editorial.sources} passage="voice"/>}</p></>}
        {story.history&&<p class="mag-reading">{story.history.text}{editorial&&<ArticleFootnote ids={story.history.sources} sources={editorial.sources} passage="history"/>}</p>}
        <details class="mag-disclosure" id={story.voice?undefined:'poems-songs'}><summary>{story.culture_heading||'Poems and songs to explore'}</summary>{d.culture.map((work,i)=><article id={work.id.replaceAll(':','-')} data-source-ids={work.sources.join(' ')}><h3>{work.title}</h3><p>{work.text}{editorial&&<ArticleFootnote ids={work.sources} sources={editorial.sources} passage={`culture-${i}`}/>}</p>{entry.slug==='chilika'&&work.type==='song'&&<p class="mag-note">{work.credit}</p>}<a href={entry.slug==='chilika'?work.url:editorial?.sources.find(s=>s.id===work.sources[0])?.url||work.url}>{work.link_label} ↗</a></article>)}</details>
      </div>
      {story.voice?<figure><ResponsiveImage src={d.visuals.mangalajodi.src} alt={d.visuals.mangalajodi.alt} width={d.visuals.mangalajodi.width} height={d.visuals.mangalajodi.height} loading="lazy"/><figcaption>{d.visuals.mangalajodi.caption}</figcaption></figure>:<aside class="mag-history-note" id={story.surprise.id} data-source-ids={story.surprise.sources.join(' ')}><p class="eyebrow">Look a little closer</p><h3>{story.surprise.heading}</h3><dl class="mag-metrics">{story.surprise.metrics.map(m=><div><dt>{m.label}</dt><dd>{m.value}</dd></div>)}</dl><p>{story.surprise.text}{editorial&&<ArticleFootnote ids={story.surprise.sources} sources={editorial.sources} passage="detail"/>}</p><details class="mag-disclosure"><summary>{story.surprise.reveal_label}</summary><p>{story.surprise.reveal}</p></details></aside>}
    </section>
    <section class="mag-chapter mag-shores" id="things-to-do" aria-labelledby="mag-shores-title">
      <div class="mag-section-heading"><div><p class="eyebrow">{layout.choicesKicker}</p><h2 id="mag-shores-title">{layout.choicesTitle[0]}<br/><em>{layout.choicesTitle[1]}</em></h2></div><p>{layout.choicesIntro} <a href="#stay">Choose where to stay →</a></p></div>
      <div class="mag-shore-grid" id="places-within">{d.experiences.map((item,index)=>{const photoRef=item.image_ref||layout.experienceImages[item.id];const photo=photoRef?d.visuals[photoRef]:story.image;return <article class="mag-shore" id={item.id.replaceAll(':','-')} data-source-ids={item.sources.join(' ')}>
        <figure><ResponsiveImage src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy"/><figcaption>{photoRef?photo.caption:layout.heroReuseCaption}</figcaption></figure>
        <div><p class="eyebrow">{item.area}</p><h3>{layout.experienceTitles[item.id]||item.title}</h3><p>{item.text}{editorial&&<ArticleFootnote ids={item.sources} sources={editorial.sources} passage={`experience-${index}`}/>}</p>{allowsPage(item.detail_href)&&<a class="mag-detail-link" href={item.detail_href}>{item.title} ↗</a>}{item.place_href&&allowsPage(item.place_href)&&<a class="mag-detail-link" href={item.place_href}>{item.place_label} →</a>}<SaveJourney id={item.id} quiet /></div>
      </article>})}</div>
      <details class="mag-disclosure mag-belief" id="local-belief" data-source-ids={story.belief.sources.join(' ')}><summary>{story.belief.heading} · local legend</summary><p class="eyebrow">{story.belief.label}</p><p>{story.belief.text}</p><p>{story.belief.qualification}{editorial&&<ArticleFootnote ids={story.belief.sources} sources={editorial.sources} passage="belief"/>}</p></details>
    </section>
    <section class="mag-chapter mag-food" id="food" aria-labelledby="mag-food-title">
      <figure><ResponsiveImage src={d.visuals[d.food_image_ref].src} alt={d.visuals[d.food_image_ref].alt} width={d.visuals[d.food_image_ref].width} height={d.visuals[d.food_image_ref].height} loading="lazy"/><figcaption>{d.visuals[d.food_image_ref].caption}</figcaption></figure>
      <div><p class="eyebrow">At the table</p><h2 id="mag-food-title">{layout.foodTitle[0]}<br/><em>{layout.foodTitle[1]}</em></h2>
        <div class="mag-food-lead" id={foodLead.id.replaceAll(':','-')} data-source-ids={foodLead.sources.join(' ')}><h3>{foodLead.title}</h3><p class="mag-reading">{foodLead.text}{editorial&&<ArticleFootnote ids={foodLead.sources} sources={editorial.sources} passage="food-lead"/>}</p>{foodLead.detail_href&&allowsPage(foodLead.detail_href)&&<a class="mag-detail-link" href={foodLead.detail_href}>Read the food story ↗</a>}<SaveJourney id={foodLead.id} quiet /></div>
        <details class="mag-disclosure"><summary>{layout.moreFoodLabel}</summary>{foodOthers.map(item=><article id={item.id.replaceAll(':','-')} data-source-ids={item.sources.join(' ')}><h3>{item.title}</h3><p>{item.text}{editorial&&<ArticleFootnote ids={item.sources} sources={editorial.sources} passage={`food-${d.foods.indexOf(item)}`}/>}</p>{item.detail_href&&allowsPage(item.detail_href)&&<a class="mag-detail-link" href={item.detail_href}>Read the food story ↗</a>}<SaveJourney id={item.id} quiet /></article>)}</details>
        <p class="mag-note">{d.food_note}</p>
        {['konark','chilika'].includes(entry.slug)&&allowsPage('/food/where-to-eat/')&&<p><a class="mag-detail-link" href={'/food/where-to-eat/#'+entry.slug}>Find a place to eat around {entry.label} →</a></p>}
      </div>
    </section>
    <section class="mag-chapter mag-visit" id="plan-visit" aria-labelledby="mag-visit-title">
      <div><p class="eyebrow">{layout.planKicker}</p><h2 id="mag-visit-title">{layout.planTitle[0]}<br/><em>{layout.planTitle[1]}</em></h2><p class="mag-reading" data-source-ids={d.orientation_sources.join(' ')}>{d.orientation}{entry.slug==='chilika'&&<ArticleFootnote ids={d.orientation_sources} sources={editorial.sources} passage="orientation"/>}</p><a class="utk-button" href="/journey/">Open my journey →</a>{d.journey_starter&&allowsPage(d.journey_starter.href)&&<p><a href={d.journey_starter.href}>{d.journey_starter.title} →</a></p>}</div>
      <div class="mag-visit-notes">
        <section data-source-ids={d.season_sources.join(' ')}><h3>When</h3><p>{d.season}{editorial&&<ArticleFootnote ids={d.season_sources} sources={editorial.sources} passage="season"/>}</p></section>
        <section id="locals" data-source-ids={d.community.sources.join(' ')}><h3>With whom</h3><p>{d.community.text}{entry.slug==='chilika'&&<ArticleFootnote ids={d.community.sources} sources={editorial.sources} passage="community"/>}</p></section>
        <section id="stay"><h3>Stay</h3><div><p>{d.stay_note}</p><details class="mag-disclosure"><summary>Explore the stay areas</summary>{d.bases.map((item,i)=><article id={item.id.replaceAll(':','-')} data-source-ids={item.sources.join(' ')}><h4>{item.title}</h4><p>{item.text}{entry.slug==='chilika'&&<ArticleFootnote ids={item.sources} sources={editorial.sources} passage={`base-${i}`}/>}</p><a href={allowsPage(item.detail_href)?item.detail_href:'/visit/stays/puri-coast/'}>Explore this stay area ↗</a><SaveJourney id={item.id} quiet /></article>)}</details></div></section>
      </div>
    </section>
   <VisitNotebook editorial={editorial}/>
   <VisitReadiness/>
    <div class="mag-further">
      <details class="mag-disclosure" id="expectations"><summary>Good to know before you go</summary><h3>{d.expectations.heading}</h3><dl>{[['A good fit for',d.expectations.strength],['Plan around',d.expectations.constraint],['Do',d.expectations.do],['Avoid',d.expectations.avoid]].map(([title,text])=><div><dt>{title}</dt><dd>{text}</dd></div>)}</dl><h3>{d.planning.heading}</h3><p>{d.planning.text}</p></details>
      <details class="mag-disclosure" id={layout.recordAnchor}><summary>{layout.recordLabel}</summary>{entry.paragraphs.map((p,i)=><p class="knowledge-text" id={'fact-'+(i+1)} data-source-ids={p.sources.join(' ')}>{p.text}{editorial&&<ArticleFootnote ids={p.sources} sources={editorial.sources} passage={`record-${i}`}/>}</p>)}{story.voice&&<section id="ecology" data-source-ids={story.surprise.sources.join(' ')}><h3>{story.surprise.heading}</h3><dl class="mag-metrics">{story.surprise.metrics.map(m=><div><dt>{m.label}</dt><dd>{m.value}</dd></div>)}</dl><p>{story.surprise.text}{editorial&&<ArticleFootnote ids={story.surprise.sources} sources={editorial.sources} passage="detail"/>}</p><details><summary>{story.surprise.reveal_label}</summary><p>{story.surprise.reveal}</p></details></section>}</details>
      {(!isCoastalEdition||entry.slug==='chilika')&&<details class="mag-disclosure"><summary>Take a photographic journey around {layout.title}</summary><PhotoJourney destination={d} story={story}/></details>}
      <details class="mag-disclosure"><summary>Keep reading · places, language and literature</summary><CultureConnections path={'/knowledge/'+entry.slug+'/'} /><div class="mag-reading-links">{d.related.filter(item=>allowsPage(item.href)).map(item=><div><h3><a href={item.href}>{item.title} →</a></h3><p>{item.text}</p></div>)}</div></details>
    </div>
    {entry.slug==='konark'&&<CollectionOnward path="/knowledge/konark/"/>}
    {editorial?<ArticleFootnotes sources={editorial.sources} passages={editorial.passages}><div class="place-photo-credits"><h3>Photographs</h3>{[story.image,...Object.values(d.visuals)].map(photo=><p><a href={photo.source}>{photo.title}</a> by {photo.creator} · <a href={photo.license_url}>{photo.license}</a>. {photo.changes} {photo.date&&<>Photograph dated {photo.date}. </>}{photo.caption}</p>)}</div></ArticleFootnotes>:<><StorySources story={story} destination={d} sources={sources} evidenceUses={evidenceUses}/><p class="mag-status">Editorial draft · awaiting Founder review.</p></>}
  </article>
</div>

<script>
import {bindStorySourceLinks} from '../lib/story-source-links.mjs';
document.querySelectorAll('.place-editorial sup, .place-editorial .article-footnotes').forEach(group=>bindStorySourceLinks(group,document));
</script>
<style is:global>
.utk .utk-magazine.place-editorial .mag-shore .mag-detail-link{display:block;width:fit-content;margin-block:1rem}

.utk .utk-magazine.place-editorial .mag-story--voice h2{margin-bottom:1em}
.utk .utk-magazine.place-editorial .mag-story--voice h3{margin-bottom:.65em}
.utk .utk-magazine.place-editorial .mag-story--voice blockquote{margin-block:1.5em}

.utk .utk-magazine.place-editorial .mag-chapter-label{display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem;padding-top:1rem}
.utk .utk-magazine.place-editorial .mag-chapter-label p{writing-mode:horizontal-tb;margin:0}

.utk .utk-magazine.place-editorial .mag-story--voice,.utk .utk-magazine.place-editorial .mag-story--history{display:block;max-width:740px;margin-inline:auto}
.utk .utk-magazine.place-editorial .mag-story-copy,.utk .utk-magazine.place-editorial .mag-history-note{max-width:740px}
.utk .utk-magazine.place-editorial .mag-history-note{margin-top:2.5rem;padding:1.5rem 0;border-top:1px solid var(--line)}
.utk .utk-magazine.place-editorial .mag-story p:not(.eyebrow),.utk .utk-magazine.place-editorial .mag-belief p:not(.eyebrow){font-size:18px;line-height:1.85;margin:0 0 1.25em}
.utk .utk-magazine.place-editorial .mag-belief{max-width:740px;margin-inline:auto}
.utk .utk-magazine.place-editorial .article-footnotes{max-width:740px;margin:4rem auto;font-size:16px;line-height:1.8;border-top:1px solid var(--line);padding-top:2rem}
.utk .utk-magazine.place-editorial .article-footnotes h2{font-size:30px;line-height:1.3;margin-bottom:1.5rem}
.utk .utk-magazine.place-editorial .article-footnotes ol{padding-left:1.5rem}
.utk .utk-magazine.place-editorial .article-footnotes li{margin-bottom:1.25em;scroll-margin-top:2rem;overflow-wrap:anywhere}
.utk .utk-magazine.place-editorial .place-photo-credits p{margin:0 0 1.25em;font-size:15px;line-height:1.8}
.utk .utk-magazine.place-editorial sup{font-size:.7em;line-height:0;vertical-align:super;margin-left:.12em}
.utk .utk-magazine.place-editorial a[data-footnote-ref],.utk .utk-magazine.place-editorial a[data-footnote-backref]{padding:.2em .15em;text-decoration:none;color:var(--sea)}
.utk .utk-magazine.place-editorial a:focus-visible{outline:2px solid var(--earth);outline-offset:3px}
.utk .utk-magazine.place-editorial img{object-fit:contain;aspect-ratio:auto;height:auto}
@media(max-width:600px){.utk .utk-magazine.place-editorial .mag-story p:not(.eyebrow),.utk .utk-magazine.place-editorial .mag-belief p:not(.eyebrow){font-size:17px;line-height:1.8}}
</style>
