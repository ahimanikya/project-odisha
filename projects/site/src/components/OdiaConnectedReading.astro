---
import ArticleReadingPath from './ArticleReadingPath.astro';
const {current} = Astro.props;
const articles = [{"slug": "odia-cultural-identity", "image": "/images/stories/odia-identity-passing-on-culture.webp", "title": "Odia Cultural Identity and Pride", "description": "Know, use and pass on our language and living traditions."}, {"slug": "rise-children-of-utkal", "image": "/images/stories/community-learning-circle.png", "title": "Rise, Children of Utkal — ଉଠରେ ଉଠରେ ଉତ୍କଳ ସନ୍ତାନ", "description": "Turn encouragement into action using what we know, have and can do together."}, {"slug": "a-place-to-learn-together", "image": "/images/stories/shared-reading-circle.png", "title": "A Place to Learn Together — ଆସନ୍ତୁ ଏକାଠି ଶିଖିବା", "description": "Give shared learning a regular place, willing people and a next meeting."}];
---
<ArticleReadingPath class="connected-reading" links={articles.filter(a => a.slug !== current).map(a => ({href: `/stories/${a.slug}/`, title: a.title, description: a.description, image: a.image}))} intro="These three essays move from carrying culture into everyday life, to taking initiative, to creating a place where people can learn together."/>
