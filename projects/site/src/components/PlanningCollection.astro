---
import FoodDiscovery from './FoodDiscovery.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import PlanningPaths from './PlanningPaths.astro';
import Shell from '../layouts/Shell.astro';
import SaveJourney from './SaveJourney.astro';
import {allowsPage} from '../data/edition';
const {collection:c}=Astro.props;
const photos=[...new Map(c.entries.filter(e=>e.photo).map(e=>[e.photo.src,e.photo])).values()];
const areaOrder=['Bhubaneswar','Cuttack','Puri & Konark','Chilika','Balasore','Mayurbhanj','Odisha'];
const coverId={food:'food:konark-chhena-poda','things-to-do':'experience:mayurbhanj-chhau','stay-areas':'stay:balasore-coast'}[c.slug];
const cover=c.entries.find(e=>e.id===coverId&&e.photo)||c.entries.find(e=>e.photo);
const groups=[...new Set(c.entries.map(e=>e.group))].sort((a,b)=>areaOrder.indexOf(a)-areaOrder.indexOf(b)).map((area,index)=>({area,id:'area-'+area.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/-$/,''),entries:c.entries.filter(e=>e.group===area)}));
---
<Shell title={c.title} description={c.lead} active="explore" wide related={false}><div class="wrap planning-collection">
<header class="page-head planning-opening"><div><p class="eyebrow">{c.title} · {c.entries.length} ideas in the collection</p><h1>{c.headline}<br/><em class="highlight">{c.highlight}</em></h1><p class="lead">{c.lead}</p></div>{cover&&<figure><ResponsiveImage src={cover.photo.src} width={cover.photo.width} height={cover.photo.height} alt={cover.photo.alt} style={{objectFit:cover.photoFit}} fetchpriority="high"/><figcaption>{cover.photoNote||cover.photo.caption}</figcaption></figure>}</header>
{c.slug==='things-to-do'&&allowsPage('/crafts/')&&<p class="planning-note"><a href="/crafts/">Made by hand in Odisha →</a> Look closely at Pipili appliqué, Pattachitra and Cuttack’s Tarakasi before arranging a maker visit.</p>}
{c.slug==='things-to-do'&&allowsPage('/textiles/')&&<p class="planning-note"><a href="/textiles/">Woven in Odisha →</a> Begin with Bandha, Khandua, Kotpad and Tasar, then plan a conversation with a weaver.</p>}
<PlanningPaths current={'/'+c.slug+'/'}/>
{c.slug==='food'&&<FoodDiscovery/>}
<p class="planning-note">{c.note}</p>
<nav class="area-links" aria-label="Jump to an area">{groups.map(g=><a href={'#'+g.id}>{g.area} <span>({g.entries.length})</span></a>)}</nav>
{groups.map(g=><section class="planning-area" id={g.id} aria-labelledby={g.id+'-heading'}><header><p class="eyebrow">{g.entries.length} {g.entries.length===1?'idea':'ideas'} to make your own</p><h2 id={g.id+'-heading'}>{g.area}</h2></header><div class="planning-cards">{g.entries.map(i=><article class="utk-card planning-card">
{i.photo&&<figure><ResponsiveImage src={i.photo.src} width={i.photo.width} height={i.photo.height} alt={i.photo.alt} style={{objectFit:i.photoFit}} loading="lazy" sizes="(max-width: 700px) 92vw, (max-width: 1050px) 44vw, 30vw"/>{i.photoNote&&<figcaption>{i.photoNote}</figcaption>}</figure>}
<div class="planning-copy"><p class="eyebrow">{i.area}</p><h3><a href={i.href}>{i.title} ↗</a></h3><p>{i.summary}</p><SaveJourney id={i.id} quiet/></div></article>)}</div></section>)}
<section class="planning-questions"><div><p class="eyebrow">Make it useful</p><h2>Before you decide</h2></div><div><ul>{c.questions.map(q=><li>{q}</li>)}</ul><div class="actions"><a class="button utk-button" href="/journey/#preparation">Open my journey checklist →</a><a class="text-link" href="/journey-starters/">Start with a few connected ideas →</a></div></div></section>
<details class="utk-disclosure planning-credits"><summary>Sources, photographs & research notes</summary><p>These selections reuse the Project Odisha knowledge collection. Each linked entry retains its sources and checked date. Local conditions and individual arrangements still need confirmation.</p><ul>{photos.map(p=><li><a href={p.source}>{p.caption||p.alt}</a> · {p.creator} · <a href={p.license_url}>{p.license}</a>. {p.changes}</li>)}</ul></details>
</div></Shell>
<style>
.planning-collection{padding-bottom:50px}.planning-opening{max-width:none;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:40px;padding-bottom:40px}.planning-opening figure{margin:0}.planning-opening img{display:block;width:100%;height:auto;aspect-ratio:1.6;background:var(--paper);object-fit:cover}.planning-opening figcaption{font-size:12px;line-height:1.6;margin-top:12px;color:var(--muted)}.planning-opening h1{font-size:clamp(42px,4.8vw,72px)}.planning-note{max-width:75ch;color:var(--muted);font-size:16px;line-height:1.75;margin:0 0 20px}.area-links{display:flex;flex-wrap:wrap;gap:4px 24px;margin-bottom:32px}.area-links a{display:inline-flex;align-items:center;min-height:44px;gap:6px}.area-links span{font-size:13px;color:var(--muted)}.planning-area{scroll-margin-top:24px;padding:32px 0 48px;border-top:1px solid var(--line)}.planning-area h2{font-size:clamp(32px,3.2vw,46px);margin:12px 0 28px}.planning-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}.planning-card{background:var(--paper);min-width:0;display:flex;flex-direction:column}.planning-card:only-child{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr}.planning-card:only-child:not(:has(figure)){display:block}.planning-card:only-child:not(:has(figure)) .planning-copy{max-width:75ch}.planning-card:only-child img{height:100%;min-height:260px}.planning-card figure{margin:0}.planning-card img{display:block;width:100%;height:auto;aspect-ratio:1.6;object-fit:cover}.planning-card figcaption{font-size:12px;line-height:1.6;padding:12px 24px;border-bottom:1px solid var(--line)}.planning-copy{padding:26px;display:flex;flex-direction:column;flex:1}.planning-card h3{font-size:clamp(27px,2.3vw,34px);line-height:1.25;margin:16px 0;overflow-wrap:anywhere}.planning-card h3 a{text-decoration:none}.planning-card h3 a:hover{text-decoration:underline}.planning-copy>p:not(.eyebrow){font-size:17px;line-height:1.75;margin-bottom:20px}.planning-copy :global(.journey-save){margin-top:auto;padding-top:12px}.planning-copy :global([data-active-journey]){font-size:12px}.planning-copy :global(button){white-space:normal;max-width:100%;text-align:left}.planning-questions{display:grid;grid-template-columns:1fr 1.3fr;gap:40px;background:var(--paper);padding:32px;margin:16px 0 44px}.planning-questions h2{font-size:clamp(30px,3vw,44px);margin-top:15px}.planning-questions ul{padding-left:22px;margin-bottom:28px}.planning-questions li{margin:12px 0}.planning-credits{font-size:13px;overflow-wrap:anywhere}.planning-credits summary{padding:14px 0}.planning-credits li{margin:14px 0}@media(max-width:1050px){.planning-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:800px){.planning-opening{grid-template-columns:1fr;gap:24px}.planning-opening h1{font-size:clamp(40px,9vw,64px)}}@media(max-width:650px){.planning-cards,.planning-questions,.planning-card:only-child{grid-template-columns:1fr}.planning-card:only-child img{min-height:0;height:auto}.planning-questions{padding:24px;gap:18px}.planning-area{padding-block:28px 36px}.planning-copy{padding:24px}}
</style>
