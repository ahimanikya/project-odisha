---
import {allowsPage} from '../data/edition';
const {current=''}=Astro.props;
const paths=[['/events/arts-literature/','Arts & literature calendar'],['/destinations/','Destinations'],['/food/','Food & flavours'],['/things-to-do/','Things to do'],['/stay-areas/','Stay areas'],['/journey-starters/','Journey starters']].filter(([href])=>allowsPage(href));
---
<nav class="planning-paths" aria-label="Plan your visit">{paths.map(([href,label])=><a href={href} aria-current={current===href?'page':undefined}>{label}</a>)}</nav>
<style>
.planning-paths{display:flex;flex-wrap:wrap;gap:4px 28px;border-block:1px solid var(--line);padding:10px 0;margin:0 0 32px}.planning-paths a{min-height:48px;display:inline-flex;align-items:center;text-underline-offset:5px}.planning-paths a[aria-current]{color:var(--earth);font-weight:700;text-decoration-thickness:2px}@media(max-width:600px){.planning-paths{gap:0 20px;font-size:14px}}
</style>
