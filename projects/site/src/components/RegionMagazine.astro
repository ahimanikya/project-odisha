---
import ArticleByline from './ArticleByline.astro';
import ArticleFootnote from './ArticleFootnote.astro';
import ArticleFootnotes from './ArticleFootnotes.astro';
import mayurbhanjEditorial from '../../../../kb/research/destinations/mayurbhanj-editorial.json';
import balasoreEditorial from '../../../../kb/research/destinations/balasore-editorial.json';
import cuttackEditorial from '../../../../kb/research/destinations/cuttack-editorial.json';
import puriEditorial from '../../../../kb/research/destinations/puri-editorial.json';
import bhubEditorial from '../../../../kb/research/destinations/bhubaneswar-editorial.json';
import notebooks from '../../../../kb/research/destinations/visit-notebooks.json';
import DestinationLanguages from './DestinationLanguages.astro';
import VisitReadiness from './VisitReadiness.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import MagazineContents from './MagazineContents.astro';
import VisitNotebook from './VisitNotebook.astro';
import editionCopy from '../../../../kb/research/destinations/coastal-edition-copy.json';
import {isCoastalEdition,allowsIdea,allowsPage} from '../data/edition';
import CollectionOnward from './CollectionOnward.astro';
import {collectionChapter} from '../data/reading-collection';
import MagazineCover from './MagazineCover.astro';
import SaveJourney from './SaveJourney.astro';
import CultureConnections from './CultureConnections.astro';
import {cultureTrailsFor} from '../data/culture-trails';
import data from '../../../../kb/research/destinations/regions.json';
import '../styles/region-magazine.css';
import connections from '../../../../kb/research/related-discoveries.json';
import {discoveryEntries} from '../data/discovery';
const r=structuredClone(Astro.props.region);
// The coastal edition already publishes the canonical Santali reading item.
const itemSaveId=i=>isCoastalEdition&&r.slug==='mayurbhanj'&&i.id==='reading:mayurbhanj-ol-chiki'?'reading:languages/santali':i.id;
if(isCoastalEdition){
 r.items=r.items.filter(i=>allowsIdea(i.id)||(r.slug==='mayurbhanj'&&i.id==='reading:mayurbhanj-ol-chiki'&&allowsIdea(itemSaveId(i))&&i.link&&allowsPage(i.link.href)));
 if(r.slug==='bhubaneswar'){
  r.orientation=editionCopy.bhubaneswar.orientation;
  r.sections.find(s=>s.id==='stories').paragraphs[0].text=editionCopy.bhubaneswar.story[0];
  r.sections.find(s=>s.id==='stories').paragraphs[1].text=editionCopy.bhubaneswar.story[1];
 }
}
const isBalasore=r.slug==='balasore';
const isMayurbhanj=r.slug==='mayurbhanj';
const narrativeRegion=isBalasore||isMayurbhanj;
const editorial=isMayurbhanj?mayurbhanjEditorial:isBalasore?balasoreEditorial:r.slug==='bhubaneswar'?bhubEditorial:r.slug==='puri'?puriEditorial:r.slug==='cuttack'?cuttackEditorial:null;
const passages=editorial?[
 ...r.sections.flatMap(section=>section.paragraphs.map((p,n)=>({id:`${section.id}-${n}`,source_ids:p.source_ids}))),
 ...r.items.map(i=>({id:i.id.replaceAll(':','-'),source_ids:i.source_ids})),
 ...(r.visitor_notes||[]).map((p,n)=>({id:`visitor-${n}`,source_ids:p.source_ids})),
 ...r.facts.map((p,n)=>({id:`fact-${n}`,source_ids:p.source_ids})),
 ...editorial.notebook_passages
]:[];
const inCollection=collectionChapter(`/destinations/${r.slug}/`)>=0;
const hero=(r.slug==='cuttack'||narrativeRegion)?{...data.assets[r.hero],fit:'contain'}:data.assets[r.hero],story=r.sections.find(s=>s.id==='stories');
const photos=[...new Set([r.hero,...r.items.map(i=>i.asset).filter(Boolean)])].map(id=>data.assets[id]);
const openingSections=narrativeRegion?r.sections.filter(s=>s.id!=='before-you-go'):[story];
const sourceIds=[...new Set([...r.source_ids,...r.facts.flatMap(f=>f.source_ids),...r.items.flatMap(i=>i.source_ids),...r.sections.flatMap(s=>s.paragraphs.flatMap(p=>p.source_ids)),...(r.visitor_notes||[]).flatMap(n=>n.source_ids)])];
const hasNotebook=notebooks.notebooks.some(n=>n.route===`/destinations/${r.slug}/`);
const pictured=r.items.filter(i=>i.asset),other=r.items.filter(i=>!i.asset),next=data.regions.find(region=>region.slug===r.next);
const further=connections.links.filter(link=>allowsPage(link.to)&&link.from===`/destinations/${r.slug}/`&&!r.items.some(i=>i.link?.href===link.to)&&link.to!==`/destinations/${next.slug}/`).map(link=>({...link,title:discoveryEntries.find(e=>e.href===link.to)?.label||link.to}));
---
<div class:list={["utk-magazine utk-magazine--region",{"region-editorial":!!editorial}]}>
 <MagazineCover title={r.title} odia={r.odia} eyebrow={r.kicker} deck={[r.headline]} photo={hero} saveId={r.id} startHref="#stories" startLabel="Meet the place" footline={r.lead}>{editorial&&<ArticleByline slot="byline" author={editorial.author}/>}</MagazineCover>
 <MagazineContents label="In this guide" links={[...(narrativeRegion?openingSections.map(s=>({href:`#${s.id}`,label:s.title})):[{href:"#stories",label:"The story"}]),{href:"#choose-your-stops",label:"Places & experiences"},...(other.length>0?[{href:"#make-it-yours",label:"Food & your own pace"}]:[]),{href:"#before-you-go",label:"Before you go"},...(hasNotebook?[{href:"#visit-notebook",label:"Visit notebook"}]:[]),{href:"#local-languages",label:"Local languages"},...(['puri','cuttack','balasore','mayurbhanj'].includes(r.slug)?[{href:"#story-sources",label:"Footnotes & Sources"}]:[])]}/>
 <article class="mag-content">
  {openingSections.map((section,index)=><section id={section.id} class="mag-reading-section region-story-opening"><div><p class="eyebrow">{narrativeRegion?`${String(index+1).padStart(2,'0')} · Read the place`:'01 · Find the thread'}</p><h2>{section.title}</h2></div><div>{section.paragraphs.map((p,n)=><p data-source-ids={p.source_ids.join(' ')}>{p.text}{editorial&&<ArticleFootnote ids={p.source_ids} sources={editorial.sources} passage={`${section.id}-${n}`}/>}</p>)}</div></section>)}
  <section id="choose-your-stops" class="mag-chapter"><div class="mag-section-heading"><div><p class="eyebrow">{narrativeRegion?'Choose your visit':'02 · A few places to begin'}</p><h2>Choose a few.<br/><em>Leave room to linger.</em></h2></div><p>{r.orientation}</p></div>
   <div class="region-picture-grid">{pictured.map(i=><article id={i.id.replaceAll(':','-')} class="mag-shore"><figure><ResponsiveImage src={data.assets[i.asset].src} width={data.assets[i.asset].width} height={data.assets[i.asset].height} alt={data.assets[i.asset].alt} loading="lazy" class:list={{'region-contain':r.slug==='cuttack'||narrativeRegion||['script','fakir'].includes(i.asset)||data.assets[i.asset].fit==='contain'}}/><figcaption>{data.assets[i.asset].caption}</figcaption></figure><div><p class="eyebrow">{i.kind}</p><h3>{i.title}</h3><p>{i.summary}{editorial&&<ArticleFootnote ids={i.source_ids} sources={editorial.sources} passage={i.id.replaceAll(':','-')}/>}</p><p class="region-suggestion">{i.tip}</p>{i.link&&allowsPage(i.link.href)&&<a class="mag-detail-link" href={i.link.href}>{i.link.title} →</a>}<SaveJourney id={itemSaveId(i)} quiet/></div></article>)}</div>
  </section>
  {other.length>0&&<section id="make-it-yours" class="region-own-pace"><div><p class="eyebrow">{narrativeRegion?'Make it yours':'03 · Make it yours'}</p><h2>A meal. A meeting.<br/><em>A little breathing room.</em></h2><p>Save the ideas that fit your interests. Choose the pace and the arrangements yourself.</p></div><div>{other.map(i=><article id={i.id.replaceAll(':','-')}><p class="eyebrow">{i.kind}</p><h3>{i.title}</h3><p>{i.summary}{editorial&&<ArticleFootnote ids={i.source_ids} sources={editorial.sources} passage={i.id.replaceAll(':','-')}/>}</p><p class="region-suggestion">{i.tip}</p>{i.link&&allowsPage(i.link.href)&&<a class="mag-detail-link" href={i.link.href}>{i.link.title} →</a>}<SaveJourney id={itemSaveId(i)} quiet/></article>)}</div></section>
  }
  {r.sections.filter(s=>narrativeRegion?s.id==='before-you-go':s.id!=='stories').map(s=><section id={s.id} class="mag-reading-section"><div><p class="eyebrow">{narrativeRegion?'Before you go':'04 · Before you go'}</p><h2>{s.title}</h2></div><div>{s.paragraphs.map((p,n)=><p data-source-ids={p.source_ids.join(' ')}>{p.text}{editorial&&<ArticleFootnote ids={p.source_ids} sources={editorial.sources} passage={`${s.id}-${n}`}/>}</p>)}{s.id==='before-you-go'&&r.visitor_notes?.map((note,n)=><div class="region-visitor-note" data-source-ids={note.source_ids.join(' ')}><h3>{note.heading}</h3><p>{note.text}{editorial&&<ArticleFootnote ids={note.source_ids} sources={editorial.sources} passage={`visitor-${n}`}/>}</p></div>)}</div></section>)}
  <VisitNotebook editorial={editorial}/>
  <DestinationLanguages slug={r.slug}/>
   <VisitReadiness/>
  <section id="at-a-glance" class="region-facts" aria-label="At a glance">{r.facts.map((f,n)=><div><p class="eyebrow">{f.label}</p><p>{f.text}{editorial&&<ArticleFootnote ids={f.source_ids} sources={editorial.sources} passage={`fact-${n}`}/>}</p></div>)}</section>
  {cultureTrailsFor(`/destinations/${r.slug}/`).length>0&&<details class="mag-disclosure"><summary>Languages, literature and connected stories</summary><CultureConnections path={`/destinations/${r.slug}/`}/></details>}
  {narrativeRegion?<details class={`mag-disclosure region-${r.slug}-onward`}><summary>Further reading</summary><div class="region-onward-links"><a class="utk-button" href="/journey/">Open my journey →</a>{r.journey_starter&&<a class="text-link" href={r.journey_starter.href}>{r.journey_starter.title} →</a>}{r.coastal_starter&&<a class="text-link" href={r.coastal_starter.href}>{r.coastal_starter.title} →</a>}<a class="text-link" href={`/destinations/${next.slug}/`}>Keep exploring · {next.title} →</a>{[...new Map(further.map(link=>[link.to,link])).values()].map(link=><p><a class="text-link" href={link.to}>{link.title} →</a></p>)}</div></details>:inCollection?<CollectionOnward path={`/destinations/${r.slug}/`} extraLinks={[{href:`/destinations/${next.slug}/`,title:`Keep exploring · ${next.title}`},...further.map(link=>({href:link.to,title:link.title})),...(r.slug==='bhubaneswar'?[{href:'/journey-starters/#bhubaneswar-stone-painted-streets',title:'Start with stone and painted streets'}]:[]),...(r.journey_starter?[r.journey_starter]:[])]}/>:<><section class="region-onward"><div><p class="eyebrow">Take the story with you</p><h2>Your discoveries.<br/><em>Your own journey.</em></h2><p>Bring the places and ideas you saved together. Add days when you are ready.</p></div><div class="region-onward-links"><a class="utk-button" href="/journey/">Open my journey →</a>{r.slug==='bhubaneswar'&&<a class="text-link" href="/journey-starters/#bhubaneswar-stone-painted-streets">Start with stone and painted streets →</a>}{r.journey_starter&&<a class="text-link" href={r.journey_starter.href}>{r.journey_starter.title} →</a>}{r.coastal_starter&&<a class="text-link" href={r.coastal_starter.href}>{r.coastal_starter.title} →</a>}<a class="text-link" href={`/destinations/${next.slug}/`}>Keep exploring · {next.title} →</a>{r.slug==='cuttack'?<details class="mag-disclosure"><summary>Further reading</summary>{[...new Map(further.map(link=>[link.to,link])).values()].map(link=><p><a class="text-link" href={link.to}>{link.title} →</a></p>)}</details>:further.map(link=><a class="text-link" href={link.to}>{link.title} →</a>)}</div></section></>}
  {editorial?<ArticleFootnotes sources={editorial.sources} passages={passages}>
   <h3>{isMayurbhanj?'Images and reuse':'Photographs'}</h3>{photos.map(p=><p><a href={p.source}>{p.caption}</a> By {p.creator} · <a href={p.license_url}>{p.license}</a>. {p.changes}</p>)}
  </ArticleFootnotes>:<details id="sources" class="mag-article-credits utk-disclosure"><summary>Sources, image credits & editorial notes</summary><p>Research and original editorial framing for Project Odisha, founded by Ahimanikya Satapathy. Suggestions are editorial ideas; visits, hosts and accommodation have not been field-checked for this preview.</p><ul>{sourceIds.map(id=><li><a href={data.sources[id].url}>{data.sources[id].title}</a><p>{data.sources[id].review}</p></li>)}</ul><h3>Image credits</h3>{photos.map(p=><p><a href={p.source}>{p.caption}</a> By {p.creator} · <a href={p.license_url}>{p.license}</a>. {p.changes}</p>)}<p>Still to research: detailed accessibility, inspected stays, invited local hosts, sourced oral histories, poems, songs and screen locations. <a href="/contribute/">Help improve this guide.</a></p></details>}
  {(r.slug==='cuttack'||narrativeRegion)&&<p class="region-update"><a href={`/contribute/?page=${encodeURIComponent('/destinations/'+r.slug+'/')}`}>Suggest an update</a>. GitHub submissions are public; omit private contact details and consent documents.</p>}
  {!editorial&&<p class="mag-status">Editorial preview · Reference check: {r.checked_on||data.checked_on}. Photos show earlier visits. Opening dates, services and conditions can change.</p>}
 </article>
</div>

<script>
import {bindStorySourceLinks} from '../lib/story-source-links.mjs';
for(const group of document.querySelectorAll('.region-editorial sup, .region-editorial .article-footnotes'))bindStorySourceLinks(group,document);
</script>
