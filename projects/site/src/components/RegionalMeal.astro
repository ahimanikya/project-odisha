---
import MagazineContents from './MagazineContents.astro';
import ArticleByline from './ArticleByline.astro';
import ArticleFootnote from './ArticleFootnote.astro';
import ArticleFootnotes from './ArticleFootnotes.astro';
import VisitNotebook from './VisitNotebook.astro';
import editionCopy from '../../../../kb/research/destinations/coastal-edition-copy.json';
import {allowsPage,isCoastalEdition} from '../data/edition';
import Shell from '../layouts/Shell.astro';
import MagazineCover from './MagazineCover.astro';
import SaveJourney from './SaveJourney.astro';
import '../styles/visitor-flow.css';
const {guide,editorial=null}=Astro.props;
const refs=(id)=>editorial?.passages.find(p=>p.id===id)?.source_ids||[];
import foods from '../../../../kb/research/food/collection.json';
const photo=foods.assets[guide.hero];
---
<Shell title={guide.title} description={guide.lead} active="explore" wide related={false}>
 <div class:list={["utk-magazine utk-magazine--detail city-food",{"meal-editorial":editorial}]}>
  <nav class="detail-breadcrumb" aria-label="Breadcrumb"><a href={guide.parent_href}>{guide.parent_title}</a><span aria-hidden="true">/</span><span>At the table</span></nav>
  <MagazineCover title={guide.title} eyebrow={guide.area+' · a taste of Odisha'} deck={[guide.lead]} photo={{...photo,caption:guide.photo_context,...(editorial?.cover_byline?{fit:'contain'}:{})}} startHref={'#'+guide.sections[0].id} startLabel="Make room for a meal" footline={guide.footline}><Fragment slot="byline">{editorial?.cover_byline&&<ArticleByline author={editorial.author}/>}</Fragment></MagazineCover>
  {editorial&&!editorial.cover_byline&&<ArticleByline author={editorial.author}/>}
  {editorial?.responsive_contents?<MagazineContents links={[...guide.sections.map(s=>({href:"#"+s.id,label:s.title})),{href:"#choose-your-kitchen",label:"Choose your kitchen"},{href:"#story-sources",label:"Footnotes & Sources"}]}/>:(<nav class="mag-navigation" aria-label="On this page">{guide.sections.map(s=><a href={'#'+s.id}>{s.title}</a>)}<a href="#choose-your-kitchen">Choose your kitchen</a></nav>)}
  <article class="mag-content">
   <div class="mag-article-chapters">{guide.sections.map((s,index)=><section id={s.id} class:list={['mag-reading-section',{'mag-reading-section--warm':index===1&&!editorial?.responsive_contents}]}><div><p class="eyebrow">{String(index+1).padStart(2,'0')} · At the table</p><h2>{s.title}</h2></div><div><p data-source-ids={s.source_ids.join(' ')}>{!editorial&&isCoastalEdition&&s.id==='sweet-finish'?editionCopy.coastal_food.sweet_finish:s.text}{editorial&&<ArticleFootnote ids={refs(s.id)} sources={editorial.sources} passage={s.id}/>}</p>{editorial&&s.paragraphs?.map((p,i)=><p>{p}<ArticleFootnote ids={refs(s.id+'-p-'+i)} sources={editorial.sources} passage={s.id+'-p-'+i}/></p>)}<aside class="table-prompt"><p class="eyebrow">{s.prompt}</p><p>{s.question}</p></aside><div class="food-actions">{s.href&&allowsPage(s.href)&&<a href={s.href}>{s.link_label} →</a>}{s.save_id&&<SaveJourney id={s.save_id} quiet/>}</div></div></section>)}</div>
   <section id="choose-your-kitchen" class="mag-reading-section"><div><p class="eyebrow">Leave a little room</p><h2>Choose your kitchen.</h2></div><div><p>{guide.closing}</p></div></section>
   <VisitNotebook editorial={editorial}/>
   <section class="visit-connections"><div><p class="eyebrow">Continue the day</p><h2>From the table,<br/><em>into the next story.</em></h2><p>Keep a meal in your plan without turning it into a timetable.</p></div><nav aria-label="Continue exploring">{guide.onward.filter(link=>allowsPage(link.href)).map(link=><a href={link.href}><span>{link.label}</span><strong>{link.title} →</strong></a>)}<a href="/journey/"><span>Keep your choices together</span><strong>Open my journey →</strong></a></nav></section>
   {editorial?<ArticleFootnotes sources={editorial.sources} passages={editorial.passages}><p><strong>Photograph.</strong> <a href={photo.source}>{photo.caption}</a> by {photo.creator} · <a href={photo.license_url}>{photo.license}</a>. {photo.changes} {guide.photo_context}</p></ArticleFootnotes>:<Fragment>   <p class="mag-status">Editorial draft · dish suggestions, with no inspected restaurant or current menu.</p>
   <details class="end-credits utk-disclosure"><summary>Sources, photograph & editorial notes</summary><p>Research checked {guide.checked_on}. Tasting prompts and planning suggestions are original editorial guidance.</p><ul>{Object.values(guide.sources).map(s=><li><a href={s.url}>{s.title}</a><p>{s.review||s.inspection}</p></li>)}</ul><p><a href={photo.source}>{photo.caption}</a> by {photo.creator} · <a href={photo.license_url}>{photo.license}</a>. {photo.changes} {guide.photo_context}</p><p>Project Odisha knowledge base. Founder & Editor-in-Chief: Ahimanikya Satapathy. Prepared with AI assistance; human editorial review pending.</p></details></Fragment>}
  </article>
 </div>
</Shell>
<style>.table-prompt{border-left:3px solid var(--earth);padding:4px 0 4px 22px;margin:28px 0}.table-prompt p:last-child{font-style:italic}.food-actions{display:flex;gap:20px;align-items:center;flex-wrap:wrap}.food-actions>a{min-height:44px;display:inline-flex;align-items:center}</style>

<script>
import {bindStorySourceLinks} from '../lib/story-source-links.mjs';
document.querySelectorAll('.meal-editorial sup, .meal-editorial .article-footnotes').forEach(group=>bindStorySourceLinks(group,document));
</script>
<style>
.meal-editorial .mag-article-chapters,.meal-editorial #choose-your-kitchen{max-width:740px;margin-inline:auto}
.meal-editorial .mag-reading-section{display:block;padding:0;margin-block:56px;background:none}
.meal-editorial .mag-reading-section h2{font-size:clamp(28px,3vw,38px);line-height:1.3;margin:0 0 24px}
.meal-editorial .mag-reading-section p:not(.eyebrow){font-size:18px;line-height:1.85;margin:0 0 1.25em;max-width:none}
.meal-editorial :global(.article-footnotes){max-width:740px;margin:64px auto 48px;border-top:1px solid var(--line);padding-top:28px;font-size:16px;line-height:1.8}
.meal-editorial :global(.article-footnotes p){margin:0 0 1.25em}
.meal-editorial :global(.article-footnotes h2){font-size:30px;margin:0 0 24px}
.meal-editorial :global(.article-footnotes li){margin-bottom:24px;scroll-margin-top:24px;overflow-wrap:anywhere}
.meal-editorial :global(.article-footnotes li:target){outline:2px solid var(--line);outline-offset:6px}
.meal-editorial :global(sup){font-size:.7em;line-height:0;margin-left:.15em}
.meal-editorial :global(a[data-footnote-ref]){font-weight:600;text-decoration:none;padding:.2em .15em}
.meal-editorial :global(a[data-footnote-backref]){display:inline-block;padding:.2rem .3rem}
.meal-editorial :global(a:focus-visible){outline:2px solid var(--earth);outline-offset:3px}
.meal-editorial :global(.mag-cover>figure img){object-fit:contain;aspect-ratio:auto}
@media(max-width:700px){.meal-editorial .mag-reading-section{margin-block:40px}.meal-editorial .mag-reading-section p:not(.eyebrow){font-size:17px;line-height:1.8}}
</style>
