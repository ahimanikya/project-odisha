---
import Brand from "./Brand.astro";
import PageShare from "./PageShare.astro";
import {allowsPage} from "../data/edition";
const {pathname=Astro.url.pathname,planningReturn=null}=Astro.props;
---
<footer class="footer">
  <div class="wrap footer-grid">
    <div class="footer-intro"><a href="/" class="home-link" aria-label="Project Odisha home"><Brand/></a><p>Discover Odisha. Imagine the possibilities.</p><p class="footer-mission">People, places and knowledge.<br/>A story we build together.</p><PageShare/><slot/></div>
    <nav class="footer-links" aria-label="About Project Odisha">
      <h2 class="eyebrow">The project</h2>
      <a href="/about/">About the project</a>
      <a href="/founder/">The founder</a>
      {allowsPage('/about/editorial-process/')&&<a href="/about/editorial-process/">Our editorial process</a>}
      {allowsPage('/global-connections/')&&<a href="/global-connections/">Global Connections</a>}
    </nav>
    <nav class="footer-links" aria-label="Explore and contribute">
      <h2 class="eyebrow">Take part</h2>
      {allowsPage('/characters/')&&<a href="/characters/">Character worlds</a>}
      {allowsPage('/odia-poetry-jhula/')&&<a href="/odia-poetry-jhula/">Odia Poetry Jhula</a>}
      <a href="/contribute/">Contribute</a>
      <a href={"/contribute/?page="+encodeURIComponent(pathname)}>Suggest a correction</a>
      {allowsPage('/brand-review/')&&<a href="/brand-review/">Brand studio</a>}
    </nav>
    <nav class="footer-links" aria-label="Website help">
      <h2 class="eyebrow">Useful links</h2>
      <a href="/how-to-use/">How to use Project Odisha</a>
      <a href="/how-to-use/#privacy">Privacy</a>
      {planningReturn&&allowsPage(planningReturn[0])&&<a href={planningReturn[0]}>{planningReturn[1]}</a>}
      <a href="#page-top">Back to top ↑</a>
    </nav>
  </div>
  <div class="wrap footer-bottom"><span>Founded by Ahimanikya Satapathy.</span><span>Preview edition · articles await editorial review</span></div>
</footer>
