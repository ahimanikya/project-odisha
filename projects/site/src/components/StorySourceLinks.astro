---
interface Source {id:string; title:string}
interface Props {ids:string[]; sources:Source[]; prefix?:string; label?:string}
const {ids,sources,prefix="story-source-",label=""}=Astro.props;
const references=ids.map(id=>{
 const index=sources.findIndex(source=>source.id===id);
 if(index<0)throw new Error(`Unknown story source: ${id}`);
 return {...sources[index],number:index+1};
});
---
{references.length>0&&<p class="story-source-links">
 {references.map(source=><sup><a href={'#'+prefix+source.id} data-footnote-ref aria-label={'Footnote '+source.number+': '+source.title}>{source.number}</a></sup>)}
</p>}
<style>
.story-source-links{display:flex;flex-wrap:wrap;align-items:center;gap:0 .9rem;font-size:15px;line-height:1.5;margin-top:1rem}
:global(.utk-magazine .mag-reading-section) .story-source-links{font:15px/1.5 system-ui,sans-serif}
.story-source-links span{color:var(--muted)}
.story-source-links a{display:inline-flex;align-items:center;min-height:44px;text-underline-offset:.2em}
.story-source-links a:focus-visible{outline:3px solid var(--earth);outline-offset:3px}
</style>
<script>
import {bindStorySourceLinks} from '../lib/story-source-links.mjs';
for(const links of document.querySelectorAll('.story-source-links'))bindStorySourceLinks(links,document);
</script>
