---
import Shell from '../layouts/Shell.astro';
import MagazineArticle from './MagazineArticle.astro';
import {allowsPage} from '../data/edition';
import data from '../../../../kb/research/culture/textile-stories.json';
const {entry}=Astro.props;
const photos=Object.fromEntries(entry.sections.filter(s=>s.photo).map(s=>[s.id,data.assets[s.photo]]));
const credits=[...new Set([entry.hero,...entry.sections.filter(s=>s.photo).map(s=>s.photo)])].map(id=>data.assets[id]);
const sourceIds=[...new Set(entry.sections.flatMap(s=>s.paragraphs.flatMap(p=>p.source_ids)))];
---
<Shell title={entry.title} description={entry.lead} active="explore" wide related={false}>
 <MagazineArticle kind="culture" title={entry.cover_title||entry.title} subtitle={entry.cover_subtitle} odia={entry.odia} eyebrow={'Woven in Odisha · '+entry.area} deck={[entry.lead]} photo={data.assets[entry.hero]} saveId={entry.save_id} sections={entry.sections} sectionPhotos={photos} chapterLabel="The story in the thread" startLabel="Follow the thread" footline="Look closely. Learn a name. Carry a story.">
  {entry.external_links&&<nav class="craft-onward" aria-label="Film and textile documentation">{entry.external_links.map(link=><a href={link.href}>{link.title} ↗</a>)}</nav>}
  <nav class="craft-onward" aria-label="Continue the textile story"><a href="/textiles/">Woven in Odisha →</a>{entry.related.filter(link=>allowsPage(link.href)).map(link=><a href={link.href}>{link.title} →</a>)}<a href="/journey/">Open my journey →</a></nav>
  <details class="mag-article-credits"><summary>Sources, photographs & editorial notes</summary><p>Research checked {entry.checked_on}. {credits.some(photo=>photo.kind==='documentary_film_poster')?'The lead image is a film poster; its licence does not cover the film.':'Photographs document the subjects and dates in their captions; they do not establish current workshop access.'} Process descriptions are attributed to their sources. No named workshop, current appointment, price or material certification has been verified. Odia names and craft terminology await local review.</p><ul>{sourceIds.map(id=><li><a href={data.sources[id].url}>{data.sources[id].title}</a><p>{data.sources[id].inspection}</p></li>)}</ul>{credits.map(p=><p><a href={p.source}>{p.caption}</a> · {p.creator} · <a href={p.license_url}>{p.license}</a>. {p.changes}</p>)}<p>Project Odisha knowledge base. Founder & Editor-in-Chief: Ahimanikya Satapathy. Specialist language and maker review remain open.</p></details>
 </MagazineArticle>
</Shell>
<style>.craft-onward{display:flex;flex-wrap:wrap;gap:1rem 2rem;padding:2rem 0;border-top:1px solid var(--line)}.craft-onward a{display:inline-flex;align-items:center;min-height:44px}</style>
