---
import ArticleFootnote from './ArticleFootnote.astro';
import VisitReadiness from './VisitReadiness.astro';
import questions from '../../../../kb/research/destinations/visit-questions.json';
import data from '../../../../kb/research/destinations/visit-notebooks.json';
import {allowsPage} from '../data/edition';
import SaveJourney from './SaveJourney.astro';
const {path=Astro.url.pathname,editorial=null}=Astro.props;
const note=data.notebooks.find(n=>n.route===path);
const ask=questions.guides.find(g=>g.route===path);
---
{note&&<section class="visit-notebook" id="visit-notebook" aria-labelledby="visit-notebook-heading" data-notebook={note.save_id}>
 <header><p class="eyebrow">Make it your visit</p><h2 id="visit-notebook-heading">{note.title}</h2><p class="notebook-observe">{note.notice}</p></header>
 <div class="notebook-copy"><div class="notebook-prepare"><h3>Before you go</h3><p>{note.prepare}</p></div>
 {note.practical_choices&&<details class="utk-disclosure notebook-details practical-choices" id="practical-choices"><summary>Arrival, access, food & a place to stay</summary><p class="practical-status">{note.practical_choices.note}</p><dl>{note.practical_choices.items.map(choice=><div><dt>{choice.heading}</dt><dd><p>{choice.text}{editorial&&<ArticleFootnote ids={choice.source_ids||[]} sources={editorial.sources} passage={`notebook-${choice.key}`}/>}</p>{choice.links.filter(link=>!link.href.startsWith('/')||allowsPage(link.href)).length>0&&<ul class="practical-links">{choice.links.filter(link=>!link.href.startsWith('/')||allowsPage(link.href)).map(link=><li><a href={link.href}>{link.label} →</a></li>)}</ul>}</dd></div>)}</dl></details>}
 <details class="utk-disclosure notebook-details" id="visit-details"><summary>{note.planning_stops?.length?'Details for this visit':'Where to ask'}</summary>{note.planning_stops?.map((stop,i)=><div class="notebook-stop"><h3>{stop.heading}</h3><p>{stop.text}{editorial&&<ArticleFootnote ids={stop.source_ids||[]} sources={editorial.sources} passage={`notebook-stop-${i}`}/>}</p></div>)}{note.planning_help&&<><h3>Where to ask</h3><p>{note.planning_help.text} <a href={note.planning_help.url}>{note.planning_help.label} →</a>{editorial&&<ArticleFootnote ids={note.planning_help.source_ids||[]} sources={editorial.sources} passage="notebook-help"/>}</p></>}</details>
 <VisitReadiness withinNotebook editorial={editorial}/>
 <details class="utk-disclosure notebook-details"><summary>People, connections & a memory to keep</summary><h3>Connect with care</h3><p>{note.connect}</p><h3>Leave room for</h3><p>{note.pair.text}</p>{allowsPage(note.pair.href)&&<a href={note.pair.href}>{note.pair.label} →</a>}<h3>Bring home a memory</h3><p>{note.remember}</p></details>
 {ask&&<details class="utk-disclosure notebook-details visit-questions" id="visit-questions"><summary>Six questions to take with you</summary><p>Ask the people arranging your visit. These prompts help you prepare; they do not confirm local arrangements.</p><dl>{ask.questions.map(q=><div><dt>{q.heading}</dt><dd>{q.text}</dd></div>)}</dl><p>Save this idea, then add any useful question to your private reminders in <a href="/journey/#preparation">My journey</a>.</p></details>}
 <SaveJourney id={note.save_id} quiet/><p class="notebook-edit">Add your own day notes in <a href="/journey/">My journey</a>.</p></div>
</section>}
<style>
.visit-notebook{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:32px 7%;padding:40px 0;margin:44px 0;border-block:1px solid var(--line);scroll-margin-top:24px}.visit-notebook h2{font-size:clamp(32px,3.2vw,48px);line-height:1.2;max-width:17ch}.notebook-copy{min-width:0;max-width:68ch}.notebook-copy p{font-size:17px;line-height:1.8;margin:12px 0 22px}.notebook-observe{font:21px/1.65 var(--serif);color:var(--sea);margin-top:24px;max-width:32ch}.notebook-prepare{border-left:3px solid var(--earth);padding-left:22px;margin:0 0 28px}.notebook-prepare h3{margin-top:0}.notebook-copy h3{font-size:22px;margin:20px 0 10px}.notebook-details{border-top:1px solid var(--line)}.notebook-details:last-of-type{border-bottom:1px solid var(--line)}.notebook-copy :global(.visit-readiness){margin:0}.notebook-copy :global(.visit-readiness details){border-bottom:0;padding:0}.notebook-copy :global(.visit-readiness summary){padding:14px 0}.notebook-copy :global(.visit-readiness h3){font-size:22px}.notebook-details summary{min-height:48px;cursor:pointer;padding:14px 0;font-weight:600;color:var(--sea)}.visit-questions dl{margin:20px 0}.visit-questions dt{font-weight:650;color:var(--sea)}.visit-questions dd{margin:8px 0 24px;font-size:16px;line-height:1.8}.notebook-details a{min-height:44px;display:inline-flex;align-items:center}.notebook-copy .notebook-edit{font-size:14px}.notebook-copy :global(.journey-save){margin-bottom:12px}@media(max-width:750px){.visit-notebook{grid-template-columns:1fr;gap:16px;padding:30px 0}.visit-notebook h2{max-width:22ch}.notebook-copy{max-width:100%}}
.practical-choices dt{font:600 22px/1.4 var(--serif);color:var(--sea);margin-top:24px}.practical-choices dd{margin:0}.practical-choices .practical-status{font-size:14px;color:var(--muted)}.practical-choices dd p{margin-bottom:8px}.practical-links{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:4px 20px;margin:0 0 20px}.practical-links li{min-width:0}.practical-links a{font-size:15px;overflow-wrap:anywhere}
</style>
