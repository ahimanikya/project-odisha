---
import ArticleByline from './ArticleByline.astro';
import ArticleFootnote from './ArticleFootnote.astro';
import LocalContributionLinks from './LocalContributionLinks.astro';
import defaultTrail from '../../../../kb/research/destinations/stone-sea-trail.json';
import {journeyCatalog} from '../data/journey-catalog';
import {bookPhotos} from '../data/book-photos';
import ResponsiveImage from './ResponsiveImage.astro';
const {starter,trail=defaultTrail,choices=[starter],headingLevel='h2',editorial=null}=Astro.props;
const Heading=headingLevel;
const ChapterHeading=headingLevel==='h1'?'h2':'h3';
const Subheading=headingLevel==='h1'?'h3':'h4';
const headingId='visitor-trail-title-'+trail.starter_id;
const chapters=trail.chapters.map(chapter=>({...chapter,photo:bookPhotos[chapter.photo],ideas:chapter.ideas.map(id=>{const idea=journeyCatalog.find(item=>item.id===id);if(!idea)throw Error('Missing trail idea: '+id);return idea;})}));
---
<section id={trail.starter_id} class:list={["visitor-trail", {"editorial-trail":!!editorial}]} aria-labelledby={headingId}>
<header class="trail-intro"><p class="eyebrow">{trail.eyebrow}</p><Heading id={headingId}>{trail.title_start}{' '}<em class="highlight">{trail.title_highlight}</em></Heading>{editorial&&<ArticleByline author={editorial.author}/>}<p class="lead">{trail.intro}</p>{trail.orientation&&<p>{trail.orientation}</p>}</header>
<div class="trail-chapters">{chapters.map((chapter,index)=><article class="trail-chapter" aria-labelledby={'trail-'+trail.starter_id+'-'+chapter.id}>
<figure><ResponsiveImage src={chapter.photo.src} alt={chapter.photo.alt} width={chapter.photo.width} height={chapter.photo.height} loading="lazy" sizes="(max-width: 760px) 92vw, 44vw"/><figcaption>{chapter.photo.caption}</figcaption></figure>
<div class="chapter-copy"><p class="eyebrow">0{index+1} · {chapter.place}</p><ChapterHeading id={'trail-'+trail.starter_id+'-'+chapter.id}>{chapter.title}</ChapterHeading><p>{chapter.text}{editorial&&<ArticleFootnote ids={editorial.passages.find(p=>p.id==='trail-'+chapter.id)?.source_ids||[]} sources={editorial.sources} passage={'trail-'+chapter.id}/>}</p><ul class="chapter-links" aria-label={'Read about '+chapter.place}>{chapter.ideas.map(idea=><li><a class="text-link" href={idea.href}>{idea.title} →</a></li>)}</ul><p class="trail-prompt"><strong>{trail.prompt_label||'Before you go'}</strong><br/>{chapter.prompt}</p></div>
</article>)}</div>
<div class="trail-prepare"><ChapterHeading>Turn the thread into your journey.</ChapterHeading><div class="preparation-grid">{trail.preparation.map((item,i)=><div><Subheading>{item.title}</Subheading><p>{item.text}{editorial&&<ArticleFootnote ids={editorial.passages.find(p=>p.id==='trail-preparation-'+i)?.source_ids||[]} sources={editorial.sources} passage={'trail-preparation-'+i}/>}</p></div>)}</div>{trail.preparation_links&&<ul>{trail.preparation_links.map(link=><li><a class="text-link" href={link.href}>{link.label} →</a></li>)}</ul>}<p>{trail.save_intro||(choices.length>1?'Choose one gateway below. Each creates a separate journey with only its related ideas.':'Save these '+choices[0].items.length+' ideas together, then choose dates, add notes and remove anything that does not fit.')} Every idea begins unscheduled. New journeys carry the chapters connected to their selected ideas into the downloadable tour book; choose the illustrated book to include photographs. Your existing journeys stay as they are.</p><div class="trail-choices">{choices.map(choice=><div class="trail-action">{choices.length>1&&<><Subheading>{choice.title}</Subheading><p>{choice.lead}</p><p>{choice.items.length} ideas · no dates assigned</p></>}<button type="button" class="button utk-button" data-journey-starter={choice.id} disabled aria-describedby={'starter-status-'+choice.id}>Start {choice.title}</button><p id={'starter-status-'+choice.id} class="starter-status" data-starter-status role="status" aria-live="polite"></p></div>)}</div>{trail.alternative&&<p class="trail-alternative">Another turn in the story: <a href={trail.alternative.href}>{trail.alternative.label}</a></p>}</div>
{trail.verification_pack&&<p><a class="text-link" href={trail.verification_pack} download>Download the local verification pack →</a></p>}{trail.contribution_kinds?.length!==0&&<LocalContributionLinks kinds={trail.contribution_kinds} page={trail.contribution_page}/>}
</section>
<style>
.visitor-trail{margin:48px 0 80px;scroll-margin-top:30px}.trail-intro{max-width:820px;margin-bottom:40px}.trail-intro :is(h1,h2){font:clamp(38px,5vw,66px)/1.08 var(--serif);margin:16px 0 24px}.trail-chapters{display:grid;gap:48px}.trail-chapter{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:center;gap:clamp(24px,4vw,64px)}.trail-chapter figure{margin:0}.trail-chapter img{display:block;width:100%;height:auto;max-height:560px;object-fit:contain}.trail-chapter figcaption{font-size:12px;color:var(--muted);margin-top:12px;line-height:1.5}.chapter-copy{min-width:0}.chapter-copy :is(h2,h3),.trail-prepare> :is(h2,h3){font:clamp(27px,3vw,38px)/1.18 var(--serif);margin:14px 0 22px}.chapter-copy>p{max-width:60ch}.chapter-links{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:8px 20px;margin:24px 0}.chapter-links a{display:inline-block;padding:8px 0}.trail-prompt{border-left:2px solid var(--earth);padding-left:18px;color:var(--muted);font-size:15px;line-height:1.65}.trail-prepare{margin-top:48px;padding:clamp(24px,4vw,48px);background:var(--paper);border:1px solid var(--line)}.preparation-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px;margin:24px 0}.preparation-grid :is(h3,h4){font-size:18px;margin:0 0 10px}.preparation-grid p{margin:0}.trail-choices{display:grid;gap:24px}.trail-choices :is(h3,h4){font-size:20px;margin:20px 0 12px}.trail-action button{white-space:normal;text-align:left}.starter-status{margin:16px 0;min-height:24px}.trail-alternative{font-size:15px}@media(max-width:760px){.trail-chapter,.preparation-grid{grid-template-columns:1fr}.trail-chapters{gap:40px}.trail-chapter{gap:22px}.trail-intro{margin-bottom:28px}.visitor-trail{margin:32px 0 56px}.trail-action button{width:100%}}
</style>

<style>
.editorial-trail .trail-intro{max-width:740px}.editorial-trail .chapter-copy>p:not(.eyebrow){font-size:1.12rem;line-height:1.85;margin:0 0 1.25em;max-width:740px}.editorial-trail .chapter-copy .trail-prompt{font-size:.95rem;line-height:1.75}.editorial-trail .preparation-grid p{line-height:1.85}.editorial-trail :global(sup){font-size:.7em;line-height:0;vertical-align:super;margin-left:.12em}.editorial-trail :global(a[data-footnote-ref]){padding:.2em .15em;text-decoration:none;font-weight:600}.editorial-trail :global(a:focus-visible){outline:2px solid var(--earth);outline-offset:3px}@media(max-width:600px){.editorial-trail .chapter-copy>p:not(.eyebrow){font-size:1.05rem;line-height:1.8}}
</style>
