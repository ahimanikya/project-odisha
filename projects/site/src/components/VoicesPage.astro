---
import CultureMagazine from './CultureMagazine.astro';
import Shell from '../layouts/Shell.astro';
import {allowsPage,isCoastalEdition} from '../data/edition';
const entry=structuredClone(Astro.props.entry);
if(isCoastalEdition){
 const held=entry.cards.filter(card=>!allowsPage(card.href));
 entry.cards=entry.cards.filter(card=>allowsPage(card.href));
 if(entry.path==='languages')entry.roster=[...held.map(card=>card.title),...(entry.roster||[])];
 entry.related=entry.related.filter(link=>allowsPage(link.href));
}
---
<Shell title={entry.title} description={entry.lead} active="explore" wide related={false}>
<CultureMagazine entry={entry}/>
</Shell>
