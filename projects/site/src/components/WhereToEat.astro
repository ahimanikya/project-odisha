---
import directory from '../../../../kb/research/food/restaurants.json';
import {allowsPage} from '../data/edition';
interface Props { dishSlug: string; }
const {dishSlug}=Astro.props;
const venues=directory.venues.filter(venue=>venue.dishes.some(dish=>dish.slug===dishSlug)&&allowsPage(`/food/restaurants/${venue.slug}/`));
const city=directory.cities.find(city=>city.guide===`/food/${dishSlug}/`);
---
{city&&allowsPage('/food/where-to-eat/')&&<section class="dish-dining" aria-labelledby={`dining-${city.slug}`}>
  <p class="eyebrow">From the story to the table</p>
  <h2 id={`dining-${city.slug}`}>Find a table in {city.name}</h2>
  <p>Explore local restaurants and visit their own websites to plan a meal.</p>
  <a class="text-link" href={`/food/where-to-eat/#${city.slug}`}>Explore restaurants in {city.name} →</a>
</section>}
{venues.length>0&&<section class="dish-dining" aria-labelledby={`try-${dishSlug}`}>
  <p class="eyebrow">From the story to the table</p>
  <h2 id={`try-${dishSlug}`}>Where to try it</h2>
  <p>These restaurants list this dish on their website. Ask about availability when planning your visit.</p>
  <div class="dish-dining-list">{venues.map(venue=><article>
    <h3><a href={`/food/restaurants/${venue.slug}/`}>{venue.name} <span aria-hidden="true">→</span></a></h3>
    <p>{venue.area} · {venue.city}</p>
  </article>)}</div>
  {allowsPage('/food/where-to-eat/')&&<a class="text-link" href="/food/where-to-eat/">Explore more places to eat →</a>}
</section>}
<style>
  .dish-dining{max-width:780px;margin:44px auto;padding:28px;border-top:3px solid var(--earth);background:var(--paper)}.dish-dining h2{font:clamp(29px,3vw,38px)/1.2 var(--serif);color:var(--sea);margin:12px 0 18px}.dish-dining>p:not(.eyebrow){font-size:16px;line-height:1.8;max-width:65ch}.dish-dining-list article{border-top:1px solid var(--line);margin-top:22px;padding-top:18px}.dish-dining h3{font:26px/1.3 var(--serif);color:var(--sea);margin:0 0 10px}.dish-dining h3 a{display:inline-block;padding-block:7px;text-underline-offset:5px}.dish-dining-list p{font-size:14px;line-height:1.8}.dish-dining>.text-link{margin-top:20px}@media(max-width:650px){.dish-dining{padding:22px;margin-block:32px}}
</style>
