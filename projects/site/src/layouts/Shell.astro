---
import {publicJourney} from '../data/public-journey';
import {allowsPage} from '../data/edition';
const safeJSON=JSON.stringify(publicJourney).replaceAll('<','\\u003c');
import Analytics from '../components/Analytics.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContextTrail from '../components/ContextTrail.astro';
import {discoveryEntries} from '../data/discovery';
import {sharingImage} from '../lib/page-context.mjs';
import {homeSharingImage} from '../data/home-sharing';

import visitNotebooks from '../../../../kb/research/destinations/visit-notebooks.json';
const notebook=visitNotebooks.notebooks.find(n=>n.route===Astro.url.pathname);
import pageDescriptions from '../../../../kb/research/coastal-page-descriptions.json';
import {isCoastalEdition} from '../data/edition';
import VisitorTrailReturn from '../components/VisitorTrailReturn.astro';
import RelatedDiscoveries from '../components/RelatedDiscoveries.astro';
import '../../../design-system/styles/utkal.css';
import '../styles/global.css';
import '../styles/design-system.css';
import designSystem from '../../../design-system/package.json';
const planningReturn=Astro.url.pathname.startsWith('/visit/stays/')?['/stay-areas/','Compare other stay areas']:Astro.url.pathname.startsWith('/visit/experiences/')?['/things-to-do/','Explore more things to do']:Astro.url.pathname.startsWith('/food/')&&Astro.url.pathname!=='/food/'?['/food/','Explore food & flavours']:Astro.url.pathname.startsWith('/destinations/')&&Astro.url.pathname!=='/destinations/'?['/destinations/','Browse destination guides']:null;

const {title='Discover Odisha. Imagine the possibilities.', description='A growing, shared encyclopedia of Odisha’s people, places and living heritage.',active='',wide=false,related=true,shareImage}=Astro.props;
const pagePath=Astro.url.pathname==='/404/'?'/404.html':Astro.url.pathname;
const pageDescription=isCoastalEdition?(pageDescriptions.descriptions[pagePath]||description):description;
const canonical=new URL(pagePath,Astro.site).href;
const pageTitle=(isCoastalEdition&&pageDescriptions.titles?.[pagePath])||(title.endsWith(' · Project Odisha')?title:title+' · Project Odisha');
const discoveryEntry=discoveryEntries.find(entry=>entry.href===pagePath);
const sharePhoto=sharingImage(shareImage ?? (pagePath==='/' ? homeSharingImage : discoveryEntry?.image));
const socialImage=new URL(sharePhoto.src,Astro.site).href;
---
<!doctype html><html lang="en"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="robots" content="noindex, nofollow"/><meta name="description" content={pageDescription}/>
<meta name="utkal-design-system" content={designSystem.version}/>
<meta name="theme-color" content="#91462F"/><title>{pageTitle}</title>
<link rel="canonical" href={canonical}/><meta name="referrer" content="no-referrer"/><meta name="color-scheme" content="light"/>
<meta property="og:type" content="website"/><meta property="og:site_name" content="Project Odisha"/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={pageDescription}/><meta property="og:url" content={canonical}/><meta property="og:locale" content="en_IN"/>
<meta property="og:image" content={socialImage}/><meta property="og:image:alt" content={sharePhoto.alt}/><meta property="og:image:width" content={sharePhoto.width}/><meta property="og:image:height" content={sharePhoto.height}/>
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={pageDescription}/><meta name="twitter:image" content={socialImage}/><meta name="twitter:image:alt" content={sharePhoto.alt}/>
<link rel="icon" type="image/png" href="/assets/utkal-favicon-64.png"/>

</head><body id="page-top" class:list={['utk',{'destination-layout':wide}]}>
<a href="#main" class="skip">Skip to content</a>
<SiteHeader active={active}/>
<main id="main" tabindex="-1"><ContextTrail path={pagePath} title={discoveryEntry?.label||title}/><slot/><VisitorTrailReturn path={pagePath}/>{related&&<RelatedDiscoveries path={Astro.url.pathname}/>}</main>
<SiteFooter pathname={Astro.url.pathname} planningReturn={planningReturn}>{notebook&&!notebook.editorial_notes_in_article&&<details class="notebook-credit"><summary>Visit notebook notes</summary><p>Original Project Odisha editorial prompts under Ahimanikya Satapathy’s direction. They invite observation and questions; they are not quotations, field reports or confirmed travel arrangements. Factual planning context is supported by the sources below. Guide sources and photograph credits appear above.</p>{notebook.planning_sources?.map(s=><p><a href={s.url}>{s.title}</a> · Planning reference checked {s.checked_on}.</p>)}</details>}</SiteFooter>
<Analytics canonical={canonical} title={pageTitle}/>
<script is:inline type="application/json" id="journey-data" set:html={safeJSON}/><script>import "../scripts/journey";</script>
<script>
import {bindFragmentNavigation} from '../lib/fragment-navigation.mjs';
import {bindStoryPrint} from '../lib/story-print.mjs';
bindStoryPrint(document,window);
bindFragmentNavigation(document,window);
</script></body></html>
