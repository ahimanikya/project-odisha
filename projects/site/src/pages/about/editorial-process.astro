---
import Shell from '../../layouts/Shell.astro';
import process from '../../../../../kb/reference/editorial-process-website.json';
import '../../styles/article-reading.css';
---
<Shell title={process.title} description={process.lead} active="about" related={false}><article class="article-reading"><p class="eyebrow">About Project Odisha</p><h1>{process.title}</h1><p class="lead">{process.lead}</p>{process.sections.map(s=><section><h2>{s.title}</h2>{s.paragraphs.map(p=><p>{p}</p>)}</section>)}<p><a href="/contribute/?page=%2Fabout%2Feditorial-process%2F">Share a correction or public source</a> · <a href="/founder/">Meet the founder</a></p></article></Shell>
