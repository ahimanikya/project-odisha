---
import Shell from '../layouts/Shell.astro';
import culture from '../data/cultural-book.json';
import BookCover from '../components/BookCover.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import dongria from '../data/dongariya-book.json';
import dongriaReading from '../data/dongria-book-reading.json';
import dongriaChapters from '../data/dongariya.json';
import kotpad from '../data/mirgan-kotpad-book.json';
import cinema from '../data/cinema.json';
import dhaga from '../../../odia-dhaga/collection.json';
import dhagaDownload from '../../../odia-dhaga/pdf-delivery.json';
const cinemaDownload = cinema.review_books.find(book => book.edition === 'digital')!;
const cinemaTitle = 'Odia Cinema: A Living Screen';
const dhagaTitle = `${dhaga.cover.title_english} — ${dhaga.cover.title_odia}`;
const dhagaCover = '/dhaga/' + dhaga.cover.src.replace(/\.png$/, '.webp');
const dongriaCover = dongriaReading.cover.at(-1)!;
---
<Shell title="Books" description="Explore five books about Odisha’s culture, communities, textiles, cinema and sayings. Read each book online at your own pace." active="books" related={false} shareImage={{src:dongriaCover.src,alt:dongriaReading.cover_alt,width:dongriaCover.width,height:dongriaCover.height}}>
<div class="books-page">
  <header class="books-intro">
    <p class="eyebrow">Project Odisha · The reading collection</p>
    <h1>Books</h1>
    <p>Five books about culture, people, cloth, cinema and the words we carry in Odisha. Each has its own reading path and sources.</p>
    <p>Choose a book and follow its chapters at your own pace.</p>
  </header>
  <div class="book-grid">
    <article class="book-card" data-book="culture" aria-labelledby="culture-title">
      <BookCover title={culture.title} author={culture.author} ratio={culture.cover.width / culture.cover.height} spineColor="#142442" spineTitle="Odisha" frontSrc={culture.cover.src} backSrc="/assets/cultural-book/back-cover.png" spineSrc="/assets/book-covers/culture-spine.png"><img src={culture.cover.src} width={culture.cover.width} height={culture.cover.height} alt={culture.cover.alt} fetchpriority="high" decoding="async"/></BookCover>
      <header><p class="eyebrow">The complete cultural edition</p><h2 id="culture-title"><a href={culture.route}>{culture.title}</a></h2></header>
      <div class="book-description"><p>A cultural companion across Odisha’s landscapes, languages, faiths, literature, performance, crafts, food and everyday lives. Follow forty-eight connected chapters through the people and practices that carry culture forward.</p><p class="book-details">48 chapters · {culture.download.pages} pages</p><p class="cover-credit">The Indigo &amp; Gold illustrated cover of the complete edition.</p></div>
      <footer class="book-actions"><a href={culture.route} aria-label={`Read online: ${culture.title}`}>Read online →</a></footer>
    </article>
    <article class="book-card" data-book="dongria" aria-labelledby="dongria-title">
      <BookCover title={dongria.title} author="Ahimanikya Satapathy" ratio={dongriaCover.width / dongriaCover.height} spineColor="#6c3928" spineTitle="Dongria Kondh" frontSrc={dongriaCover.src} backSrc="/assets/book-covers/dongria-back.png"><img src={dongriaCover.src} srcset={dongriaReading.cover.map(v=>`${v.src} ${v.width}w`).join(', ')} sizes="(max-width: 400px) 70vw, 308px" width={dongriaCover.width} height={dongriaCover.height} alt={dongriaReading.cover_alt} loading="lazy" decoding="async"/></BookCover>
      <header>
        <p class="eyebrow">{dongria.edition}</p>
        <h2 id="dongria-title"><a href="/stories/dongria/book/">{dongria.title}</a></h2>
        
      </header>
      <div class="book-description">
        <p>Beginning with a shawl, this book follows the people, food, cloth, learning and songs of Niyamgiri. Its connected chapters bring together named accounts and sources for further reading.</p>
        <p class="book-details">{dongriaChapters.length} chapters · {dongria.pages} pages</p>
        <p class="cover-credit">Cover photograph: {dongriaReading.cover_credit.creator}. <a href={dongriaReading.cover_credit.source_url}>Source</a> · <a href={dongriaReading.cover_credit.licence_url}>{dongriaReading.cover_credit.licence}</a>. The preview reproduces the published cover.</p>
      </div>
      <footer class="book-actions">
        <a href="/stories/dongria/book/" aria-label={`Read online: ${dongria.title}`}>Read online →</a>
      </footer>
    </article>
    <article class="book-card" data-book="kotpad" aria-labelledby="kotpad-title">
      <BookCover title={kotpad.title} author={kotpad.author} ratio={kotpad.cover.width / kotpad.cover.height} spineColor="#69342b" spineTitle="Kotpad Cloth" frontSrc={kotpad.cover.src} backSrc="/images/mirgan-kotpad/back-cover.png"><ResponsiveImage src={kotpad.cover.src} sizes="(max-width: 400px) 70vw, 246px" width={kotpad.cover.width} height={kotpad.cover.height} alt={kotpad.cover.alt} loading="lazy"/></BookCover>
      <header>
        <p class="eyebrow">{kotpad.edition}</p>
        <h2 id="kotpad-title"><a href="/stories/kotpad/book/">{kotpad.title}</a></h2>
        
      </header>
      <div class="book-description">
        <p>Follow the work behind Kotpad cloth, from making colour and sharing earnings to learning and the working year. This first edition draws on published sources and named testimony.</p>
        <p class="book-details">{kotpad.chapters.length} chapters · {kotpad.download.pages} pages</p>
        <p class="cover-credit">The illustrated cover of the first reading edition.</p>
      </div>
      <footer class="book-actions">
        <a href="/stories/kotpad/book/" aria-label={`Read online: ${kotpad.title}`}>Read online →</a>
      </footer>
    </article>
    <article class="book-card" data-book="cinema" aria-labelledby="cinema-title">
      <BookCover title={cinemaTitle} author="Ahimanikya Satapathy" ratio={800 / 1199} spineColor="#4b3427" spineTitle="Odia Cinema" frontSrc="/assets/cinema/a-living-screen-cover-20261027.jpg" backSrc="/assets/book-covers/cinema-back.png"><img src="/assets/cinema/a-living-screen-cover-20261027.jpg" width="800" height="1199" alt="Odia Cinema: A Living Screen, with a symbolic household scene on the front cover" loading="lazy" decoding="async"/></BookCover>
      <header>
        <p class="eyebrow">Digital reading edition</p>
        <h2 id="cinema-title"><a href="/cinema/">{cinemaTitle}</a></h2>
        
      </header>
      <div class="book-description">
        <p>A connected journey through Odia cinema, literature, songs, radio and television. The readings follow storytellers, audiences and the work that helps creative lives continue.</p>
        <p class="book-details">{cinemaDownload.readings} book chapters · {cinemaDownload.pages} pages</p>
        <p class="cover-credit">The illustrated cover of Odia Cinema: A Living Screen.</p>
        <p><a href="/cinema/book/">Book editions and printing notes →</a></p>
      </div>
      <footer class="book-actions">
        <a href="/cinema/" aria-label={`Read online: ${cinemaTitle}`}>Read online →</a>
      </footer>
    </article>
    <article class="book-card" data-book="dhaga" aria-labelledby="dhaga-title">
      <BookCover title={dhagaTitle} author={dhaga.cover.byline} ratio={dhaga.cover.width / dhaga.cover.height} spineColor="#8d5733" spineTitle="Odia Dhaga" frontSrc={dhagaCover} backText="Odia sayings carry images, humour and ways of judging everyday life. Odia and English meanings, usage and illustrations."><img src={dhagaCover} width="640" height={Math.round(dhaga.cover.height * 640 / dhaga.cover.width)} alt={dhaga.cover.alt} loading="lazy" decoding="async"/></BookCover>
      <header>
        <p class="eyebrow">Odia Dhaga · Illustrated collection</p>
        <h2 id="dhaga-title"><a href="/dhaga/">{dhaga.cover.title_english} — <span lang="or">{dhaga.cover.title_odia}</span></a></h2>
        
      </header>
      <div class="book-description">
        <p>Odia sayings carry images, humour and ways of judging everyday life. Explore {dhagaDownload.entries} sayings with Odia and English meanings, usage and illustrations.</p>
        <p class="book-details">{dhagaDownload.entries} sayings · {dhagaDownload.pages} pages</p>
        <p class="cover-credit">Cover illustration: Project Odisha · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>.</p>
      </div>
      <footer class="book-actions">
        <a href="/dhaga/" aria-label={`Read online: ${dhagaTitle}`}>Read online →</a>
      </footer>
    </article>
  </div>
  <section class="books-next" aria-labelledby="books-next-title">
    <h2 id="books-next-title">Continue exploring</h2>
    <p><a href="/explore/">Browse Project Odisha’s articles →</a></p>
    <p><a href="/contribute/?page=%2Fbooks%2F">Suggest an update to this collection</a>. GitHub submissions are public. Please omit private contact details and consent documents.</p>
  </section>
</div>
</Shell>
<style>
  .books-page{inline-size:min(70rem,calc(100% - 2.4rem));margin:3rem auto 5rem}
  .books-intro{max-inline-size:44rem;margin-block-end:2.8rem}
  .books-intro h1{font-size:clamp(2.8rem,6vw,4.5rem);margin-block:.6rem 1.4rem}
  .books-intro>p:not(.eyebrow){font-size:1.12rem;line-height:1.8;margin-block:.75rem}
  .book-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,24rem),1fr));gap:2rem}
  .book-card{display:grid;grid-template-rows:auto auto 1fr auto;gap:1.5rem;min-inline-size:0;padding:clamp(1rem,3vw,2rem);border:1px solid var(--line);background:var(--paper);align-content:start}
  .book-card h2{font-size:clamp(1.9rem,3vw,2.5rem);line-height:1.16;margin-block:.65rem 1rem;overflow-wrap:break-word}
  .book-card h2 a{text-decoration:none}
  .book-card h2 a:hover{text-decoration:underline}
  .book-description{font-size:1.05rem;line-height:1.8;min-inline-size:0}
  .book-description p+p{margin-block-start:1rem}
  .book-details{font-size:.95rem}
  .cover-credit{font-size:.85rem;line-height:1.65;color:var(--muted)}
  .book-actions{display:flex;flex-wrap:wrap;flex-wrap:balance;gap:.75rem 1.25rem;padding-block-start:1.25rem;border-block-start:1px solid var(--line);align-items:safe center}
  .book-actions a{display:inline-block;padding-block:.4rem;font-weight:600;font-size:1rem}
  .books-page a{overflow-wrap:anywhere;text-underline-offset:.2em}
  .books-page a:focus-visible{outline:3px solid var(--sea);outline-offset:4px}
  .books-next{max-inline-size:44rem;margin-block-start:3rem;font-size:1rem;line-height:1.8}
  .books-next h2{font-size:1.8rem;margin-block-end:1rem}
  .books-next p+p{margin-block-start:1rem}
  @media(max-width:400px){.books-page{margin-block-start:2rem}}
</style>
