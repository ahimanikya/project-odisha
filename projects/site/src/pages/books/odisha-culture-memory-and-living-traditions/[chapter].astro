---
import Shell from '../../../layouts/Shell.astro';
import CulturalBookFigure from '../../../components/CulturalBookFigure.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import book from '../../../data/cultural-book.json';
import { paragraphHTML, firstCitation } from '../../../lib/cultural-book.mjs';
import '../../../styles/cultural-book.css';
export function getStaticPaths(){return book.chapters.map((chapter,index)=>({params:{chapter:chapter.slug},props:{chapter,index}}));}
const {chapter,index}=Astro.props;
const previous=book.chapters[index-1],next=book.chapters[index+1];
const part=book.parts.find(p=>p.number===chapter.part)!;
const route=`${book.route}${chapter.slug}/`;
const image=id=>chapter.images.find(i=>i.id===id);
---
<Shell title={`${chapter.title} — ${book.title}`} description={`${chapter.subtitle}. Chapter ${chapter.number} of Odisha: Culture, Memory and Living Traditions, by Ahimanikya Satapathy.`} active="books" related={false} shareImage={book.cover}>
<article class="culture-book culture-reading">
  <nav class="culture-breadcrumbs" aria-label="Breadcrumbs"><ol><li><a href="/books/">Books</a></li><li><a href={book.route}>Culture, Memory and Living Traditions</a></li><li><a href={route} aria-current="page">Chapter {chapter.number}</a></li></ol></nav>
  <header class="culture-chapter-head"><p class="eyebrow">Part {part.number} · {part.title}</p><p class="culture-small">Chapter {chapter.number} of 48</p><h1 id="chapter-title">{chapter.title}</h1><p class="culture-subtitle">{chapter.subtitle}</p><p class="culture-byline">By {chapter.author}</p></header>
  <nav class="culture-chapter-tools" aria-label="Reading tools"><a href={`${book.route}#contents`}>All chapters</a><a href="#references">Footnotes &amp; Sources</a></nav>
  <div class="culture-prose">{chapter.sections.map((section,si)=><section class="culture-section">
    {section.heading && <h2>{section.heading}</h2>}
    {section.image_before && <CulturalBookFigure image={image(section.image_before)} eager={si===0}/>}
    {section.paragraphs.map((paragraph,pi)=><p set:html={paragraphHTML(paragraph,si,pi)}/>)}
    {section.image_after && <CulturalBookFigure image={image(section.image_after)}/>}
  </section>)}</div>
  <section id="references" class="culture-references" aria-labelledby="sources-title"><h2 id="sources-title">Footnotes &amp; Sources</h2><ol>{chapter.notes.map(note=><li id={`source-${note.number}`} value={note.number}><a href={note.url}>{note.title}</a>. {note.detail}{note.license_url && <> <a href={note.license_url}>{note.license}</a></>} {note.extra_url && <a href={note.extra_url}>Additional source</a>} <a class="culture-return" href={note.return_href || firstCitation(chapter,note.number)} aria-label={`Return to source ${note.number} in the chapter`}>↩</a></li>)}</ol><p class="culture-rights">{chapter.imageLicenseStatement}</p></section>
  {chapter.slug === 'growing-up-in-odisha' && <section class="culture-section"><h2>Further reading</h2><p>Read the companion article: <a href="/stories/bagha-chheli-tigers-goats-and-the-rules-of-play/">Bagha Chheli and the Rules of Play</a>.</p></section>}
  {chapter.slug === 'silver-metal-clay-stone-and-applique' && <section class="culture-section"><h2>Further reading</h2><p>Read the companion article: <a href="/stories/jau-kandhei-clay-lac-and-the-makers-of-balasore/">Jau Kandhei and the Doll Makers of Balasore</a>.</p><p>Read the companion article: <a href="/stories/sagada-and-the-work-of-the-bullock-cart/">Sagada: The Work of a Bullock Cart</a>.</p><p>Read the companion article: <a href="/stories/kagaja-mukha-and-the-making-of-a-mask/">Kagaja Mukha and the Paper Masks of Raghurajpur</a>.</p><p><a class="brass-fish-reading" href="/stories/bellaguntha-brass-fish/"><ResponsiveImage src="/images/stories/bellaguntha-brass-fish.jpg" alt="" width={1000} height={667} sizes="176px" loading="lazy"/><span>Bellaguntha’s Brass Fish →</span></a></p><style is:inline>.brass-fish-reading{display:flex;align-items:center;gap:1rem;flex-wrap:wrap}.brass-fish-reading img{width:11rem;max-width:100%;height:auto;object-fit:contain}</style><p><a class="horn-reading" href="/stories/paralakhemundi-horn-craft/"><ResponsiveImage src="/images/stories/paralakhemundi-horn-fish.webp" alt="" width={1200} height={864} sizes="176px" loading="lazy"/><span>Paralakhemundi’s Horn Craft: From Comb to Crane →</span></a></p><p>Museum example; manufacture place unidentified.<sup><a id="horn-reading-reference" href="#source-11" aria-label="Footnote 11">11</a></sup></p><style is:inline>.horn-reading{display:flex;align-items:center;gap:1rem;flex-wrap:wrap}.horn-reading img{width:11rem;max-width:100%;height:auto;object-fit:contain}</style></section>}
  {['silver-metal-clay-stone-and-applique','modern-art-photography-and-public-heritage'].includes(chapter.slug) && <section class="culture-section"><h2>Continue reading</h2><p><a class="binchana-reading" href="/stories/binchana-and-the-handmade-breeze/"><ResponsiveImage src="/images/stories/binchana-from-odisha.webp" alt="" width={960} height={1163} sizes="176px" loading="lazy"/><span>Binchana and the Handmade Breeze →</span></a></p><style is:inline>.binchana-reading{display:flex;align-items:center;gap:1rem;flex-wrap:wrap}.binchana-reading img{width:11rem;max-width:100%;height:auto;object-fit:contain}</style></section>}
  <nav class="culture-next" aria-label="Continue reading">{previous ? <a href={`${book.route}${previous.slug}/`}><span>Previous chapter</span><strong>← {previous.title}</strong></a> : <a href={book.route}><span>The book</span><strong>← Introduction and contents</strong></a>}{next ? <a href={`${book.route}${next.slug}/`}><span>Next chapter</span><strong>{next.title} →</strong></a> : <a href={book.route}><span>The book</span><strong>Return to the contents →</strong></a>}</nav>
  <section class="culture-update"><h2>Suggest an update</h2><p><a href={`/contribute/?page=${encodeURIComponent(route)}`}>Share a correction or source for this chapter</a>. GitHub submissions are public. Please omit private contact details and consent documents.</p></section>
</article>
</Shell>
