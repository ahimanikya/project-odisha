---
import Shell from '../../layouts/Shell.astro';
import ArticleByline from '../../components/ArticleByline.astro';
import ArticleFootnote from '../../components/ArticleFootnote.astro';
import ArticleFootnotes from '../../components/ArticleFootnotes.astro';
import ArticleReadingPath from '../../components/ArticleReadingPath.astro';
import ResearchContents from '../../components/ResearchContents.astro';
import SaveJourney from '../../components/SaveJourney.astro';
import '../../styles/article-reading.css';
import story from '../../../../../kb/research/communities/badhei.json';
const passages=story.sections.flatMap(section=>section.paragraphs.map((paragraph,i)=>({id:`${section.id}-${i}`,source_ids:paragraph.source_ids})));
const contents=[...story.sections.filter(section=>section.title).map(section=>({title:section.title,href:'#'+section.id})),{title:'Further reading',href:'#badhei-further-reading'},{title:'Footnotes & Sources',href:'#story-sources'}];
---
<Shell title={story.title} description={story.description} active="explore" wide related={false}>
<article class="article-reading badhei-story">
 <a class="collection-return" href="/explore/">← Explore Odisha</a>
 <header class="badhei-hero">
  <p class="eyebrow">Odisha · Communities and heritage</p>
  <h1>{story.title}</h1>
  <ArticleByline author={story.author}/>
  <p class="lead">{story.lead}</p>
  <SaveJourney id="reading:badhei" quiet/>
 </header>
 <ResearchContents items={contents} label="In this article"/>
 {story.sections.map(section=><div class="badhei-section" id={section.id}>
  {section.title&&<h2>{section.title}</h2>}
  {section.paragraphs.map((paragraph,i)=><p data-source-ids={paragraph.source_ids.join(' ')}>{paragraph.text}<ArticleFootnote ids={paragraph.source_ids} sources={story.sources} passage={`${section.id}-${i}`}/></p>)}
 </div>)}
 <ArticleReadingPath id="badhei-further-reading" heading="Further reading" links={story.further_reading}/>
 <ArticleFootnotes sources={story.sources} passages={passages}/>
 <p class="badhei-update"><a href="/contribute/?page=%2Fcommunities%2Fbadhei%2F">Suggest an update</a>. GitHub submissions are public; omit private contact details and consent documents.</p>
</article>
</Shell>
<script>
import {bindStorySourceLinks} from '../../lib/story-source-links.mjs';
document.querySelectorAll('.badhei-story sup, .badhei-story .article-footnotes').forEach(group=>bindStorySourceLinks(group,document));
</script>
<style>
.collection-return{display:inline-block;margin:0 0 2rem;font-size:.95rem}
.badhei-hero{border-bottom:1px solid var(--line);padding-bottom:1.25rem}
.badhei-hero .eyebrow{font-size:.75rem;margin-bottom:1rem}
.badhei-hero .lead{font-size:1.25rem;line-height:1.75;margin-top:1.4rem}
.badhei-section{margin-block:3rem}
.badhei-update{font-size:.9rem;line-height:1.75;margin-top:2.5rem}
@media(max-width:600px){.badhei-hero .lead{font-size:1.12rem}.badhei-section{margin-block:2.5rem}}
</style>
