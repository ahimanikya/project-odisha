---
import Shell from '../../layouts/Shell.astro';
import ArticleByline from '../../components/ArticleByline.astro';
import ArticleFootnote from '../../components/ArticleFootnote.astro';
import ArticleFootnotes from '../../components/ArticleFootnotes.astro';
import ResearchContents from '../../components/ResearchContents.astro';
import SaveJourney from '../../components/SaveJourney.astro';
import '../../styles/article-reading.css';
import story from '../../../../../kb/research/communities/sunari.json';
const timeline=story.timeline||[];
const reading=story.further_reading||[];
const passages=[...story.sections.flatMap(s=>s.paragraphs.map((p,i)=>({id:`${s.id}-${i}`,source_ids:p.source_ids}))),...timeline.map((event,i)=>({id:`timeline-${i}`,source_ids:event.source_ids}))];
const contents=[...story.sections.map(s=>({title:s.title,href:'#'+s.id})),...(timeline.length?[{title:'Dates in the story',href:'#sunari-timeline'}]:[]),...(reading.length?[{title:'Further reading',href:'#sunari-further-reading'}]:[]),{title:'Footnotes & Sources',href:'#story-sources'}];
---
<Shell title={story.title} description={story.description||story.lead} active="explore" wide related={false}>
<article class="article-reading sunari-story">
 <a class="collection-return" href="/explore/">← Explore Odisha</a>
 <header class="sunari-hero"><p class="eyebrow">Odisha · Communities and heritage</p><h1>{story.title}</h1>{story.odia&&<p class="sunari-odia" lang="or">{story.odia}</p>}<ArticleByline author={story.author}/><p class="lead">{story.lead}</p><SaveJourney id="reading:sunari" quiet/></header>
 <ResearchContents items={contents} label="In this article"/>
 {story.sections.map(section=><Fragment><section class="sunari-section" aria-labelledby={section.id}><h2 id={section.id}>{section.title}</h2>{section.paragraphs.map((paragraph,i)=><p data-source-ids={paragraph.source_ids.join(' ')}>{paragraph.text}<ArticleFootnote ids={paragraph.source_ids} sources={story.sources} passage={`${section.id}-${i}`}/></p>)}</section>{story.figure?.after_section===section.id&&<figure class="sunari-object"><img src={story.figure.src} width={story.figure.width} height={story.figure.height} alt={story.figure.alt} loading="lazy" decoding="async"/><figcaption><p>{story.figure.caption}</p><p class="object-credit">Photograph: {story.figure.creator} · <a href={story.figure.source}>Original source</a> · <a href={story.figure.license_url}>{story.figure.license}</a>. {story.figure.changes}</p></figcaption></figure>}</Fragment>)}
 {timeline.length>0&&<section class="sunari-timeline" aria-labelledby="sunari-timeline"><h2 id="sunari-timeline">Dates in the story</h2><ol>{timeline.map((event,i)=><li><p class="timeline-date">{event.date}</p><h3>{event.title}</h3><p>{event.text}<ArticleFootnote ids={event.source_ids} sources={story.sources} passage={`timeline-${i}`}/></p></li>)}</ol></section>}
 {reading.length>0&&<section id="sunari-further-reading" class="sunari-further-reading"><details class="utk-disclosure"><summary>Further reading</summary><nav aria-label="Related Odisha reading"><ul>{reading.map(link=><li><a href={link.href}>{link.title} →</a>{link.description&&<p>{link.description}</p>}</li>)}</ul></nav></details></section>}
 <ArticleFootnotes sources={story.sources} passages={passages}/>
 <p class="sunari-update"><a href="/contribute/?page=%2Fcommunities%2Fsunari%2F">Suggest an update</a>. GitHub submissions are public; omit private contact details and consent documents.</p>
</article>
</Shell>
<script>
import {bindStorySourceLinks} from '../../lib/story-source-links.mjs';
document.querySelectorAll('.sunari-story sup, .sunari-story .article-footnotes').forEach(group=>bindStorySourceLinks(group,document));
</script>
<style>
.collection-return{display:inline-block;margin:0 0 2rem;font-size:.95rem}
.sunari-hero{border-bottom:1px solid var(--line);padding-bottom:1.25rem}
.sunari-hero .eyebrow{font-size:.75rem;margin-bottom:1rem}
.sunari-hero .sunari-odia{font-size:1.7rem;color:var(--earth);line-height:1.5;margin-top:-.4rem}
.sunari-hero .lead{font-size:1.25rem;line-height:1.75;margin-top:1.4rem}
.sunari-section{margin-block:3rem}
.sunari-object{margin:3rem 0}
.sunari-object img{display:block;width:100%;height:auto;object-fit:contain}
.sunari-object figcaption p{font-size:.95rem;line-height:1.65;margin:.7rem 0 0}
.sunari-object figcaption .object-credit{font-size:.8rem}
.sunari-timeline{margin:3rem 0}
.sunari-timeline ol{list-style:none;border-left:2px solid var(--line);padding-left:1.5rem}
.sunari-timeline li{position:relative;margin-bottom:2rem;padding-left:0}
.sunari-timeline li::before{position:absolute;content:'';width:.65rem;height:.65rem;border-radius:50%;background:var(--earth);left:-1.89rem;top:.5rem}
.sunari-timeline .timeline-date{font-size:.85rem;font-weight:700;color:var(--earth);margin:0 0 .3rem}
.sunari-timeline h3{margin:0 0 .6rem}
.sunari-timeline li>p:last-child{font-size:1rem;line-height:1.75}
.sunari-further-reading{margin-top:3rem}
.sunari-further-reading p{font-size:.95rem;margin-bottom:0}
.sunari-update{font-size:.9rem;line-height:1.75;margin-top:2.5rem}
@media(max-width:600px){.sunari-hero .lead{font-size:1.12rem}.sunari-section{margin-block:2.5rem}}
</style>
