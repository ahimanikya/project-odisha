---
import Shell from '../../layouts/Shell.astro';
import MagazineArticle from '../../components/MagazineArticle.astro';
import {allowsPage} from '../../data/edition';
import data from '../../../../../kb/research/culture/craft-stories.json';
export function getStaticPaths(){return data.pages.map(entry=>({params:{slug:entry.slug},props:{entry}}));}
const {entry}=Astro.props;
const photos=Object.fromEntries(entry.sections.filter(s=>s.photo).map(s=>[s.id,data.assets[s.photo]]));
const credits=[...new Set([entry.hero,...entry.sections.filter(s=>s.photo).map(s=>s.photo)])].map(id=>data.assets[id]);
const sourceIds=[...new Set(entry.sections.flatMap(s=>s.paragraphs.flatMap(p=>p.source_ids)))];
---
<Shell title={entry.title} description={entry.lead} active="explore" wide related={false}>
 <MagazineArticle kind="culture" title={entry.cover_title||entry.title} subtitle={entry.cover_subtitle} odia={entry.odia} eyebrow={'A craft of Odisha · '+entry.area} deck={[entry.lead]} photo={data.assets[entry.hero]} saveId={entry.save_id} sections={entry.sections} sectionPhotos={photos} chapterLabel="The person behind the work" startLabel="Follow the detail" footline="Look closely. Ask gently. Remember the maker.">
  <nav class="craft-onward" aria-label="Continue the craft story"><a href="/crafts/">Made by hand in Odisha →</a>{entry.related.filter(link=>allowsPage(link.href)).map(link=><a href={link.href}>{link.title} →</a>)}<a href="/journey/">Open my journey →</a></nav>
  <details class="mag-article-credits"><summary>Sources, photographs & editorial notes</summary><p>Research checked {entry.checked_on}. Documentary photographs and attributed process accounts; no named workshop, current appointment, price or material certification verified. Odia names and craft terminology await local review.</p><ul>{sourceIds.map(id=><li><a href={data.sources[id].url}>{data.sources[id].title}</a><p>{data.sources[id].inspection}</p></li>)}</ul>{credits.map(p=><p><a href={p.source}>{p.caption}</a> · {p.creator} · <a href={p.license_url}>{p.license}</a>. {p.changes}</p>)}<p>Project Odisha knowledge base. Founder & Editor-in-Chief: Ahimanikya Satapathy. Prepared with AI assistance; human editorial review pending.</p></details>
 </MagazineArticle>
</Shell>
<style>.craft-onward{display:flex;flex-wrap:wrap;gap:1rem 2rem;padding:2rem 0;border-top:1px solid var(--line)}.craft-onward a{display:inline-flex;align-items:center;min-height:44px}</style>
