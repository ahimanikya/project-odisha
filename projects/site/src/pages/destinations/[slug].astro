---
import Shell from '../../layouts/Shell.astro';
import RegionMagazine from '../../components/RegionMagazine.astro';
import SaveJourney from '../../components/SaveJourney.astro';
import CultureConnections from '../../components/CultureConnections.astro';
import data from '../../../../../kb/research/destinations/regions.json';
export function getStaticPaths(){return data.regions.map(region=>({params:{slug:region.slug},props:{region}}));}
const {region:r}=Astro.props;
const hero=data.assets[r.hero];
const photos=[...new Set([r.hero,...r.items.map(i=>i.asset).filter(Boolean)])].map(id=>data.assets[id]);
const sourceIds=[...new Set([...r.source_ids,...r.facts.flatMap(f=>f.source_ids),...r.items.flatMap(i=>i.source_ids),...r.sections.flatMap(s=>s.paragraphs.flatMap(p=>p.source_ids))])];
const next=data.regions.find(region=>region.slug===r.next);
---
<Shell title={`${r.title}: places, food & living culture`} description={r.orientation} active="explore" wide related={!["bhubaneswar","puri","cuttack","balasore","mayurbhanj"].includes(r.slug)}>
 {["bhubaneswar","puri","cuttack","balasore","mayurbhanj"].includes(r.slug)?<RegionMagazine region={r}/>:<div class="wrap region-guide">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/explore/?topic=Places">Explore Odisha</a><span aria-hidden="true"> / </span><span>{r.title}</span></nav>
  <header class="region-hero">
   <div class="region-opening"><p class="eyebrow">{r.kicker}</p><h1>{r.title}<span lang="or">{r.odia}</span></h1><h2>{r.headline}</h2><p class="lead">{r.lead}</p><SaveJourney id={r.id}/></div>
   <figure><img src={hero.src} width={hero.width} height={hero.height} alt={hero.alt} fetchpriority="high"/><figcaption>{hero.caption}</figcaption></figure>
  </header>
  <nav class="region-jumps" aria-label="In this guide"><a href="#at-a-glance">At a glance</a><a href="#choose-your-stops">Places & experiences</a><a href="#stories">Culture & stories</a><a href="#before-you-go">Before you go</a><a href="#sources">Sources & credits</a></nav>
  <section id="at-a-glance" class="region-glance" aria-label="At a glance">{r.facts.map(f=><div><p class="eyebrow">{f.label}</p><p>{f.text}</p></div>)}</section>
  <section id="choose-your-stops" class="region-stops"><div class="section-heading"><div><p class="eyebrow">Build your own visit</p><h2>Choose a few. Leave room to linger.</h2></div><p>Save places, meals and ideas to your journey. These are starting points for planning; confirm access and arrangements before travelling.</p></div>
   {[{label:'Places and stories in pictures',items:r.items.filter(i=>i.asset),visual:true},{label:'More ways to make it yours',items:r.items.filter(i=>!i.asset),visual:false}].filter(group=>group.items.length).map(group=><div class="region-stop-group"><h3 class="group-label">{group.label}</h3><div class:list={['region-cards',{'visual-stops':group.visual,'compact-stops':!group.visual}]}>{group.items.map(i=><article id={i.id.replaceAll(':','-')} class:list={['region-card',{'with-image':Boolean(i.asset)}]}>
    {i.asset&&<figure><img src={data.assets[i.asset].src} width={data.assets[i.asset].width} height={data.assets[i.asset].height} alt={data.assets[i.asset].alt} loading="lazy" class:list={{'script-image':i.asset==='script','portrait-image':i.asset==='fakir'}}/><figcaption>{data.assets[i.asset].caption}</figcaption></figure>}
    <div class="region-card-body"><p class="eyebrow"><span class="stop-number">{String(r.items.indexOf(i)+1).padStart(2,'0')}</span> {i.kind}</p><h3>{i.title}</h3><p>{i.summary}</p><p class="region-tip"><strong>Our suggestion</strong> {i.tip}</p>{i.link&&<a class="text-link" href={i.link.href}>{i.link.title} →</a>}<SaveJourney id={i.id}/></div>
   </article>)}</div></div>)}
  </section>
  {r.sections.map(s=><section id={s.id} class="region-story"><h2>{s.title}</h2><div>{s.paragraphs.map(p=><p>{p.text}</p>)}</div></section>)}
  <CultureConnections path={`/destinations/${r.slug}/`}/>
  <aside class="region-next"><div><p class="eyebrow">Keep exploring Odisha</p><h2>{next.title}</h2><p>{next.lead}</p></div><a class="button utk-button" href={`/destinations/${next.slug}/`}>Explore {next.title} →</a></aside>
  <p class="region-status">Editorial preview · Reference check: {data.checked_on}. Photos show earlier visits. Opening dates, services and conditions can change.</p>
  <details id="sources" class="region-sources"><summary>Sources, image credits & editorial notes</summary><p>Research and original editorial framing for Project Odisha, founded by Ahimanikya Satapathy. Suggestions are editorial ideas; visits, hosts and accommodation have not been field-checked for this preview.</p><ul>{sourceIds.map(id=><li><a href={data.sources[id].url}>{data.sources[id].title}</a><p>{data.sources[id].review}</p></li>)}</ul><h3>Image credits</h3>{photos.map(p=><p><a href={p.source}>{p.caption}</a> By {p.creator} · <a href={p.license_url}>{p.license}</a>. {p.changes}</p>)}<p>Still to research: detailed accessibility, inspected stays, invited local hosts, sourced oral histories, poems, songs and screen locations. We welcome specific corrections and contributions through <a href="/contribute/">Be part of it</a>.</p></details>
 </div>}
</Shell>
<style>
 .region-guide{padding-top:28px;padding-bottom:65px}.breadcrumbs{font-size:14px;margin-bottom:30px}.region-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);align-items:center;gap:55px}.region-opening h1{font-size:clamp(50px,5vw,88px);line-height:1.05;margin:24px 0}.region-opening h1 span{display:block;font-family:OdiaSerif,serif;font-weight:700;letter-spacing:0;font-size:24px;line-height:1.8;color:var(--earth);margin-top:12px}.region-opening h2{font-size:clamp(27px,2.5vw,39px);color:var(--earth);max-width:540px;margin:0 0 20px}.region-opening .lead{font-size:21px}.region-hero figure{margin:0;min-width:0}.region-hero img{width:100%;height:auto;aspect-ratio:1.2;object-fit:cover;display:block}.region-guide figcaption{font-size:12px;line-height:1.6;color:var(--muted);padding:10px 0}.region-jumps{display:flex;gap:14px 30px;flex-wrap:wrap;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:23px 0;margin:42px 0 0;font-size:14px}.region-glance{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));background:var(--paper);padding:30px;gap:35px}.region-glance .eyebrow{margin-bottom:10px}.region-glance p{font-size:16px}.region-stops{margin:65px 0}.section-heading{display:grid;grid-template-columns:1.25fr 1fr;gap:50px;align-items:end;margin-bottom:32px}.section-heading h2{max-width:650px;margin-top:12px}.section-heading>p{max-width:540px}.region-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;align-items:start}.region-card{background:var(--paper);border:1px solid var(--line);min-width:0}.region-card figure{margin:0}.region-card figure img{display:block;width:100%;height:235px;object-fit:cover}.region-card figure img.portrait-image{object-position:center;object-fit:contain;background:var(--paper)}.region-card figure img.script-image{object-fit:contain;padding:45px;background:#e8dbc0}.region-card figcaption{padding:9px 22px;border-bottom:1px solid var(--line)}.region-card-body{padding:27px}.region-card h3{font-size:29px;margin:17px 0}.region-card p{font-size:16px}.stop-number{color:var(--earth);margin-right:10px}.region-card .region-tip{font-size:14px;line-height:1.8;margin:20px 0;color:var(--muted)}.region-tip strong{display:block;color:var(--earth);font-size:12px;text-transform:uppercase;letter-spacing:.08em}.region-card :global(.journey-save .button){font-size:13px;padding:12px 15px}.region-card :global([data-active-journey]){font-size:12px}.region-story{display:grid;grid-template-columns:1fr 1.3fr;gap:65px;padding:40px 0;border-top:1px solid var(--line)}.region-story h2{max-width:520px}.region-story p+p{margin-top:20px}.region-next{display:flex;align-items:center;justify-content:space-between;gap:30px;background:#e8dbc0;padding:35px;margin:30px 0}.region-next p{max-width:600px}.region-next h2{margin:12px 0}.region-status{font-size:13px;margin:30px 0}.region-sources{padding:25px 0;border-top:1px solid var(--line);max-width:950px}.region-sources summary{cursor:pointer;font-weight:bold}.region-sources p,.region-sources li{font-size:14px;margin-top:14px}.region-sources h3{margin-top:28px}.region-guide section,.region-card{scroll-margin-top:30px}
 @media(min-width:1700px){.region-hero img{aspect-ratio:1.5}.region-card figure img{height:300px}}
 @media(max-width:1050px){.region-hero{gap:30px}.region-cards{grid-template-columns:repeat(2,minmax(0,1fr))}.region-story{gap:30px}}
 @media(max-width:720px){.region-hero,.section-heading,.region-story{grid-template-columns:1fr;gap:24px}.region-hero img{aspect-ratio:1.5}.region-cards{grid-template-columns:1fr}.region-glance{grid-template-columns:1fr;gap:24px;padding:25px}.region-opening h1{font-size:51px}.region-next{align-items:start;flex-direction:column}.region-jumps{gap:16px 23px}.region-stops{margin:45px 0}.region-card figure img{height:260px}}
.region-stop-group+.region-stop-group{margin-top:36px}.group-label{font:600 15px/1.6 var(--sans);color:var(--sea);margin-bottom:18px}.region-cards{align-items:stretch;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr))}.region-card{display:flex;flex-direction:column}.region-card-body{display:flex;flex-direction:column;flex:1}.region-card-body :global(.journey-save){margin-top:auto;padding-top:20px}.region-card h3{overflow-wrap:anywhere}.region-story>div{max-width:75ch}.region-jumps a{min-height:44px;display:inline-flex;align-items:center}.region-stop-group .stop-number{display:none}@media(max-width:900px){.region-hero{grid-template-columns:1fr}.region-hero img{aspect-ratio:1.7}.region-opening .lead{max-width:65ch}}
</style>
