---
import Shell from '../../layouts/Shell.astro';
import PlanningPaths from '../../components/PlanningPaths.astro';
import calendar from '../../../../../kb/research/events/arts-literature.json';
const labels={announced:'Announced edition',reported:'Reported · reconfirm',pending:'Awaiting dates',past:'Past edition'};
const groups=[['announced','Dates for your diary','Edition-specific announcements. Check the linked organiser for programme and entry details.'],['reported','Reported dates to reconfirm','Useful leads with unresolved dates or an organiser notice still needed.'],['pending','Festivals and programmes to follow','Established events and programme sources whose next public dates have not been verified.'],['past','Recent editions','A record of Odisha’s cultural calendar. These dates have passed; future editions are not assumed.']];
const categories=[...new Set(calendar.events.map(e=>e.category))].sort();
const cities=[...new Set(calendar.events.map(e=>e.city))].sort();
const events=[...calendar.events].sort((a,b)=>(a.start||'9999').localeCompare(b.start||'9999')||a.title.localeCompare(b.title));
---
<Shell title={calendar.title} description="Explore Odisha’s literature festivals, book fairs, storytelling, art exhibitions and craft celebrations, with sources and edition-specific dates." active="explore" wide related={false}>
<div class="wrap calendar-page">
<header class="page-head"><p class="eyebrow">Odisha · Books, voices & the arts</p><h1>A calendar for<br/><em class="highlight">curious minds.</em></h1><p class="lead">Literature festivals, book fairs, poetry, storytelling, art and craft gatherings across Odisha. Find an occasion to read, listen, look—and take part.</p><p>{calendar.events.length} events and programme sources · Research updated 14 October 2026</p></header>
<PlanningPaths current="/events/arts-literature/"/>
<nav class="jump" aria-label="Calendar sections">{groups.map(([id,title])=><a href={'#'+id}>{title} ↓</a>)}</nav>
<form class="filters" role="search" onsubmit="return false"><label>Find an event<input id="event-search" type="search" placeholder="Festival, place or keyword"/></label><label>Interest<select id="event-category"><option value="">All interests</option>{categories.map(c=><option>{c}</option>)}</select></label><label>Place<select id="event-city"><option value="">All places</option>{cities.map(c=><option>{c}</option>)}</select></label><button type="reset">Clear filters</button></form>
<p id="result-count" role="status" aria-live="polite">Showing all {events.length} entries</p><noscript><p>All entries are shown below. Use the section links to browse.</p></noscript>
{groups.map(([status,title,intro])=><section class="calendar-section" id={status}><h2>{title}</h2><p>{intro}</p><div class="entries">{events.filter(e=>e.status===status).map(event=><article id={event.id} class="entry" data-category={event.category} data-city={event.city} data-search={[event.title,event.city,event.category,event.description].join(' ').toLowerCase()}>
<div class="date"><span class="status">{labels[event.status]}</span><p>{event.date_label}</p><span>{event.city}</span></div><div class="entry-body"><p class="eyebrow">{event.category}</p><h3><a href={'#'+event.id}>{event.title}</a></h3><p>{event.description}</p><p class="note">{event.note}</p><div class="sources">{event.sources.map(s=><a href={s.url}>{s.label} ↗</a>)}</div><small>Source checked {event.checked_on}</small></div>
</article>)}</div></section>)}
<p id="no-results" hidden>No matching entries. Try another place or clear the filters.</p>
<aside class="method"><h2>A growing calendar, with a source for every entry.</h2><p>This first collection includes major festivals and smaller programme sources; it is not yet an exhaustive directory of every district. “Awaiting dates” means no next edition was verified, not that an event has been cancelled. Past dates remain attached to their original year.</p><p>Organiser and government announcements take priority. News reports are labelled. A venue, residency call or procurement notice alone does not confirm public admission. Follow the source link for current timings, registration and accessibility.</p><p>Know a missing event or a changed date? <a href="/contribute/">Share a dated organiser announcement</a>. District book fairs, poetry circles, theatre and independent exhibitions will help this collection grow.</p><p><a href="/events/">Events overview →</a></p></aside>
</div></Shell>
<script>
const search=document.querySelector<HTMLInputElement>('#event-search');
const category=document.querySelector<HTMLSelectElement>('#event-category');
const city=document.querySelector<HTMLSelectElement>('#event-city');
const form=document.querySelector<HTMLFormElement>('.filters');
function filter(){let count=0;document.querySelectorAll<HTMLElement>('.entry').forEach(card=>{const show=(!search?.value||card.dataset.search?.includes(search.value.trim().toLowerCase()))&&(!category?.value||card.dataset.category===category.value)&&(!city?.value||card.dataset.city===city.value);card.hidden=!show;if(show)count++;});document.querySelectorAll<HTMLElement>('.calendar-section').forEach(section=>{section.hidden=!section.querySelector('.entry:not([hidden])');});document.querySelector('#result-count')!.textContent=`Showing ${count} of ${document.querySelectorAll('.entry').length} entries`;document.querySelector<HTMLElement>('#no-results')!.hidden=count!==0;}
form?.addEventListener('input',filter);form?.addEventListener('reset',()=>setTimeout(filter,0));
</script>
<style>
.calendar-page{padding-bottom:64px}.page-head{max-width:1000px}h1{font-size:clamp(44px,6vw,80px);line-height:1.08}.jump{display:flex;gap:12px 24px;flex-wrap:wrap;margin:20px 0}.jump a{min-height:44px;display:flex;align-items:center}.filters{display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:18px;background:var(--paper);padding:24px;margin-top:24px;align-items:end}.filters label{display:grid;gap:8px;font-size:14px}.filters input,.filters select,.filters button{font:inherit;padding:12px;border:1px solid var(--line);border-radius:2px;background:white;min-width:0;min-height:46px;color:var(--ink)}.filters button{cursor:pointer}#result-count{font-size:14px;color:var(--muted)}.calendar-section{border-top:1px solid var(--line);margin-top:36px;padding-top:30px;scroll-margin-top:24px}.calendar-section h2,.method h2{font-size:clamp(28px,3vw,40px);line-height:1.2}.entry{display:grid;grid-template-columns:220px 1fr;gap:35px;padding:30px 0;border-bottom:1px solid var(--line);scroll-margin-top:24px}.entry[hidden],.calendar-section[hidden]{display:none}.date p{font-size:22px;line-height:1.4;color:var(--sea);margin:12px 0}.date span{font-size:14px}.status{display:block;font-weight:600;color:var(--earth)}.entry h3{font-size:28px;line-height:1.25;margin:6px 0 12px}.entry h3 a{text-decoration:none;color:inherit}.entry p{line-height:1.7;margin-top:10px}.entry .eyebrow{font-size:12px;margin:0}.note{color:var(--muted);font-size:14px}.sources{display:flex;gap:12px 24px;flex-wrap:wrap;font-size:14px;margin:14px 0}.entry small{color:var(--muted)}.method{background:var(--paper);padding:30px;margin-top:40px}.method p{line-height:1.8;max-width:80ch}input:focus-visible,select:focus-visible,button:focus-visible,a:focus-visible{outline:3px solid var(--earth);outline-offset:4px}@media(max-width:750px){.filters{grid-template-columns:1fr 1fr;padding:18px}.filters label:first-child{grid-column:1/-1}.entry{grid-template-columns:1fr;gap:16px}.date p{font-size:20px}.entry h3{font-size:26px}.method{padding:22px}}@media(max-width:400px){.filters{grid-template-columns:1fr}}
</style>
