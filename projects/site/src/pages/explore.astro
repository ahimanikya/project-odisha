---
import ResponsiveImage from '../components/ResponsiveImage.astro';
import PlanningPaths from '../components/PlanningPaths.astro';
import {isCoastalEdition} from '../data/edition';
import Shell from '../layouts/Shell.astro';
import {discoveryEntries as entries,discoveryTopics as topics,discoveryRegions as regions} from '../data/discovery';
const images=[...new Map(entries.filter(e=>e.image).map(e=>[e.image.src,e.image])).values()];
---
<Shell title="Explore the collection" active="explore" wide><div class="wrap explore-page"><div class="page-head"><p class="eyebrow">The collection · preview edition</p><h1>Where will curiosity<br/>take you?</h1><p class="lead">A shore, a story, a taste of somewhere. Choose a subject and an area, then follow what draws you in.</p></div>
<PlanningPaths/>
<p class="notice"><a href="/reading-room/">The Odisha reading room →</a> Crafts, livelihoods, trade and places through dated research. <a href="/culture/osha/">Osha, stories & the food year →</a></p>
<p class="notice"><a href="/sounds-of-odisha/">Sounds of Odisha →</a> Voices, instruments and living traditions. <a href="/explore/?q=Sounds%20of%20Odisha">Find the stories in this collection →</a></p>
<form class="filter-form" id="search-form" role="search" aria-label="Search Project Odisha collection"><label for="search" class="utk-field">Search the collection<input id="search" name="q" type="search" maxlength="200" placeholder={isCoastalEdition?'Try Konark, Puri or food':'Try Chilika, textiles or Samanta'} autocomplete="off"/></label><label for="region" class="utk-field">Area or place connection<select id="region" name="region">{regions.map(r=><option value={r}>{r==='All'?'All areas':r}</option>)}</select></label><label class="utk-field" for="sort">Order<select id="sort" name="sort"><option value="collection">Collection order</option><option value="title">Name A–Z</option></select></label><button class="button utk-button" type="submit">Search <span aria-hidden="true">↗</span></button></form>
<nav class="filters" aria-label="Filter by topic">{topics.map(topic=><a href={topic==='All'?'/explore/':'/explore/?topic='+encodeURIComponent(topic)} data-topic={topic} aria-current={topic==='All'?'true':undefined}>{topic} <span data-topic-count>({topic==='All'?entries.length:entries.filter(e=>e.category===topic).length})</span></a>)}</nav><div id="active-filters" class="active-filters" role="group" aria-label="Remove individual filters" hidden><button type="button" data-remove-filter="q" hidden>Remove search</button><button type="button" data-remove-filter="topic" hidden>Remove topic</button><button type="button" data-remove-filter="region" hidden>Remove area</button></div><div class="results-heading"><p class="result-count" id="result-count" tabindex="-1" role="status" aria-live="polite">{entries.length} entries in this preview</p><a href="/explore/" id="clear-filters">Clear filters</a></div><noscript><p class="notice">All entries are shown below. Enable JavaScript to combine search and filters.</p></noscript>
<div class="notes-grid search-results" id="results" role="region" aria-label="Matching collection entries">{entries.map(e=><article class="note-card utk-card" data-entry={JSON.stringify({label:e.label,dek:e.dek,category:e.category,regions:e.regions,aliases:e.aliases})}>{e.image&&<figure class="explore-figure"><ResponsiveImage sizes="(max-width: 650px) 92vw, (min-width: 2080px) 619px, 30vw" class:list={['explore-photo',{'explore-portrait':e.category==='People'&&e.image.fit!=='cover'}]} src={e.image.src} alt={e.image.alt} width={e.image.width} height={e.image.height} loading="lazy"/></figure>}<p class="eyebrow">{e.category} · {e.regions.join(' / ')}</p><h2 class="entry-title"><a href={e.href}>{e.label}</a></h2><p>{e.dek}</p><a href={e.href} class="card-bottom"><span>Read the entry</span><span aria-hidden="true">↗</span></a></article>)}</div><p class="empty" id="empty-results" hidden>No matching entries yet. Try another search or area, or remove a filter above to widen your search. A missing result means our collection is still growing—<a href="/contribute/?new=1">suggest a subject</a>.</p><details class="explore-credits utk-disclosure"><summary>Collection image credits</summary><ul>{images.map(p=><li><a href={p.source}>{p.caption||p.alt}</a> · {p.creator} · <a href={p.license_url}>{p.license}</a>. {p.changes}</li>)}</ul></details><div class="section"><p class="notice">These are editorial previews. Area filters indicate a place or cultural connection, not a verified route or a language’s full geographic range.</p></div></div></Shell>
<script>
 import {bindDiscovery} from '../lib/discovery-browser.mjs';
 bindDiscovery();
</script>
<style>.active-filters{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 20px}.active-filters button{font:inherit;font-size:13px;min-height:44px;padding:10px 14px;border:1px solid var(--sea);color:var(--sea);background:var(--paper);cursor:pointer;max-width:100%;overflow-wrap:anywhere;text-align:left}.filters a{gap:6px}.result-count{overflow-wrap:anywhere;min-width:0}.results-heading #clear-filters{flex-shrink:0}.explore-page .page-head{max-width:1000px;padding-bottom:24px}.explore-page .search-results{gap:44px 32px}.explore-page .note-card{border:0;padding:0;background:transparent;display:flex;flex-direction:column}.explore-page .note-card .card-bottom{margin-top:auto;padding-block:18px}.explore-page .explore-figure{background:var(--paper)}.explore-page .explore-photo{display:block;height:auto;aspect-ratio:1.45}.explore-page .explore-photo.explore-portrait{object-fit:contain}.explore-page .filter-form{padding:24px;background:var(--paper);border-top:2px solid var(--earth);gap:20px}.explore-page .entry-title{font-size:34px}.explore-page .entry-title a{text-decoration:none}.explore-page .entry-title a:hover{text-decoration:underline}.explore-page .note-card>p:not(.eyebrow){line-height:1.7;font-size:16px}.explore-page .filters{margin-top:24px}@media(max-width:950px){.explore-page .filter-form{flex-wrap:wrap}.explore-page .filter-form label:first-child{flex-basis:100%}}.explore-credits{font-size:13px;margin-top:35px;overflow-wrap:anywhere}.explore-credits li{margin:14px 0}.explore-credits summary{padding:12px 0}.explore-figure{margin:0 0 20px}.explore-photo{width:100%;height:210px;object-fit:cover}.explore-figure figcaption{font-size:11px;color:var(--muted);margin-top:6px}.entry-title{font-size:28px;margin-bottom:12px}.filter-form label{min-width:0}.filter-form select{font:inherit;font-size:16px;padding:13px 16px;border:1px solid var(--line);background:var(--light);color:var(--ink);max-width:100%}.results-heading{display:flex;justify-content:space-between;gap:20px;margin-bottom:25px;align-items:center}.results-heading p{margin:0}.results-heading a{font-size:14px;padding:10px 0}.filters a{min-height:44px;display:inline-flex;align-items:center}@media(max-width:700px){.filter-form{flex-direction:column;align-items:stretch}.filter-form label{width:100%}.explore-photo{height:auto;aspect-ratio:1.6}.results-heading{align-items:start}}</style>
