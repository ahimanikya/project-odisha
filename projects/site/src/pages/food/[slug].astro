---
import WhereToEat from '../../components/WhereToEat.astro';
import ChandipurMealArticle from '../../components/ChandipurMealArticle.astro';
import chandipurMealEditorial from '../../../../../kb/research/food/chandipur-meal-editorial.json';
import MudhiMansaArticle from '../../components/MudhiMansaArticle.astro';
import mudhiEditorial from '../../../../../kb/research/food/mudhi-mansa-editorial.json';
import ChhenaPodaArticle from '../../components/ChhenaPodaArticle.astro';
import chhenaEditorial from '../../../../../kb/research/food/chhena-poda-editorial.json';
import MagazineArticle from '../../components/MagazineArticle.astro';
import Shell from '../../layouts/Shell.astro';
import {allowsPage} from '../../data/edition';
import connections from '../../../../../kb/research/related-discoveries.json';
import {discoveryEntries} from '../../data/discovery';
import collection from '../../../../../kb/research/food/collection.json';
export function getStaticPaths(){return collection.pages.map(entry=>({params:{slug:entry.slug},props:{entry}}));}
const {entry}=Astro.props;
const photo=collection.assets[entry.hero];
const sources=[...new Set(entry.sections.flatMap(s=>s.paragraphs.flatMap(p=>p.source_ids)))];
const linked=connections.links.filter(link=>link.from==='/food/'+entry.slug+'/').map(link=>({href:link.to,title:discoveryEntries.find(item=>item.href===link.to)?.label||link.to,reason:link.reason}));
const links=[...new Map([...entry.related,...linked].filter(link=>allowsPage(link.href)).map(link=>[link.href,link])).values(),{title:'Open my journey',href:'/journey/'}];
---
<Shell title={entry.title} description={entry.lead} active="explore" wide related={false}>
 {entry.slug==='chhena-poda'?<ChhenaPodaArticle entry={entry} photo={photo} links={links} editorial={chhenaEditorial}><WhereToEat dishSlug={entry.slug}/></ChhenaPodaArticle>:entry.slug==='mudhi-mansa'?<MudhiMansaArticle entry={entry} photo={photo} links={links} editorial={mudhiEditorial}><WhereToEat dishSlug={entry.slug}/></MudhiMansaArticle>:entry.slug==='balasore'?<ChandipurMealArticle entry={entry} photo={photo} links={links} editorial={chandipurMealEditorial}><WhereToEat dishSlug={entry.slug}/></ChandipurMealArticle>:<MagazineArticle kind="food" title={entry.title} odia={entry.odia} eyebrow={'A taste of Odisha · '+entry.area} deck={[entry.lead]} photo={photo} saveId={entry.save_id} sections={entry.sections} links={links} startLabel="Meet the dish" footline="A taste to remember. A question to take with you.">
  <WhereToEat dishSlug={entry.slug}/>
  <details class="mag-article-credits"><summary>Sources, image credit & editorial notes</summary><p>Research checked {entry.checked_on||collection.checked_on}. Founder & Editor-in-Chief: Ahimanikya Satapathy. Prepared with AI assistance; human editorial review pending.</p><ul>{sources.map(id=><li><a href={collection.sources[id].url}>{collection.sources[id].title}</a><p>{collection.sources[id].inspection}</p></li>)}</ul><p><a href={photo.source}>Photograph</a> by {photo.creator} · <a href={photo.license_url}>{photo.license}</a>. {photo.changes}</p></details><p class="mag-status">Editorial preview · a dish to discover, not a reviewed kitchen.</p>
 </MagazineArticle>}
</Shell>
