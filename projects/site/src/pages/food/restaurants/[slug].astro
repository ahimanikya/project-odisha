---
import Shell from '../../../layouts/Shell.astro';
import directory from '../../../../../../kb/research/food/restaurants.json';
import {allowsPage} from '../../../data/edition';
export function getStaticPaths(){
  return directory.venues.map(venue=>({params:{slug:venue.slug},props:{venue}}));
}
const {venue}=Astro.props;
const visitorNote=typeof venue.visitor_note==='string'?venue.visitor_note.trim():'';
const menuNote=typeof venue.menu_note==='string'?venue.menu_note.trim():'';
const indexedSource=venue.evidence_status.includes('indexed');
const citySlug=venue.city_slug||venue.city.toLowerCase().replace(/[^a-z0-9]+/g,'-');
const city=directory.cities?.find(item=>item.slug===citySlug);
const directoryHref='/food/where-to-eat/#'+citySlug;
const checkedDate=new Date(venue.checked_on+'T00:00:00Z').toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'});
const dishes=venue.dishes.filter(dish=>allowsPage(`/food/${dish.slug}/`));
const pageDescription=venue.description.length<50
  ?`${venue.name} in ${venue.city}: ${venue.description} Find location details and the operator’s website to plan your visit.`
  :venue.description;
---
<Shell title={`${venue.name} · ${venue.city}`} description={pageDescription} active="explore" related={false}>
  <article class="wrap restaurant-profile">
    {allowsPage('/food/where-to-eat/')&&<a class="text-link" href={directoryHref}>← Where to eat in {venue.city}</a>}
    <header class="restaurant-opening">
      <p class="eyebrow">{venue.city} · {venue.category==='odia'?'Odia dining':venue.category==='experience'?'Dining experience':'Where to eat'}</p>
      <h1>{venue.name}</h1>
      <p class="restaurant-lead">{venue.description}</p>
    </header>
    <section class="restaurant-visit" aria-labelledby="restaurant-visit-title">
      <div>
        <h2 id="restaurant-visit-title">Plan a meal</h2>
        <p class="restaurant-location">{venue.area}<br/>{venue.city}</p>
        {visitorNote&&<p class="restaurant-visitor-note"><strong>For your visit</strong>{visitorNote}</p>}
        <div class="restaurant-actions">
          <a class="utk-button" href={venue.website}>{venue.link_label} <span aria-hidden="true">↗</span></a>
          {venue.menu&&<a class="utk-button utk-button--secondary" href={venue.menu}>Explore the menu <span aria-hidden="true">↗</span></a>}
          {venue.phone&&<a class="restaurant-phone" href={`tel:${venue.phone}`}>Call {venue.phone_label||venue.phone}</a>}
        </div>
        {venue.menu&&menuNote&&<p class="restaurant-advice">{menuNote}</p>}
        <p class="restaurant-advice">Check the current menu, opening hours and prices directly. For hotel or resort restaurants, confirm dining access if you are not staying there. If you have dietary needs, ask about ingredients and preparation before ordering.</p>
      </div>
    </section>
    {dishes.length>0&&<section class="restaurant-stories" aria-labelledby="restaurant-stories-title">
      <p class="eyebrow">A little more to savour</p>
      <h2 id="restaurant-stories-title">The stories behind the dishes</h2>
      <p>The restaurant lists these dishes on its website. Read about them before you visit, and ask what is available that day.</p>
      <nav aria-label="Dish stories">{dishes.map(dish=><a href={`/food/${dish.slug}/`}>{dish.label} <span aria-hidden="true">→</span></a>)}</nav>
    </section>}
    <footer class="restaurant-details">
      {indexedSource
        ?<p>Based on search-indexed information from the <a href={venue.website}>operator’s website</a>, reviewed {checkedDate}. We could not verify the live page; confirm the location and dining service before travelling.</p>
        :<p>Operator information reviewed {checkedDate}. <a href={venue.website}>Visit the operator’s website</a> for updates.</p>}
      <div class="restaurant-onward">
        {city?.guide&&allowsPage(city.guide)&&<a href={city.guide}>Explore {venue.city}’s food →</a>}
        {city?.destination&&allowsPage(city.destination)&&<a href={city.destination}>Plan a visit to {venue.city} →</a>}
        {allowsPage('/food/where-to-eat/')&&<a href={directoryHref}>More places in {venue.city} →</a>}
      </div>
    </footer>
  </article>
</Shell>
<style>
  .restaurant-profile{max-width:900px;padding-block:28px 64px}.restaurant-opening{margin-top:34px}.restaurant-opening h1{font:clamp(42px,5vw,70px)/1.1 var(--serif);color:var(--sea);margin:18px 0 26px;overflow-wrap:break-word}.restaurant-lead{font:clamp(22px,2.5vw,29px)/1.6 var(--serif);max-width:48ch}.restaurant-visit{margin-top:38px;padding:32px;background:var(--paper);border-top:3px solid var(--earth)}.restaurant-profile h2{font:clamp(28px,3vw,38px)/1.2 var(--serif);color:var(--sea);margin-bottom:20px}.restaurant-location{font-size:17px;line-height:1.8}.restaurant-visitor-note{font-size:16px;line-height:1.8;max-width:65ch;margin-top:22px}.restaurant-visitor-note strong{display:block;font-size:14px;color:var(--sea);margin-bottom:6px}.restaurant-actions{display:flex;align-items:center;flex-wrap:wrap;gap:14px 20px;margin:24px 0}.restaurant-actions a{min-height:44px}.restaurant-actions span{margin-left:8px}.restaurant-phone{display:inline-flex;align-items:center;color:var(--sea);font-size:15px;text-underline-offset:5px}.restaurant-advice{font-size:14px;line-height:1.8;max-width:68ch}.restaurant-stories{margin-top:44px}.restaurant-stories>p{line-height:1.8;max-width:65ch}.restaurant-stories nav{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}.restaurant-stories nav a{display:inline-flex;align-items:center;gap:12px;padding:12px 18px;border:1px solid var(--line);color:var(--sea);min-height:44px;font-size:16px;text-underline-offset:4px}.restaurant-details{margin-top:44px;padding-top:22px;border-top:1px solid var(--line);font-size:13px;line-height:1.8;color:var(--muted)}.restaurant-details a{color:var(--sea)}.restaurant-onward{display:flex;flex-wrap:wrap;gap:8px 28px;margin-top:18px}.restaurant-onward a{display:inline-flex;align-items:center;min-height:44px;font-size:14px;text-underline-offset:5px}@media(max-width:650px){.restaurant-opening{margin-top:24px}.restaurant-visit{padding:24px}.restaurant-actions{align-items:flex-start;flex-direction:column}.restaurant-profile{padding-bottom:44px}}
</style>
