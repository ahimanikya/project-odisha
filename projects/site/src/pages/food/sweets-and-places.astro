---
import Shell from '../../layouts/Shell.astro';
import ArticleByline from '../../components/ArticleByline.astro';
import ArticleFootnote from '../../components/ArticleFootnote.astro';
import ArticleFootnotes from '../../components/ArticleFootnotes.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import '../../styles/article-reading.css';
import story from '../../../../../kb/research/food/sweets-and-places.json';
import foods from '../../../../../kb/research/food/collection.json';
const passageId=(section:string,id:string)=>`sweets-${section}-${id}`;
const passages=[...story.intro.map(p=>({id:passageId('intro',p.id),source_ids:p.source_ids})),...story.entries.flatMap(entry=>entry.paragraphs.map(p=>({id:passageId(entry.id,p.id),source_ids:p.source_ids}))),...story.closing.map(p=>({id:passageId('closing',p.id),source_ids:p.source_ids}))];
const photoFor=(key:string)=>foods.assets[key as keyof typeof foods.assets];
---
<Shell title={story.title} description={story.lead} active="explore" wide related={false}>
<article class="article-reading sweets-and-places">
<a class="collection-return" href="/food/">← Food & flavours</a>
<header><p class="eyebrow">Odisha’s sweets & the places we remember</p><h1>{story.title}</h1><ArticleByline author={story.author} reviewedOn={story.reviewed_on}/><p class="lead">{story.lead}</p></header>
{story.intro.map(p=><p>{p.text}<ArticleFootnote ids={p.source_ids} sources={story.sources} passage={passageId('intro',p.id)}/></p>)}
<nav class="sweet-contents" aria-label="Find a sweet"><ul>{story.entries.map(entry=><li><a href={'#'+entry.id}>{entry.name}</a></li>)}</ul></nav>
{story.entries.map(entry=><section class="sweet-entry" aria-labelledby={entry.id}>
<h2 id={entry.id}>{entry.name}</h2><p class="sweet-places">{entry.places.join(' · ')}</p>
{entry.photo&&(()=>{const photo=photoFor(entry.photo.asset);return <figure><ResponsiveImage src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" sizes="(max-width: 740px) 92vw, 700px"/><figcaption>{entry.photo.caption||photo.caption} <a href={photo.source}>{photo.creator}</a> · <a href={photo.license_url}>{photo.license}</a>. {photo.changes}</figcaption></figure>})()}
{entry.paragraphs.map(p=><p>{p.text}<ArticleFootnote ids={p.source_ids} sources={story.sources} passage={passageId(entry.id,p.id)}/></p>)}
{entry.reading?.length>0&&<p class="sweet-reading">{entry.reading.map((link,i)=><>{i>0&&' · '}<a href={link.href}>{link.title} →</a></>)}</p>}
</section>)}
<section aria-labelledby="before-you-go"><h2 id="before-you-go">Before you go</h2>{story.closing.map(p=><p>{p.text}<ArticleFootnote ids={p.source_ids} sources={story.sources} passage={passageId('closing',p.id)}/></p>)}</section>
<ArticleFootnotes sources={story.sources} passages={passages}/>
<details class="utk-disclosure sweets-reading" id="reading-paths"><summary>Further reading</summary><ul>{story.further_reading.map(link=><li><a href={link.href}>{link.title} →</a></li>)}</ul></details>
<p class="sweets-update"><a href="/contribute/?page=%2Ffood%2Fsweets-and-places%2F">Suggest an update</a>. GitHub submissions are public; omit private contact details and consent documents.</p>
</article>
</Shell>
<style>
.collection-return{display:inline-block;margin-bottom:2rem}.sweets-and-places header .eyebrow{font-size:.78rem}.sweets-and-places .lead{font-size:1.2rem;line-height:1.75;margin-bottom:2rem}.sweet-contents{padding:.5rem 1.2rem;background:var(--paper);margin:2rem 0}.sweet-contents ul{display:grid;grid-template-columns:1fr 1fr;gap:.4rem 1.7rem;list-style:none;padding:0;margin:1rem 0}.sweet-contents li{padding:0;margin:0}.sweet-contents a{display:inline-block;padding:.35rem 0}.sweet-places{font-size:.9rem;font-weight:600;color:var(--sea)}.sweet-reading{font-size:.95rem}.sweets-reading{margin-block:3rem 2rem}.sweets-reading summary{padding:.8rem 0;cursor:pointer}.sweets-update{font-size:.9rem}@media(max-width:500px){.sweet-contents ul{grid-template-columns:1fr}}
</style>
