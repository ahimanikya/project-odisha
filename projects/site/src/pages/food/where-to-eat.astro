---
import Shell from '../../layouts/Shell.astro';
import directory from '../../../../../kb/research/food/restaurants.json';
import {allowsPage} from '../../data/edition';
const venues=directory.venues.map(venue=>({...venue,visitor_note:'visitor_note' in venue&&typeof venue.visitor_note==='string'?venue.visitor_note.trim():''})).filter(venue=>allowsPage(`/food/restaurants/${venue.slug}/`));
type City={slug:string;name:string;guide?:string;destination?:string};
const citySlug=(venue:typeof venues[number])=>venue.city_slug||venue.city.toLowerCase().replace(/[^a-z0-9]+/g,'-');
const cities:City[]=directory.cities||Array.from(new Map(venues.map(venue=>[citySlug(venue),{slug:citySlug(venue),name:venue.city}])).values());
const groups=cities.map(city=>({...city,sections:[
  {title:'Odia dining',venues:venues.filter(venue=>citySlug(venue)===city.slug&&venue.category==='odia')},
  {title:'More places to eat',venues:venues.filter(venue=>citySlug(venue)===city.slug&&venue.category!=='odia'&&venue.category!=='experience')},
  {title:'Dining experiences',venues:venues.filter(venue=>citySlug(venue)===city.slug&&venue.category==='experience')}
].filter(section=>section.venues.length)}));
const checkedDate=new Date(directory.checked_on+'T00:00:00Z').toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'});
---
<Shell title="Where to eat in Odisha" description={directory.intro} active="explore" wide={true} related={false}>
  <div class="wrap dining-directory">
    <header class="dining-opening">
      <p class="eyebrow">Food & flavours</p>
      <h1>Where to eat<br/><em>in Odisha.</em></h1>
      <p class="dining-lead">{directory.intro}</p>
      <p class="dining-intro-note"><strong>Before you go.</strong> {directory.note}</p>
      <form class="dining-search" role="search" aria-label="Search places to eat" hidden>
        <label for="dining-query">Find a restaurant, place or cuisine</label>
        <div class="dining-search-controls"><input id="dining-query" name="q" type="search" placeholder="Try Puri, Odia or seafood" aria-controls="dining-results" autocomplete="off"/><button type="reset">Clear search</button></div>
        <p class="dining-search-status" role="status" aria-live="polite" aria-atomic="true"></p>
      </form>
      <nav class="dining-nav" aria-label="Choose a place">
        {cities.map(city=><a href={'#'+city.slug}>{city.name}</a>)}
      </nav>
    </header>
    <div id="dining-results">
    <p class="dining-no-results" hidden>No matching places. Try a different name, place or cuisine, or clear the search to see every listing.</p>
    {groups.map(city=><section class="dining-group" id={city.slug} aria-labelledby={`${city.slug}-title`}>
      <div class="dining-group-heading">
        <div><p class="eyebrow">Find a table in</p><h2 id={`${city.slug}-title`}>{city.name}</h2></div>
        <div class="dining-city-links">
          {city.guide&&allowsPage(city.guide)&&<a href={city.guide}>Explore the food guide →</a>}
          {city.destination&&allowsPage(city.destination)&&<a href={city.destination}>Plan a visit →</a>}
        </div>
      </div>
      {city.sections.map(section=><div class="dining-city-section" id={city.slug==='bhubaneswar'?(section.title==='Odia dining'?'odia-dining':section.title==='More places to eat'?'more-places':'dining-experiences'):undefined}>
        <h3 class="dining-section-label">{section.title}</h3>
        <div class="dining-grid">{section.venues.map(venue=><article class="dining-card" data-search={[venue.name,venue.city,venue.area,venue.category==='odia'?'Odia':venue.category==='experience'?'Dining experience':'',venue.description,venue.visitor_note].join(' ')}>
          <p class="dining-area">{venue.area}</p>
          <h4><a href={`/food/restaurants/${venue.slug}/`}>{venue.name}</a></h4>
          <p>{venue.description}</p>
          {venue.visitor_note&&<p class="dining-visitor-note"><strong>For your visit</strong>{venue.visitor_note}</p>}
          <div class="dining-actions">
            <a href={`/food/restaurants/${venue.slug}/`} aria-label={`Explore this place: ${venue.name}`}>Explore this place <span aria-hidden="true">→</span></a>
            <a href={venue.website} aria-label={`${venue.link_label}: ${venue.name}`}>{venue.link_label} <span aria-hidden="true">↗</span></a>
          </div>
        </article>)}</div>
      </div>)}
      {!city.sections.length&&<p class="dining-pending">We are gathering places to eat in {city.name}. Explore another city for now.</p>}
      <a class="dining-return" href="#page-top">Choose another place ↑</a>
    </section>)}
    </div>
    <p class="dining-date">Directory reviewed {checkedDate}.</p>
    {allowsPage('/food/')&&<a class="text-link" href="/food/">Explore more food & flavours →</a>}
  </div>
</Shell>
<script>
  const directoryElement=document.querySelector<HTMLElement>('.dining-directory');
  const form=directoryElement?.querySelector<HTMLFormElement>('.dining-search');
  const input=form?.querySelector<HTMLInputElement>('#dining-query');
  const status=form?.querySelector<HTMLElement>('.dining-search-status');
  const noResults=directoryElement?.querySelector<HTMLElement>('.dining-no-results');
  if(directoryElement&&form&&input&&status&&noResults){
    const cards=Array.from(directoryElement.querySelectorAll<HTMLElement>('.dining-card'));
    const categories=Array.from(directoryElement.querySelectorAll<HTMLElement>('.dining-city-section'));
    const cityGroups=Array.from(directoryElement.querySelectorAll<HTMLElement>('.dining-group'));
    const normalize=(text:string)=>text.normalize('NFKC').toLocaleLowerCase().trim();
    const searchable=new Map(cards.map(card=>[card,normalize(card.dataset.search||'')]));
    const filter=()=>{
      const terms=normalize(input.value).split(/\s+/).filter(Boolean);
      let count=0;
      for(const card of cards){
        card.hidden=!terms.every(term=>searchable.get(card)!.includes(term));
        if(!card.hidden)count++;
      }
      for(const category of categories)category.hidden=terms.length>0&&!category.querySelector('.dining-card:not([hidden])');
      for(const group of cityGroups)group.hidden=terms.length>0&&!group.querySelector('.dining-card:not([hidden])');
      noResults.hidden=count>0||terms.length===0;
      status.textContent=terms.length?`Showing ${count} of ${cards.length} listings.`:`Showing all ${cards.length} listings. Choose a place below or search to narrow the list.`;
    };
    const clear=()=>{input.value='';filter();};
    form.addEventListener('submit',event=>event.preventDefault());
    input.addEventListener('input',filter);
    form.addEventListener('reset',event=>{event.preventDefault();clear();input.focus();});
    // Restore targets before native navigation, including repeat clicks on the current hash.
    directoryElement.querySelector('.dining-nav')?.addEventListener('click',event=>{
      if((event.target as Element)?.closest('a[href^="#"]'))clear();
    },true);
    window.addEventListener('hashchange',()=>{
      let id;try{id=decodeURIComponent(window.location.hash.slice(1));}catch{return;}
      const target=document.getElementById(id);
      if(input.value&&target?.closest('.dining-group')){clear();target.scrollIntoView({block:'start',behavior:'instant'});}
    });
    filter();
    form.hidden=false;
  }
</script>
<style>
  .dining-directory{padding-block:40px 72px}.dining-opening{max-width:960px}.dining-opening h1{font:clamp(42px,5.8vw,78px)/1.08 var(--serif);color:var(--sea);margin:18px 0 26px;letter-spacing:-.025em}.dining-opening h1 em{color:var(--earth);font-weight:400}.dining-lead{max-width:67ch;font-size:19px;line-height:1.8}.dining-intro-note{max-width:76ch;margin-top:20px;font-size:14px;line-height:1.8;color:var(--muted)}.dining-intro-note strong{color:var(--sea)}.dining-search{margin-top:28px;max-width:760px}.dining-search label{display:block;font-size:15px;font-weight:600;color:var(--sea);margin-bottom:10px}.dining-search-controls{display:flex;gap:12px}.dining-search input{min-width:0;flex:1;padding:13px 16px;font:inherit;font-size:16px;line-height:1.5;border:1px solid var(--muted);background:var(--paper);color:var(--ink);border-radius:0}.dining-search button{font:inherit;font-size:14px;line-height:1.5;color:var(--sea);border:1px solid var(--sea);background:transparent;padding:12px 18px;min-height:48px;cursor:pointer}.dining-search-status{font-size:13px;line-height:1.7;margin-top:10px;color:var(--muted)}.dining-no-results{font-size:17px;line-height:1.8;padding:28px;background:var(--paper);margin-top:30px}.dining-nav{display:flex;flex-wrap:wrap;gap:12px 30px;padding-block:18px;margin-top:30px;border-block:1px solid var(--line)}.dining-nav a,.dining-actions a{display:inline-flex;align-items:center;min-height:44px;color:var(--sea);font-size:14px;text-underline-offset:5px}.dining-group{margin-top:54px;padding-top:32px;border-top:1px solid var(--line);scroll-margin-top:24px}.dining-group-heading{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:28px}.dining-group h2{font:clamp(31px,3.4vw,46px)/1.2 var(--serif);color:var(--sea);margin-bottom:16px}.dining-group-heading p{line-height:1.8}.dining-city-links{display:flex;flex-wrap:wrap;gap:4px 24px}.dining-city-links a,.dining-return{display:inline-flex;align-items:center;min-height:44px;color:var(--sea);font-size:14px;text-underline-offset:5px}.dining-city-section+.dining-city-section{margin-top:32px}.dining-section-label{font-size:15px;line-height:1.5;color:var(--earth);margin-bottom:18px;font-family:inherit;font-weight:600}.dining-return{margin-top:22px}.dining-pending{font-size:16px;line-height:1.8}.dining-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.dining-card{min-width:0;padding:28px;background:var(--paper);border-top:3px solid var(--earth);display:flex;flex-direction:column}.dining-card h4{font:29px/1.22 var(--serif);color:var(--sea);margin:14px 0 18px}.dining-card h4 a{text-decoration:none}.dining-card h4 a:hover{text-decoration:underline;text-underline-offset:5px}.dining-card p{font-size:15px;line-height:1.75}.dining-card .dining-area{font-size:12px;color:var(--muted);margin:0}.dining-card .dining-visitor-note{margin-top:18px;padding-top:16px;border-top:1px solid var(--line);font-size:14px;line-height:1.8}.dining-visitor-note strong{display:block;color:var(--sea);font-size:13px;margin-bottom:6px}.dining-actions{display:flex;flex-wrap:wrap;gap:4px 20px;margin-top:auto;padding-top:24px}.dining-actions span{margin-left:6px}.dining-date{color:var(--muted);font-size:13px;line-height:1.8;margin:40px 0 20px}@media(max-width:1000px){.dining-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.dining-directory{padding-block:28px 48px}.dining-grid{grid-template-columns:1fr}.dining-card{padding:24px}.dining-lead{font-size:17px}.dining-nav{gap:4px 24px}.dining-group-heading{display:block}.dining-city-links{margin-top:12px}.dining-group{margin-top:38px}.dining-search-controls{flex-wrap:wrap}.dining-search input{flex-basis:100%}}
</style>
