---
import Shell from '../../layouts/Shell.astro';
import data from '../../../../../kb/research/references/data/odisha-heritage-walks-20261019.json';
const places=[...new Set(data.walks.map(w=>w.place))].sort();
const rank=(w:any)=>w.status.startsWith('Dated')?0:w.group==='Official listings'?1:w.group==='Private enquiries'?2:w.group==='Community walks'?3:4;
const walks=[...data.walks].sort((a,b)=>rank(a)-rank(b)||a.place.localeCompare(b.place));
const eventEnd=(w:any)=>w.id==='community-7'?'2026-10-25T11:00:00+05:30':w.id==='ekamra-living-temple-city'?'2026-10-21T09:30:00+05:30':w.id==='ekamra-dhauli-peace-walk'?'2026-10-20T09:30:00+05:30':w.id.startsWith('ekamra-mystical')?'2026-10-19T09:30:00+05:30':'';
const action=(w:any)=>w.id==='community-7'?'See registration details':w.group==='Community walks'?'Find the next community walk':w.group==='Private enquiries'?'Request dates and a quote':w.status.includes('Sold out')||w.status.includes('closed')?'Check other dates':'Check dates with organiser';
const phone=(c:string)=>c.split(/[\/·]/)[0].replace(/[^+0-9]/g,'');
const groups=[...new Set(data.walks.map(w=>w.group))];
---
<Shell title="Heritage walks in Odisha" description="Find heritage walks in Odisha, with booking links, best times, meeting points and practical visitor information." active="explore" wide related={false}>
<div class="wrap heritage-directory">
<header class="page-head walk-opening"><p class="breadcrumb"><a href="/things-to-do/">Things to do</a> <span aria-hidden="true">/</span> Heritage walks</p><p class="eyebrow">Explore Odisha on foot · checked 19 October 2026</p><h1>Heritage walks <em class="highlight">in Odisha</em></h1><p class="lead">Find old-town lanes, temple precincts, artisan neighbourhoods and community stories — then book directly with the organiser.</p><p class="opening-note">60 researched entries. A listing is not a confirmed departure; routes involving road travel and nature excursions are labelled.</p></header>

<section id="finder" aria-label="Find a walk" class="finder filter-form"><h2>Where would you like to walk?</h2><label for="search">Search<input id="search" type="search" placeholder="Try Puri, filigree, museum…"/></label><label for="place">Place<select id="place"><option value="">Every place</option>{places.map(p=><option>{p}</option>)}</select></label><label for="group">Programme<select id="group"><option value="">Every programme</option>{groups.map(g=><option>{g}</option>)}</select></label><label for="availability">Availability<select id="availability"><option value="">All availability</option><option value="dated">Dated options to check</option><option value="enquiry">Enquiry or date confirmation needed</option><option value="unavailable">Closed, sold out or seasonal</option></select></label><label class="check"><input id="saved-only" type="checkbox"/> My shortlist</label><label class="check"><input id="nature" type="checkbox"/> Include nature excursions</label><button class="utk-button utk-button--secondary" id="reset">Reset filters</button></section><p class="help">Times are IST. “Dated” means advertised on the checked date, not a reserved seat. Save walks on this browser to compare them. Nature excursions are hidden initially.</p><section class="dates"><h2>Dates worth checking first</h2><p><a href="https://odishaheritagewalks.com/detail.php?id=82">Khordha · 25 October, 9–11am</a> — free; register by phone. <a href="https://www.ekamra-walks.com/event-details/living-temple-city">Ekamra Living Temple City · 21 October, 5:30–9:30am</a> — ₹100 advertised; a ticket selector was visible when checked. The 20 October Dhauli event was sold out. Recheck before travelling.</p></section><p id="count" role="status" aria-live="polite"></p><div id="empty" hidden><h2>No matching walks</h2><p>Try a nearby place, remove a filter, or include nature excursions. No organised departure is currently verified here for Sonepur (Sonpur/Subarnapur).</p><button class="utk-button utk-button--secondary" id="clear-empty">Show all heritage entries</button></div><p id="save-feedback" role="status" aria-live="polite"></p><noscript><p>All 60 entries are shown below. Search filters require JavaScript; the downloadable guide works without it.</p></noscript>
<section id="walks" aria-label="Walk directory">{walks.map(w=><article class="utk-card walk-card" id={w.id} data-id={w.id} data-end={eventEnd(w)} data-availability={w.status.startsWith("Dated")?"dated":/Sold out|closed|Seasonal/.test(w.status)?"unavailable":"enquiry"} data-place={w.place} data-group={w.group} data-nature={String(w.theme.startsWith('Nature'))} data-search={`${w.name} ${w.place} ${w.theme} ${w.expect} ${w.provider} ${w.place==='Bhubaneswar'?'Bhubaneshwar Lingaraj Old Town Ekamra':''} ${w.place==='Cuttack'?'Katak Kataka':''} ${w.place==='Konark'?'Konarka':''}`.toLowerCase()}><div class="cardtop"><span>{w.place} · {w.theme}</span><span class="status">{w.status}</span></div><h2><a href={"#"+w.id}>{w.name}</a></h2><button class="save utk-button utk-button--secondary" data-save={w.id} aria-pressed="false" aria-label={"Save "+w.name}>Save to shortlist</button><p class="provider">{w.provider}</p><p>{w.expect}</p><dl><div><dt>When</dt><dd>{w.schedule}</dd></div><div><dt>Duration</dt><dd>{w.duration}</dd></div><div><dt>Meet</dt><dd>{w.meeting}</dd></div><div><dt>Price</dt><dd>{w.price}</dd></div></dl><p class="note"><strong>Before booking:</strong> {w.note}</p><details><summary>Best time, practical details and contact</summary><p><strong>Best time:</strong> {w.bestTime}</p><p><strong>Format:</strong> {w.mode}</p><p><strong>Language:</strong> {w.language}</p><p><strong>Contact:</strong> {w.contact}</p><p><a href={"tel:"+phone(w.contact)}>Call organiser</a>{w.contact.includes("@") && <> · <a href={"mailto:"+w.contact.split(" · ").at(-1)}>Email organiser</a></>}</p><p>Confirm access needs, toilets, child policy, food, admissions, transfers and cancellation terms. Unspecified services are not included by default.</p></details><p><a class="book button utk-button" href={w.booking}>{action(w)} →</a></p><small class="expiry"></small><small>Source: provider listing · checked {data.checked} · availability can change</small></article>)}</section>
<section class="planning"><h2>Plan a good walk</h2><div class="columns"><div><h3>Choose the right time</h3><p>{data.general.season}</p><p>All times below are IST. Museum and craft visits depend on actual opening and working hours.</p></div><div><h3>Know what you are paying for</h3><p>{data.general.booking}</p><p>{data.general.ask}</p></div></div><details><summary>Temple access, etiquette and coverage</summary><p>{data.general.etiquette}</p><p>{data.general.gaps}</p><p>{data.general.winter}</p></details></section>
<section class="downloads-section"><h2>Take the guide with you</h2><p>Save the full catalogue for offline use, or print only the walks currently shown.</p><div class="downloads"><a href="/downloads/heritage-walks/odisha-heritage-walks.html" download>Save offline guide (HTML)</a><a href="/downloads/heritage-walks/odisha-heritage-walks.zip" download>Download all entries (ZIP)</a><a href="/downloads/heritage-walks/odisha-heritage-walks.csv" download>Spreadsheet CSV</a><button class="utk-button utk-button--secondary" id="print">Print current results / save PDF</button></div></section>
<section class="walk-sources"><h2>Sources and keeping this useful</h2><p>Each entry links directly to its provider. Advertised offers, community programmes and dated tickets carry different status labels. Times that conflict are retained for confirmation. There were no purchases or organiser confirmations.</p><ul>{data.generalSources.map(s=><li><a href={s.url}>{s.name}</a></li>)}</ul><p><a href="/downloads/heritage-walks/odisha-heritage-walks.md" download>Readable guide</a> · <a href="/downloads/heritage-walks/odisha-heritage-walks.json" download>Structured catalogue</a> · <a href="/things-to-do/">Explore more things to do</a></p><p>Book directly with the organiser. Project Odisha does not sell tour tickets.</p></section>
</div>
<script>
 const $=(id:string)=>document.getElementById(id)!;
 const search=$('search') as HTMLInputElement, place=$('place') as HTMLSelectElement, group=$('group') as HTMLSelectElement, availability=$('availability') as HTMLSelectElement;
 const nature=$('nature') as HTMLInputElement, savedOnly=$('saved-only') as HTMLInputElement;
 const cards=[...document.querySelectorAll<HTMLElement>('article[data-place]')];
 let saved=new Set<string>();try{const v=JSON.parse(localStorage.getItem('odisha-walk-shortlist')||'[]');if(Array.isArray(v))saved=new Set(v.filter(x=>typeof x==='string'&&cards.some(c=>c.dataset.id===x)));}catch{}
 function refreshDates(){for(const c of cards){if(c.dataset.end&&Date.now()>Date.parse(c.dataset.end)){c.dataset.availability='unavailable';c.querySelector('.status')!.textContent='Past event — ask for new dates';c.querySelector('.expiry')!.textContent='This advertised event has ended. The schedule below is retained for reference. ';}}document.querySelector('.dates')!.classList.toggle('past',Date.now()>Date.parse('2026-10-25T11:00:00+05:30'));const h=document.querySelector('.dates h2')!;h.textContent=document.querySelector('.dates')!.classList.contains('past')?'Previously advertised dates — check for new editions':'Advertised dates — check before travelling';}
 function filter(){refreshDates();let n=0;const terms=search.value.toLowerCase().trim().split(/\s+/).filter(Boolean);for(const c of cards){c.hidden=Boolean((place.value&&c.dataset.place!==place.value)||(group.value&&c.dataset.group!==group.value)||(availability.value&&c.dataset.availability!==availability.value)||(!nature.checked&&c.dataset.nature==='true')||(savedOnly.checked&&!saved.has(c.dataset.id!))||!terms.every(t=>c.dataset.search?.includes(t)));if(!c.hidden)n++;const b=c.querySelector<HTMLButtonElement>('.save')!;b.textContent=saved.has(c.dataset.id!)?'Saved — remove':'Save to shortlist';b.setAttribute('aria-pressed',String(saved.has(c.dataset.id!)));} $('count').textContent=`${n} ${n===1?'entry':'entries'} shown · ${saved.size} saved · ${nature.checked?'including nature excursions':'nature excursions hidden'}`;$('empty').hidden=n!==0;}
 for(const el of [search,place,group,availability,nature,savedOnly])el.addEventListener('input',filter);
 function reset(){search.value='';place.value='';group.value='';availability.value='';nature.checked=false;savedOnly.checked=false;filter();}
 $('reset').addEventListener('click',reset);$('clear-empty').addEventListener('click',reset);
 document.querySelectorAll<HTMLButtonElement>('.save').forEach(b=>b.addEventListener('click',()=>{const id=b.dataset.save!;saved.has(id)?saved.delete(id):saved.add(id);try{localStorage.setItem('odisha-walk-shortlist',JSON.stringify([...saved]));$('save-feedback').textContent='Shortlist updated on this browser.';}catch{$('save-feedback').textContent='Shortlist works for this visit, but this browser could not save it for later.';}filter();}));
 let opened:HTMLDetailsElement[]=[];
 window.addEventListener('beforeprint',()=>{opened=[...document.querySelectorAll<HTMLDetailsElement>('.heritage-directory details:not([open])')];opened.forEach(d=>d.open=true);});
 window.addEventListener('afterprint',()=>{opened.forEach(d=>d.open=false);opened=[];});
 $('print').addEventListener('click',()=>window.print());
 filter();if(location.hash){try{const c=document.getElementById(decodeURIComponent(location.hash.slice(1)));if(c?.matches('article')){nature.checked=true;filter();c.scrollIntoView();}}catch{}}
</script>
<style>
.heritage-directory{padding-bottom:56px}.walk-opening{max-width:900px;padding-top:28px;padding-bottom:28px}.walk-opening .breadcrumb{margin-bottom:24px}.breadcrumb span{margin-inline:8px}.walk-opening .lead{max-width:740px}.opening-note{max-width:75ch;margin-top:18px;color:var(--muted);font-size:14px}
.finder{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;align-items:end;border-block:1px solid var(--line);padding:24px 0;margin:0 0 14px;scroll-margin-top:24px}.finder h2{grid-column:1/-1;font-size:clamp(26px,3vw,36px);margin-bottom:4px}.finder label{display:flex;flex-direction:column;gap:8px;font-size:13px;font-weight:600;min-width:0}.finder input,.finder select{font:inherit;font-size:16px;width:100%;max-width:100%;min-height:46px;padding:10px 12px;border:1px solid var(--muted);border-radius:0;color:var(--ink);background:var(--paper)}.finder .check{flex-direction:row;align-items:center;min-height:44px;font-weight:400}.finder .check input{width:18px;height:18px;min-height:0;padding:0;flex-shrink:0;accent-color:var(--sea)}.finder button{justify-self:start;min-height:44px}.help{font-size:13px;color:var(--muted);max-width:90ch;margin-bottom:20px}.dates{border-left:3px solid var(--straw);padding:14px 20px;background:var(--paper);margin:20px 0 24px}.dates h2{font-family:inherit;font-size:14px;font-weight:600;line-height:1.5;letter-spacing:0;margin-bottom:8px}.dates p{font-size:14px;line-height:1.7}.dates a{color:var(--sea)}#count{font-size:13px;color:var(--muted);margin:24px 0 18px}#save-feedback{font-size:13px;color:var(--muted);margin-bottom:12px}#save-feedback:empty{display:none}#empty{padding:28px;border:1px solid var(--line);margin-bottom:24px}#empty h2{font-size:30px;margin-bottom:14px}#empty button{margin-top:20px}
#walks{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}.walk-card{background:var(--paper);padding:28px;min-width:0;scroll-margin-top:24px}.cardtop{display:flex;flex-direction:column;gap:10px;font-size:12px;color:var(--muted)}.status{align-self:start;border:1px solid var(--line);padding:4px 8px;color:var(--ink);font-size:12px;line-height:1.5}.walk-card h2{font-size:clamp(27px,2.5vw,36px);line-height:1.2;margin:20px 0 14px}.walk-card h2 a{text-decoration:none}.walk-card h2 a:hover{text-decoration:underline}.save{font-size:12px;min-height:44px;padding:9px 12px;margin-bottom:16px}.save[aria-pressed=true]{border-color:var(--sea);background:var(--sea);color:var(--light)}.provider{font-size:12px;color:var(--muted);margin-bottom:14px}.walk-card>p:not(.provider){font-size:16px;line-height:1.75;margin-bottom:20px}.walk-card dl{margin:24px 0}.walk-card dl>div{display:grid;grid-template-columns:78px 1fr;gap:10px;border-top:1px solid var(--line);padding:10px 0}.walk-card dt{font-size:12px;font-weight:650;color:var(--muted)}.walk-card dd{font-size:14px;margin:0;overflow-wrap:anywhere}.walk-card .note{border-left:2px solid var(--earth);padding-left:14px;font-size:14px!important}.walk-card details{border-top:1px solid var(--line);padding-top:8px;margin-bottom:20px}.walk-card summary{cursor:pointer;min-height:44px;padding-block:10px;font-size:14px;font-weight:600;color:var(--sea)}.walk-card details p{font-size:14px;margin:12px 0;line-height:1.7}.book{white-space:normal;max-width:100%;font-size:13px;min-height:44px}.walk-card small{display:block;color:var(--muted);font-size:12px;line-height:1.6}.walk-card .expiry{color:var(--earth);font-weight:600}.expiry:empty{display:none}.walk-card a{overflow-wrap:anywhere}
.planning,.downloads-section,.walk-sources{border-top:1px solid var(--line);padding-top:32px;margin-top:44px}.planning h2,.downloads-section h2,.walk-sources h2{font-size:clamp(28px,3vw,40px);margin-bottom:22px}.columns{display:grid;grid-template-columns:1fr 1fr;gap:40px}.columns h3{font-size:26px;margin-bottom:14px}.columns p,.planning details p,.walk-sources>p{margin-bottom:16px;line-height:1.8}.planning summary{cursor:pointer;min-height:44px;padding-block:14px;color:var(--sea)}.downloads-section>p{color:var(--muted);margin-bottom:22px}.downloads{display:flex;align-items:center;flex-wrap:wrap;gap:14px 24px}.downloads a{display:inline-flex;align-items:center;min-height:44px;font-size:14px}.downloads button{min-height:44px}.walk-sources{font-size:14px;max-width:85ch}.walk-sources li{margin:12px 0}.walk-sources a{overflow-wrap:anywhere}
@media(max-width:900px){.finder{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.walk-opening{padding-top:28px}.finder{grid-template-columns:1fr;gap:14px}#walks,.columns{grid-template-columns:1fr}.walk-card{padding:22px}.columns{gap:26px}.walk-card dl>div{grid-template-columns:65px 1fr}.dates{padding:12px 16px}.planning,.downloads-section,.walk-sources{margin-top:32px}.downloads{align-items:start;flex-direction:column}}
@media print{.finder,.downloads-section,#count,.save,#save-feedback,#empty,.help,.breadcrumb{display:none!important}.heritage-directory{width:100%;max-width:none;padding:0}#walks,.columns{display:block}.walk-card{break-inside:avoid;margin:16px 0;padding:18px;border:1px solid var(--line);background:transparent}.walk-card[hidden]{display:none!important}.walk-opening{padding-top:0}.walk-opening h1{font-size:28pt}.walk-card h2{font-size:20pt}.book{color:var(--ink);background:transparent;border:0;padding:0}.book::after{content:" (" attr(href) ")";font-size:8pt;overflow-wrap:anywhere}.dates{background:transparent}}
</style>
</Shell>
