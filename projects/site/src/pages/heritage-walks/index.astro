---
import Shell from '../../layouts/Shell.astro';
import data from '../../../../../kb/research/references/data/odisha-heritage-walks-20261019.json';
const places=[...new Set(data.walks.map(w=>w.place))].sort();
const rank=(w:any)=>w.status.startsWith('Dated')?0:w.group==='Official listings'?1:w.group==='Private enquiries'?2:w.group==='Community walks'?3:4;
const walks=[...data.walks].sort((a,b)=>rank(a)-rank(b)||a.place.localeCompare(b.place));
const eventEnd=(w:any)=>w.id==='community-7'?'2026-10-25T11:00:00+05:30':w.id==='ekamra-living-temple-city'?'2026-10-21T09:30:00+05:30':w.id==='ekamra-dhauli-peace-walk'?'2026-10-20T09:30:00+05:30':w.id.startsWith('ekamra-mystical')?'2026-10-19T09:30:00+05:30':'';
const action=(w:any)=>w.id==='community-7'?'See registration details':w.group==='Community walks'?'Find the next community walk':w.group==='Private enquiries'?'Request dates and a quote':w.status.includes('Sold out')||w.status.includes('closed')?'Check other dates':'Check dates with organiser';
const phone=(c:string)=>c.split(/[\/·]/)[0].replace(/[^+0-9]/g,'');
const groups=[...new Set(data.walks.map(w=>w.group))];
---
<Shell title="Heritage walks in Odisha" description="Find heritage walks in Odisha, with booking links, best times, meeting points and practical visitor information." active="explore" wide related={false}>
<div class="heritage-directory">
<a class="walk-skip" href="#finder">Skip to walk finder</a><nav class="guide-nav" aria-label="Walk guide navigation"><a href="/">Home</a><a href="/things-to-do/">Things to do</a><span>Checked 19 October 2026</span></nav>
<div class="guide-content"><section class="intro"><p class="eyebrow">Explore Odisha on foot</p><h1>Heritage walks<br/>to look for in Odisha</h1><p class="lead">Old-town lanes, temple precincts, artisan neighbourhoods and community stories. Find a walk, understand the day, and book with its organiser.</p><p>60 entries across official listings, Ekamra events, community chapters and private services. Some involve substantial road travel; nature excursions are labelled separately. A listing is not a confirmed departure.</p><p><a class="primary" href="#finder">Find a walk ↓</a></p><div class="downloads"><a href="/downloads/heritage-walks/odisha-heritage-walks.html" download>Save offline guide (HTML)</a><a href="/downloads/heritage-walks/odisha-heritage-walks.zip" download>Download all entries (ZIP)</a><a href="/downloads/heritage-walks/odisha-heritage-walks.csv" download>Spreadsheet CSV</a><button id="print">Print current results / save PDF</button></div></section>
<section class="dates"><h2>Dates worth checking first</h2><p><a href="https://odishaheritagewalks.com/detail.php?id=82">Khordha · 25 October, 9–11am</a> — free; register by phone. <a href="https://www.ekamra-walks.com/event-details/living-temple-city">Ekamra Living Temple City · 21 October, 5:30–9:30am</a> — ₹100 advertised; a ticket selector was visible when checked. The 20 October Dhauli event was sold out. Recheck before travelling.</p></section>
<section id="finder" aria-label="Find a walk" class="finder"><h2>Where would you like to walk?</h2><label for="search">Search<input id="search" type="search" placeholder="Try Puri, filigree, museum…"/></label><label for="place">Place<select id="place"><option value="">Every place</option>{places.map(p=><option>{p}</option>)}</select></label><label for="group">Programme<select id="group"><option value="">Every programme</option>{groups.map(g=><option>{g}</option>)}</select></label><label for="availability">Availability<select id="availability"><option value="">All availability</option><option value="dated">Dated options to check</option><option value="enquiry">Enquiry or date confirmation needed</option><option value="unavailable">Closed, sold out or seasonal</option></select></label><label class="check"><input id="saved-only" type="checkbox"/> My shortlist</label><label class="check"><input id="nature" type="checkbox"/> Include nature excursions</label><button id="reset">Reset filters</button></section><p class="help">Times are IST. “Dated” means advertised on the checked date, not a reserved seat. Save walks on this browser to compare them. Nature excursions are hidden initially.</p><p id="count" role="status" aria-live="polite"></p><div id="empty" hidden><h2>No matching walks</h2><p>Try a nearby place, remove a filter, or include nature excursions. No organised departure is currently verified here for Sonepur (Sonpur/Subarnapur).</p><button id="clear-empty">Show all heritage entries</button></div><p id="save-feedback" role="status" aria-live="polite"></p><noscript><p>All 60 entries are shown below. Search filters require JavaScript; the downloadable guide works without it.</p></noscript>
<section id="walks" aria-label="Walk directory">{walks.map(w=><article id={w.id} data-id={w.id} data-end={eventEnd(w)} data-availability={w.status.startsWith("Dated")?"dated":/Sold out|closed|Seasonal/.test(w.status)?"unavailable":"enquiry"} data-place={w.place} data-group={w.group} data-nature={String(w.theme.startsWith('Nature'))} data-search={`${w.name} ${w.place} ${w.theme} ${w.expect} ${w.provider} ${w.place==='Bhubaneswar'?'Bhubaneshwar Lingaraj Old Town Ekamra':''} ${w.place==='Cuttack'?'Katak Kataka':''} ${w.place==='Konark'?'Konarka':''}`.toLowerCase()}><div class="cardtop"><span>{w.place} · {w.theme}</span><span class="status">{w.status}</span></div><h2><a href={"#"+w.id}>{w.name}</a></h2><button class="save" data-save={w.id} aria-pressed="false" aria-label={"Save "+w.name}>Save to shortlist</button><p class="provider">{w.provider}</p><p>{w.expect}</p><dl><div><dt>When</dt><dd>{w.schedule}</dd></div><div><dt>Duration</dt><dd>{w.duration}</dd></div><div><dt>Meet</dt><dd>{w.meeting}</dd></div><div><dt>Price</dt><dd>{w.price}</dd></div></dl><p class="note"><strong>Before booking:</strong> {w.note}</p><details><summary>Best time, practical details and contact</summary><p><strong>Best time:</strong> {w.bestTime}</p><p><strong>Format:</strong> {w.mode}</p><p><strong>Language:</strong> {w.language}</p><p><strong>Contact:</strong> {w.contact}</p><p><a href={"tel:"+phone(w.contact)}>Call organiser</a>{w.contact.includes("@") && <> · <a href={"mailto:"+w.contact.split(" · ").at(-1)}>Email organiser</a></>}</p><p>Confirm access needs, toilets, child policy, food, admissions, transfers and cancellation terms. Unspecified services are not included by default.</p></details><p><a class="book" href={w.booking}>{action(w)} →</a></p><small class="expiry"></small><small>Source: provider listing · checked {data.checked} · availability can change</small></article>)}</section>
<section class="planning"><h2>Plan a good walk</h2><div class="columns"><div><h3>Choose the right time</h3><p>{data.general.season}</p><p>All times below are IST. Museum and craft visits depend on actual opening and working hours.</p></div><div><h3>Know what you are paying for</h3><p>{data.general.booking}</p><p>{data.general.ask}</p></div></div><details><summary>Temple access, etiquette and coverage</summary><p>{data.general.etiquette}</p><p>{data.general.gaps}</p><p>{data.general.winter}</p></details></section>
<section><h2>Sources and keeping this useful</h2><p>Each entry links directly to its provider. Advertised offers, community programmes and dated tickets carry different status labels. Times that conflict are retained for confirmation. There were no purchases or organiser confirmations.</p><ul>{data.generalSources.map(s=><li><a href={s.url}>{s.name}</a></li>)}</ul><p><a href="/downloads/heritage-walks/odisha-heritage-walks.md" download>Readable guide</a> · <a href="/downloads/heritage-walks/odisha-heritage-walks.json" download>Structured catalogue</a> · <a href="/things-to-do/">Explore more things to do</a></p></section></div>
<p class="guide-footer">Traveller guide · Book directly with the organiser. Project Odisha does not sell tour tickets.</p>
</div>
<script>
 const $=(id:string)=>document.getElementById(id)!;
 const search=$('search') as HTMLInputElement, place=$('place') as HTMLSelectElement, group=$('group') as HTMLSelectElement, availability=$('availability') as HTMLSelectElement;
 const nature=$('nature') as HTMLInputElement, savedOnly=$('saved-only') as HTMLInputElement;
 const cards=[...document.querySelectorAll<HTMLElement>('article[data-place]')];
 let saved=new Set<string>();try{const v=JSON.parse(localStorage.getItem('odisha-walk-shortlist')||'[]');if(Array.isArray(v))saved=new Set(v.filter(x=>typeof x==='string'&&cards.some(c=>c.dataset.id===x)));}catch{}
 function refreshDates(){for(const c of cards){if(c.dataset.end&&Date.now()>Date.parse(c.dataset.end)){c.dataset.availability='unavailable';c.querySelector('.status')!.textContent='Past event — ask for new dates';c.querySelector('.expiry')!.textContent='This advertised event has ended. The schedule below is retained for reference. ';}}document.querySelector('.dates')!.classList.toggle('past',Date.now()>Date.parse('2026-10-25T11:00:00+05:30'));const h=document.querySelector('.dates h2')!;h.textContent=document.querySelector('.dates')!.classList.contains('past')?'Previously advertised dates — check for new editions':'Advertised dates — check before travelling';}
 function filter(){refreshDates();let n=0;const terms=search.value.toLowerCase().trim().split(/\s+/).filter(Boolean);for(const c of cards){c.hidden=Boolean((place.value&&c.dataset.place!==place.value)||(group.value&&c.dataset.group!==group.value)||(availability.value&&c.dataset.availability!==availability.value)||(!nature.checked&&c.dataset.nature==='true')||(savedOnly.checked&&!saved.has(c.dataset.id!))||!terms.every(t=>c.dataset.search?.includes(t)));if(!c.hidden)n++;const b=c.querySelector<HTMLButtonElement>('.save')!;b.textContent=saved.has(c.dataset.id!)?'Saved — remove':'Save to shortlist';b.setAttribute('aria-pressed',String(saved.has(c.dataset.id!)));} $('count').textContent=`${n} ${n===1?'entry':'entries'} shown · ${saved.size} saved · ${nature.checked?'including nature excursions':'nature excursions hidden'}`;$('empty').hidden=n!==0;}
 for(const el of [search,place,group,availability,nature,savedOnly])el.addEventListener('input',filter);
 function reset(){search.value='';place.value='';group.value='';availability.value='';nature.checked=false;savedOnly.checked=false;filter();}
 $('reset').addEventListener('click',reset);$('clear-empty').addEventListener('click',reset);
 document.querySelectorAll<HTMLButtonElement>('.save').forEach(b=>b.addEventListener('click',()=>{const id=b.dataset.save!;saved.has(id)?saved.delete(id):saved.add(id);try{localStorage.setItem('odisha-walk-shortlist',JSON.stringify([...saved]));$('save-feedback').textContent='Shortlist updated on this browser.';}catch{$('save-feedback').textContent='Shortlist works for this visit, but this browser could not save it for later.';}filter();}));
 let opened:HTMLDetailsElement[]=[];
 window.addEventListener('beforeprint',()=>{opened=[...document.querySelectorAll<HTMLDetailsElement>('.heritage-directory details:not([open])')];opened.forEach(d=>d.open=true);});
 window.addEventListener('afterprint',()=>{opened.forEach(d=>d.open=false);opened=[];});
 $('print').addEventListener('click',()=>window.print());
 filter();if(location.hash){try{const c=document.getElementById(decodeURIComponent(location.hash.slice(1)));if(c?.matches('article')){nature.checked=true;filter();c.scrollIntoView();}}catch{}}
</script>
<style>
.heritage-directory{font-family:system-ui,sans-serif;color:#243b36;background:#f8f5ed;line-height:1.6}*{box-sizing:border-box}.guide-nav,.guide-footer{padding:22px max(5vw,20px);background:#153f36;color:#fff}.guide-nav{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}.guide-nav a{color:#fff}.guide-content{max-width:1100px;margin:auto;padding:32px 24px}a{color:#155c50;text-underline-offset:3px}h1,h2,h3{line-height:1.18}h1{font-family:Georgia,serif;font-size:clamp(36px,6vw,65px);font-weight:500;margin:15px 0 25px}h2{font-family:Georgia,serif;font-size:27px}.intro{max-width:850px;padding:20px 0 35px}.lead{font-size:21px}.eyebrow{text-transform:uppercase;letter-spacing:.13em;font-size:13px;font-weight:700}.downloads{display:flex;gap:16px;align-items:center;flex-wrap:wrap}.downloads>a:first-child,.book{font-weight:650}.dates{border-left:4px solid #b67b38;padding:4px 25px;background:#efe8d8}.columns{display:grid;grid-template-columns:1fr 1fr;gap:32px}.planning{padding:20px 0}.finder{display:flex;gap:16px;align-items:end;flex-wrap:wrap;padding:22px;background:#e5ece5;border-radius:8px}label{display:flex;flex-direction:column;font-weight:600;font-size:14px;gap:6px}input,select,button{font:inherit;border:1px solid #9caea3;border-radius:4px;padding:10px;background:white;color:#243b36;max-width:100%}.check{flex-direction:row;align-items:center;max-width:170px}button,summary{cursor:pointer}#walks{display:grid;grid-template-columns:1fr 1fr;gap:24px}article{padding:25px;background:#fff;border:1px solid #d7ddd4;border-radius:8px;min-width:0}article[hidden]{display:none}.cardtop{display:flex;flex-direction:column;gap:8px;font-size:13px}.status{align-self:start;background:#edf1e9;border-radius:4px;padding:3px 8px;font-weight:600}.provider,small{color:#52665f;font-size:13px}dt{font-weight:700;font-size:13px}dd{margin:0}dl>div{margin-bottom:10px}.note{padding:12px;background:#faf6ed;font-size:14px}summary{font-weight:600}details p{font-size:14px}.guide-footer{margin-top:30px}a,dd{overflow-wrap:anywhere}@media(max-width:700px){.columns,#walks{grid-template-columns:1fr}.finder{align-items:stretch}.finder label{width:100%}.check{max-width:none}.guide-content{padding:20px 16px}}@media print{.guide-nav,.finder,.downloads,#count,.guide-footer{display:none}.guide-content{max-width:none;padding:0}#walks,.columns{display:block}article{break-inside:avoid;margin:15px 0;border-radius:0}.heritage-directory{background:white;font-size:10pt}h1{font-size:28pt}h2{font-size:17pt}a{color:black}.dates{background:white}}

.finder h2{flex-basis:100%;margin:0 0 8px;font-size:25px}.finder{scroll-margin-top:20px}.help{font-size:14px;color:#52665f}.primary,.book{display:inline-block;padding:10px 16px;background:#155c50;color:white;border-radius:5px;text-decoration:none;min-height:44px}.save{font-size:13px;min-height:44px}.save[aria-pressed=true]{background:#e5ece5}article h2 a{color:inherit;text-decoration:none}article h2 a:hover{text-decoration:underline}.expiry{display:block;color:#80441c;font-weight:600}.check{max-width:none}.finder label{flex:1 1 180px}.finder .check{flex:0 1 180px}.finder input,.finder select{width:100%}.finder .check input{width:auto}.intro{padding-bottom:15px}.dates{margin-bottom:25px}.walk-skip{position:absolute;left:10px;top:-100px;background:white;padding:12px;z-index:10}.walk-skip:focus{top:10px}:focus-visible{outline:3px solid #b67b38;outline-offset:4px}#empty{padding:25px;background:#fff;border:1px solid #c7d4c9}#empty[hidden]{display:none}article{scroll-margin-top:20px}.planning{margin-top:32px}.past{background:#eee}.dates a{font-weight:600}@media print{.save,#save-feedback,#empty,.help,.walk-skip{display:none!important}.book{color:black;background:white;padding:0}.book::after{content:" (" attr(href) ")";font-size:8pt;overflow-wrap:anywhere}article[hidden]{display:none!important}}
</style>
</Shell>
