---
import HomeSharingCredit from '../components/HomeSharingCredit.astro';
import CoastalHome from '../components/CoastalHome.astro';
import HomeArt from '../components/HomeArt.astro';
import {isCoastalEdition} from '../data/edition';
import Shell from '../layouts/Shell.astro';
import FeaturedStories from '../components/FeaturedStories.astro';
import {featuredStories as storyPicks} from '../data/featured-stories';
import DestinationCards from '../components/DestinationCards.astro';
import {destinationGuides} from '../data/destination-directory';
const topics=[['People','Lives & ideas'],['Places','Land & water'],['Living culture','Art & making'],['Food','Tables & traditions'],['Maritime connections','Journeys & exchange']];
---
{isCoastalEdition?<CoastalHome/>:<Shell>
 <div class="wrap">
 <section class="hero"><div><p class="eyebrow">A living encyclopedia of Odisha</p><h1>Discover Odisha.<br/><em>Imagine the possibilities.</em></h1><p class="lead">Explore its people, places, culture and opportunities. Find the knowledge to plan your visit or investment.</p><div class="actions"><a class="button utk-button" href="/explore/">Begin exploring <span aria-hidden="true">↗</span></a><a class="text-link" href="/about/">Why Project Odisha?</a></div><p class="hero-note">Rooted in heritage. Growing through knowledge.</p></div><HomeArt/></section>
 <section class="section home-story-picks"><div class="section-heading"><div><p class="eyebrow">Start with a story</p><h2>A place. A taste.<br/><em class="highlight">A story to carry with you.</em></h2></div><a class="text-link" href="/explore/">Explore the collection ↗</a></div><FeaturedStories/></section>
 <section class="section"><div class="section-heading"><div><p class="eyebrow">Begin with a place</p><h2>Let somewhere <em class="highlight">draw you in.</em></h2></div><a class="text-link" href="/destinations/">All destination guides ↗</a></div><DestinationCards guides={destinationGuides.filter(g=>['Bhubaneswar','Puri','Cuttack'].includes(g.title))}/></section>
 <section class="voices-home"><div><p class="eyebrow">Languages & literary lives</p><h2>Many voices.<br/><em class="highlight">A world of words.</em></h2><p>Meet Odisha through its languages, then follow a writer into a story.</p></div><div class="voices-home-links"><a href="/languages/"><span>01 · Languages of Odisha</span><strong>Listen to a wider world.</strong><small>Odia, Santali and a growing collection of voices ↗</small></a><a href="/literature/"><span>02 · Odia Literature</span><strong>Meet the people behind the words.</strong><small>Writers, works and places to begin reading ↗</small></a></div></section>
 <section class="store-teaser"><div><p class="eyebrow">From the photographic archive · February 2009</p><h2>Bhubaneswar’s <em class="highlight">painted streets.</em></h2><p>Hours on foot, a camera, and walls worth stopping for. Photographs by Ahimanikya Satapathy.</p></div><a class="button utk-button" href="/stories/bhubaneswar-fresco/">Explore the fresco gallery ↗</a></section><div class="intro-band"><p class="eyebrow">Many ways to belong</p><p>For those who call Odisha home. For those far from it.<br/>And for everyone discovering it for the first time.</p></div>
 <section class="section"><div class="section-heading"><div><p class="eyebrow">Follow your curiosity</p><h2>There is more to discover.</h2></div><a class="text-link" href="/explore/">Explore the collection ↗</a></div><div class="topic-row">{topics.map(([name,desc],i)=><a class="topic" href={'/explore/?topic='+encodeURIComponent(name)}><span class="topic-number">0{i+1}</span><span class="topic-name">{name}</span><small>{desc}</small></a>)}</div></section>
 </div>
 <section class="feature"><div class="wrap feature-inner"><div class="sky-panel" aria-label="Decorative illustration of a star"><p style="color:var(--paper)">The sky above.<br/>The questions within.</p><small>KNOWLEDGE · CURIOSITY · OBSERVATION</small></div><div><p class="eyebrow">A life worth knowing</p><h2>Samanta<br/>Chandrasekhar</h2><p>An astronomer whose careful observations and self-made instruments became part of Odisha’s intellectual heritage.</p><div class="actions"><a class="text-link" href="/people/samanta-chandrasekhar/">Read the first entry ↗</a><span style="font-size:11px;color:var(--muted)">Editorial draft</span></div></div></div></section>
 <div class="wrap"><section class="section"><p class="eyebrow">Take the story with you</p><h2>Your Odisha. Your own pace.</h2><p class="lead">Save a place, a meal or a reading idea. Arrange your discoveries into a personal journey to print and carry.</p><div class="actions"><a class="button utk-button" href="/journey-starters/">Find my starting point →</a><a class="text-link" href="/stories/culture-trails/">Follow a cultural thread →</a></div></section>
 <section class="invitation"><div><p class="eyebrow">An encyclopedia grows through people</p><h2>Your knowledge.<br/>Our shared story.</h2></div><div><p>A family photograph. A local name. A source we haven’t found. Help make this a richer, more thoughtful record of Odisha.</p><div class="actions"><a href="/contribute/" class="button utk-button">Find your way to contribute <span aria-hidden="true">↗</span></a></div></div></section><details class="home-image-credits utk-disclosure"><summary>Image credits</summary><p>Homepage artwork: imagined scenes inspired by Odisha. These illustrations do not document identified people or locations. Creative direction: Ahimanikya Satapathy.</p><HomeSharingCredit/><ul data-featured-credits>{storyPicks.map(e=><li><a href={e.image.source}>{e.image.caption||e.image.alt||e.image.title}</a> · {e.image.creator} · <a href={e.image.license_url}>{e.image.license}</a>. {e.image.changes}</li>)}</ul></details></div>

</Shell>}

<style>.home-image-credits{font-size:13px;margin-top:36px;overflow-wrap:anywhere}.home-image-credits li{margin:14px 0}.home-image-credits summary{padding-block:14px}.home-story-picks{border-top:1px solid var(--line)}.voices-home{display:grid;grid-template-columns:1fr 1.3fr;gap:50px;padding:45px 0 60px;border-top:1px solid var(--line)}.voices-home p:last-child{margin-top:20px;max-width:460px}.voices-home-links{display:grid;grid-template-columns:1fr 1fr;gap:18px}.voices-home-links a{padding:30px;background:var(--sea);color:var(--light);text-decoration:none;display:flex;flex-direction:column;gap:20px}.voices-home-links a:last-child{background:var(--earth)}.voices-home-links span{font-size:12px}.voices-home-links strong{font:30px/1.2 var(--serif)}.voices-home-links small{font-size:13px;margin-top:auto}@media(max-width:900px){.voices-home{grid-template-columns:1fr;gap:28px}}@media(max-width:540px){.voices-home-links{grid-template-columns:1fr}}</style>
