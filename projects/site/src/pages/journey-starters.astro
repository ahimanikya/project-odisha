---
import ArticleFootnotes from '../components/ArticleFootnotes.astro';
import '../styles/article-reading.css';
import visitPlans from '../../../../kb/research/destinations/flexible-visit-plans.json';
import {allowsStarter,isCoastalEdition} from '../data/edition';
import VisitorTrail from '../components/VisitorTrail.astro';
import TrailFinder from '../components/TrailFinder.astro';
import {trailComparisons} from '../data/trail-comparison';
import trail from '../../../../kb/research/destinations/stone-sea-trail.json';
import PlanningPaths from '../components/PlanningPaths.astro';
import Shell from '../layouts/Shell.astro';
import selection from '../../../../kb/research/journey-starters.json';
import {journeyCatalog} from '../data/journey-catalog';
import {bookPhotos} from '../data/book-photos';
const starters=selection.starters.filter(s=>allowsStarter(s.id)).map(s=>({...s,photo:bookPhotos[s.cover],ideas:s.items.map(id=>{const item=journeyCatalog.find(i=>i.id===id);if(!item)throw Error('Missing starter idea: '+id);return item;})}));
const featured=starters.find(s=>s.id===trail.starter_id);
const photographs=[...new Map([...trailComparisons.map(s=>s.photo),...starters.map(s=>s.photo),...(featured?trail.chapters.map(c=>bookPhotos[c.photo]):[])].map(photo=>[photo.src,photo])).values()];
---
<Shell title="Journey starters" description="Compare five illustrated Odisha trails by heritage, nature, food, crafts or literature. Choose a story, save ideas and build your own tour book." active="journey" wide><div class="wrap"><header class="page-head"><p class="eyebrow">A little inspiration · your own pace</p><h1>Find your trail.<br/><em class="highlight">Make it your own.</em></h1><p class="lead">{isCoastalEdition?'Follow a city, a coast, a forest or a literary voice. Each starting point becomes a separate journey you can rename, rearrange and add to.':'Choose a few places or a handful of stories. These starting points become separate journeys you can rename, rearrange and add to.'}</p><p>Every idea starts under “Ideas for later”, with no dates assigned. These are research collections, not checked travel routes.</p><div class="actions"><a class="text-link" href="/journey/">Open my saved journeys →</a><a class="text-link" href="/destinations/">Browse destinations →</a></div></header>
<PlanningPaths current="/journey-starters/"/>
<noscript><p class="notice">Enable JavaScript to create a journey. You can still follow every reading link below.</p></noscript>
<section id="short-visits" class="short-visits" aria-labelledby="short-visits-title"><p class="eyebrow">A little room in your day</p><h2 id="short-visits-title">Three places to begin.</h2><p>Choose a museum, meet a maker or follow a message in stone. These smaller plans connect two cultural stops and a meal; each includes a way to shorten the visit.</p><div>{visitPlans.plans.filter(p=>allowsStarter(p.starter_id)).map(p=><a href={p.href}><strong>{p.title}</strong><span>Read the plan and choose what fits →</span></a>)}</div></section>
<TrailFinder/>
{featured&&<VisitorTrail starter={featured} editorial={trail}/>}
<h2 class="other-starters-title">Find another beginning.</h2>
<section class="starter-grid" aria-label="Choose a journey starter">{starters.filter(s=>s!==featured).map(s=><article id={s.id} class="starter-card utk-card"><figure><img src={s.photo.src} alt={s.photo.alt} width={s.photo.width} height={s.photo.height} loading="lazy"/></figure><div><p class="eyebrow">{s.type} · {s.ideas.length} ideas</p><h2>{s.title}</h2><p>{s.lead}</p>{s.story_href&&<p><a class="text-link" href={s.story_href}>Read the illustrated trail →</a></p>}<ol>{s.ideas.map(i=><li><a href={i.href}>{i.title}</a><small>{i.kind}</small></li>)}</ol><button type="button" class="button utk-button" data-journey-starter={s.id} disabled aria-describedby={'starter-status-'+s.id}>Start {s.title}</button><p id={'starter-status-'+s.id} class="starter-status" data-starter-status role="status" aria-live="polite"></p></div></article>)}</section>
<p class="notice">Saved only in this browser, alongside your existing journeys. You can keep up to ten; export a backup from My journey to keep a copy elsewhere.</p>
<div class="article-reading starter-source-notes"><ArticleFootnotes sources={trail.sources} passages={trail.passages}><h3>Photographs</h3><p>The photographs retain their original dates and credits. They do not establish present access or availability.</p><ul>{photographs.map(photo=><li><a href={photo.source}>{photo.caption||photo.alt}</a> · {photo.creator} · <a href={photo.license_url}>{photo.license}</a>. {photo.changes}</li>)}</ul></ArticleFootnotes></div></div></Shell>
<style>
.other-starters-title{margin-bottom:28px}.starter-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px;padding-bottom:36px}.starter-card{min-width:0;background:var(--paper);overflow:hidden;display:flex;flex-direction:column}.starter-card figure{margin:0}.starter-card img{display:block;width:100%;height:auto;aspect-ratio:1.5;object-fit:cover}.starter-card>div{padding:28px;display:flex;flex-direction:column;flex:1}.starter-card h2{font:clamp(28px,3vw,38px)/1.15 var(--serif);margin:15px 0 22px}.starter-card ol{padding-left:24px;margin:24px 0 30px;flex:1}.starter-card li{padding:8px 0 8px 4px}.starter-card small{display:block;color:var(--muted);font-size:12px}.starter-card button{white-space:normal;text-align:left;min-height:48px;overflow-wrap:anywhere}.starter-status{margin-top:18px;font-size:14px;min-height:24px}.starter-credits{font-size:13px;margin:30px 0 50px;overflow-wrap:anywhere}.starter-credits li{margin:12px 0}.starter-credits summary{padding:12px 0;cursor:pointer}@media(max-width:1000px){.starter-grid{grid-template-columns:1fr}.starter-card{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.4fr)}.starter-card img{height:100%;aspect-ratio:auto;min-height:280px}}@media(max-width:600px){.starter-card{display:flex}.starter-card img{height:auto;min-height:0;aspect-ratio:1.5}.starter-card>div{padding:24px}}
</style>

<style>.short-visits{margin:32px 0 64px;scroll-margin-top:24px}.short-visits h2{font:clamp(30px,4vw,48px)/1.15 var(--serif)}.short-visits>p{max-width:75ch}.short-visits>div{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:24px}.short-visits a{display:flex;flex-direction:column;gap:16px;padding:24px;border:1px solid var(--line);background:var(--paper);text-decoration:none}.short-visits strong{font:26px/1.25 var(--serif)}.short-visits span{font-size:15px}.short-visits a:hover{border-color:var(--sea)}@media(max-width:760px){.short-visits>div{grid-template-columns:1fr}}</style>
