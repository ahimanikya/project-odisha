---
import Shell from '../../layouts/Shell.astro';
import VisitorTrail from '../../components/VisitorTrail.astro';
import visitPlans from '../../../../../kb/research/destinations/flexible-visit-plans.json';
import selection from '../../../../../kb/research/journey-starters.json';
import {allowsStarter} from '../../data/edition';
import {bookPhotos} from '../../data/book-photos';
export function getStaticPaths(){return visitPlans.plans.map(trail=>({params:{plan:trail.slug},props:{trail}}));}
const {trail}=Astro.props;
const choices=selection.starters.filter(s=>trail.starter_ids.includes(s.id)&&allowsStarter(s.id));
const photos=[...new Map(trail.chapters.map(c=>{const p=bookPhotos[c.photo];return [p.src,p];})).values()];
---
<Shell title={trail.title} description={trail.intro} active="journey" wide related={false}>
<div class="wrap">
<nav class="plan-breadcrumb" aria-label="Visit plan"><a href="/journey-starters/#short-visits">Flexible visit plans</a><span aria-hidden="true"> / </span><span>{trail.title}</span></nav>
<noscript><p class="notice">Enable JavaScript to save this plan. The stories and preparation questions remain available below.</p></noscript>
<VisitorTrail trail={trail} choices={choices} headingLevel="h1"/>
<nav class="plan-alternatives" aria-label="Other flexible visit plans"><h2>Another place, another beginning.</h2>{visitPlans.plans.filter(p=>p.slug!==trail.slug).map(p=><a class="text-link" href={p.href}>{p.title} →</a>)}<a class="text-link" href="/journey/">Open my journey →</a></nav>
<details class="plan-credits"><summary>Photographs & source notes</summary><p>Plan assembled {trail.reviewed_on}. {trail.review_scope}</p><ul>{trail.sources.map(s=><li><a href={s.url}>{s.title}</a>. {s.note}</li>)}</ul><p>Food and visitor guidance draws on the linked Project Odisha articles; each retains its sources and practical limits.</p><ul>{photos.map(p=><li><a href={p.source}>{p.caption||p.alt}</a> · {p.creator} · <a href={p.license_url}>{p.license}</a>. {p.changes}</li>)}</ul></details>
</div>
</Shell>
<style>.plan-breadcrumb{padding-top:28px;font-size:15px;overflow-wrap:anywhere}.plan-breadcrumb a{display:inline-block;padding:10px 0}.plan-alternatives{border-top:1px solid var(--line);padding-top:28px}.plan-alternatives h2{font:32px/1.2 var(--serif)}.plan-alternatives a{display:inline-block;min-height:44px;margin-right:24px;padding:12px 0}.plan-credits{margin:32px 0 60px;font-size:14px;max-width:85ch;overflow-wrap:anywhere}.plan-credits summary{padding:14px 0;cursor:pointer}.plan-credits li{margin:14px 0}</style>
