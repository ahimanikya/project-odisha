---
import Shell from '../../layouts/Shell.astro';
import VisitorTrail from '../../components/VisitorTrail.astro';
import ArticleByline from '../../components/ArticleByline.astro';
import editorial from '../../../../../kb/research/destinations/mayurbhanj-journey-editorial.json';
import trail from '../../../../../kb/research/destinations/mayurbhanj-trail.json';
import selection from '../../../../../kb/research/journey-starters.json';
import {allowsStarter} from '../../data/edition';
import {bookPhotos} from '../../data/book-photos';
const choices=selection.starters.filter(s=>trail.starter_ids.includes(s.id)&&allowsStarter(s.id));
const photos=[...new Map(trail.chapters.map(c=>{const p=bookPhotos[c.photo];return [p.src,p];})).values()];
---
<Shell title="Mayurbhanj · Forest, Rhythm and a Meal" description={trail.description} active="journey" wide>
<div class="wrap">
<nav class="trail-breadcrumb" aria-label="Journey trail"><a href="/journey-starters/">Journey starters</a><span aria-hidden="true"> / </span><a href="/destinations/mayurbhanj/">Mayurbhanj guide</a></nav>
<noscript><p class="notice">Enable JavaScript to save a journey. All stories and guide links can be read without it.</p></noscript>
<VisitorTrail trail={trail} choices={choices} headingLevel="h1"/>
<article class="mayurbhanj-exposition" aria-labelledby="mayurbhanj-reading-title">
<h2 id="mayurbhanj-reading-title">{editorial.title}</h2>
<ArticleByline author={editorial.byline.replace(/^By /,'')}/>
<p class="reading-scope">{editorial.scope_note}</p>
{editorial.paragraphs.map(p=><p id={'exposition-'+p.id}>{p.text}{Boolean(p.source_id)&&<sup><a id="mayurbhanj-reading-ref-1" href="#mayurbhanj-reading-note-1" data-footnote-ref aria-label="Source 1">[1]</a></sup>}</p>)}
<section id="mayurbhanj-reading-sources" class="reading-sources" aria-labelledby="mayurbhanj-sources-title"><h3 id="mayurbhanj-sources-title">Footnotes &amp; Sources</h3><ol><li id="mayurbhanj-reading-note-1" tabindex="-1"><a href={editorial.notes[0].url}>{editorial.notes[0].text}</a> <a href="#mayurbhanj-reading-ref-1" data-footnote-backref aria-label="Return to reference 1">↩</a></li></ol></section>
<section aria-labelledby="mayurbhanj-further-title"><h3 id="mayurbhanj-further-title">Further reading</h3><ul><li><a href="/destinations/mayurbhanj/">Mayurbhanj guide →</a></li><li><a href="#visitor-trail-title-mayurbhanj-forest-culture">Return to the journey chapters →</a></li></ul><p><a href="/contribute/?page=%2Fjourney-starters%2Fmayurbhanj%2F">Suggest an update →</a></p><p class="reading-privacy">Submissions through GitHub Issues are public. Share public sources; leave out private contact details.</p></section>
</article>
<section class="trail-credits" aria-labelledby="trail-credits-title"><h2 id="trail-credits-title">Photographs &amp; source notes</h2><p>Context reviewed {trail.reviewed_on}. {trail.review_scope}</p><ul>{trail.sources.map(s=><li><a href={s.url}>{s.title}</a>. {s.note}</li>)}</ul><ul>{photos.map(p=><li><a href={p.source}>{p.caption||p.alt}</a> · {p.creator} · <a href={p.license_url}>{p.license}</a>. {p.changes}</li>)}</ul></section>
</div>
</Shell>
<style>.trail-breadcrumb{padding-top:28px;font-size:15px}.trail-breadcrumb a{display:inline-block;padding:10px 0}.trail-credits{margin:32px 0 60px;font-size:14px;max-width:85ch;overflow-wrap:anywhere}.trail-credits summary{padding:14px 0;cursor:pointer}.trail-credits li{margin:14px 0}</style>

<script>
import {bindStorySourceLinks} from '../../lib/story-source-links.mjs';
document.querySelectorAll('.mayurbhanj-exposition').forEach(group=>bindStorySourceLinks(group,document));
</script>
<style>
.mayurbhanj-exposition{max-width:740px;margin:40px auto 64px}.mayurbhanj-exposition>h2{font-size:clamp(36px,5vw,64px);line-height:1.14;overflow-wrap:break-word}.mayurbhanj-exposition>p{font-size:1.1rem;line-height:1.85;margin-block:1.25em}.mayurbhanj-exposition .reading-scope{font-size:.95rem;color:var(--muted);border-left:2px solid var(--earth);padding-left:18px}.mayurbhanj-exposition h3{font-size:clamp(27px,3vw,38px);margin:1.5em 0 .65em}.reading-sources{border-top:1px solid var(--line);padding-top:12px;margin-top:36px;overflow-wrap:anywhere}.reading-sources li{line-height:1.8;scroll-margin-top:28px}.mayurbhanj-exposition sup{font-size:.7em;line-height:0;margin-left:.15em}.mayurbhanj-exposition [data-footnote-ref]{padding:.2em .15em}.mayurbhanj-exposition [data-footnote-backref]{display:inline-block;padding:.2rem .3rem}.mayurbhanj-exposition a:focus-visible{outline:2px solid var(--earth);outline-offset:3px}.mayurbhanj-exposition .reading-privacy{font-size:.85rem;line-height:1.7}
</style>
