---
import Shell from '../../layouts/Shell.astro';
import atlas from '../../../../../kb/research/voices/population-2011.json';
import {selection,districtRows,districtHref,count,percent} from '../../lib/language-atlas.mjs';
const initial=selection(atlas),rows=districtRows(atlas,initial.code);
const labels=Object.values(atlas.labels);
// Retain only summary C-17 values in browser data. Complete relationships stay in the KB.
const browserData={labels:atlas.labels,areas:atlas.areas,profiles:atlas.profiles,multilingualism:Object.fromEntries(Object.entries(atlas.multilingualism).map(([k,v])=>[k,{population:v.population,at_least_two_languages:v.at_least_two_languages,three_languages:v.three_languages}]))};
const json=JSON.stringify(browserData).replaceAll('<','\\u003c');
---
<Shell title="Languages of Odisha · population atlas" description="Explore Odisha’s recorded mother tongues across all 30 districts, with clear Census 2011 counts, percentages and source classifications." active="explore" wide related={false}>
 <div class="atlas-wrap">
  <header class="atlas-intro"><p class="eyebrow">Languages of Odisha · Census 2011</p><h1>Many voices.<br/><em>A closer look at home.</em></h1><p class="atlas-lead">A language is lived in conversation, song and memory. These numbers offer one way to explore where people reported their mother tongue—and to follow the stories behind it.</p><p><a href="/languages/">Meet the languages →</a> · <a href="/languages/districts/">Start with a district →</a></p></header>
  <aside class="atlas-note"><strong>A historical snapshot.</strong> All figures are from 2011. Census language groups contain individual mother-tongue entries; they must not be added together. These classifications do not decide how a community should describe its language or identity.</aside>
  <section aria-labelledby="explore-counts">
   <h2 id="explore-counts">Choose a voice. Explore its districts.</h2>
   <div class="atlas-controls">
    <label>Language or mother-tongue entry<select id="atlas-language">{[['language_group','Census language groups'],['mother_tongue','Individual mother-tongue entries']].map(([level,title])=><optgroup label={title}>{labels.filter(l=>l.level===level).sort((a,b)=>a.label.localeCompare(b.label)).map(l=><option value={l.code} selected={l.code===initial.code}>{l.label}{l.parent?' · under '+atlas.labels[l.parent].label:''}</option>)}</optgroup>)}</select></label>
    <label>Area of residence<select id="atlas-residence"><option value="total">All areas</option><option value="rural">Rural</option><option value="urban">Urban</option></select></label>
    <label>Order districts by<select id="atlas-sort"><option value="count">Number of people</option><option value="share">Share of district population</option><option value="name">District name</option></select></label>
    <label>Find a district<input id="atlas-query" type="search" placeholder="Try Mayurbhanj"/></label>
   </div>
   <p id="atlas-selection-note">Census language group ODIA. Includes the individual Odia, Sambalpuri, Desia and other entries listed beneath it.</p>
   <div class="atlas-summary" aria-live="polite" aria-atomic="true"><div><span id="atlas-label">ODIA · language group</span><strong id="atlas-count">{count(initial.persons)}</strong><span id="atlas-breakdown">{count(initial.males)} male · {count(initial.females)} female</span></div><div><span id="atlas-share-label">Share of Odisha’s population · all areas</span><strong id="atlas-share">{initial.share}</strong><span id="atlas-denominator">Out of {count(initial.population)} people, Census 2011</span></div></div>
   <p id="atlas-results" role="status" aria-live="polite">30 districts · ordered by number of people</p>
   <p class="atlas-help">“Share of district” asks how common the selected entry was within that district. “Share of Odisha’s entry” asks how much of its statewide population lived there. District names follow the source’s 2011 labels.</p>
   <div class="atlas-table-scroll" tabindex="0" role="region" aria-label="Language distribution by district, scroll horizontally on small screens"><table><caption id="atlas-caption">ODIA language group · district population, Census 2011 · all areas</caption><thead><tr><th scope="col">District</th><th scope="col">People</th><th scope="col">Share of district</th><th scope="col">Share of Odisha’s entry</th></tr></thead><tbody id="atlas-rows">{rows.map(r=><tr><th scope="row"><a href={districtHref(atlas.areas[r.code])}>{r.name}</a></th><td>{r.persons===null?'Not separately listed':count(r.persons)}</td><td>{r.persons===null?'—':percent(r.persons,r.population)}<span class="atlas-bar" aria-hidden="true"><span style={'width:'+Math.max(0,r.share||0)+'%'}></span></span></td><td>{r.persons===null?'—':percent(r.persons,initial.persons)}</td></tr>)}</tbody></table></div>
   <p id="atlas-empty" hidden>No district matches. Try the name used in the 2011 table, or clear the search.</p>
   <p class="atlas-help">“Not separately listed” means this entry has no row for that district in this table. It does not establish an absence of speakers today.</p>
   <button id="atlas-download" class="utk-button" type="button">Download this district selection</button><p class="atlas-help">CSV includes male/female counts, denominators and original row numbers. All data are public Census aggregates.</p>
   <noscript><p>The default ODIA-group table is available above. Enable JavaScript to choose another entry, filter districts or download a selection.</p></noscript>
  </section>
  <section class="atlas-multilingual" aria-labelledby="more-than-one"><p class="eyebrow">Languages travel together</p><h2 id="more-than-one">More than one language</h2><p><a href="/languages/multilingual-odisha/">Understand the statewide picture →</a></p><p id="atlas-multi">{count(atlas.multilingualism[initial.code].at_least_two_languages[0])} people in the ODIA group reported at least one additional language. Of these, {count(atlas.multilingualism[initial.code].three_languages[0])} reported two additional languages. Statewide, all areas, Census 2011.</p><p class="atlas-help">C-17 reports additional languages for the statewide Census language group, across rural and urban areas combined. People reporting three languages are included among those reporting at least two. These are not district counts or separate counts for each mother-tongue entry.</p></section>
  <section class="atlas-reading"><h2>Follow the numbers into a story</h2><p>Read a language introduction, find a publication, or help us understand the names and places behind the table.</p><div>{Object.entries(atlas.profiles).map(([slug,p])=><a href={'/languages/'+slug+'/'}>{slug==='saora'?'Saora / Sora':atlas.labels[p.code].label} →</a>)}</div><p><a href="/contribute/?page=%2Flanguages%2Fatlas%2F">Suggest a correction or source</a></p></section>
  <details class="mag-article-credits"><summary>Sources, definitions & how we checked the numbers</summary><p>Office of the Registrar General & Census Commissioner, India. Original workbooks downloaded 1 October 2026 and preserved unchanged in the Project Odisha knowledge bundle.</p><ul>{Object.values(atlas.sources).map(s=><li><a href={s.url}>{s.title}</a> · <a href={s.download}>original workbook</a></li>)}</ul><p>We checked male/female and rural/urban sums for all 21,188 C-16 data rows, reconciled district counts with the state for each entry, checked group totals against their listed children, and matched all 90 C-17 group populations to C-16. The residual OTHERS group is included in totals. Arithmetic checks do not independently establish the accuracy of self-reported language identities.</p><p>This first atlas displays state and district data. Subdistrict rows remain in the original C-16 workbook. There is no current population estimate, geographic boundary map, migration inference or language-vitality ranking here. Native-speaker and specialist naming review remains open.</p><p>Research and implementation prepared with AI assistance under Ahimanikya Satapathy, Founder & Editor-in-Chief.</p></details>
 </div>
 <script id="language-atlas-data" type="application/json" is:inline set:html={json}/>
 <script>import '../../scripts/language-atlas';</script>
</Shell>
<style is:global>
.atlas-wrap{max-width:1600px;margin:auto;padding:clamp(1rem,4vw,4rem)}.atlas-intro{padding:2rem 0 3rem;max-width:1100px}.atlas-intro h1{font:clamp(3rem,6.5vw,6.5rem)/1.08 Georgia,serif;color:#1D4658;margin:1rem 0 1.5rem}.atlas-intro em{color:#91462F}.atlas-lead{font-size:clamp(1.1rem,1.6vw,1.4rem);line-height:1.7;max-width:65ch}.atlas-note{border-left:3px solid #91462F;padding:1.2rem 1.5rem;background:#F2E6D0;margin-bottom:3rem;max-width:100ch}.atlas-wrap h2{font:clamp(1.8rem,3vw,3rem)/1.2 Georgia,serif;color:#1D4658}.atlas-controls{display:grid;grid-template-columns:2fr 1fr 1.5fr 1fr;gap:1rem;margin:2rem 0}.atlas-controls label{min-width:0;font-size:.85rem;font-weight:650}.atlas-controls input,.atlas-controls select{display:block;width:100%;margin-top:.4rem;min-height:3rem;padding:.75rem;border:1px solid #8c8270;background:#fffdf8;color:#302E28;font:inherit;border-radius:4px}.atlas-summary{display:grid;grid-template-columns:1fr 1fr;gap:2rem;border-block:1px solid #C9B99B;padding:2rem 0;margin:1.5rem 0}.atlas-summary>div{display:flex;flex-direction:column;gap:.5rem}.atlas-summary strong{font:clamp(2.5rem,4vw,4.5rem)/1.1 Georgia,serif;color:#1D4658}.atlas-summary span{font-size:.95rem}.atlas-help{font-size:.9rem;line-height:1.7;max-width:95ch}.atlas-table-scroll{overflow:auto;margin:1.5rem 0}.atlas-table-scroll table{border-collapse:collapse;width:100%;min-width:620px}.atlas-table-scroll caption{text-align:left;padding:.7rem 0;font-weight:650}.atlas-table-scroll th,.atlas-table-scroll td{padding:.9rem 1rem;border-bottom:1px solid #C9B99B;text-align:right;font-variant-numeric:tabular-nums}.atlas-table-scroll th:first-child{text-align:left}.atlas-table-scroll thead{background:#1D4658;color:#FBF6EC}.atlas-table-scroll tbody th{font-weight:550}.atlas-bar{display:block;height:5px;background:#F2E6D0;margin-top:.5rem;width:100%}.atlas-bar>span{display:block;height:100%;background:#91462F}.atlas-multilingual,.atlas-reading{padding:2rem 0;border-top:1px solid #C9B99B;margin-top:3rem}.atlas-reading>div{display:flex;gap:1.2rem 2rem;flex-wrap:wrap}#atlas-selection-note{max-width:95ch}.atlas-wrap button:focus-visible,.atlas-wrap select:focus-visible,.atlas-wrap input:focus-visible,.atlas-table-scroll:focus-visible{outline:3px solid #91462F;outline-offset:3px}@media(max-width:1000px){.atlas-controls{grid-template-columns:1fr 1fr}}@media(max-width:600px){.atlas-controls,.atlas-summary{grid-template-columns:1fr}.atlas-wrap{padding:1.2rem}.atlas-intro{padding-top:1rem}.atlas-table-scroll th,.atlas-table-scroll td{padding:.75rem}.atlas-summary{gap:1.5rem}}@media print{.atlas-controls,#atlas-download{display:none}.atlas-table-scroll{overflow:visible}.atlas-table-scroll table{min-width:0;font-size:10pt}.atlas-intro h1{font-size:30pt}.atlas-summary strong{font-size:24pt}}
</style>
