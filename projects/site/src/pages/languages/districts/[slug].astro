---
import Shell from '../../../layouts/Shell.astro';
import DistrictLanguageTable from '../../../components/DistrictLanguageTable.astro';
import discoveries from '../../../../../../kb/research/related-discoveries.json';
import {discoveryEntries} from '../../../data/discovery';
import {allowsPage} from '../../../data/edition';
import atlas from '../../../../../../kb/research/voices/population-2011.json';
import connections from '../../../../../../kb/research/voices/district-connections.json';
import {districtSlug,districtBreakdown,count,percent} from '../../../lib/language-atlas.mjs';
import '../../../styles/language-districts.css';
export function getStaticPaths(){return Object.values(atlas.areas).filter(a=>a.code!=='000').map(area=>({params:{slug:districtSlug(area)},props:{code:area.code}}));}
const {code}=Astro.props,d=districtBreakdown(atlas,code),area=d.area;
const profiles=Object.entries(atlas.profiles).filter(([slug,p])=>area.rows[p.code]?.values[0]>0).sort((a,b)=>area.rows[b[1].code].values[0]-area.rows[a[1].code].values[0]);
const visits=connections.connections.filter(c=>c.district===code);
const further=discoveries.links.filter(link=>link.from===`/languages/districts/${districtSlug(area)}/`&&allowsPage(link.to)).map(link=>({...link,title:discoveryEntries.find(entry=>entry.href===link.to)?.label||link.to}));
---
<Shell title={area.name+' · languages and population'} description={'Explore '+area.name+' district’s recorded mother tongues in Census 2011, compare rural and urban populations, and discover related language stories.'} active="explore" wide related={false}>
<article class="district-wrap"><a href="/languages/districts/">← All 30 districts</a><header class="district-intro"><p class="eyebrow">A district in voices · Census 2011</p><h1>{area.name}<br/><em>More than a single voice.</em></h1><p>The largest recorded language group was {d.groups[0].label}, with {count(d.groups[0].persons)} people ({d.groups[0].share}). Open the individual entries below: broad groups can contain distinct names and stories.</p></header>
<div class="district-stats"><div><span>District population · 2011</span><strong>{count(d.population)}</strong></div><div><span>Rural population</span><strong>{percent(area.population[3],d.population)}</strong><span>{count(area.population[3])} people</span></div><div><span>Urban population</span><strong>{percent(area.population[6],d.population)}</strong><span>{count(area.population[6])} people</span></div></div>
<p class="district-note">This is a historical district profile, not a city survey or a present-day forecast. Mother tongue, community identity, ancestry and the languages used at work are different questions.</p>
<section class="district-section"><h2>The whole district</h2><DistrictLanguageTable data={d} atlas={atlas}/></section>
<section class="district-section"><h2>Rural and urban: two views within the district</h2><p>Each share below uses the population of that residence category. Rural and urban counts add to the district total; their percentages use different denominators.</p>{['rural','urban'].map(residence=><details><summary>{residence==='rural'?'Rural':'Urban'} population breakdown</summary><DistrictLanguageTable data={districtBreakdown(atlas,code,residence)} atlas={atlas}/></details>)}</section>
<section class="district-section"><h2>Follow a voice into its story</h2><p>These introductions connect to individual mother-tongue entries recorded here. They are a selection from our growing collection, not a complete list of the district’s languages.</p><nav class="district-links" aria-label="Language stories">{profiles.map(([slug,p])=><a href={'/languages/'+slug+'/'}>{slug==='saora'?'Saora / Sora (Census: Savara)':atlas.labels[p.code].label} →</a>)}</nav></section>
{visits.length>0&&<section class="district-section"><h2>Let the place deepen the reading</h2>{visits.map(v=><div class="district-copy"><p>{v.note}</p><a href={'/destinations/'+v.destination+'/'}>Explore {v.title} →</a></div>)}</section>}
<!-- Editorial reading links do not infer language, ancestry or travel access. -->
{further.length>0&&<section class="district-section"><h2>Read another story from the district</h2>{further.map(link=><div class="district-copy"><p>{link.reason}</p><a href={link.to}>{link.title} →</a></div>)}</section>}
<section class="district-section district-copy"><h2>Take curiosity into a conversation</h2><p>Ask which name a speaker uses for their language and which language they prefer for your conversation. A family memory, a local publication or a song they choose can add context that a table cannot supply.</p><p><a href="/languages/multilingual-odisha/">Read about multilingual Odisha →</a> · <a href="/contribute/">Share a source or correction →</a></p></section>
<details class="mag-article-credits"><summary>Sources, geography & interpretation</summary><p><a href={atlas.sources.c16.url}>Census C-16, Odisha, 2011</a>. District code {code}; source name {area.name}. All figures derive from the original workbook retained in our KB. Parent groups contain their individual entries; classification does not determine community-preferred naming.</p><p>District figures cannot establish the languages of a particular town, accommodation provider or individual. C-17 multilingualism is statewide and is not apportioned to this district. No migration or ancestry claim is inferred.</p><p>Community naming and visual review remain open.</p></details>
</article></Shell>
