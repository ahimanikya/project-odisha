---
import entry from '../../../../../kb/research/people/samanta-chandrasekhar.json';
import Shell from '../../layouts/Shell.astro';
---
<Shell title={entry.title} description={entry.summary} wide>
  <div class="wrap samanta-entry" id="article" tabindex="-1">
    <div class="draft"><span class="dot" aria-hidden="true"></span> Editorial preview <span class="draft-detail">· Draft awaiting Founder review</span></div>
    <section class="hero" aria-labelledby="entry-title">
      <div>
        <p class="eyebrow">{entry.category}</p>
        <h1 id="entry-title">Samanta<br />Chandrasekhar</h1>
        <p class="alternate">Also known as {entry.alternateName}</p>
        <p class="standfirst">{entry.summary}</p>
        <p class="place">{entry.place}</p>
      </div>
      <div class="sky" aria-hidden="true">
        <svg viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="200" cy="200" r="161"/><circle cx="200" cy="200" r="118"/><circle cx="200" cy="200" r="74"/>
          <ellipse cx="200" cy="200" rx="161" ry="55" transform="rotate(-35 200 200)" />
          <path d="M38 200H362M200 39V361M86 86L314 314M86 314L314 86" />
          <circle class="star" cx="200" cy="200" r="8"/><circle class="star" cx="288" cy="99" r="4"/><circle class="star" cx="93" cy="270" r="5"/>
          <path class="bright" d="M322 240V258M313 249H331M106 91V103M100 97H112"/>
        </svg>
        <p>Observe. Question. Understand.</p>
        <small>Decorative sky study</small>
      </div>
    </section>
    <div class="reading-layout">
      <aside class="contents" aria-label="On this page">
        <p class="eyebrow">In this entry</p>
        <nav>{entry.sections.map((section, i) => <a href={'#'+section.id}><span>0{i+1}</span>{section.title}</a>)}<a href="#sources"><span>04</span>Sources & reading</a><a href="#credits"><span>05</span>Credit & review</a></nav>
        <div class="context"><span class="eyebrow">Knowledge grows</span><p>This first entry makes its sources and open questions visible. New evidence can improve the next version.</p></div>
      </aside>
      <article>
        {entry.sections.map((section) => <section id={section.id} class:list={['article-section', {uncertainty: section.id === 'reading-with-care'}]}>
          <h2>{section.title}</h2>
          {section.paragraphs.map(p => <p>{p.text} {p.sources.map(id => <a class="citation" href={'#'+id} aria-label={'Read source '+id}>[{id.slice(1)}]</a>)}</p>)}
        </section>)}
        <section id="sources" class="article-section sources">
          <p class="eyebrow">Follow the evidence</p><h2>Sources & further reading</h2>
          <p class="section-intro">What we consulted, and how far we could verify it.</p>
          <ol>{entry.sources.map(s => <li id={s.id}><a href={s.url}>{s.title} <span aria-hidden="true">↗</span></a><p>{s.author}<br/><span>{s.publisher}</span></p><details><summary>What we reviewed</summary><p>{s.review}</p></details></li>)}</ol>
        </section>
        <section id="credits" class="article-section credits">
          <p class="eyebrow">Made with care · Open to correction</p><h2>Credit & review</h2>
          <p>Prepared for <strong>{entry.credit.initiative}</strong>. Founder & Editor-in-Chief: <strong>{entry.credit.founder}</strong>.</p>
          <p class="review-status">Editorial review: pending</p>
          <details><summary>Research & design notes</summary><p>Source authors retain credit for their work; the source notes describe what was reviewed and what remains uncertain.</p><p>The sky ornament is decorative artwork, not a reconstruction of a historical instrument. Editorial review is pending; no scholarly endorsement or fieldwork is claimed.</p></details>
          <p class="contribution">Help improve this entry through <a href="/contribute/?page=%2Fpeople%2Fsamanta-chandrasekhar%2F">our contribution page</a>. Public submissions are reviewed before encyclopedia publication.</p>
        </section>
      </article>
    </div>
  </div>
</Shell>
<style>
.samanta-entry{padding-bottom:3rem}
.draft{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;padding-block:1.5rem;color:var(--muted);font-size:.85rem}
.dot{width:.45rem;height:.45rem;background:var(--earth);border-radius:50%;flex:none}
.hero{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:3rem;padding:2rem 0 4rem;align-items:center;border-bottom:1px solid var(--line)}
.hero>div{min-width:0}.hero h1{margin-bottom:1.5rem;max-width:100%}
.alternate{font:italic 1.25rem/1.6 var(--uds-type-reading);color:var(--muted)}
.standfirst{font:1.4rem/1.7 var(--uds-type-reading);max-width:48ch;margin-top:1.75rem}
.place{font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--olive);margin-top:2rem}
.sky{background:var(--sea);color:var(--light);aspect-ratio:4/5;display:flex;flex-direction:column;justify-content:center;align-items:center;border-radius:11rem 11rem .25rem .25rem;padding:1rem;width:100%;max-width:34rem;justify-self:end}
.sky svg{width:100%;stroke:var(--light);stroke-opacity:.45;stroke-width:1}
.sky .star{fill:var(--straw);stroke:none}.sky .bright{stroke:var(--straw);stroke-opacity:1}
.sky p{font:italic 1.05rem/1.6 var(--uds-type-display);margin-bottom:.75rem}
.sky small{font-size:.65rem;letter-spacing:.1em;text-transform:uppercase}
.reading-layout{display:grid;grid-template-columns:15rem minmax(0,52rem);justify-content:space-between;gap:clamp(2rem,6vw,6rem);padding-top:3.5rem}
.contents nav{display:grid;gap:.5rem}.contents nav a{display:flex;gap:.9rem;min-height:var(--uds-interaction-target);align-items:center;font-size:.95rem;text-decoration:none}
.contents nav a span{color:var(--earth);font-size:.8rem}.context{border-top:1px solid var(--line);margin-top:2rem;padding-top:1.5rem}.context p{font:italic 1.05rem/1.7 var(--uds-type-reading)}
.article-section{margin-bottom:3.5rem}.article-section h2{margin-bottom:1.5rem}.article-section p{font:1.125rem/1.85 var(--uds-type-reading);margin-bottom:1.4rem}
.citation{display:inline-flex;min-height:2.75rem;min-width:2rem;align-items:center;justify-content:center;font:.85rem var(--uds-type-ui);color:var(--sea)}
.uncertainty{border-left:3px solid var(--straw);padding-left:1.5rem}
.sources{border-top:1px solid var(--line);padding-top:2.5rem}.sources ol{padding-left:1.5rem}.sources li{padding:0 0 1.5rem .5rem;overflow-wrap:anywhere;scroll-margin-top:1.5rem}.sources li>a{font:1.25rem/1.5 var(--uds-type-display)}.sources li p{font-size:.95rem;margin:.75rem 0}
summary{cursor:pointer;color:var(--sea);min-height:var(--uds-interaction-target);padding-block:.75rem}details p{margin-block:1rem;font-size:1rem}
.credits{padding:2rem;background:var(--paper);border-radius:var(--uds-interaction-radius)}.credits p{font-size:1rem}.review-status{color:var(--earth)}.contribution{border-top:1px solid var(--line);padding-top:1.25rem}
@media(max-width:850px){.reading-layout{grid-template-columns:1fr}.contents nav{grid-template-columns:1fr 1fr;gap:.5rem 1rem}.context{display:none}.hero{gap:1.5rem}}
@media(max-width:650px){.hero{grid-template-columns:1fr;padding:1.5rem 0 2.5rem}.sky{max-width:100%;aspect-ratio:1.6;position:relative;overflow:hidden;padding:1.5rem}.sky svg{position:absolute;width:15rem;right:-2.5rem;top:-1.5rem;opacity:.55}.sky p,.sky small{position:relative;align-self:start}.sky p{margin-top:3rem}.contents nav{grid-template-columns:1fr}.reading-layout{padding-top:2rem}.credits{padding:1.5rem}}
</style>
