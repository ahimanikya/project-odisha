---
import Shell from '../../layouts/Shell.astro';
import BoseArticle from '../../components/BoseArticle.astro';
import entry from '../../../../../kb/research/people/subhas-chandra-bose.json';
import editorial from '../../../../../kb/research/people/bose-editorial.json';
import {allowsPage} from '../../data/edition';
const links=[...entry.related.filter(link=>allowsPage(link.href)),{title:'Open my journey',href:'/journey/'}];
---
<Shell title={entry.title} description={entry.lead} active="explore" wide related={false}>
 <BoseArticle entry={entry} photo={entry.assets[entry.hero]} links={links} editorial={editorial}/>
</Shell>
