---
import ArticleByline from '../../components/ArticleByline.astro';
import ArticleFootnote from '../../components/ArticleFootnote.astro';
import ArticleReadingPath from '../../components/ArticleReadingPath.astro';
import SaveJourney from '../../components/SaveJourney.astro';
import '../../styles/article-reading.css';
import Shell from '../../layouts/Shell.astro';
import ResearchContents from '../../components/ResearchContents.astro';
import {entries,renderResearchDocument,researchLink,articleForEntry} from '../../lib/reading-room.mjs';
export function getStaticPaths(){return entries.map(entry=>({params:{slug:entry.slug},props:{entry}}));}
const {entry}=Astro.props;
const editorial=articleForEntry(entry);
const passages=editorial?.sections.flatMap(section=>section.paragraphs.map((paragraph,index)=>({...paragraph,id:`${section.id}-${index}`})))||[];
const contents=editorial?[...editorial.sections.filter(section=>section.title).map(section=>({title:section.title,href:'#'+section.id})),{title:'Further reading',href:'#niyamgiri-further-reading'},{title:'Footnotes & Sources',href:'#story-sources'}]:[];
const {html:body,headings}=editorial?{html:'',headings:[]}:await renderResearchDocument(entry);
const sections=headings.filter(h=>h.depth===2).map(h=>({href:'#'+h.slug,title:h.text}));
if(entry.sources.length)sections.push({href:'#reading-sources',title:'Sources to follow'});
---
<Shell title={editorial?.title||entry.title+' — Research notes'} description={editorial?editorial.sections[1].paragraphs[1].text:entry.description} active="explore" related={false}>
{editorial?<article class="article-reading niyamgiri-story">
 <a class="collection-return" href={editorial.collection_return.href}>← {editorial.collection_return.title}</a>
 <header><h1>{editorial.title}</h1><ArticleByline author={editorial.author}/><SaveJourney id="reading:reading-room/economy/niyamgiri-rights-and-mining" quiet/></header>
 <ResearchContents items={contents} label="In this article"/>
 {editorial.sections.map(section=><div id={section.id}>
  {section.title&&<h2>{section.title}</h2>}
  {section.paragraphs.map((paragraph,index)=><p class:list={{'article-opening':passages[editorial.leadParagraphIndex]?.id===`${section.id}-${index}`}} data-source-ids={paragraph.source_ids.join(' ')}>{paragraph.segments.map(segment=>segment.source_id?<ArticleFootnote ids={[segment.source_id]} sources={editorial.sources} passage={`${section.id}-${index}`}/>:segment.text)}</p>)}
 </div>)}
 <ArticleReadingPath id="niyamgiri-further-reading" heading="Further reading" links={editorial.further_reading}/>
 <section id="story-sources" class="article-footnotes" aria-labelledby="footnote-title"><h2 id="footnote-title">Footnotes &amp; Sources</h2><ol>{editorial.sources.map((source,index)=><li id={'note-'+source.id} tabindex="-1">{source.footnote_segments.map(segment=>segment.href?<a href={segment.href}>{segment.text}</a>:segment.text)}{' '}<span class="footnote-returns">{passages.filter(p=>p.source_ids.includes(source.id)).map((p,i)=><a href={`#ref-${p.id}-${source.id}`} data-footnote-backref aria-label={`Return to passage ${i+1} for footnote ${index+1}`}>↩{i>0?i+1:''}</a>)}</span></li>)}</ol></section>
 <p class="article-update"><a href="/contribute/?page=%2Freading-room%2Feconomy%2Fniyamgiri-rights-and-mining%2F">Suggest an update</a>. GitHub submissions are public; omit private contact details and consent documents.</p>
</article>:<article class="reading-article">
<nav aria-label="Reading room breadcrumb"><a href="/reading-room/">Reading room</a> / {entry.group}</nav>
<header><p class="eyebrow">{entry.type} · Research notes</p><h1>{entry.title}</h1><p class="lead">{entry.description}</p><p class="reading-status">Dated evidence and open questions. These notes preserve the sources’ reporting periods and research limits; they do not confirm current services, permissions or investment returns. Specialist review remains open.</p></header>
{headings.filter(h=>h.depth===2).length>=3&&<ResearchContents items={sections}/>}
<div class="research-body" set:html={body}/>
{entry.sources.length>0&&<section class="source-list" aria-labelledby="reading-sources"><h2 id="reading-sources">Sources to follow</h2><ul>{entry.sources.map(source=><li><a href={researchLink(source.resource,entry.path)}>{source.title||source.id}</a></li>)}</ul></section>}
<footer><p>Published in the reading room on 15 October 2026. Research dates are retained in the text and source records.</p><a href="/reading-room/">Explore more research →</a></footer>
</article>}
</Shell>
<style>
.niyamgiri-story .collection-return{display:inline-block;margin-bottom:2rem;font-size:.95rem}.niyamgiri-story .article-opening{font-size:1.18rem}.niyamgiri-story .article-update{font-size:.9rem;margin-top:2.5rem}

.reading-article{max-width:800px;margin:3rem auto 5rem;padding:0 1.4rem;line-height:1.8;overflow-wrap:anywhere}.reading-article nav{font-size:.95rem;margin-bottom:2rem}.reading-article h1{font:clamp(2.2rem,5vw,3.7rem)/1.13 var(--serif);margin:.7rem 0 1.3rem;color:var(--sea)}.lead{font-size:1.15rem}.reading-status{border-left:3px solid var(--earth);padding:.8rem 1.2rem;background:var(--paper);font-size:.9rem;margin:1.5rem 0 2.5rem}.reading-article :global(p){margin-bottom:1.2rem}.reading-article :global(h2){font:1.8rem/1.3 var(--serif);margin:2.5rem 0 1rem}.reading-article :global(h3){font-size:1.2rem;margin:1.8rem 0 .8rem}.reading-article :global(ul),.reading-article :global(ol){padding-left:1.5rem;margin:1rem 0 1.5rem}.reading-article :global(li){margin:.55rem 0}.reading-article :global(a){text-decoration:underline;text-underline-offset:3px}.reading-article :global(a:focus-visible){outline:3px solid var(--earth);outline-offset:4px}.reading-article :global(table){display:block;overflow-x:auto;max-width:100%;border-collapse:collapse;margin:1.5rem 0;font-size:.9rem}.reading-article :global(th),.reading-article :global(td){border:1px solid var(--line);padding:.6rem;text-align:left;min-width:105px}.reading-article :global(blockquote){border-left:3px solid var(--earth);padding:1rem;margin:1.5rem 0;background:var(--paper)}.reading-article :global(pre){overflow-x:auto;white-space:pre-wrap}.source-list,.reading-article footer{border-top:1px solid var(--line);padding-top:1rem;margin-top:2.5rem}.reading-article footer{font-size:.9rem}
</style>
