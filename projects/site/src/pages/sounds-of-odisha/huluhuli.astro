---
import ArticleByline from '../../components/ArticleByline.astro';
import ArticleFootnote from '../../components/ArticleFootnote.astro';
import ArticleFootnotes from '../../components/ArticleFootnotes.astro';
import '../../styles/article-reading.css';
import Shell from '../../layouts/Shell.astro';
import SoundReadingPaths from '../../components/SoundReadingPaths.astro';
import ResearchContents from '../../components/ResearchContents.astro';
import SoundsReadingTrail from '../../components/SoundsReadingTrail.astro';
import story from '../../../../../kb/research/culture/huluhuli-website.json';
const sections=story.blocks.map((block,index)=>({...block,id:block.title?`story-section-${index+1}`:undefined,passage:`huluhuli-${index}`}));
const passages=sections.flatMap(b=>b.paragraphs.map((_,i)=>({id:b.passage+'-'+i,source_ids:b.paragraph_source_ids[i]})));
const contents=[...sections.filter(block=>block.title).map(block=>({title:block.title,href:'#'+block.id})),{title:'Footnotes & Sources',href:'#story-sources'}];
---
<Shell title={story.title} description={story.lead} active="explore" wide related={false}>
<article class="article-reading huluhuli-story"><a class="text-link collection-return" href="/sounds-of-odisha/#huluhuli">← Sounds of Odisha</a>
<header class="huluhuli-hero"><p class="eyebrow">Sounds of Odisha · ହୁଳହୁଳି</p><h1>Huluhuli.<br/><em>A voice of welcome.</em></h1><ArticleByline author={story.author} reviewedOn={story.reviewed_on}/><p class="lead">{story.lead}</p><figure><img src={story.photo.src} width={story.photo.width} height={story.photo.height} alt={story.photo.alt} fetchpriority="high"/><figcaption>{story.photo.caption}</figcaption></figure></header>
<ResearchContents items={contents} label="In this story"/>
{sections.map(b=><section class="narrative-section">{b.title&&<h2 id={b.id}>{b.title}</h2>}{b.paragraphs.map((p,i)=><p>{p}<ArticleFootnote ids={b.paragraph_source_ids[i]} sources={story.sources} passage={b.passage+'-'+i}/></p>)}</section>)}
<p><a href="/literature/">Explore Odia literature →</a> · <a href="/sounds-of-odisha/#dhemsa">Meet Dhemsa →</a></p>
<ArticleFootnotes sources={story.sources.map(s=>({id:s.id,title:s.title,url:s.resource,note:s.reader_note}))} passages={passages}><h3>Illustration</h3><p>{story.photo.reader_credit}</p></ArticleFootnotes>
<SoundReadingPaths current="huluhuli"/>
<p><a href="/contribute/?page=%2Fsounds-of-odisha%2Fhuluhuli%2F">Suggest a correction or a public source</a>. GitHub submissions are public; omit private contact details and consent documents.</p><SoundsReadingTrail slug="huluhuli"/>
</article></Shell>
<style>.collection-return{display:inline-block;margin:1rem 0 2rem}.huluhuli-hero em{color:var(--sea)}.huluhuli-hero .lead{font-size:1.25rem;line-height:1.7}.huluhuli-hero img{width:100%;height:auto}.narrative-section{margin-block:2.5rem}.narrative-section h2{scroll-margin-top:2rem}</style>
