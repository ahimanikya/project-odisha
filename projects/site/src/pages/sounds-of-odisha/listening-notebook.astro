---
import Shell from '../../layouts/Shell.astro';
import guide from '../../../../../kb/research/culture/listening-notebook.json';
---
<Shell title={guide.title} description={guide.lead} active="explore" wide related={false}>
<article class="wrap notebook"><a class="text-link collection-return" href="/sounds-of-odisha/">← Sounds of Odisha</a>
<header><p class="eyebrow">A companion for your visit</p><h1>A listening<br/><em>notebook.</em></h1><p class="lead">{guide.lead}</p><a class="button-link download-note" href="/assets/odisha-listening-notebook.txt" download>Download the blank notebook ↓</a><p class="quiet">Use your browser’s Print command for a paper copy. This page does not collect your notes.</p></header>
<div class="reading">{guide.sections.map(s=><section><h2>{s.title}</h2>{s.paragraphs.map(p=><p>{p}</p>)}</section>)}
<section><p class="eyebrow">Choose a question</p><h2>Eight paths into listening.</h2><div class="question-grid">{guide.entries.map(e=><div class="question-card"><h3><a href={e.route}>{e.name} →</a></h3><p>{e.question}</p></div>)}</div></section>
<section class="blank-notebook"><h2>One encounter.</h2><p>Keep observations and explanations separate. Leave unknown details blank.</p><dl>{guide.fields.map(f=><div><dt>{f}</dt><dd aria-label="Space for a handwritten note"><span aria-hidden="true">________________________________</span></dd></div>)}</dl></section>
<p class="notice">{guide.limitations}</p><p><a href="/contribute/?page=%2Fsounds-of-odisha%2Flistening-notebook%2F">Suggest a correction or a public source</a>. GitHub submissions are public.</p><a class="text-link" href="/sounds-of-odisha/">Return to the stories →</a></div></article>
</Shell>
<style>
.notebook{padding-bottom:64px}.collection-return{display:inline-block;margin:28px 0}.notebook header{max-width:850px;margin:18px auto 60px}.notebook h1{font-size:clamp(48px,6vw,84px);line-height:1.1}.notebook h1 em{color:var(--sea)}.quiet{font-size:14px;color:var(--muted);margin-top:18px}.reading{max-width:900px;margin:auto;font-size:19px;line-height:1.85}.reading section{margin-bottom:44px}.reading h2{font-size:clamp(30px,3vw,44px);line-height:1.2;margin:28px 0 20px}.question-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.question-card{border-top:1px solid var(--line);padding:18px 0}.question-card h3{font-size:25px;margin:0 0 10px}.question-card p{font-size:17px;margin:0}.blank-notebook dl>div{break-inside:avoid;margin:18px 0}.blank-notebook dt{font-weight:600}.blank-notebook dd{margin:8px 0;color:var(--muted);overflow:hidden}.notice{font-size:15px}.download-note{display:inline-block}@media(max-width:760px){.notebook header{margin-bottom:36px}.reading{font-size:17px}.question-grid{grid-template-columns:1fr}.notebook h1{font-size:46px}}@media print{.download-note,.collection-return,.quiet{display:none}.notebook header{margin:0 0 24px}.notebook h1{font-size:38pt}.reading{font-size:11pt;line-height:1.5}.reading h2{font-size:22pt;break-after:avoid}.question-card{break-inside:avoid}.blank-notebook{break-before:page}.blank-notebook dd{height:32px}.reading section{margin-bottom:24px}.reading a{color:inherit}}
</style>
