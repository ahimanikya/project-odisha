---
import StorySourceLinks from '../../components/StorySourceLinks.astro';
import Shell from '../../layouts/Shell.astro';
import SoundReadingPaths from '../../components/SoundReadingPaths.astro';
import ResearchContents from '../../components/ResearchContents.astro';
import SoundsReadingTrail from '../../components/SoundsReadingTrail.astro';
import story from '../../../../../kb/research/culture/mardala-website.json';
const sections=story.blocks.map((block,index)=>({...block,id:block.title?`story-section-${index+1}`:undefined}));
const contents=[...sections.filter(block=>block.title).map(block=>({title:block.title,href:'#'+block.id})),{title:'Sources & reading notes',href:'#story-sources'}];
---
<Shell title={story.title} description={story.lead} active="explore" wide related={false}>
<article class="wrap mardala-story"><a class="text-link collection-return" href="/sounds-of-odisha/#mardala">← Sounds of Odisha</a>
<header class="mardala-hero"><div><p class="eyebrow">Sounds of Odisha · Rhythm & dance</p><h1>Mardala.<br/><em>The conversation beneath the dance.</em></h1><p class="lead">{story.lead}</p></div><figure><img src="/assets/home-art/odissi-rehearsal-v1.webp" width="1536" height="1024" alt={story.photo.alt} fetchpriority="high"/><figcaption>{story.photo.caption}</figcaption></figure></header>
<div class="mardala-reading"><ResearchContents items={contents} label="In this story"/>{sections.map(b=><section>{b.title&&<h2 id={b.id}>{b.title}</h2>}{b.items.length>0&&<p>{b.paragraphs[0]}</p>}{b.items.length>0&&<ol>{b.items.map(p=><li>{p}</li>)}</ol>}{(b.items.length>0?b.paragraphs.slice(1):b.paragraphs).map(p=><p>{p}</p>)}<StorySourceLinks ids={b.source_ids} sources={story.sources}/></section>)}
<p class="notice">A sourced reader story. Practitioner/language review remains open; no audio recording or current performance booking is provided.</p>
<p><a href="/stories/gotipua/">Explore Gotipua’s learning story →</a></p>
<p><a href="/literature/">Explore Odia literature →</a> · <a href="/sounds-of-odisha/huluhuli/">Meet Huluhuli →</a></p>
<details id="story-sources" class="utk-disclosure mardala-credits"><summary>Sources, artwork &amp; reading notes</summary><p>{story.limits} Desk review: {story.reviewed_on}.</p><ol>{story.sources.map(s=><li id={"story-source-"+s.id} tabindex="-1"><a href={s.resource}>{s.title}</a> — {s.locator}</li>)}</ol><p>The Banamali Maharana citation is historical. Award year 2013 and presentation date 11 April 2014 remain distinct. ABHIPSAA credits concern the named pieces, not every part of the production. No recording playback or current class access verified.</p><h3>Artwork</h3><p>{story.photo.public_description} {story.photo.changes}</p></details>
<SoundReadingPaths current="mardala"/>
<p><a href="/contribute/?page=%2Fsounds-of-odisha%2Fmardala%2F">Suggest a correction or a public source</a>. GitHub submissions are public; omit private contact details and consent documents.</p><SoundsReadingTrail slug="mardala"/></div>
</article></Shell>
<style>[id^="story-source-"]{scroll-margin-top:24px}[id^="story-source-"]:target{background:var(--paper,#f4ede1);outline:2px solid var(--earth);outline-offset:6px}.mardala-story{padding-bottom:70px}.collection-return{display:inline-block;margin:28px 0}.mardala-hero{display:grid;grid-template-columns:1fr 1.1fr;gap:clamp(28px,5vw,100px);align-items:center;margin:12px 0 52px}.mardala-hero h1{font-size:clamp(48px,5vw,84px);line-height:1.08}.mardala-hero h1 em{color:var(--sea)}.mardala-hero figure{margin:0}.mardala-hero img{width:100%;height:auto}.mardala-hero figcaption{font-size:13px;color:var(--muted);margin-top:10px}.mardala-reading{max-width:900px;margin:auto;font-size:19px;line-height:1.85}.mardala-reading section{margin-bottom:40px}.mardala-reading h2{font-size:clamp(30px,3vw,44px);line-height:1.2;margin:36px 0 18px}.mardala-reading li{margin:12px 0}.mardala-credits{font-size:16px;overflow-wrap:anywhere;margin:30px 0}.mardala-credits li{margin:10px 0}@media(max-width:760px){.mardala-hero{grid-template-columns:1fr;gap:24px;margin-bottom:30px}.mardala-hero h1{font-size:46px}.mardala-reading{font-size:17px}.mardala-reading section{margin-bottom:28px}}</style>
