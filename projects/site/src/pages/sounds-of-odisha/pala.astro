---
import ArticleByline from '../../components/ArticleByline.astro';
import ArticleFootnote from '../../components/ArticleFootnote.astro';
import ArticleFootnotes from '../../components/ArticleFootnotes.astro';
import '../../styles/article-reading.css';
import Shell from '../../layouts/Shell.astro';
import SoundReadingPaths from '../../components/SoundReadingPaths.astro';
import ResearchContents from '../../components/ResearchContents.astro';
import SoundsReadingTrail from '../../components/SoundsReadingTrail.astro';
import story from '../../../../../kb/research/culture/pala-website.json';
const sections=story.blocks.map((block,index)=>({...block,id:block.title?`story-section-${index+1}`:undefined,passage:`pala-${index}`}));
const passages=sections.flatMap(b=>b.paragraphs.map((_,i)=>({id:b.passage+'-'+i,source_ids:b.paragraph_source_ids[i]})));
const contents=[...sections.filter(block=>block.title).map(block=>({title:block.title,href:'#'+block.id})),{title:'Footnotes & Sources',href:'#story-sources'}];
---
<Shell title={story.title} description={story.lead} active="explore" wide related={false}>
<article class="article-reading pala-story"><a class="text-link collection-return" href="/sounds-of-odisha/#pala">← Sounds of Odisha</a>
<header class="pala-hero"><p class="eyebrow">Sounds of Odisha · Pala</p><h1>Poetry with<br/><em>people around it.</em></h1><ArticleByline author={story.author} reviewedOn={story.reviewed_on}/><p class="lead">{story.lead}</p><figure><img src="/images/sounds/pala-nalconagar.webp" width="1600" height="1200" alt={story.photo.alt} fetchpriority="high"/><figcaption>{story.photo.caption}</figcaption></figure></header>
<div class="pala-reading"><ResearchContents items={contents} label="In this story"/>{sections.map(b=><section class="narrative-section">{b.title&&<h2 id={b.id}>{b.title}</h2>}{b.items.length>0&&<ul>{b.items.map(p=><li>{p}</li>)}</ul>}{b.paragraphs.map((p,i)=><p>{p}<ArticleFootnote ids={b.paragraph_source_ids[i]} sources={story.sources} passage={b.passage+'-'+i}/></p>)}</section>)}
<p><a href="/literature/">Explore Odia literature →</a> · <a href="/sounds-of-odisha/#daskathia">Meet Daskathia →</a></p>
<ArticleFootnotes sources={story.sources.map(s=>({id:s.id,title:s.title,url:s.resource,note:s.reader_note}))} passages={passages}><h3>Photograph</h3><p><a href={story.photo.url}>{story.photo.creator} · Nalconagar, 2013</a> · <a href={story.photo.license_url}>{story.photo.license}</a>. {story.photo.changes} The performer is not identified here.</p></ArticleFootnotes>
<SoundReadingPaths current="pala"/>
<p><a href="/contribute/?page=%2Fsounds-of-odisha%2Fpala%2F">Suggest an update</a>. GitHub submissions are public; omit private contact details and consent documents.</p><SoundsReadingTrail slug="pala"/></div>
</article></Shell>
<style>.collection-return{display:inline-block;margin:1rem 0 2rem}.pala-hero h1 em{color:var(--sea)}.pala-hero .lead{font-size:1.25rem;line-height:1.7}.pala-hero figure{margin:2rem 0}.pala-hero img{display:block;width:100%;height:auto}.pala-hero figcaption{font-size:.85rem;color:var(--muted);margin-top:.6rem;line-height:1.6}.narrative-section{margin-block:2.5rem}.narrative-section h2{scroll-margin-top:2rem}</style>
