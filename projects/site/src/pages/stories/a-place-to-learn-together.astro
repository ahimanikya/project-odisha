---
import Shell from '../../layouts/Shell.astro';
import ArticleByline from '../../components/ArticleByline.astro';
import OdiaConnectedReading from '../../components/OdiaConnectedReading.astro';
import '../../styles/article-reading.css';
import {Content, frontmatter} from '../../../../../kb/research/culture/a-place-to-learn-together.md';
---
<Shell title={frontmatter.title} description={frontmatter.description} shareImage={{src:"/images/stories/learn-neighbourhood-room-v2.png",alt:"Illustration of neighbours reading and discussing together in a community room while another person brings a chair.",width:1536,height:1024}} active="explore" wide related={false}>
<article class="article-reading"><header><h1>{frontmatter.title}</h1><ArticleByline author="Ahimanikya Satapathy"/></header>
<figure><img src="/images/stories/learn-neighbourhood-room-v2.png" width="1536" height="1024" alt="Illustration of neighbours reading and discussing together in a community room while another person brings a chair."/><figcaption>Illustration · An imagined neighbourhood room for reading, discussion and making space for one another.</figcaption></figure>
<Content/>
<OdiaConnectedReading current="a-place-to-learn-together"/>
<p><a href="/contribute/?page=%2Fstories%2Fa-place-to-learn-together%2F">Suggest an update</a>. GitHub submissions are public; omit private contact details and consent documents.</p>
</article></Shell>
<style>article :global(img){max-width:100%;height:auto}article :global(.footnotes h2){position:static;width:auto;height:auto;clip:auto;clip-path:none;overflow:visible;white-space:normal}article :global(.footnotes){margin-top:3rem}</style>
