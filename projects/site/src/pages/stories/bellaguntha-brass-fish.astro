---
import Shell from '../../layouts/Shell.astro';
import ArticleByline from '../../components/ArticleByline.astro';
import ArticleReadingPath from '../../components/ArticleReadingPath.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import {renderReviewedCultureArticle} from '../../lib/reviewed-culture-article.mjs';
import '../../styles/article-reading.css';
import source from '../../../../../kb/research/culture/bellaguntha-brass-fish.md?raw';
const metadata=source.match(/^---\n([\s\S]*?)\n---\n/)?.[1];
if(!metadata)throw Error('Brass-fish canonical metadata missing');
const readMetadata=(key: string)=>{
 const value=metadata.match(new RegExp(`^${key}: (".*")$`,'m'))?.[1];
 if(!value)throw Error(`Brass-fish canonical ${key} missing`);
 const parsed=JSON.parse(value);
 if(typeof parsed!=='string')throw Error(`Brass-fish canonical ${key} must be a string`);
 return parsed;
};
const frontmatter={title:readMetadata('title'),description:readMetadata('description'),author:readMetadata('author')};
const route='/stories/bellaguntha-brass-fish/';
const imageMatch=source.match(/!\[([^\]]+)\]\(([^)]+)\)/);
if(!imageMatch)throw Error('Brass-fish canonical image missing');
const image={src:'/images/stories/bellaguntha-brass-fish.jpg',alt:imageMatch[1],width:1000,height:667};
let body=source.replace(/^---\n[\s\S]*?\n---\n/,'');
if(!/^## Footnotes & Sources\s*$/m.test(body))body=body.replace(/^(\[\^\d+\]:)/m,'## Footnotes & Sources\n\n$1');
const article=renderReviewedCultureArticle(`# ${frontmatter.title}\n\nBy ${frontmatter.author}\n\n${body}`,{
 sourcePath:'kb/research/culture/bellaguntha-brass-fish.md',route,
 images:{[imageMatch[2]]:image.src},imageDimensions:{[image.src]:{width:image.width,height:image.height}}
});
// Supplementary attribution for the incoming horn-craft reading image.
const noteSections=[...article.html.matchAll(/<section data-footnotes\b[\s\S]*?<\/section>/g)];
if(noteSections.length!==1)throw Error('Brass-fish requires one source-note section');
const noteSection=noteSections[0][0];
if((noteSection.match(/<li id="user-content-fn-/g)||[]).length!==4 || (noteSection.match(/<\/ol>/g)||[]).length!==1 || article.html.includes('id="user-content-fn-5"'))throw Error('Brass-fish supplementary note insertion is ambiguous');
const hornPhotoNote="<li id=\"user-content-fn-5\"><p>Subhashish Panigrahi, <a href=\"https://commons.wikimedia.org/wiki/File:Decorative_ishes_made_of_animal_horn_at_Odisha_Crafts_Museum,_Bhubaneswar,_Odisha,_India.jpg\">horn fish at Odisha Crafts Museum, Bhubaneswar</a> (2018), Wikimedia Commons. <a href=\"https://creativecommons.org/licenses/by-sa/4.0/\">CC BY-SA 4.0</a>. Resized and compressed. <a href=\"#user-content-fnref-5\" data-footnote-backref=\"\" aria-label=\"Return to reading-link photograph reference\" class=\"data-footnote-backref\">↩</a></p></li>";
article.html=article.html.replace(noteSection,noteSection.replace('</ol>',hornPhotoNote+'\n</ol>'));
const figure=article.html.match(/<p><img\b[^>]+><\/p>\s*<p>([\s\S]*?)<\/p>/);
if(!figure)throw Error('Brass-fish canonical image and caption missing');
const [beforeFigure,afterFigure]=article.html.split(figure[0]);
const continueReading=[{href:'/stories/paralakhemundi-horn-craft/',title:'Paralakhemundi’s Horn Craft: From Comb to Crane',image:'/images/stories/paralakhemundi-horn-fish.webp',imageNote:'Museum example; manufacture place unidentified.'},{href:'/crafts/balakati-metalcraft/',title:'Balakati metalcraft: the work behind the ringing',image:'/assets/balakati-metalcraft/process-overview.svg'}];
const furtherReading=[{href:'/books/odisha-culture-memory-and-living-traditions/silver-metal-clay-stone-and-applique/',title:'Silver, Metal, Clay, Stone and Appliqué'}];
---
<Shell title={frontmatter.title} description={frontmatter.description} shareImage={image} active="explore" wide related={false}>
  <article class="article-reading">
    <header><h1>{frontmatter.title}</h1><ArticleByline author={frontmatter.author}/></header>
    <div set:html={beforeFigure}/>
    <figure>
      <ResponsiveImage {...image} sizes="(max-width: 740px) calc(100vw - 2.4rem), 696px" loading="eager" fetchpriority="high"/>
      <figcaption set:html={figure[1]}/>
    </figure>
    <div set:html={afterFigure}/>
    <ArticleReadingPath heading="Continue reading" links={continueReading}/>
    <p>Horn-fish photograph.<sup><a href="#user-content-fn-5" id="user-content-fnref-5" data-footnote-ref aria-describedby="footnote-label">5</a></sup></p>
    <ArticleReadingPath heading="Further reading" links={furtherReading}/>
    <p><a href={`/contribute/?page=${encodeURIComponent(route)}`}>Suggest an update</a>. GitHub submissions are public; omit private contact details and consent documents.</p>
  </article>
</Shell>
<style>
  article h1{font-size:clamp(2.2rem,1.2rem + 4vw,3.6rem)}
  article :global(.article-footnotes h2){position:static;width:auto;height:auto;clip:auto;clip-path:none;overflow:visible;white-space:normal}
</style>
