---
import Shell from '../../layouts/Shell.astro';
import ArticleByline from '../../components/ArticleByline.astro';
import ArticleReadingPath from '../../components/ArticleReadingPath.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import '../../styles/article-reading.css';
import { compiledContent } from '../../../../../kb/research/stories/bhubaneswar-week.md';

const title = 'A Week in Bhubaneswar: Conversations and New Beginnings';
const description = 'Ahimanikya Satapathy reflects on a week of conversations in Bhubaneswar, returning to poetry, building a poets’ portal and registering the Pravakar Satapathy Foundation.';
const shareImage = {
  src: '/assets/bhubaneswar-week/mentis-films.jpg',
  width: 5712,
  height: 3213,
  alt: 'Three people standing beneath the Mentis Films sign and framed film posters, including Daman.'
};
// Only the trusted, locally compiled article is rendered below. Keep photographs
// with their narrative sections without duplicating or rewriting the Markdown.
const photographSections = new Map([
  ['Returning to people I have known since childhood', 'conversations'],
  ['Stories on screen and in conversation', 'mentis']
]);
const articleHtml = await compiledContent();
if (typeof articleHtml !== 'string') throw new Error('Bhubaneswar Markdown must compile to HTML text.');
const sections = articleHtml.split(/(?=<h2(?:\s|>))/).map(html => {
  const heading = html.match(/^<h2\b[^>]*>([\s\S]*?)<\/h2>/)?.[1];
  return { html, photograph: photographSections.get(heading) };
});
for (const [heading, photograph] of photographSections) {
  if (sections.filter(section => section.photograph === photograph).length !== 1) {
    throw new Error(`Bhubaneswar photograph placement needs exactly one section: ${heading}`);
  }
}
const readingLinks = [{
  href: '/literature/',
  title: 'Odia Literature',
  description: 'Explore literary voices, their works and the different ways a story can be told.',
  image: '/assets/language-literature/odia-manuscript.webp'
}];
---

<Shell title={title} description={description} shareImage={shareImage} active="explore" wide related={false}>
  <article class="article-reading bhubaneswar-week">
    <header>
      <p class="eyebrow">Personal essay · Bhubaneswar</p>
      <h1>{title}</h1>
      <ArticleByline author="Ahimanikya Satapathy" />
      <p class="publication-date"><time datetime="2026-10-24">24 October 2026</time></p>
    </header>

    {sections.map(({ html, photograph }) => <>
      <Fragment set:html={html} />
      {photograph === 'conversations' && <figure class="conversation-photograph">
        <ResponsiveImage
          src="/assets/bhubaneswar-week/conversations.jpg"
          alt="Three people standing together indoors, with an arm around one another’s shoulders."
          width="3213"
          height="5712"
          sizes="(max-width: 480px) calc(100vw - 2.4rem), 420px"
          loading="lazy"
        />
        <figcaption>A moment from a week of conversations. Photograph supplied by Ahimanikya Satapathy.</figcaption>
      </figure>}
      {photograph === 'mentis' && <figure>
        <ResponsiveImage
          src={shareImage.src}
          alt={shareImage.alt}
          width={shareImage.width}
          height={shareImage.height}
          sizes="(max-width: 600px) calc(100vw - 2.4rem), (max-width: 740px) calc(100vw - 2.8rem), 695.2px"
          loading="lazy"
        />
        <figcaption>At Mentis Films during the week in Bhubaneswar. Photograph supplied by Ahimanikya Satapathy.</figcaption>
      </figure>}
    </>)}

    <ArticleReadingPath heading="Further reading" links={readingLinks} />
    <p class="reader-update"><a href="/contribute/?page=%2Fstories%2Fbhubaneswar-week%2F">Suggest an update</a>. GitHub submissions are public; omit private contact details and consent documents.</p>
  </article>
</Shell>

<style>
  .bhubaneswar-week .publication-date {
    margin: -1.2rem 0 2rem;
    color: var(--muted);
    font: normal .9rem/1.65 system-ui, sans-serif;
  }
  .bhubaneswar-week .conversation-photograph {
    max-width: 420px;
    margin: 2.5rem auto 3rem;
  }
  .bhubaneswar-week .reader-update {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: .95rem;
    line-height: 1.75;
  }
</style>
