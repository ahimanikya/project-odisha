---
import ArticleByline from '../../components/ArticleByline.astro';
import ArticleFootnote from '../../components/ArticleFootnote.astro';
import ArticleFootnotes from '../../components/ArticleFootnotes.astro';
import '../../styles/article-reading.css';
import Shell from '../../layouts/Shell.astro';
import SoundReadingPaths from '../../components/SoundReadingPaths.astro';
import ResearchContents from '../../components/ResearchContents.astro';
import story from '../../../../../kb/research/culture/boat-songs-website.json';
const sections=story.blocks.map((block,index)=>({...block,id:block.title?`story-section-${index+1}`:undefined,passage:`boat-songs-${index}`}));
const passages=sections.flatMap(b=>b.paragraphs.map((_,i)=>({id:b.passage+'-'+i,source_ids:b.paragraph_source_ids[i]})));
const contents=[...sections.filter(block=>block.title).map(block=>({title:block.title,href:'#'+block.id})),{title:'Footnotes & Sources',href:'#story-sources'}];
---
<Shell title={story.title} description={story.lead} active="explore" wide related={false}>
<article class="article-reading boat-songs-story"><a class="text-link collection-return" href="/sounds-of-odisha/">← Sounds of Odisha</a>
<header class="boat-songs-hero"><p class="eyebrow">Sounds of Odisha</p><h1>Boat songs<br/><em>of Odisha.</em></h1><ArticleByline author={story.author} reviewedOn={story.reviewed_on}/><p class="lead">{story.lead}</p></header>
<ResearchContents items={contents} label="In this story"/>
{sections.map(b=><section class="narrative-section">{b.title&&<h2 id={b.id}>{b.title}</h2>}{b.paragraphs.map((p,i)=><p>{p}<ArticleFootnote ids={b.paragraph_source_ids[i]} sources={story.sources} passage={b.passage+'-'+i}/></p>)}</section>)}
<aside class="listening-panel" aria-labelledby="listening-guide-title"><h2 id="listening-guide-title">{story.listening_panel.heading}</h2><ol>{story.listening_panel.steps.map(step=><li><h3>{step.label}</h3><p>{step.prompt}</p></li>)}</ol><p class="panel-note">{story.listening_panel.note}</p></aside>
<p><a href="/stories/chilika-listening/">Continue with Listening to Chilika →</a> · <a href="/sounds-of-odisha/listening-notebook/">Take a listening notebook →</a></p>
<ArticleFootnotes sources={story.sources.map(s=>({id:s.id,title:s.title,url:s.resource,note:s.reader_note}))} passages={passages}/>
<SoundReadingPaths current="boat-songs"/>
<p><a href="/contribute/?page=%2Fstories%2Fboat-songs%2F">Suggest a correction or a public source</a>. GitHub submissions are public; omit private contact details and consent documents.</p><a class="text-link" href="/sounds-of-odisha/">Return to Sounds of Odisha →</a>
</article></Shell>
<style>.collection-return{display:inline-block;margin:1rem 0 2rem}.boat-songs-hero em{color:var(--sea)}.boat-songs-hero .lead{font-size:1.25rem;line-height:1.7}.narrative-section{margin-block:2.5rem}.narrative-section h2{scroll-margin-top:2rem}.listening-panel{border-left:3px solid var(--earth);padding:.2rem 0 .2rem 1.2rem;margin:2.5rem 0}.listening-panel h2{margin-top:0}.listening-panel h3{font-size:1.1rem;margin:0 0 .4rem}.listening-panel p{font-size:1rem;margin-bottom:0}.listening-panel .panel-note{font-size:.9rem;color:var(--muted)}</style>
