---
import Shell from '../../layouts/Shell.astro';
import ArticleByline from '../../components/ArticleByline.astro';
import ArticleReadingPath from '../../components/ArticleReadingPath.astro';
import '../../styles/article-reading.css';
import {Content, frontmatter} from '../../../../../kb/research/culture/chandan-yatra.md';

const related = [
  {href: '/stories/the-year-that-feeds-us/', title: 'The Year That Feeds Us', description: 'Explore the stories of cultivation and household worship in this series.'},
  {href: '/stories/snana-purnima/', title: 'Snana Purnima', description: 'Follow the deities from the public bath into Anasara.'},
  {href: '/stories/baisakha-brata/', title: 'Baisakha Brata', description: 'Read about the daily gift of water in the summer month.'},
  {href: '/stories/akhi-muthi-anukula/', title: 'Akhi Muthi Anukula', description: 'Follow the first handful of paddy seed on Akshaya Tritiya.'},
];
---
<Shell title={frontmatter.title} description={frontmatter.description} active="explore" wide related={false}>
  <article class="article-reading">
    <header>
      <a href="/stories/the-year-that-feeds-us/">The Year That Feeds Us</a>
      <h1>{frontmatter.title}</h1>
      <ArticleByline author="Ahimanikya Satapathy"/>
    </header>
    <Content/>
    <ArticleReadingPath heading="Continue reading" links={related}/>
    <p><a href="/contribute/?page=%2Fstories%2Fchandan-yatra%2F">Suggest an update</a>. GitHub submissions are public. Please omit private contact details and consent documents.</p>
  </article>
</Shell>
