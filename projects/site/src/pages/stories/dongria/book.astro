---
import DongriaLocator from '../../../components/DongriaLocator.astro';
import Shell from '../../../layouts/Shell.astro';
import DongriaReadingSequence from '../../../components/DongriaReadingSequence.astro';
import guide from '../../../data/dongria-reading-guide.json';
import articles from '../../../data/dongariya.json';
import book from '../../../data/dongariya-book.json';
import reading from '../../../data/dongria-book-reading.json';
import '../../../styles/article-reading.css';
const cover=reading.cover.at(-1)!;
const route=(slug:string)=>`/stories/dongria/${articles.find(a=>a.slug===slug)?.routeSlug || slug}/`;
const escaped=(s:string)=>s.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;');
const credit=(s:string)=>escaped(s).replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g,'<a href="$2">$1</a>');
const mapLabels=['Rayagada Forest Division working plan, §1.2.2','Niyamgiri field study, surveyed sites','Rayagada Municipality, location','Rayagada District Profile, §2.1'];
---
<Shell title="Dongria Kondh: Life in Niyamgiri — the book" description="Begin with a shawl, then follow the people, food, cloth, learning and songs of Niyamgiri. Read the connected book online or download the illustrated edition." active="explore" related={false} shareImage={{src:cover.src,alt:reading.cover_alt,width:cover.width,height:cover.height}}>
<article class="article-reading dongria-book">
<p><a href="/stories/dongria/">← Dongria Kondh: life in Niyamgiri</a></p>
<header><p class="eyebrow">The book · Read online or take it with you</p><h1>Dongria Kondh:<br/>Life in Niyamgiri</h1><p>By Ahimanikya Satapathy</p>
<div class="book-opening"><figure><img src={cover.src} srcset={reading.cover.map(v=>`${v.src} ${v.width}w`).join(', ')} sizes="(max-width: 640px) 70vw, 300px" width={cover.width} height={cover.height} alt={reading.cover_alt} fetchpriority="high"/><figcaption>The cover of the illustrated reading edition.</figcaption></figure><div><p>A shawl bought at a dinner party with friends opened questions about the people behind the cloth. The reading led to Site Jakesika’s embroidery, Mukteswar Wadaka’s teaching, seeds kept in circulation and songs remembered across generations.</p><p><a href="#author-note">Begin with the author’s note →</a></p><p><a href={book.file}>Download the illustrated reading edition · PDF</a><br/>{book.pages} pages · {(book.bytes/1000000).toFixed(1)} MB</p></div></div></header>
<nav id="contents" class="book-contents" aria-label="Book contents"><h2>Read the book online</h2><ol><li><a href="#author-note">A shawl, and the questions it opened</a></li><li><a href="#before-we-begin">Before we begin</a></li><li><a href="#locator">Locating Niyamgiri</a></li><li><a href="#chapters">Twelve connected chapters</a></li><li><a href="#looking-again">Looking again</a></li><li><a href="#glossary">Words in this book</a></li><li><a href="#sources">Footnotes &amp; Sources</a></li></ol></nav>
<section id="author-note"><p class="eyebrow">Author’s note</p><h2>{reading.author_note.title}</h2>{reading.author_note.paragraphs.map((p,i)=><Fragment><p>{p}</p>{i===1&&<figure class="author-story-photo"><img src={reading.author_story_photo.variants.at(-1)!.src} srcset={reading.author_story_photo.variants.map(v=>`${v.src} ${v.width}w`).join(", ")} sizes="(max-width: 464px) calc(100vw - 44px), 420px" width={reading.author_story_photo.variants.at(-1)!.width} height={reading.author_story_photo.variants.at(-1)!.height} alt={reading.author_story_photo.caption} loading="lazy"/><figcaption>{reading.author_story_photo.caption}</figcaption></figure>}</Fragment>)}<p><a href="#before-we-begin">Continue: Before we begin →</a></p></section>
<section id="before-we-begin"><h2>{reading.preface.title}</h2><blockquote><p>{reading.preface.paragraphs[0]}</p><footer>{reading.preface.paragraphs[1]}</footer></blockquote>{reading.preface.paragraphs.slice(2).map(p=><p>{p}</p>)}<nav class="book-step" aria-label="After the preface"><a href="#locator">Continue: Locating Niyamgiri →</a><a href="#contents">Book contents</a></nav></section>
<section id="locator"><h2>{reading.map.title}</h2><DongriaLocator map={reading.map}/><p>Niyamgiri is shown as an approximate regional position north of Rayagada town. The locator does not mark a summit, a village or a route.</p><nav class="book-step" aria-label="After the locator"><a href="/stories/dongria/dongria-life/">Begin chapter 01: Dongria life →</a><a href="#chapters">Browse the twelve chapters</a></nav></section>
<section id="chapters"><h2>Twelve connected chapters</h2><p>{guide.section_intro}</p><DongriaReadingSequence headingLevel={3} showBookends={false}/></section>
<section id="looking-again"><h2>{reading.closing.title}</h2>{reading.closing.paragraphs.map(p=><p>{p}</p>)}<nav class="book-step" aria-label="After the closing essay"><a href="#glossary">Continue: Words in this book →</a><a href="#contents">Book contents</a></nav></section>
<section id="glossary"><h2>Words in this book</h2><p>These short definitions explain how the terms are used in this book. Personal and place-name spellings follow the cited accounts and may vary.</p><dl>{reading.glossary.map(entry=><div><dt>{entry.term}</dt><dd>{entry.definition} <a href={route(entry.chapter_slug)}>Read the chapter</a>.</dd></div>)}</dl><nav class="book-step" aria-label="After the glossary"><a href="#sources">Footnotes &amp; Sources →</a><a href="#contents">Book contents</a></nav></section>
<section id="author"><h2>About the author</h2><figure class="author"><img src={reading.author_portrait.at(-1)!.src} width={reading.author_portrait.at(-1)!.width} height={reading.author_portrait.at(-1)!.height} alt="Ahimanikya Satapathy" loading="lazy"/><figcaption>Ahimanikya Satapathy</figcaption></figure><p>{reading.author_bio}</p></section>
<section id="sources"><h2>Footnotes &amp; Sources</h2><h3>The chapters</h3><p>The twelve chapters retain their fuller online source notes. The PDF brings the same sources together in a compact list.</p><ul>{articles.map(a=><li><a href={route(a.slug)+'#footnote-label'}>{a.title}: source notes</a></li>)}</ul><h3>Author’s note photograph</h3><p>{reading.author_story_photo.credit}</p><h3>Before we begin</h3><p><a href="https://grain.org/en/article/743-endangered-tribals-up-against-the-terror-of-vedanta">Living Farms, GRAIN, 26 July 2009</a>; translator unnamed.</p><h3>Locator</h3><ul>{reading.map.sources.map((s,i)=><li><a href={s.url}>{mapLabels[i]}</a>.</li>)}</ul><p>Odisha outline: <a href={reading.map.outline_source.url}>{reading.map.outline_source.title}</a>, <a href={reading.map.outline_source.licence_url}>{reading.map.outline_source.licence}</a>.</p><h3>Glossary</h3><ul>{reading.glossary.map(e=><li>{e.term}: <a href={e.source_url}>{e.source_title || 'source'}</a>.</li>)}</ul><h3>Pictures in the book</h3><p>Front cover photograph: {reading.cover_credit.creator}. <a href={reading.cover_credit.source_url}>Source</a>. <a href={reading.cover_credit.licence_url}>{reading.cover_credit.licence}</a>. The preview reproduces the published cover.</p>{reading.chapter_credits.map(c=><p><strong>{c.title}.</strong> <Fragment set:html={credit(c.text)}/></p>)}{reading.additional_photographs.map(p=><p>{p.caption} Photograph: {p.creator}. <a href={p.source_url}>Source</a>. <a href={p.licence_url}>{p.licence}</a>. Resized; composition unchanged.</p>)}<p>Interpretive stitch-band drawing: Project Odisha. Technique reference: Kanak Rajadhyaksha, <a href="https://www.sahapedia.org/kapdagondas-motifs-and-technique">Kapdagondas: Motifs and Technique</a>, Sahapedia. Hairpin drawing: interpretive adaptation by Project Odisha from a <a href="https://commons.wikimedia.org/wiki/File:Dangaria_accessory_detail_01.jpg">photograph by Pillai Sree Vidya</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>; adaptation under the same licence. Drawings simplify details. Author portrait: supplied by Ahimanikya Satapathy.</p></section>
<p><a href={book.file}>Download the illustrated reading edition · {book.pages} pages · PDF</a></p>
<section aria-labelledby="companion-book"><h2 id="companion-book">A companion book</h2><p><a href="/stories/kotpad/book/">Mirgan Households and Kotpad Textiles →</a> Follow the people, colour and livelihood relationships behind Kotpad cloth in a separate nine-chapter book by Ahimanikya Satapathy.</p></section>
</article></Shell>
<style>
.book-step{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.5rem 1.5rem;margin-top:2rem}.book-step a{display:inline-block;min-height:44px;padding-block:.5rem}.book-step a:focus-visible{outline:3px solid var(--earth);outline-offset:4px}.dongria-book{max-width:804px;padding-inline:32px;overflow-wrap:anywhere}.dongria-book section{margin-block:3rem}.dongria-book img{display:block;max-width:100%;height:auto}.book-opening{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:2rem;align-items:center}.book-opening figure{margin:0}.book-opening img{width:100%;aspect-ratio:4/5}.book-opening figcaption{font-size:.9rem;margin-top:.75rem}.book-contents{border-block:1px solid var(--line);padding-block:1rem;margin-block:3rem}.book-contents ol,.chapter-list{padding-left:1.5rem}.book-contents li,.chapter-list li{margin-block:.6rem}.dongria-book dl>div{margin-block:1.5rem}.dongria-book dt{font-weight:700}.dongria-book dd{margin:.3rem 0}.dongria-book svg{display:block;width:100%;height:auto;aspect-ratio:34/37;max-width:440px;margin-inline:auto;color:var(--sea)}.dongria-book svg text{fill:currentColor;font-size:20px}.dongria-book svg .map-state{font-size:24px}.dongria-book svg .map-region{fill:var(--earth);font-size:25px}.dongria-book svg .map-detail{font-size:19px}.author{max-width:220px}.author-story-photo{max-width:420px;margin-inline:auto!important}.author-story-photo img{aspect-ratio:1365/2048}.dongria-book [id]{scroll-margin-top:2rem}#sources{font-size:.95rem}blockquote footer{font-size:1rem}a{overflow-wrap:anywhere}@media(max-width:640px){.dongria-book{padding-inline:22px}.book-opening{grid-template-columns:1fr}.book-opening figure{max-width:280px;margin-inline:auto}}
</style>
