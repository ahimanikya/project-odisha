---
import Shell from '../../layouts/Shell.astro';
import ArticleByline from '../../components/ArticleByline.astro';
import ArticleReadingPath from '../../components/ArticleReadingPath.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import '../../styles/article-reading.css';
import { compiledContent } from '../../../../../kb/research/stories/ekamra-evening.md';

const title = 'An Evening in Ekamra: Walking Through Stone, Listening to Song';
const description = 'Ahimanikya Satapathy joins Prateek at Parsurameswara Temple, then listens and learns with Omm Prakash and team beside Bindu Sagar during Ekamra Walks.';
const dimensions = {
  'odissi-baithaki.jpg': [1600, 900],
  'parsurameswara-temple.jpg': [1012, 1800],
  'ganesha-doorway.jpg': [1600, 900],
  'mother-goddesses.jpg': [1600, 900],
  'sahasra-linga.jpg': [1012, 1800],
  'bindu-sagar-lingaraja.jpg': [1600, 900],
  'omm-prakash-and-team.jpg': [1600, 900]
};
const shareImage = {src: '/assets/ekamra-evening/odissi-baithaki.jpg', width: 1600, height: 900, alt: 'Omm Prakash and team performing beside Bindu Sagar at night.'};
let articleHtml = await compiledContent();
if (typeof articleHtml !== 'string') throw new Error('Ekamra Markdown must compile to HTML text.');
// Render this trusted, locally compiled manuscript with the existing responsive-image component.
// Exact matching fails the build if an image or caption would otherwise be silently omitted.
articleHtml = articleHtml.replace(/<h2\b[^>]*id="footnote-label"[^>]*>[\s\S]*?<\/h2>/, '<h2 id="footnote-label">Footnotes &amp; Sources</h2>')
  .replace(/<section([^>]*data-footnotes[^>]*)>/, (_, attributes) => {
    const styled = /class="[^"]*"/.test(attributes)
      ? attributes.replace(/class="([^"]*)"/, 'class="$1 article-footnotes"')
      : attributes + ' class="article-footnotes"';
    return '<section' + styled + '>';
  });
const pattern = /<p><img\b[^>]*src="(https:\/\/projectodisha\.org\/assets\/ekamra-evening\/[^\"]+)"[^>]*><\/p>\s*<p><em>([\s\S]*?)<\/em><\/p>/g;
const parts = [];
let offset = 0;
for (const match of articleHtml.matchAll(pattern)) {
  const src = match[1].replace('https://projectodisha.org', '');
  const filename = src.split('/').pop();
  const size = dimensions[filename];
  const alt = match[0].match(/alt="([^"]*)"/)?.[1];
  if (!size || !alt) throw new Error('Unmapped Ekamra photograph: ' + src);
  parts.push({html: articleHtml.slice(offset, match.index), photo: {src, alt, width: size[0], height: size[1], caption: match[2]}});
  offset = match.index + match[0].length;
}
parts.push({html: articleHtml.slice(offset), photo: null});
if (parts.filter(part => part.photo).length !== 7) throw new Error('Ekamra article must render all seven supplied photographs.');
const readingLinks = [{href: '/stories/bhubaneswar-week/', title: 'A Week in Bhubaneswar: Conversations and New Beginnings', description: 'My earlier personal essay about poetry, conversations and a growing involvement in Odisha’s cultural life.', image: '/assets/bhubaneswar-week/poem-conversations-v1.png'}];
---
<Shell title={title} description={description} shareImage={shareImage} active="explore" wide related={false}>
  <article class="article-reading ekamra-evening">
    <header>
      <p class="eyebrow">Personal essay · Bhubaneswar</p>
      <h1>{title}</h1>
      <ArticleByline author="Ahimanikya Satapathy" />
      <p class="publication-date"><time datetime="2026-11-14">14 November 2026</time></p>
    </header>
    {parts.map(({html, photo}, index) => <>
      <Fragment set:html={html} />
      {photo && <figure class:list={{portrait: photo.height > photo.width}}>
        <ResponsiveImage src={photo.src} alt={photo.alt} width={photo.width} height={photo.height}
          sizes={photo.height > photo.width ? '(max-width: 480px) calc(100vw - 2.4rem), 420px' : '(max-width: 600px) calc(100vw - 2.4rem), (max-width: 740px) calc(100vw - 2.8rem), 695.2px'}
          loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : undefined}/>
        <figcaption><Fragment set:html={photo.caption}/></figcaption>
      </figure>}
    </>)}
    <ArticleReadingPath heading="Continue reading" links={readingLinks} />
    <p class="reader-update"><a href="/contribute/?page=%2Fstories%2Fekamra-evening%2F">Suggest an update</a>. GitHub submissions are public; omit private contact details and consent documents.</p>
  </article>
</Shell>
<style>
.ekamra-evening .publication-date{margin:-1.2rem 0 2rem;color:var(--muted);font:normal .9rem/1.65 system-ui,sans-serif}
.ekamra-evening figure.portrait{max-width:420px;margin:2.5rem auto 3rem}
.ekamra-evening .reader-update{margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid var(--line);font-size:.95rem;line-height:1.75}
</style>
