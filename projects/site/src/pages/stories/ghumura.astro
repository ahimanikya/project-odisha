---
import Shell from '../../layouts/Shell.astro';
import ResearchContents from '../../components/ResearchContents.astro';
import story from '../../../../../kb/research/culture/ghumura-website.json';
const sections=story.blocks.map((block,index)=>({...block,id:block.title?`story-section-${index+1}`:undefined}));
const contents=[...sections.filter(block=>block.title).map(block=>({title:block.title,href:'#'+block.id})),{title:'Sources & reading notes',href:'#story-sources'}];
---
<Shell title={story.title} description={story.lead} active="explore" wide related={false}>
<article class="wrap ghumura-story"><a class="text-link collection-return" href="/sounds-of-odisha/">← Sounds of Odisha</a>
<header class="ghumura-hero"><div><p class="eyebrow">Sounds of Odisha · Further reading</p><h1>Ghumura.<br/><em>The drum in motion.</em></h1><p class="lead">{story.lead}</p></div><aside class="listening-panel" aria-label="Listening guide"><p class="eyebrow">{story.listening_panel.heading}</p>{story.listening_panel.steps.map((step,i)=><div class="listening-step"><span aria-hidden="true">{String(i+1).padStart(2,'0')}</span><div><h2>{step.label}</h2><p>{step.prompt}</p></div></div>)}<p class="panel-note">{story.listening_panel.note}</p></aside></header>
<div class="ghumura-reading"><ResearchContents items={contents} label="In this story"/>{sections.map(b=><section>{b.title&&<h2 id={b.id}>{b.title}</h2>}{b.items.length>0&&<p>{b.paragraphs[0]}</p>}{b.items.length>0&&<ol>{b.items.map(p=><li>{p}</li>)}</ol>}{(b.items.length>0?b.paragraphs.slice(1):b.paragraphs).map(p=><p>{p}</p>)}</section>)}
<p class="notice">Begin with the performer and their explanation. This is a reading story; no audio recording is included.</p>
<p><a href="/sounds-of-odisha/dalkhai/">Continue with Dalkhai →</a> · <a href="/sounds-of-odisha/listening-notebook/">Take a listening notebook →</a></p>
<details id="story-sources" class="utk-disclosure ghumura-credits"><summary>Sources &amp; reading notes</summary><p>{story.limits} Desk review: {story.reviewed_on}.</p><ul>{story.sources.map(s=><li><a href={s.resource}>{s.title}</a> — {s.locator}</li>)}</ul><p>The suggested listening questions are editorial guidance. No visit, interview or recording by Project Odisha is presented.</p></details>
<p><a href="/contribute/?page=%2Fstories%2Fghumura%2F">Suggest a correction or a public source</a>. GitHub submissions are public; omit private contact details and consent documents.</p><a class="text-link" href="/sounds-of-odisha/">Return to Sounds of Odisha →</a></div>
</article></Shell>
<style>.section-sources{font-size:15px}.listening-panel{background:var(--paper,#f4ede1);border:1px solid var(--line,#d8cfc2);padding:clamp(24px,3vw,40px)}.listening-step{display:grid;grid-template-columns:34px 1fr;gap:16px;padding:22px 0;border-bottom:1px solid var(--line,#d8cfc2)}.listening-step>span{color:var(--clay,#844b35);font-size:14px}.listening-step h2{font-size:28px;margin:0 0 8px}.listening-step p{font-size:17px;line-height:1.6;margin:0}.panel-note{font-size:13px;color:var(--muted);margin:20px 0 0}.ghumura-story{padding-bottom:70px}.collection-return{display:inline-block;margin:28px 0}.ghumura-hero{display:grid;grid-template-columns:1fr 1.1fr;gap:clamp(28px,5vw,100px);align-items:center;margin:12px 0 52px}.ghumura-hero h1{font-size:clamp(48px,5vw,84px);line-height:1.08}.ghumura-hero h1 em{color:var(--sea)}.ghumura-hero figure{margin:0}.ghumura-hero img{width:100%;height:auto}.ghumura-hero figcaption{font-size:13px;color:var(--muted);margin-top:10px}.ghumura-reading{max-width:900px;margin:auto;font-size:19px;line-height:1.85}.ghumura-reading section{margin-bottom:40px}.ghumura-reading h2{font-size:clamp(30px,3vw,44px);line-height:1.2;margin:36px 0 18px}.ghumura-reading li{margin:12px 0}.ghumura-credits{font-size:16px;overflow-wrap:anywhere;margin:30px 0}.ghumura-credits li{margin:10px 0}@media(max-width:760px){.ghumura-hero{grid-template-columns:1fr;gap:24px;margin-bottom:30px}.ghumura-hero h1{font-size:46px}.ghumura-reading{font-size:17px}.ghumura-reading section{margin-bottom:28px}}</style>
