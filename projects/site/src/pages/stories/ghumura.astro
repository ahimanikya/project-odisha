---
import SoundReadingPaths from '../../components/SoundReadingPaths.astro';
import Shell from '../../layouts/Shell.astro';
import ArticleByline from '../../components/ArticleByline.astro';
import ArticleFootnote from '../../components/ArticleFootnote.astro';
import ArticleReadingPath from '../../components/ArticleReadingPath.astro';
import ResearchContents from '../../components/ResearchContents.astro';
import SaveJourney from '../../components/SaveJourney.astro';
import '../../styles/article-reading.css';
import story from '../../../../../kb/research/culture/ghumura-website.json';
const blocks=story.blocks.map((block,index)=>({...block,id:`story-section-${index+1}`}));
const passages=blocks.flatMap(block=>block.paragraphs.map((text,index)=>({id:`${block.id}-${index}`,text,source_ids:block.paragraph_source_ids[index]})));
const contents=[...blocks.filter(block=>block.title).map(block=>({title:block.title!,href:'#'+block.id})),{title:'Reading paths',href:'#reading-paths'},{title:'Further reading',href:'#ghumura-further-reading'},{title:'Footnotes & Sources',href:'#story-sources'}];
---
<Shell title={story.title} description={story.lead} active="explore" wide related={false}>
<article class="article-reading ghumura-story">
 <a class="collection-return" href="/sounds-of-odisha/">← Sounds of Odisha</a>
 <header class="ghumura-hero">
  <p class="eyebrow">Odisha · Music and movement</p>
  <h1>{story.title}</h1>
  <ArticleByline author={story.author}/>
  <p class="lead">{story.lead}</p>
  <SaveJourney id="reading:stories/ghumura" quiet/>
 </header>
 <ResearchContents items={contents} label="In this article"/>
 {blocks.map(block=><div class="ghumura-section" id={block.id}>
  {block.title&&<h2>{block.title}</h2>}
  {block.paragraphs.map((text,index)=><p data-source-ids={block.paragraph_source_ids[index].join(' ')}>{text}<ArticleFootnote ids={block.paragraph_source_ids[index]} sources={story.sources} passage={`${block.id}-${index}`}/></p>)}
 </div>)}
 <SoundReadingPaths current="ghumura" expanded={true}/>
 <ArticleReadingPath id="ghumura-further-reading" heading="Further reading" links={story.further_reading}/>
 <section id="story-sources" class="article-footnotes" aria-labelledby="footnote-title">
  <h2 id="footnote-title">Footnotes &amp; Sources</h2>
  <ol>{story.sources.map((source,index)=><li id={'note-'+source.id} tabindex="-1">
   {source.footnote_segments.map(segment=>segment.href?<a href={segment.href}>{segment.text}</a>:segment.text)}
   {' '}<span class="footnote-returns">{passages.filter(p=>p.source_ids.includes(source.id)).map((p,i)=><a href={`#ref-${p.id}-${source.id}`} data-footnote-backref aria-label={`Return to passage ${i+1} for footnote ${index+1}`}>↩{i>0?i+1:''}</a>)}</span>
  </li>)}</ol>
 </section>
 <p class="ghumura-update"><a href="/contribute/?page=%2Fstories%2Fghumura%2F">Suggest an update</a>. GitHub submissions are public; omit private contact details and consent documents.</p>
</article>
</Shell>
<script>
import {bindStorySourceLinks} from '../../lib/story-source-links.mjs';
document.querySelectorAll('.ghumura-story sup, .ghumura-story .article-footnotes').forEach(group=>bindStorySourceLinks(group,document));
</script>
<style>
.collection-return{display:inline-block;margin:0 0 2rem;font-size:.95rem}
.ghumura-hero{border-bottom:1px solid var(--line);padding-bottom:1.25rem}
.ghumura-hero .eyebrow{font-size:.75rem;margin-bottom:1rem}
.ghumura-hero .lead{font-size:1.25rem;line-height:1.75;margin-top:1.4rem}
.ghumura-section{margin-block:3rem}
.ghumura-update{font-size:.9rem;line-height:1.75;margin-top:2.5rem}
@media(max-width:600px){.ghumura-hero .lead{font-size:1.12rem}.ghumura-section{margin-block:2.5rem}}
</style>
