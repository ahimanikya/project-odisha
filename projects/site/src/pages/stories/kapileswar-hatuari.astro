---
import Shell from '../../layouts/Shell.astro';
import ArticleByline from '../../components/ArticleByline.astro';
import ArticleReadingPath from '../../components/ArticleReadingPath.astro';
import '../../styles/article-reading.css';
import {Content, frontmatter} from '../../../../../kb/research/places/kapileswar-hatuari-article.md';
import image from '../../../../../kb/research/places/kapileswar-hatuari-image.json';
import kapilashImage from '../../../../../kb/research/destinations/kapilash-image.json';
---
<Shell title={frontmatter.title} description={frontmatter.description} shareImage={image} active="explore" wide related={false}>
  <article class="article-reading">
    <header>
      <p class="eyebrow"><a href="/history/">History and heritage</a> · Dhenkanal</p>
      <h1>{frontmatter.title}</h1>
      <ArticleByline author={frontmatter.author}/>
    </header>
    <figure class="shrine-photo">
      <img src={image.src} srcset={`${image.small_src} 480w, ${image.src} 864w`} sizes="(max-width: 488px) calc(100vw - 2.4rem), 440px" alt={image.alt} width={image.width} height={image.height} loading="eager" fetchpriority="high" decoding="async"/>
      <figcaption>{image.caption} Photograph by <a href={image.source}>{image.creator}</a>, <a href={image.license_url}>{image.license}</a>. {image.changes}</figcaption>
    </figure>
    <Content/>
    <ArticleReadingPath heading="Continue reading" links={[{href:'/destinations/kapilash/',title:'Kapilash: A Hill Shrine and an Older Temple’s Trace',description:'Read the separate evidence for Chandrasekhar’s hill shrine and its inscribed architectural remnant.',image:kapilashImage.src}]}/>
    <ArticleReadingPath heading="Further reading" links={[{href:'/history/',title:'History and heritage',description:'Explore connected accounts of places, records and the people who study them.'}]}/>
    <p><a href="/contribute/?page=%2Fstories%2Fkapileswar-hatuari%2F">Suggest an update</a>. GitHub submissions are public; omit private contact details and consent documents.</p>
  </article>
</Shell>
<style>
  .article-reading .shrine-photo{width:min(100%,440px);margin-inline:auto}
  article h1{font-size:clamp(2.2rem,1.2rem + 4vw,3.6rem)}
  article :global(.footnotes h2){position:static;width:auto;height:auto;clip:auto;clip-path:none;overflow:visible;white-space:normal}
  article :global(.footnotes){margin-top:3rem;padding-top:1.5rem;border-top:1px solid var(--line);font-size:.95rem;line-height:1.75}
  article :global(.footnotes li){scroll-margin-top:2rem}
</style>
