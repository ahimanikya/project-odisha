---
import Shell from '../../../layouts/Shell.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import ArticleByline from '../../../components/ArticleByline.astro';
import ArticleReadingPath from '../../../components/ArticleReadingPath.astro';
import KotpadText from '../../../components/KotpadText.astro';
import KotpadContents from '../../../components/KotpadContents.astro';
import book from '../../../data/mirgan-kotpad-book.json';
import '../../../styles/article-reading.css';
import '../../../styles/kotpad-reading.css';
const opening=book.bookends.slice(0,2),closing=book.bookends.slice(2);
---
<Shell title={`${book.title} — the book`} description="Read the nine chapters of Mirgan Households and Kotpad Textiles online, or download the complete first reading edition." active="explore" related={false} shareImage={{src:book.cover.src,alt:book.cover.alt,width:book.cover.width,height:book.cover.height}}>
<article class="article-reading kotpad-reading">
<p><a href="/books/">← All books</a> · <a href="/stories/kotpad/">All chapters</a></p>
<header><p class="eyebrow">The book · First reading edition</p><h1>{book.title}</h1><p>{book.subtitle}</p><ArticleByline author={book.author}/></header>
<div class="book-opening"><figure><ResponsiveImage src={book.cover.src} sizes="(max-width: 640px) 256px, 288px" alt={book.cover.alt} width={book.cover.width} height={book.cover.height} fetchpriority="high"/><figcaption>The cover of the first reading edition.</figcaption></figure><div>{book.synopsis.map(p=><p>{p}</p>)}<p><a href={book.download.file}>Download the complete reading edition · PDF</a></p><p class="download-detail">{book.download.pages} pages, including the front and back covers.</p><p><a href="#introduction">Begin with the introduction →</a></p></div></div>
<nav id="contents" class="book-contents" aria-label="Book contents"><h2>Read the book online</h2><ol>{opening.map(s=><li><a href={`#${s.id}`}>{s.title}</a></li>)}<li><a href="#chapters">Nine connected chapters</a></li>{closing.map(s=><li><a href={`#${s.id}`}>{s.title}</a></li>)}<li><a href="#references">Footnotes &amp; Sources</a></li></ol></nav>
{opening.map(s=><section id={s.id} class="book-section"><h2>{s.title}</h2><KotpadText blocks={s.blocks} headingLevel={3}/><nav class="book-step" aria-label={`After ${s.title}`}><a href={s.id==='introduction'?'#method':'#chapters'}>Continue reading →</a><a href="#contents">Book contents</a></nav></section>)}
<section id="chapters" class="book-section"><h2>Nine connected chapters</h2><KotpadContents/></section>
{closing.map((s,i)=><section id={s.id} class="book-section"><h2>{s.title}</h2><KotpadText blocks={s.blocks} headingLevel={3}/><nav class="book-step" aria-label={`After ${s.title}`}><a href={closing[i+1]?`#${closing[i+1].id}`:'#references'}>Continue reading →</a><a href="#contents">Book contents</a></nav></section>)}
<section id="references" class="book-section bibliography"><h2>Footnotes &amp; Sources</h2><p>Numbers match the linked notes in the nine chapters. Each chapter places its sources beside the relevant account and provides return links.</p><ol>{book.references.map(r=><li id={`book-note-${r.number}`} value={r.number}><a href={r.url}>{r.title}</a> {r.note}<p>In {book.chapters.filter(c=>c.sources.some(s=>s.number===r.number)).map((c,i)=><Fragment>{i>0?', ':''}<a href={`/stories/kotpad/${c.slug}/#note-${r.number}`}>Chapter {c.number}</a></Fragment>)}.</p></li>)}</ol></section>
<p><a href={book.download.file}>Download the complete book · {book.download.pages} pages · PDF</a></p>
<ArticleReadingPath heading="Further reading" links={[{href:'/stories/dongria/book/',title:'Dongria Kondh: Life in Niyamgiri',description:'A separate companion book, following people, food, cloth, learning and songs in Niyamgiri.'}]}/>
<section class="suggest-update"><h2>Suggest an update</h2><p><a href="/contribute/?page=%2Fstories%2Fkotpad%2Fbook%2F">Share a correction or source for this book</a>.</p><p>GitHub submissions are public. Please omit private contact details and consent documents.</p></section>
</article></Shell>
