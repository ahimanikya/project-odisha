---
import Shell from '../../layouts/Shell.astro';
import ArticleReadingPath from '../../components/ArticleReadingPath.astro';
import ArticleByline from '../../components/ArticleByline.astro';
import '../../styles/article-reading.css';
import {Content, frontmatter} from '../../../../../kb/research/stories/buddhist-triangle/lalitgiri.md';

const image = {
  src: '/assets/buddhist-triangle/lalitgiri.jpg',
  width: 1440,
  height: 960,
  alt: 'Brick remains of an apsidal structure and rows of small stone stupas at Lalitgiri.',
};
---
<Shell title={frontmatter.title} description={frontmatter.description} shareImage={image} active="explore" wide related={false}>
  <article class="article-reading">
    <header>
      <p class="eyebrow">Cuttack · Buddhist heritage</p>
      <h1>{frontmatter.title}</h1>
      <ArticleByline author="Ahimanikya Satapathy"/>
    </header>
    <figure>
      <img {...image}
        srcset="/assets/buddhist-triangle/lalitgiri-720.jpg 720w, /assets/buddhist-triangle/lalitgiri-1080.jpg 1080w, /assets/buddhist-triangle/lalitgiri.jpg 1440w"
        sizes="(max-width: 600px) calc(100vw - 2.4rem), (max-width: 740px) calc(100vw - 2.8rem), 695.2px"
        loading="eager" fetchpriority="high"/>
      <figcaption>Brick remains of an apsidal structure and rows of small stone stupas at Lalitgiri. Photograph: Rupeshsarkar, <a href="https://commons.wikimedia.org/wiki/File:Lalitgiri_-_Odisha_-_001.jpg">“Lalitgiri - Odisha - 001.jpg”</a>, 15 September 2020. <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. Resized and compressed without cropping.</figcaption>
    </figure>
    <Content/>
    <ArticleReadingPath links={[{href:'/stories/ratnagiri/',title:'Ratnagiri: a place built for learning',description:'Monasteries, votive stupas and the archaeological evidence for a Buddhist institution.',image:'/assets/buddhist-triangle/ratnagiri.jpg'},{href:'/stories/udayagiri-buddhist/',title:'Buddhist Udayagiri in Jajpur',description:'Named monasteries, sacred texts and the work of daily life near Ratnagiri.',image:'/assets/buddhist-triangle/udayagiri.jpg'}]}/>
    <p><a href="/contribute/?page=%2Fstories%2Flalitgiri%2F">Suggest an update</a>. GitHub submissions are public; omit private contact details and consent documents.</p>
  </article>
</Shell>
<style>
  article :global(.footnotes) { margin-top:3.5rem; padding-top:1.5rem; border-top:1px solid var(--line); font-size:.95rem; }
  article :global(.footnotes h2) { position:static; width:auto; height:auto; padding:0; margin:0 0 1.4rem; overflow:visible; clip:auto; clip-path:none; white-space:normal; }
  article :global(.footnotes li) { scroll-margin-top:2rem; }
  article :global(.footnotes li:target) { background:var(--paper); outline:2px solid var(--line); outline-offset:.4rem; }
</style>
