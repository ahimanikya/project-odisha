---
import ArticleByline from '../../components/ArticleByline.astro';
import ArticleFootnote from '../../components/ArticleFootnote.astro';
import ArticleFootnotes from '../../components/ArticleFootnotes.astro';
import '../../styles/article-reading.css';
import Shell from '../../layouts/Shell.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import SaveJourney from '../../components/SaveJourney.astro';
import story from '../../../../../kb/research/stories/narratives/maritime-memory.json';
import regions from '../../../../../kb/research/destinations/regions.json';
const passages=story.chapters.flatMap(c=>c.paragraphs.map((_,i)=>({id:c.id+'-'+i,source_ids:c.paragraph_source_ids[i]})));
const hero=regions.assets[story.hero], courtyard=regions.assets[story.visit.photo];
---
<Shell title={story.title} description={story.lead} active="explore" wide related={false}>
<article class="article-reading maritime-story">
  <header class="maritime-hero">
    <div><p class="eyebrow">Odisha and the sea · A reading story</p><h1>Boita.<br/><em>A sea of connections.</em></h1><ArticleByline author={story.author} reviewedOn={story.reviewed_on}/><p class="lead">{story.lead}</p><a class="text-link" href="#remembered-voyages">Follow the story ↓</a></div>
    <figure><ResponsiveImage src={hero.src} width={hero.width} height={hero.height} alt={hero.alt} fetchpriority="high" sizes="(max-width: 900px) 92vw, 52vw"/><figcaption>{story.hero_caption}</figcaption></figure>
  </header>
  <section aria-label="Keep this reading story"><p>Keep this story for another day, with its questions and sources. Save it to My journey, then download a text or illustrated book. This saves the reading; the museum visit is a separate choice below.</p><SaveJourney id={story.save_id}/></section>
  <p class="opening-copy">{story.opening}</p>
  <nav class="story-nav" aria-label="Maritime story chapters">{story.chapters.map(c=><a href={'#'+c.id}>{c.eyebrow}</a>)}<a href="#visit-jobra">Bring it to a visit</a><a href="#story-sources">Footnotes &amp; Sources</a></nav>
  {story.chapters.map(chapter=><section id={chapter.id} class="story-chapter">
    <div class="chapter-title"><p class="eyebrow">{chapter.eyebrow}</p><h2>{chapter.title}</h2></div>
    <div class="chapter-body">{chapter.paragraphs.map((p,i)=><p>{p}<ArticleFootnote ids={chapter.paragraph_source_ids[i]} sources={story.sources} passage={chapter.id+'-'+i}/></p>)}
      {chapter.id==='a-travelled-stone'&&<div class="stone-connection" role="group" aria-label="Anchor rock evidence, not a sailing route"><div><span>Probable rock source</span><strong>Palitana, Gujarat</strong></div><div><span>Anchor find</span><strong>Manikapatna, Odisha</strong></div><p>Connected by the study’s material analysis. No itinerary is reconstructed here.</p></div>}
      <aside class="looking-question"><h3>A question to carry</h3><p>{chapter.question}</p></aside>
    </div>
  </section>)}
  <section id="visit-jobra" class="visit-jobra">
    <figure><ResponsiveImage src={courtyard.src} width={courtyard.width} height={courtyard.height} alt={courtyard.alt} loading="lazy" sizes="(max-width: 900px) 92vw, 50vw"/><figcaption>{story.visit.caption}</figcaption></figure>
    <div><p class="eyebrow">Read, notice, remember</p><h2>{story.visit.title}</h2><p>{story.visit.intro}</p><ol>{story.visit.questions.map(q=><li>{q}</li>)}</ol><a class="text-link" href={story.visit.href}>Read the museum guide →</a><p class="save-explanation">Keep the museum as an idea for a future visit.</p><SaveJourney id={story.visit.save_id}/></div>
  </section>
  <section class="next-reading"><p class="eyebrow">Keep the conversation moving</p><h2>What could we learn across a shared sea?</h2><p>Let curiosity about the past lead to respectful conversations today. Global Connections explores documented city relationships and possibilities for future collaboration.</p><a class="utk-button" href="/global-connections/">Explore Global Connections →</a><p><a href="/contribute/?page=%2Fstories%2Fmaritime-memory%2F">Share a public source or suggest a correction</a>. GitHub submissions are public; leave out private family and contact details.</p></section>
  <ArticleFootnotes sources={story.sources.map(s=>({...s,note:s.reader_note}))} passages={passages}><h3>Photographs</h3><ul>{[hero,courtyard].map((photo,index)=><li><a href={photo.source}>{index===0?'Boat-building display':'Museum courtyard'}</a> · {photo.creator} · <a href={photo.license_url}>{photo.license}</a>. {photo.changes}</li>)}</ul><p>Photographed in 2013. These museum views show neither the Manikapatna anchor nor an ancient voyage.</p></ArticleFootnotes>
</article>
</Shell>
<style>
.maritime-hero{display:block}.maritime-hero .lead{font-size:1.25rem;line-height:1.7}.maritime-story em{color:var(--earth)}.maritime-story figure :global(img){width:100%;height:auto;object-fit:contain}.opening-copy{font-size:1.25rem;line-height:1.75;margin:2rem 0}.story-nav{display:flex;flex-wrap:wrap;gap:.5rem 1.3rem;padding:1rem 0;border-block:1px solid var(--line);font-size:.9rem}.story-nav a{min-height:44px;display:inline-flex;align-items:center}.story-chapter{scroll-margin-top:2rem}.chapter-title .eyebrow{margin:3rem 0 .5rem}.chapter-title h2{margin-top:0}.looking-question{border-left:3px solid var(--earth);padding:.2rem 0 .2rem 1.2rem;margin:1.8rem 0 2.5rem;font-size:1rem}.looking-question h3{margin:0 0 .7rem}.looking-question p{margin:0}.stone-connection{display:grid;grid-template-columns:1fr 1fr;gap:1rem;background:var(--sea);color:var(--paper);padding:1.4rem;margin:1.8rem 0}.stone-connection span{display:block;font-size:.8rem}.stone-connection strong{font-size:1rem}.stone-connection p{grid-column:1/-1;font-size:.9rem;margin:0}.save-explanation{font-size:.9rem}.visit-jobra{margin-top:3rem}.next-reading{margin-top:3rem}@media(max-width:420px){.stone-connection{grid-template-columns:1fr}}@media print{.story-nav{display:none}.looking-question,.stone-connection{break-inside:avoid}}
</style>
