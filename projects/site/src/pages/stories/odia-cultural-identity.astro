---
import OdiaConnectedReading from '../../components/OdiaConnectedReading.astro';
import Shell from '../../layouts/Shell.astro';
import ArticleByline from '../../components/ArticleByline.astro';
import '../../styles/article-reading.css';
import {Content, frontmatter} from '../../../../../kb/research/culture/odia-cultural-identity.md';
const reading = [
  {href:'/languages/odia/', title:'The Odia language'},
  {href:'/sounds-of-odisha/dalkhai/', title:'Dalkhai: song, dance and community'},
  {href:'/textiles/sambalpuri-bandha/', title:'Sambalpuri Bandha weaving'},
  {href:'/culture/osha/nuakhai/', title:'Nuakhai: the new harvest'}
];
---
<Shell title={frontmatter.title} description={frontmatter.description} active="explore" wide related={false}>
  <article class="article-reading odia-identity-story">
    <a class="collection-return" href="/explore/">← Explore Odisha</a>
    <header class="identity-heading">
      <p class="eyebrow">Odisha · Language and living heritage</p>
      <h1>{frontmatter.title}</h1>
      <ArticleByline author="Ahimanikya Satapathy"/>
    </header>
    <figure class="identity-illustration">
      <img src="/images/stories/odia-identity-passing-on-culture.webp" width="1536" height="1024" alt="Illustration of an older woman and a child folding leaves around pitha batter together." decoding="async"/>
      <figcaption>Illustration · Culture lives in what we pass on.</figcaption>
    </figure>
    <Content/>
    <OdiaConnectedReading current="odia-cultural-identity"/>
    <section id="identity-further-reading" class="identity-further-reading">
      <h2>Further reading</h2>
        <nav aria-label="Related Odisha reading"><ul>{reading.map(link => <li><a href={link.href}>{link.title} →</a></li>)}</ul></nav>
    </section>
    <p class="identity-update"><a href="/contribute/?page=%2Fstories%2Fodia-cultural-identity%2F">Suggest an update</a>. GitHub submissions are public; omit private contact details and consent documents.</p>
  </article>
</Shell>
<script>
import {bindStorySourceLinks} from '../../lib/story-source-links.mjs';
document.querySelectorAll('.odia-identity-story sup, .odia-identity-story .footnotes').forEach(group => bindStorySourceLinks(group, document));
</script>
<style>
.collection-return{display:inline-block;margin:0 0 2rem;font-size:.95rem}
.identity-heading{margin-bottom:2rem}
.identity-heading .eyebrow{font-size:.75rem;margin-bottom:1rem}
.identity-further-reading{margin-top:3rem}
.identity-update{font-size:.9rem;line-height:1.75;margin-top:2.5rem}
/* Markdown's source heading is screen-reader-only by default. Keep it visible. */
.odia-identity-story :global(.footnotes){margin-top:3.5rem;padding-top:1.5rem;border-top:1px solid var(--line)}
.odia-identity-story :global(.footnotes h2){position:static;width:auto;height:auto;padding:0;margin:0 0 1.4rem;overflow:visible;clip:auto;clip-path:none;white-space:normal}
.odia-identity-story :global(.footnotes ol){font-size:.95rem;line-height:1.75}
.odia-identity-story :global(.footnotes li){scroll-margin-top:2rem;padding-left:.4rem;overflow-wrap:anywhere}
.odia-identity-story :global(.footnotes li:target){background:var(--paper);outline:2px solid var(--line);outline-offset:.4rem}
.odia-identity-story :global(.footnotes li p){margin-bottom:.65rem}
</style>
