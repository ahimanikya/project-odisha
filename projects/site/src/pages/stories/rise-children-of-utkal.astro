---
import Shell from '../../layouts/Shell.astro';
import ArticleByline from '../../components/ArticleByline.astro';
import OdiaConnectedReading from '../../components/OdiaConnectedReading.astro';
import '../../styles/article-reading.css';
import {Content, frontmatter} from '../../../../../kb/research/culture/rise-children-of-utkal.md';
---
<Shell title={frontmatter.title} description={frontmatter.description} shareImage={{src:"/images/stories/community-learning-circle.png",alt:"Illustration of neighbours learning together on a veranda.",width:1536,height:1024}} active="explore" wide related={false}>
<article class="article-reading"><header><h1>{frontmatter.title}</h1><ArticleByline author="Ahimanikya Satapathy"/></header>
