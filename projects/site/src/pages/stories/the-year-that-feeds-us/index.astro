---
import Shell from '../../../layouts/Shell.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import image from '../../../../../../kb/research/stories/osakothi-image.json';
import '../../../styles/article-reading.css';
import story from '../../../../../../kb/research/stories/when-the-goddess-comes-to-the-wall.json';
import ArticleByline from '../../../components/ArticleByline.astro';
import ArticleReadingPath from '../../../components/ArticleReadingPath.astro';
import {Content} from '../../../../../../kb/research/culture/the-year-that-feeds-us.md';
const chapters = [
  {href: '/stories/akhi-muthi-anukula/', title: 'Akhi Muthi Anukula', description: 'Follow the first handful of paddy seed from home to the field.'},
  {href: '/culture/osha/raja-parba/', title: 'Raja Parba', description: 'Resting the earth as the monsoon approaches.'},
  {href: '/stories/chitau-amavasya/', title: 'Chitau Amavasya', description: 'Follow a rice cake from the kitchen to the water and the people working among the paddy.'},
  {href: '/stories/garbhana-sankranti/', title: 'Garbhana Sankranti', description: 'Prayers for the rice still growing in the field, and a comparison with Gujarat’s Garba.'},
  {href: '/culture/osha/nuakhai/', title: 'Nuakhai', description: 'Offering and sharing the first new rice in western Odisha.'},
  {href: '/culture/osha/manabasa-gurubara/', title: 'Manabasa Gurubara', description: 'The grain measure, Lakshmi and the question of who may eat.'},
];
const title='The Year That Feeds Us';
const description='Stories of cultivation, food, seasonal observances and the people who carry them forward.';
---
<Shell title={title} description={description} active="explore" shareImage={image} wide related={false}>
 <div class="article-reading seasonal-series">
  <a href="/explore/">← Explore Project Odisha</a>
  <header><h1>{title}</h1><p class="series-dek">Nature, food and the celebration of life in Odisha</p><ArticleByline author="Ahimanikya Satapathy"/></header>
  <Content/>
  <ArticleReadingPath heading="Read the festival articles" links={chapters}/>
  <section id="series-stories" class="series-stories">
   <h2>Stories in this series</h2>
   <figure class="series-photograph">
    <a href={story.route}><ResponsiveImage src={image.src} alt={image.alt} width={image.width} height={image.height} sizes="(max-width: 470px) 90vw, 420px"/></a>
    <figcaption>{image.caption} Photograph by <a href={image.source}>{image.creator}</a>, <a href={image.license_url}>{image.license}</a>. Responsive versions resized and re-encoded without cropping.</figcaption>
   </figure>
   <h3><a href={story.route}>{story.title} <span aria-hidden="true">→</span></a></h3>
   <p>{story.description}</p>
  </section>
  <p class="article-update"><a href="/contribute/?page=%2Fstories%2Fthe-year-that-feeds-us%2F">Suggest an update</a>. GitHub submissions are public; omit private contact details and consent documents.</p>
 </div>
</Shell>
<style>
 .seasonal-series>header{margin-block:2rem}
 .series-dek{font-size:1.2rem;color:var(--muted)}
 .series-stories{margin-top:3rem;padding-top:1.5rem;border-top:1px solid var(--line)}
 .series-photograph{width:100%;max-width:420px;margin:1.5rem auto}
 .series-photograph :global(img){display:block;width:100%;height:auto;aspect-ratio:auto;object-fit:contain}
 .series-photograph figcaption{font-size:.85rem;line-height:1.6;margin-top:.75rem}
 .article-update{font-size:.9rem;margin-top:2.5rem}
</style>
