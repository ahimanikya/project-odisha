---
import Shell from '../../layouts/Shell.astro';
import ArticleByline from '../../components/ArticleByline.astro';
import ArticleReadingPath from '../../components/ArticleReadingPath.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import '../../styles/article-reading.css';
import { compiledContent } from '../../../../../kb/research/stories/watching-prahlad-natak.md';

const title = 'Finally Watching Prahlad Natak';
const description = 'A personal account of finally watching Prahlad Natak, enjoying its distinctive dance style, and meeting organiser and Odissi singer Soumya Biswajit.';
const dimensions = {
  'performance-space.jpg': [1600, 900],
  'performers-close.jpg': [1013, 1800],
  'stepped-platform.jpg': [1013, 1800],
  'book-at-venue.jpg': [1600, 900]
};
const shareImage = {src: '/assets/watching-prahlad-natak/performance-space.jpg', width: 1600, height: 900, alt: 'Performers and audience beneath a yellow-and-white canopy at a Prahlad Natak performance.'};
let articleHtml = await compiledContent();
if (typeof articleHtml !== 'string') throw new Error('Prahlad Natak Markdown must compile to HTML text.');
// Render this trusted, locally compiled manuscript with the existing responsive-image component.
// Exact matching fails the build if an image or caption would otherwise be silently omitted.
articleHtml = articleHtml.replace(/<h2\b[^>]*id="footnote-label"[^>]*>[\s\S]*?<\/h2>/, '<h2 id="footnote-label">Footnotes &amp; Sources</h2>')
  .replace(/<section([^>]*data-footnotes[^>]*)>/, (_, attributes) => {
    const styled = /class="[^"]*"/.test(attributes)
      ? attributes.replace(/class="([^"]*)"/, 'class="$1 article-footnotes"')
      : attributes + ' class="article-footnotes"';
    return '<section' + styled + '>';
  });
const pattern = /<p><img\b[^>]*src="(https:\/\/projectodisha\.org\/assets\/watching-prahlad-natak\/[^\"]+)"[^>]*><\/p>\s*<p><em>([\s\S]*?)<\/em><\/p>/g;
const parts = [];
let offset = 0;
for (const match of articleHtml.matchAll(pattern)) {
  const src = match[1].replace('https://projectodisha.org', '');
  const filename = src.split('/').pop();
  const size = dimensions[filename];
  const alt = match[0].match(/alt="([^"]*)"/)?.[1];
  if (!size || !alt) throw new Error('Unmapped Prahlad Natak photograph: ' + src);
  parts.push({html: articleHtml.slice(offset, match.index), photo: {src, alt, width: size[0], height: size[1], caption: match[2]}});
  offset = match.index + match[0].length;
}
parts.push({html: articleHtml.slice(offset), photo: null});
if (parts.filter(part => part.photo).length !== 4) throw new Error('Prahlad Natak article must render all four selected photographs.');
const readingLinks = [{href: '/stories/prahlada-nataka/', title: 'Prahallad Nataka: Ganjam’s Musical Theatre', description: 'Read about the tradition, its performers and its continuing transmission.', image: '/assets/prahallad-nataka/crafts-museum.jpg'}, {href: '/explore/?topic=Personal', title: 'More Personal Stories', description: 'Visits, encounters and reflections by Ahimanikya Satapathy.', image: '/assets/ekamra-evening/odissi-baithaki.jpg'}];
---
<Shell title={title} description={description} shareImage={shareImage} active="explore" wide related={false}>
  <article class="article-reading watching-prahlad-natak">
    <header>
      <p class="eyebrow"><a href="/explore/?topic=Personal">Personal</a> · Performance</p>
      <h1>{title}</h1>
      <ArticleByline author="Ahimanikya Satapathy" />
      <p class="publication-date">Published <time datetime="2026-11-16">16 November 2026</time></p>
    </header>
    {parts.map(({html, photo}, index) => <>
      <Fragment set:html={html} />
      {photo && <figure class:list={{portrait: photo.height > photo.width}}>
        <ResponsiveImage src={photo.src} alt={photo.alt} width={photo.width} height={photo.height}
          sizes={photo.height > photo.width ? '(max-width: 480px) calc(100vw - 2.4rem), 420px' : '(max-width: 600px) calc(100vw - 2.4rem), (max-width: 740px) calc(100vw - 2.8rem), 695.2px'}
          loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : undefined}/>
        <figcaption><Fragment set:html={photo.caption}/></figcaption>
      </figure>}
    </>)}
    <ArticleReadingPath heading="Continue reading" links={readingLinks} />
    <p class="reader-update"><a href="/contribute/?page=%2Fstories%2Fwatching-prahlad-natak%2F">Suggest an update</a>. GitHub submissions are public; omit private contact details and consent documents.</p>
  </article>
</Shell>
<style>
.watching-prahlad-natak .publication-date{margin:-1.2rem 0 2rem;color:var(--muted);font:normal .9rem/1.65 system-ui,sans-serif}
.watching-prahlad-natak figure.portrait{max-width:420px;margin:2.5rem auto 3rem}
.watching-prahlad-natak .reader-update{margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid var(--line);font-size:.95rem;line-height:1.75}
</style>
