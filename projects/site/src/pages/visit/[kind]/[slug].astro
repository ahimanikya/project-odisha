---
import ArticleByline from '../../../components/ArticleByline.astro';
import ArticleFootnote from '../../../components/ArticleFootnote.astro';
import ArticleFootnotes from '../../../components/ArticleFootnotes.astro';
import birdwatchingEditorial from '../../../../../../kb/research/destinations/mangalajodi-birdwatching-editorial.json';
import satapadaEditorial from '../../../../../../kb/research/destinations/satapada-editorial.json';
import kalijaiEditorial from '../../../../../../kb/research/destinations/kalijai-editorial.json';
import mangalajodiEditorial from '../../../../../../kb/research/destinations/mangalajodi-editorial.json';
import puriStaysEditorial from '../../../../../../kb/research/destinations/puri-stays-editorial.json';
import raghurajpurEditorial from '../../../../../../kb/research/destinations/raghurajpur-editorial.json';
import dhauliEditorial from '../../../../../../kb/research/destinations/dhauli-editorial.json';
import FiligreeStructure from '../../../components/FiligreeStructure.astro';
import notebooks from '../../../../../../kb/research/destinations/visit-notebooks.json';
import MagazineContents from '../../../components/MagazineContents.astro';
import VisitReadiness from '../../../components/VisitReadiness.astro';
import VisitNotebook from '../../../components/VisitNotebook.astro';
import {allowsPage} from '../../../data/edition';
import CollectionOnward from '../../../components/CollectionOnward.astro';
import {collectionChapter} from '../../../data/reading-collection';
import regions from '../../../../../../kb/research/destinations/regions.json';
import MagazineCover from '../../../components/MagazineCover.astro';
import '../../../styles/visitor-flow.css';
import {journeyCatalog} from '../../../data/journey-catalog';
import Shell from '../../../layouts/Shell.astro';
import DestinationPhoto from '../../../components/DestinationPhoto.astro';
import {detailRecords,detailPhoto,detailChapterPhoto,detailSources,relatedDetail,parentUrl,parentTitle} from '../../../data/destination-details';
export function getStaticPaths(){return detailRecords.map(record=>({params:{kind:record.kind,slug:record.slug},props:{record}}));}
const {record:r}=Astro.props;
const editorial=r.kind==='experiences'&&r.slug==='mangalajodi-birdwatching'?birdwatchingEditorial:r.kind==='places'?(r.slug==='satapada'?satapadaEditorial:r.slug==='kalijai'?kalijaiEditorial:r.slug==='mangalajodi'?mangalajodiEditorial:r.slug==='dhauli'?dhauliEditorial:r.slug==='raghurajpur'?raghurajpurEditorial:null):r.kind==='stays'&&r.slug==='puri-coast'?puriStaysEditorial:null;
const passageSources=(id)=>editorial?.passages.find(p=>p.id===id)?.source_ids||[];
const pagePath=`/visit/${r.kind}/${r.slug}/`,inCollection=collectionChapter(pagePath)>=0;
const hasNotebook=notebooks.notebooks.some(n=>n.route===pagePath);
const photo=detailPhoto(r),sources=detailSources(r);
const saveItem=journeyCatalog.find(i=>i.href===`/visit/${r.kind}/${r.slug}/`);
const kindLabel=r.kind==='stays'?'Stay-area guide':r.kind==='experiences'?'Things to do':'A closer look';
---
<Shell title={r.title} description={r.lead} active="explore" wide related={!r.single_ending&&!inCollection}>
 <div class:list={["utk-magazine", "utk-magazine--detail", {"detail-editorial":!!editorial}]}>
  <nav class="detail-breadcrumb" aria-label="Breadcrumb"><a href="/explore/">Explore</a><span aria-hidden="true">/</span><a href={parentUrl(r)}>{parentTitle(r)}</a><span aria-hidden="true">/</span><span>{kindLabel}</span></nav>
  <MagazineCover title={r.title} subtitle={r.subtitle} eyebrow={parentTitle(r)+' · '+kindLabel} deck={[r.lead]} photo={photo} saveId={saveItem?.id} startHref="#detail-section-1" startLabel={r.start_label||(r.kind==='stays'?'Research the area':'Look a little closer')} footline={r.footline||(r.kind==='stays'?'Choose the area. Then find your stay.':'One place. Your own way into it.')}><Fragment slot="byline">{editorial&&<ArticleByline author={editorial.author}/>}</Fragment></MagazineCover>
  <MagazineContents links={[...r.sections.map((section,index)=>({href:'#detail-section-'+(index+1),label:section.nav_label||section.heading})),...(hasNotebook?[{href:'#visit-notebook',label:'Visit notebook'}]:[]),{href:inCollection?'#collection-onward':'#connect-visit',label:inCollection?'Continue the collection':'Connect your visit'},...(((r.kind==='experiences'&&r.slug==='mangalajodi-birdwatching')||r.slug==='raghurajpur'||(r.kind==='places'&&['mangalajodi','kalijai','satapada'].includes(r.slug))||(r.kind==='stays'&&r.slug==='puri-coast'))?[{href:'#story-sources',label:'Footnotes & Sources'}]:[])]}/>

  <article class="mag-content">
   <div class="mag-article-chapters">{r.sections.map((section,index)=><section id={'detail-section-'+(index+1)} class:list={['mag-reading-section',{'mag-reading-section--warm':index===1}]}><div><p class="eyebrow">{String(index+1).padStart(2,'0')} · {kindLabel}</p><h2>{section.heading}</h2></div><div data-source-ids={(section.sources||section.source_ids||[]).join(' ')}>{section.photo_ref&&section.photo_position==='before'&&<div class="detail-chapter-photo detail-chapter-photo--before" style={`max-width: ${detailChapterPhoto(section.photo_ref).width}px`}><DestinationPhoto photo={{...detailChapterPhoto(section.photo_ref),caption:section.photo_caption||detailChapterPhoto(section.photo_ref).caption}}/></div>}<p>{section.text}{editorial&&<ArticleFootnote ids={passageSources(`detail-${index}`)} sources={editorial.sources} passage={`detail-${index}`}/>}</p>{section.paragraphs?.map((text,pindex)=><p>{text}{editorial&&<ArticleFootnote ids={passageSources(`detail-${index}-p-${pindex}`)} sources={editorial.sources} passage={`detail-${index}-p-${pindex}`}/>}</p>)}{section.diagram==='filigree-frame'&&<FiligreeStructure/>}{section.links&&<nav class="detail-section-links" aria-label={section.heading+' connections'}>{section.links.filter(link=>allowsPage(link.href)).map(link=><a href={link.href}>{link.title} →</a>)}</nav>}{section.options&&<div class="area-options">{section.options.map(option=><section><h3>{option.area}</h3><dl><dt>Consider it for</dt><dd>{option.fit}</dd><dt>Transport to plan</dt><dd>{option.transport}</dd><dt>Ask before booking</dt><dd>{option.check}</dd></dl></section>)}</div>}{section.photo_ref&&section.photo_position!=='before'&&<div class="detail-chapter-photo"><DestinationPhoto photo={{...detailChapterPhoto(section.photo_ref),caption:section.photo_caption||detailChapterPhoto(section.photo_ref).caption}}/></div>}</div>{section.making_steps&&<ol class="making-sequence" aria-label="Three stages to notice">{section.making_steps.map((step,stepIndex)=><li><span class="making-number" aria-hidden="true">{String(stepIndex+1).padStart(2,'0')}</span><p class="eyebrow">{step.cue}</p><h3>{step.title}</h3><p>{step.text}{editorial&&<ArticleFootnote ids={passageSources(`detail-${index}-step-${stepIndex}`)} sources={editorial.sources} passage={`detail-${index}-step-${stepIndex}`}/>}</p></li>)}</ol>}</section>)}</div>
   {!editorial?.practical_in_article&&<VisitReadiness/>}
   <VisitNotebook editorial={editorial}/>
   {inCollection?<div id="connect-visit"><CollectionOnward path={pagePath} extraLinks={r.related.map(relatedDetail).filter(Boolean)}/></div>:<><section id="connect-visit" class="visit-connections"><div><p class="eyebrow">Connect the pieces</p><h2>Make room for<br/><em>the whole visit.</em></h2><p>Know the place, choose an experience and research a base. These are related ideas, not a confirmed route.</p></div><nav aria-label="Related places and experiences">{r.related.map(relatedDetail).filter(link=>link&&allowsPage(link.href)).map(link=><a href={link.href}><span>{link.href.includes('/food/')?'At the table':link.href.includes('/stays/')?'Stay-area research':link.href.includes('/experiences/')?'An experience':link.href.includes('/places/')?'The place':link.href.includes('/crafts/')?'A craft story':'The wider destination'}</span><strong>{link.title} ↗</strong></a>)}<a href="/journey/"><span>Bring your choices together</span><strong>Open my journey →</strong></a></nav></section></>}
   {r.gallery?.filter(id=>!r.sections.some(s=>s.photo_ref===id)).map(id=><div class="detail-gallery"><DestinationPhoto photo={detailChapterPhoto(id)}/></div>)}
   {!editorial&&<p class="mag-status">Editorial draft · {r.kind==='stays'?'Area research, not a reviewed property.':'Practical details need local confirmation.'}</p>}
  {editorial?<ArticleFootnotes sources={editorial.sources} passages={editorial.passages}><div id="sources-credits"><h3>Photographs</h3><p><a href={photo.source}>{photo.title}</a> by {photo.creator} · <a href={photo.license_url}>{photo.license}</a>. {photo.changes}</p>{r.gallery?.map(id=><p><a href={detailChapterPhoto(id).source}>{detailChapterPhoto(id).caption}</a> by {detailChapterPhoto(id).creator} · <a href={detailChapterPhoto(id).license_url}>{detailChapterPhoto(id).license}</a>. {detailChapterPhoto(id).changes}</p>)}</div></ArticleFootnotes>:<><details class="end-credits utk-disclosure" id="sources-credits"><summary>Sources, photograph & research notes</summary><p>Research checked {r.checked_on}. Sections include original editorial planning advice. No prices, availability, verified travel times or booking service are provided.</p><ul>{sources.map(source=><li><a href={source.resource}>{source.title}</a><p>{source.inspection}</p></li>)}</ul><p><a href={photo.source}>{photo.title}</a> by {photo.creator} · <a href={photo.license_url}>{photo.license}</a>. {photo.changes} {r.photo_context}</p>{r.gallery?.map(id=><p><a href={detailChapterPhoto(id).source}>{detailChapterPhoto(id).caption}</a> by {detailChapterPhoto(id).creator} · <a href={detailChapterPhoto(id).license_url}>{detailChapterPhoto(id).license}</a>. {detailChapterPhoto(id).changes}</p>)}<p>Project Odisha knowledge base. Founder & Editor-in-Chief: Ahimanikya Satapathy. Drafted with AI assistance; human editorial review pending.</p></details></>}

 </article></div>
</Shell>

<style>.detail-chapter-photo{margin-top:28px}.detail-chapter-photo :global(img){width:100%;height:auto;object-fit:contain}.detail-gallery{margin:40px 0}.detail-gallery :global(img){width:100%;height:auto}</style>

<style>.area-options{display:grid;gap:24px;margin-top:28px}.area-options section{padding:24px;background:var(--paper);border:1px solid var(--line)}.area-options h3{font-size:28px;margin:0 0 18px;color:var(--sea)}.area-options dl{margin:0}.area-options dt{font-weight:700;font-size:14px;margin-top:18px;color:var(--earth)}.area-options dd{margin:6px 0 0;font-size:17px;line-height:1.7}</style>

<style>
.making-sequence{grid-column:1/-1;list-style:none;padding:0;margin:12px 0 0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.making-sequence li{border-top:3px solid var(--earth);padding:24px;background:var(--paper);min-width:0}.making-sequence li:nth-child(2){border-color:var(--sea)}.making-sequence li:nth-child(3){border-color:var(--muted)}.making-number{display:block;font:48px/1 var(--serif);color:var(--earth);margin-bottom:24px}.making-sequence h3{font:clamp(24px,2vw,32px)/1.2 var(--serif);color:var(--sea);margin:12px 0 18px}.making-sequence li>p:last-child{font-size:17px;line-height:1.8;margin:0}@media(max-width:750px){.making-sequence{grid-template-columns:1fr;gap:16px}.making-sequence li{padding:20px}.making-number{font-size:36px;margin-bottom:16px}}
</style>

<style>.detail-chapter-photo--before{margin:0 0 28px}.detail-section-links{display:flex;flex-wrap:wrap;gap:12px 24px;margin-top:24px}.detail-section-links a{display:inline-flex;align-items:center;min-height:44px}</style>

<script>
import {bindStorySourceLinks} from '../../../lib/story-source-links.mjs';
document.querySelectorAll('.detail-editorial sup, .detail-editorial .article-footnotes').forEach(group=>bindStorySourceLinks(group,document));
</script>
<style>
.detail-editorial .mag-article-chapters{max-width:740px;margin-inline:auto}
.detail-editorial .mag-reading-section{display:block;padding:0;margin:56px 0;background:none}
.detail-editorial .mag-reading-section h2{font-size:clamp(28px,3vw,38px);line-height:1.3;margin:0 0 24px}
.detail-editorial .mag-reading-section p:not(.eyebrow){font-size:18px;line-height:1.85;margin:0 0 1.25em;max-width:none}
.detail-editorial :global(.article-footnotes){max-width:740px;margin:64px auto 48px;border-top:1px solid var(--line);padding-top:28px;font-size:16px;line-height:1.8}
.detail-editorial :global(.article-footnotes p){margin:0 0 1.25em}
.detail-editorial :global(.article-footnotes h2){font-size:30px;margin:0 0 24px}
.detail-editorial :global(.article-footnotes li){margin-bottom:24px;scroll-margin-top:24px;overflow-wrap:anywhere}
.detail-editorial :global(.article-footnotes li:target){outline:2px solid var(--line);outline-offset:6px}
.detail-editorial :global(sup){font-size:.7em;line-height:0;margin-left:.15em}
.detail-editorial :global(a[data-footnote-ref]){font-weight:600;text-decoration:none;padding:.2em .15em}
.detail-editorial :global(a[data-footnote-backref]){display:inline-block;padding:.2rem .3rem}
.detail-editorial :global(a:focus-visible){outline:2px solid var(--earth);outline-offset:3px}
.detail-editorial :global(.mag-cover>figure img){object-fit:contain;aspect-ratio:auto}
@media(max-width:700px){.detail-editorial .mag-reading-section{margin:40px 0}.detail-editorial .mag-reading-section p:not(.eyebrow){font-size:17px;line-height:1.8}}
</style>
