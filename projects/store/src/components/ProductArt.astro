---
import DesignImage from './DesignImage.astro';
const {product, large=false}=Astro.props;
const alt=product.name+'. '+(product.image_label||'Design concept; not a manufactured sample.');
---
<figure class:list={['merch-render',{'large':large}]}>
 <DesignImage src={product.image} alt={alt} view={product.image_view} width={product.image_width||1448} height={product.image_height||1086} eager={large} maxHeight={large?620:340}/>
 <figcaption>{product.image_label}</figcaption>
</figure>
