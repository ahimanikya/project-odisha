---
import Store from '../layouts/Store.astro';
---
<Store title="Private store dashboard"><section class="wrap admin"><p class="eyebrow">ODISHA STORE · PRIVATE</p><h1>Store <em>dashboard.</em></h1><p class="lead">Manage the catalogue and the people interested in it.</p><p id="admin-status" role="status" aria-live="polite"></p><form id="login-form" class="stack-form login-panel"><label for="admin-password">Administrator password</label><input id="admin-password" name="password" type="password" autocomplete="current-password" required/><button class="button">Sign in</button><p class="small-print">Customer information is loaded only after you sign in.</p></form><div id="admin-content" hidden><div class="admin-toolbar"><button class="button" data-tab="orders">Interest requests</button><button class="button secondary" data-tab="catalog">Catalogue & supply</button><button id="logout" class="text-button">Sign out</button></div><section id="orders-panel"><div class="section-head"><div><h2>Interest requests</h2><p id="orders-count"></p></div><button id="refresh-orders" class="text-button">Refresh requests</button></div><p class="notice">These are expressions of interest. Nothing has been paid, allocated or reserved. Marking a request reviewed or closed does not contact the customer.</p><div id="orders"></div><div class="admin-toolbar"><button id="previous-orders" class="text-button">← Previous</button><button id="next-orders" class="text-button">Next →</button></div></section><section id="catalog-panel" hidden><h2>Catalogue & supply</h2><p class="notice">Leave an unknown price or quantity blank. Zero means a confirmed zero. Quantities are reported figures; receiving interest does not change them. Only enter a price or available supply you can support.</p><div id="catalog-editor"></div></section></div><noscript><p>JavaScript is required for this private dashboard.</p></noscript></section></Store>
<script>import '../scripts/admin.js';</script>
