---
import Store from '../../layouts/Store.astro';
import DesignImage from '../../components/DesignImage.astro';
import ProductArt from '../../components/ProductArt.astro';
import products from '../../data/products.json';
export function getStaticPaths(){return products.map(product=>({params:{slug:product.id},props:{product}}));}
const {product}=Astro.props;
---
<Store title={product.name}><div class="wrap"><p class="breadcrumb"><a href="/catalog/">The collection</a> / {product.name}</p><section class="product-detail"><div><ProductArt product={product} large/><p class="design-note">{product.concept_label}</p></div><div><p class="eyebrow">{product.collection}</p><h1>{product.name}</h1><p class="lead">{product.description}</p><form id="selection-form" data-product={product.id}><label for="variant">{product.kind==='tee'?'Proposed size':product.kind==='poetry-jhula'?'Bag or kit':'Design option'}</label><select id="variant" name="variant" required>{product.variants.map(v=><option value={v}>{v==='Standard'?'Ivory & blue':v}</option>)}</select><label for="quantity">Quantity</label><input id="quantity" name="quantity" type="number" min="1" max="10" value="1" required/><div class="option-availability" id="option-availability" aria-live="polite">Price and supply to be confirmed</div><button class="button" type="submit">Add to your selection ↗</button></form><p id="save-status" role="status"></p><a class="text-link" href="/bag/">View selection & register interest →</a><details open><summary>Before you register interest</summary><p>This is a design concept. Materials, dimensions, sizing, finish and delivery timing will be confirmed after physical samples are reviewed. Any price shown is indicative.</p><p>No payment is required. Sending interest neither reserves stock nor commits you to buy. We’ll contact you when the product is ready, so you can decide then.</p></details></div></section><section class="closing"><p class="eyebrow">DESIGN DETAILS</p><h2>A closer look.</h2><div class="design-gallery">{product.galleries.map(g=><figure><DesignImage src={g.src} alt={g.caption} view={g.image_view} width={g.image_width} height={g.image_height}/><figcaption>{g.caption}</figcaption></figure>)}</div>{product.kind==='poetry-jhula'&&<p class="notice">The proposed Poetry Kit includes the Jhula, an A5 cloth notebook, a refillable pen, a bookmark, a pen sleeve and an Odia poetry book. The book and final materials are still to be selected. The two Pattachitra border studies are bag-only. <a href="https://projectodisha.org/odia-poetry-jhula/">Read the collection’s story and craft notes →</a></p>}<p class="design-note">{product.kind==='poetry-jhula'?'Cloth, borders and making techniques describe design directions, not verified craft provenance. Final materials and construction will be agreed through sampling.':'The sailing scenes are artistic interpretations of Odisha’s maritime memory. Colours, proportions and print placement may change after sample review.'}</p><a class="text-link" href={product.kind==='poetry-jhula'?'/kabi-jhulas/':'/design-review/'}>{product.kind==='poetry-jhula'?'Explore all Kabi Jhulas →':'See the earlier artwork studies →'}</a></section></div></Store>
<script>import '../../scripts/product.js';</script>
